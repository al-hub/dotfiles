#!/usr/bin/env bash
# scripts/tmux-popup-detector
# tmux 팝업창 레이아웃 밀림 및 기능 실행 실패 디텍터 스크립트 (양방향 검사 최종 완벽 버전)

SOCKET="cmd-palette-detect"

# 1. 격리된 임시 tmux 세션 생성 (단축키 리스트 긁어오기 용)
tmux -L "$SOCKET" -f dotfiles/tmux.conf new-session -d -s test-session

PALETTE_SCRIPT="/home/al-hub/.local/bin/tmux-command-palette"

echo "[Detector] 1. 팝업 스크립트 환경 검사 시작..."
if [ ! -f "$PALETTE_SCRIPT" ]; then
    echo "[Detector] ⚠️ $PALETTE_SCRIPT 파일이 설치되어 있지 않습니다."
    tmux -L "$SOCKET" kill-server 2>/dev/null
    exit 1
fi

mismatch_found=false
execution_fail_detected=false

# 2. fzf 실행 옵션(프롬프트, 헤더) 내 이모지/특수문자 포함 여부 정밀 디텍트
FZF_OPT_PROMPT=$(grep -E "\-\-prompt=" "$PALETTE_SCRIPT" 2>/dev/null)
FZF_OPT_HEADER=$(grep -E "\-\-header=" "$PALETTE_SCRIPT" 2>/dev/null)

detect_emoji_in_string() {
    local name="$1"
    local val="$2"
    if echo "$val" | grep -q -E "[⌨🎨🗂✂📝➡️⬅❓⏰🖼💡🔧🚀]" 2>/dev/null; then
        echo "🔴 [밀림 디텍트] $name 에 이모지 포함 감지! -> $val"
        mismatch_found=true
    else
        echo "🟢 [정상] $name 에 이모지 없음"
    fi
}

echo "[Detector] 2. fzf 프롬프트 및 헤더 옵션 분석..."
detect_emoji_in_string "fzf --prompt" "$FZF_OPT_PROMPT"
detect_emoji_in_string "fzf --header" "$FZF_OPT_HEADER"

# 3. 실행 기능 무반응 및 씹힘 방지 체크
echo ""
echo "[Detector] 3. 실행 프로세스 이스케이프 및 컨텍스트 추적 감지..."

RUN_SHELL_WITHOUT_PANE=$(grep -E "tmux (run-shell -b|eval-shell)" "$PALETTE_SCRIPT" | grep -v "\-t" 2>/dev/null)
if [ -n "$RUN_SHELL_WITHOUT_PANE" ]; then
    echo "🔴 [실행 실패 디텍트] 타깃 pane(-t) 없이 비동기 run-shell/eval-shell 호출 감지!"
    execution_fail_detected=true
else
    echo "🟢 [정상] 비동기 run-shell/eval-shell 에 타깃 pane 지정 설정되어 있음"
fi

TRACE_STR=$(grep -E "2> \"\\\$ERR_LOG\"" "$PALETTE_SCRIPT" 2>/dev/null)
TRACE_STATUS=$(grep -F "echo \"SUCCESS\" > \"\$STATUS_FILE\"" "$PALETTE_SCRIPT" 2>/dev/null)
TRACE_EXIT=$(grep -F "echo \$? > \"\$EXIT_LOG\"" "$PALETTE_SCRIPT" 2>/dev/null)

if [ -z "$TRACE_STR" ] || [ -z "$TRACE_STATUS" ] || [ -z "$TRACE_EXIT" ]; then
    echo "⚠️ [추적 미설정] 스크립트 내부에 에러/종료코드/상태 양방향 추적 장치(Handshake)가 심어져 있지 않습니다."
    execution_fail_detected=true
else
    echo "🟢 [정상] 고유 에러 및 종료코드, 양방향 상태 추적 장치 설치 확인"
fi

# 4. 동적 런타임 실행 시뮬레이션 및 양방향 핸드셰이크 검증 (E2E Test Execution)
echo ""
echo "[Detector] 4. 동적 런타임 실행 시뮬레이션 및 에러 검출..."

PANE_CLEAN_ID="0"
TEST_ERR_LOG="/tmp/tmux-cmd-palette-run-${PANE_CLEAN_ID}.err"
TEST_STATUS_FILE="/tmp/tmux-cmd-palette-status-${PANE_CLEAN_ID}.log"
TEST_EXIT_LOG="/tmp/tmux-cmd-palette-exit-${PANE_CLEAN_ID}.log"

# 기존 테스트 자원 정리
rm -f "$TEST_ERR_LOG" "$TEST_STATUS_FILE" "$TEST_EXIT_LOG"

# headless 및 연결된 터미널 개수와 상관없이 항상 무조건 성공(Exit 0)을 반환하는 display-message 명령어 래핑 실행
TEST_CMD="display-message 'Success'"
echo "Starting E2E simulation with command: $TEST_CMD"

# tmux 가상 환경 내에서 동적 테스트 실행기 호출
TMUX="/tmp/tmux-1000/$SOCKET" TMUX_PANE="%0" "$PALETTE_SCRIPT" --test-exec-cmd "$TEST_CMD" >/dev/null 2>&1

# 비동기 구동 대기
sleep 1.2

# 4-1. 실행 유실(False Negative) 디텍션
if [ ! -f "$TEST_STATUS_FILE" ]; then
    echo "🔴 [동적 실행 실패 검출] 실행 플래그 파일이 생성되지 않았습니다! (실행 흐름 유실)"
    execution_fail_detected=true
else
    STATUS_VAL=$(cat "$TEST_STATUS_FILE")
    if [ "$STATUS_VAL" != "SUCCESS" ]; then
        echo "🔴 [동적 실행 실패 검출] 실행 흐름 완료 실패 (상태: $STATUS_VAL)"
        execution_fail_detected=true
    else
        echo "🟢 [정상] 실행 흐름 정상 완료 확인 (SUCCESS 핸드셰이크 감지)"
    fi
fi

# 4-2. 명령어 리턴 코드 (Exit Code) 검출
if [ -f "$TEST_EXIT_LOG" ]; then
    EXIT_CODE=$(cat "$TEST_EXIT_LOG" | tr -d '[:space:]')
    if [ -n "$EXIT_CODE" ] && [ "$EXIT_CODE" -ne 0 ]; then
        echo "🔴 [동적 실행 실패 검출] 비동기 명령어가 에러 코드($EXIT_CODE)를 뿜으며 비정상 종료됨!"
        execution_fail_detected=true
    else
        echo "🟢 [정상] 명령어 반환 종료 코드 정상 (Exit: 0)"
    fi
fi

# 4-3. 표준 에러 로그 감시
if [ -f "$TEST_ERR_LOG" ] && [ -s "$TEST_ERR_LOG" ]; then
    ERR_CONTENT=$(cat "$TEST_ERR_LOG")
    echo "🔴 [동적 실행 실패 검출] 가상 실행 중 stderr 에러 발생!"
    echo "   -> 에러 원인: $ERR_CONTENT"
    execution_fail_detected=true
fi

# 테스트 완료 후 임시 파일 깔끔하게 클리업
rm -f "$TEST_ERR_LOG" "$TEST_STATUS_FILE" "$TEST_EXIT_LOG"

# 5. 목록 데이터 너비 검사
get_hotkeys_and_detect() {
    declare -A KEY_NOTES
    while IFS= read -r line; do
        if [ -n "$line" ]; then
            key=$(echo "$line" | awk '{print $1}')
            key_parts_count=$(echo "$line" | awk '{print $2}' | grep -E "^(C-|M-|S-|[a-zA-Z0-9\?\!\"\'\#\$\&\(\)\*\+\,\-\.\/\:\;\<\=\>\@\[\\\]\^\_\`\{\|\}\~])" | wc -l)
            if [ "$key_parts_count" -gt 0 ]; then
                key=$(echo "$line" | awk '{print $1 " " $2}')
                desc=$(echo "$line" | cut -d' ' -f3- | sed 's/^[[:space:]]*//')
            else
                desc=$(echo "$line" | cut -d' ' -f2- | sed 's/^[[:space:]]*//')
            fi
            if [ -n "$key" ] && [ -n "$desc" ]; then
                KEY_NOTES["$key"]="$desc"
            fi
        fi
    done < <(tmux -L "$SOCKET" list-keys -N 2>/dev/null)

    local MAX_ALLOWED_WIDTH=50
    local line_no=1

    echo ""
    echo "[Detector] 5. 라인별 가시 너비(Visual Width) 검사..."
    echo "허용 한계폭: $MAX_ALLOWED_WIDTH 칸"
    echo "--------------------------------------------------------"

    get_visual_width() {
        local str="$1"
        echo -n "$str" | awk '
        BEGIN { FS="" }
        {
            w = 0
            for (i=1; i<=NF; i++) {
                if ($i ~ /[ㄱ-ㅎㅏ-ㅣ가-힣]/ || ord($i) > 127) {
                    w += 2
                } else {
                    w += 1
                }
            }
            print w
        }
        function ord(c,    i, n) {
            for (i=1; i<=255; i++) {
                if (sprintf("%c", i) == c) return i
            }
            return 256
        }'
    }

    declare -A ALIAS_MAP
    ALIAS_MAP["tmux-theme-picker"]="[테마] 테마 피커 실행"
    ALIAS_MAP["tmux-session-launcher --open-sidebar"]="[세션] 세션 런처 사이드바 토글"
    ALIAS_MAP["next-window"]="[윈도우] 다음 윈도우로 이동"
    ALIAS_MAP["previous-window"]="[윈도우] 이전 윈도우로 이동"
    ALIAS_MAP["tmux-session-launcher --split-horizontal"]="[분할] 작업 영역 가로 분할"
    ALIAS_MAP["tmux-session-launcher --split-vertical"]="[분할] 작업 영역 세로 분할"
    ALIAS_MAP["copy-mode"]="[복사] 텍스트 복사 모드 진입"

    while read -r line; do
        if [[ "$line" =~ -T[[:space:]]+([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]+(.+) ]]; then
            local table="${BASH_REMATCH[1]}"
            local key="${BASH_REMATCH[2]}"
            local raw_cmd="${BASH_REMATCH[3]}"
            local clean_cmd=$(echo "$raw_cmd" | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g')

            local lookup_key=""
            if [ "$table" = "prefix" ]; then
                lookup_key="C-a $key"
            else
                lookup_key="$key"
            fi

            local display_desc=""
            
            if [ -n "${KEY_NOTES[$lookup_key]}" ]; then
                display_desc="${KEY_NOTES[$lookup_key]}"
            elif [ -n "${KEY_NOTES[$key]}" ]; then
                display_desc="${KEY_NOTES[$key]}"
            else
                for pattern in "${!ALIAS_MAP[@]}"; do
                    if [[ "$clean_cmd" =~ $pattern ]]; then
                        display_desc="${ALIAS_MAP[$pattern]}"
                        break
                    fi
                done
                if [ -z "$display_desc" ]; then
                    display_desc="$clean_cmd"
                fi
            fi

            local key_label=""
            [ "$table" = "prefix" ] && key_label="[Ctrl+a $key]" || key_label="[$key]"
            local formatted_key=$(printf "%-18s" "$key_label")
            local truncated_desc="${display_desc:0:30}"

            local key_width=${#key_label}
            [ "$key_width" -lt 18 ] && key_width=18
            local desc_width=$(get_visual_width "$truncated_desc")
            local total_width=$((key_width + desc_width + 2))

            if [ "$total_width" -gt "$MAX_ALLOWED_WIDTH" ]; then
                echo "🔴 [밀림 디텍트] Line $line_no: $key_label -> $truncated_desc (너비: $total_width 칸 초과!)"
                mismatch_found=true
            fi
            line_no=$((line_no + 1))
        fi
    done < <(tmux -L "$SOCKET" list-keys | grep -E "(-T prefix|-T root)" | grep -vE "(Mouse|MouseDown|MouseDrag|DoubleClick|Wheel)")

    echo "--------------------------------------------------------"
}

get_hotkeys_and_detect

# 세션 안전하게 정리
tmux -L "$SOCKET" kill-server 2>/dev/null

# 6. 최종 판정 보고 및 종료 코드 전송
if [ "$mismatch_found" = true ] || [ "$execution_fail_detected" = true ]; then
    echo "[Detector] RESULT: 🔴 오류 검출 성공 (Layout Shift / Execution Fail Detected)"
    exit 1
else
    echo "[Detector] RESULT: 🟢 오류 없음 (Safe & Aligned)"
    exit 0
fi

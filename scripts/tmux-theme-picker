#!/usr/bin/env bash

# ==============================================================================
# Preview Renderer Subcommand
# ==============================================================================
if [ "$1" = "--preview" ]; then
    file="$2"
    if [ ! -f "$file" ]; then
        echo "Theme file not found: $file"
        exit 1
    fi

    filename=$(basename "$file" .conf)
    title=""
    status_bg="" status_fg="" win_bg="" win_act_bg="" border_act="" border_inact=""

    while IFS= read -r line || [ -n "$line" ]; do
        # Extract title from first comment line
        if [[ "$line" =~ ^#[[:space:]]*(.*) ]] && [ -z "$title" ]; then
            title="${BASH_REMATCH[1]}"
            continue
        fi

        if [[ "$line" =~ status-style.*bg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            status_bg="${BASH_REMATCH[1]}"
        fi
        if [[ "$line" =~ status-style.*fg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            status_fg="${BASH_REMATCH[1]}"
        fi
        if [[ "$line" =~ window-style.*bg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            win_bg="${BASH_REMATCH[1]}"
        fi
        if [[ "$line" =~ window-active-style.*bg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            win_act_bg="${BASH_REMATCH[1]}"
        fi
        if [[ "$line" =~ pane-active-border-style.*fg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            border_act="${BASH_REMATCH[1]}"
        fi
        if [[ "$line" =~ pane-border-style.*fg=[\'\"]?#?([0-9a-fA-F]{6})[\'\"]? ]]; then
            border_inact="${BASH_REMATCH[1]}"
        fi
    done < "$file"

    category="CUSTOM / USER"
    case "$filename" in
        base-*) category="BASELINE" ;;
        open-*) category="OPEN SOURCE SIGNATURE" ;;
        code-*) category="CODE & SHELL ENVIRONMENT" ;;
        eye-*) category="EYE CARE & ERGONOMICS" ;;
        disp-*) category="DISPLAY & LIGHT SPECIALIZED" ;;
        os-*) category="OS PLATFORM SIGNATURE" ;;
        retro-*) category="RETRO CRT HARDWARE" ;;
    esac

    is_focus=false
    if [[ "$filename" == *-focus ]]; then
        is_focus=true
    fi

    color_chip() {
        local hex="$1"
        local label="$2"
        if [ -n "$hex" ] && [ ${#hex} -eq 6 ]; then
            local r=$((16#${hex:0:2}))
            local g=$((16#${hex:2:2}))
            local b=$((16#${hex:4:2}))
            printf "  %-16s : \033[48;2;%d;%d;%dm      \033[0m #%s\n" "$label" "$r" "$g" "$b" "$hex"
        else
            printf "  %-16s : (default)\n" "$label"
        fi
    }

    echo -e "\033[1;36m┌────────────────────────────────────────────────────────────┐\033[0m"
    printf "\033[1;36m│\033[0m \033[1;37m🎨 THEME: %-48s\033[0m \033[1;36m│\033[0m\n" "$filename"
    echo -e "\033[1;36m├────────────────────────────────────────────────────────────┤\033[0m"
    printf "  \033[1mCategory\033[0m : %s\n" "$category"
    [ -n "$title" ] && printf "  \033[1mSummary\033[0m  : %s\n" "$title"
    if [ "$is_focus" = true ]; then
        echo -e "  \033[1mVariant\033[0m  : \033[1;33m🌟 Focus-Aware (High Active/Inactive Contrast)\033[0m"
    else
        echo -e "  \033[1mVariant\033[0m  : Standard Palette"
    fi
    echo ""
    echo -e "  \033[1;4m[ Color Palette & Tokens ]\033[0m"
    color_chip "$status_bg" "Status Bar BG"
    color_chip "$status_fg" "Status Bar FG"
    color_chip "$win_act_bg" "Active Pane BG"
    color_chip "$win_bg" "Inactive Pane BG"
    color_chip "$border_act" "Active Border"
    color_chip "$border_inact" "Inactive Border"
    echo ""
    echo -e "  \033[1;4m[ Ergonomics & Recommendations ]\033[0m"
    case "$filename" in
        eye-astigmatism-*)
            echo "  • Benefit   : Low halation & controlled contrast (WCAG AA)"
            echo "  • Best For  : Astigmatism & reduced eye strain"
            ;;
        eye-circadian-*)
            echo "  • Benefit   : 2700K warm amber, zero blue-light disturbance"
            echo "  • Best For  : Late-night coding & circadian rhythm protection"
            ;;
        eye-scotopic-*)
            echo "  • Benefit   : Purkinje green wavelength adaptation"
            echo "  • Best For  : Darkroom & low luminance environments"
            ;;
        disp-oled-*)
            echo "  • Benefit   : 100% True Black (#000000) pixel power shutoff"
            echo "  • Best For  : OLED / QD-OLED monitors & laptop battery saving"
            ;;
        disp-paper-*)
            echo "  • Benefit   : Warm parchment cream texture & anti-glare"
            echo "  • Best For  : Daytime natural sunlight & documentation"
            ;;
        retro-*)
            echo "  • Benefit   : Monochromatic phosphor aesthetic & 80s nostalgia"
            echo "  • Best For  : Deep focus terminal work & retro hacking"
            ;;
        code-powershell)
            echo "  • Style     : Windows PowerShell signature royal blue & yellow"
            echo "  • Best For  : Windows/PowerShell enthusiasts & CLI administration"
            ;;
        code-windows-terminal)
            echo "  • Style     : Windows Terminal Campbell dark & Fluent accent blue"
            echo "  • Best For  : Modern multi-pane split workflows"
            ;;
        *)
            echo "  • Lighting  : Standard darkroom / balanced studio"
            echo "  • Best For  : Universal coding & multitasking"
            ;;
    esac
    echo -e "\033[1;36m└────────────────────────────────────────────────────────────┘\033[0m"
    exit 0
fi

# ==============================================================================
# Main Interactive Theme Picker
# ==============================================================================

THEME_DIR="$HOME/.config/tmux/themes"
CONFIG_THEME_FILE="$HOME/.config/tmux/theme.conf"

# 테마 디렉토리가 없거나 비어있는 경우 자동 채우기
if [ ! -d "$THEME_DIR" ] || [ -z "$(find "$THEME_DIR" -name "*.conf" 2>/dev/null)" ]; then
    mkdir -p "$THEME_DIR"
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    SRC_THEMES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)/dotfiles/tmux/themes"
    if [ -d "$SRC_THEMES_DIR" ]; then
        cp "$SRC_THEMES_DIR"/*.conf "$THEME_DIR/" 2>/dev/null
    fi
fi

# 원래 활성화되어 있던 테마 정보 파악
if [ -f "$CONFIG_THEME_FILE" ]; then
    ORIG_THEME="$CONFIG_THEME_FILE"
elif [ -f "$THEME_DIR/base-classic.conf" ]; then
    ORIG_THEME="$THEME_DIR/base-classic.conf"
else
    ORIG_THEME="$THEME_DIR/classic-baseline.conf"
fi

get_themes_list() {
    find "$THEME_DIR" -name "*.conf" | while read -r filepath; do
        filename=$(basename "$filepath")
        theme_name="${filename%.conf}"

        # Determine Category Weight & Badge
        weight=90
        badge="[USER]  "

        case "$theme_name" in
            base-*)
                weight=00
                badge="[BASE]  "
                ;;
            open-*-focus)
                weight=11
                badge="[OPEN*] "
                ;;
            open-*)
                weight=10
                badge="[OPEN]  "
                ;;
            code-*)
                weight=20
                badge="[CODE]  "
                ;;
            eye-*-focus)
                weight=31
                badge="[EYE*]  "
                ;;
            eye-*)
                weight=30
                badge="[EYE]   "
                ;;
            disp-*)
                weight=40
                badge="[DISP]  "
                ;;
            os-*)
                weight=50
                badge="[OS]    "
                ;;
            retro-*)
                weight=60
                badge="[RETRO] "
                ;;
            classic-baseline|display-oled-pureblack|paper-sepia)
                # Legacy compatibility alias files: skip duplicate display
                continue
                ;;
        esac

        display_label="${badge} ${theme_name}"
        printf "%s\t%s\t%s\t%s\n" "$weight" "$display_label" "$theme_name" "$filepath"
    done | sort -k1,1 -k3,3 | cut -f2-
}

apply_theme_permanently() {
    local theme_path="$1"
    mkdir -p "$(dirname "$CONFIG_THEME_FILE")"
    cp "$theme_path" "$CONFIG_THEME_FILE"
    tmux source-file "$CONFIG_THEME_FILE" 2>/dev/null || tmux display-message "Theme applied permanently."
}

edit_theme() {
    local orig_theme_name="$1"
    local orig_theme_path="$2"

    clear
    echo "=== Clone & Edit Theme ==="
    echo "Cloning from: $orig_theme_name"
    read -p "Enter new theme name (prefix 'custom-' recommended): " new_name

    # 입력 검증
    if [[ ! "$new_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Invalid name. Only alphanumeric, dashes, and underscores allowed."
        sleep 2
        return 1
    fi

    # Auto-prefix with custom- if no category prefix
    if [[ ! "$new_name" =~ ^(custom|user)- ]]; then
        new_name="custom-${new_name}"
    fi

    local new_theme_path="$THEME_DIR/${new_name}.conf"
    if [ -f "$new_theme_path" ]; then
        echo "Error: Theme '${new_name}' already exists."
        sleep 2
        return 1
    fi

    cp "$orig_theme_path" "$new_theme_path"

    # 에디터 실행
    ${EDITOR:-vi} "$new_theme_path"

    echo "Theme '${new_name}' created at $new_theme_path"
    read -p "Do you want to apply this new theme now? [y/N] " yn
    case $yn in
        [Yy]* )
            apply_theme_permanently "$new_theme_path"
            ORIG_THEME="$new_theme_path"
            ;;
        * )
            echo "Theme saved but not applied."
            sleep 1
            ;;
    esac
    return 0
}

run_picker() {
    while true; do
        local list
        list=$(get_themes_list)

        if command -v fzf >/dev/null 2>&1; then
            local supports_focus=false
            if echo "" | fzf --bind "focus:accept" --filter "" >/dev/null 2>&1; then
                supports_focus=true
            fi

            local self_script
            self_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

            if [ "$supports_focus" = true ]; then
                fzf_out=$(echo "$list" | fzf -d $'\t' --with-nth=1 \
                    --preview "bash \"$self_script\" --preview {3}" \
                    --preview-window="right:48%:wrap" \
                    --bind "focus:execute-silent(tmux source-file {3})" \
                    --bind "ctrl-p:toggle-preview" \
                    --header "Enter: Apply | Esc/q: Cancel | Ctrl-e: Clone & Edit | Ctrl-p: Preview" \
                    --expect="ctrl-e" \
                    --prompt="Theme> ")
            else
                fzf_out=$(echo "$list" | fzf -d $'\t' --with-nth=1 \
                    --preview "bash \"$self_script\" --preview {3}" \
                    --preview-window="right:48%:wrap" \
                    --header "Enter: Apply | Esc/q: Cancel | Ctrl-e: Clone & Edit | Ctrl-p: Preview" \
                    --expect="ctrl-e" \
                    --prompt="Theme (No Preview)> ")
            fi

            if [ -z "$fzf_out" ]; then
                # Cancel/Esc
                if [ -f "$ORIG_THEME" ]; then
                    tmux source-file "$ORIG_THEME"
                fi
                exit 0
            fi

            key_pressed=$(echo "$fzf_out" | head -n 1)
            selected_item=$(echo "$fzf_out" | tail -n 1)

            if [ -z "$selected_item" ]; then
                if [ -f "$ORIG_THEME" ]; then
                    tmux source-file "$ORIG_THEME"
                fi
                exit 0
            fi

            theme_name=$(echo "$selected_item" | cut -f2)
            theme_path=$(echo "$selected_item" | cut -f3)

            if [ "$key_pressed" = "ctrl-e" ]; then
                edit_theme "$theme_name" "$theme_path"
                continue
            else
                apply_theme_permanently "$theme_path"
                exit 0
            fi
        else
            # fzf fallback
            clear
            echo "=== tmux Theme Picker (fallback) ==="
            echo "fzf is not installed. Interactive preview is disabled."
            echo "Select a theme by number (Ctrl+C to cancel):"

            local names=()
            local paths=()
            local i=1
            while IFS=$'\t' read -r label name path; do
                names+=("$label")
                paths+=("$path")
                echo "$i) $label"
                ((i++))
            done <<< "$list"

            echo "$i) [Clone & Edit Existing Theme]"

            read -p "Choice [1-$i]: " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
                if [ "$choice" -eq "$i" ]; then
                    echo "Choose a theme to clone from:"
                    for idx in "${!names[@]}"; do
                        echo "$((idx+1))) ${names[$idx]}"
                    done
                    read -p "Select base theme [1-${#names[@]}]: " base_choice
                    if [[ "$base_choice" =~ ^[0-9]+$ ]] && [ "$base_choice" -ge 1 ] && [ "$base_choice" -le "${#names[@]}" ]; then
                        local b_idx=$((base_choice-1))
                        edit_theme "${names[$b_idx]}" "${paths[$b_idx]}"
                    fi
                else
                    local s_idx=$((choice-1))
                    apply_theme_permanently "${paths[$s_idx]}"
                    exit 0
                fi
            else
                echo "Invalid choice. Exiting."
                exit 1
            fi
        fi
    done
}

run_picker

#!/usr/bin/env bash

# tmux-sidebar-tmux-adapter
#
# Small, explicit tmux command boundary for the single-sidebar controller.
# All callers should pass stable pane/window/session IDs where possible.

SIDEBAR_TMUX_CONTROL_ENABLED="${TMUX_SESSION_SIDEBAR_CONTROL_MODE:-false}"
SIDEBAR_TMUX_CONTROL_ACTIVE=0
SIDEBAR_TMUX_CONTROL_PID=""
SIDEBAR_TMUX_CONTROL_IN=""
SIDEBAR_TMUX_CONTROL_OUT=""
SIDEBAR_TMUX_CONTROL_DIR=""
SIDEBAR_TMUX_CONTROL_IN_PATH=""
SIDEBAR_TMUX_CONTROL_OUT_PATH=""
SIDEBAR_TMUX_CONTROL_LAST_SENT=0

sidebar_tmux_control_socket()
{
    local socket="${TMUX:-}"
    socket="${socket%%,*}"
    [ -n "$socket" ] || return 1
    printf '%s\n' "$socket"
}

sidebar_tmux_control_available()
{
    [ "$SIDEBAR_TMUX_CONTROL_ACTIVE" = 1 ] || return 1
    [ -n "$SIDEBAR_TMUX_CONTROL_PID" ] || return 1
    kill -0 "$SIDEBAR_TMUX_CONTROL_PID" 2>/dev/null
}

sidebar_tmux_control_start()
{
    local socket target control_dir in_path out_path
    [ "$SIDEBAR_TMUX_CONTROL_ENABLED" = true ] || return 1
    sidebar_tmux_control_available && return 0
    socket="$(sidebar_tmux_control_socket || true)"
    [ -n "$socket" ] && [ -S "$socket" ] || return 1
    target="${TMUX_SESSION_SIDEBAR_CONTROL_TARGET:-${current_session:-}}"
    [ -n "$target" ] || target="$(command tmux -S "$socket" display-message -p '#S' 2>/dev/null || true)"
    [ -n "$target" ] || return 1
    control_dir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sidebar-control.XXXXXX")" || return 1
    in_path="$control_dir/in"
    out_path="$control_dir/out"
    mkfifo "$in_path" "$out_path" || {
        rmdir "$control_dir" 2>/dev/null || true
        return 1
    }
    # Ordinary file descriptors remain available in Bash command-substitution
    # subshells, unlike coprocess descriptors. This lets adapter calls used in
    # pipelines share one persistent control connection.
    exec {SIDEBAR_TMUX_CONTROL_IN}<>"$in_path"
    exec {SIDEBAR_TMUX_CONTROL_OUT}<>"$out_path"
    command tmux -C -S "$socket" attach-session -t "$target" \
        <"$in_path" >"$out_path" 2>/dev/null &
    SIDEBAR_TMUX_CONTROL_PID="$!"
    SIDEBAR_TMUX_CONTROL_DIR="$control_dir"
    SIDEBAR_TMUX_CONTROL_IN_PATH="$in_path"
    SIDEBAR_TMUX_CONTROL_OUT_PATH="$out_path"
    SIDEBAR_TMUX_CONTROL_ACTIVE=1
    if [ -z "$SIDEBAR_TMUX_CONTROL_IN" ] || [ -z "$SIDEBAR_TMUX_CONTROL_OUT" ] ||
        ! sidebar_tmux_control_available; then
        sidebar_tmux_control_stop
        return 1
    fi
    # attach-session emits an initial empty command response and a
    # session-changed notification before the first request. Drain those
    # asynchronous records so request/response parsing starts at a boundary.
    while IFS= read -r -t 0.05 -u "$SIDEBAR_TMUX_CONTROL_OUT" line; do :; done
    return 0
}

sidebar_tmux_control_stop()
{
    SIDEBAR_TMUX_CONTROL_ACTIVE=0
    if [ -n "${SIDEBAR_TMUX_CONTROL_PID:-}" ]; then
        kill "$SIDEBAR_TMUX_CONTROL_PID" 2>/dev/null || true
        wait "$SIDEBAR_TMUX_CONTROL_PID" 2>/dev/null || true
    fi
    SIDEBAR_TMUX_CONTROL_PID=""
    if [ -n "${SIDEBAR_TMUX_CONTROL_IN:-}" ]; then
        eval "exec ${SIDEBAR_TMUX_CONTROL_IN}>&-" 2>/dev/null || true
    fi
    if [ -n "${SIDEBAR_TMUX_CONTROL_OUT:-}" ]; then
        eval "exec ${SIDEBAR_TMUX_CONTROL_OUT}>&-" 2>/dev/null || true
    fi
    SIDEBAR_TMUX_CONTROL_IN=""
    SIDEBAR_TMUX_CONTROL_OUT=""
    if [ -n "${SIDEBAR_TMUX_CONTROL_DIR:-}" ]; then
        rm -f "$SIDEBAR_TMUX_CONTROL_IN_PATH" "$SIDEBAR_TMUX_CONTROL_OUT_PATH" 2>/dev/null || true
        rmdir "$SIDEBAR_TMUX_CONTROL_DIR" 2>/dev/null || true
    fi
    SIDEBAR_TMUX_CONTROL_DIR=""
    SIDEBAR_TMUX_CONTROL_IN_PATH=""
    SIDEBAR_TMUX_CONTROL_OUT_PATH=""
}

sidebar_tmux_control_quote_args()
{
    local arg quoted
    for arg in "$@"; do
        quoted="${arg//\'/\'\\\'\'}"
        printf "'%s' " "$quoted"
    done
}

sidebar_tmux_control_request()
{
    local command_line line status=0 completed=0
    SIDEBAR_TMUX_CONTROL_LAST_SENT=0
    sidebar_tmux_control_available || return 2
    command_line="$(sidebar_tmux_control_quote_args "$@")"
    [ -n "$command_line" ] || return 1
    SIDEBAR_TMUX_CONTROL_LAST_SENT=1
    printf '%s\n' "$command_line" >&"$SIDEBAR_TMUX_CONTROL_IN" || return 1
    while IFS= read -r -u "$SIDEBAR_TMUX_CONTROL_OUT" line; do
        case "$line" in
            %begin\ *) ;;
            %end\ *) completed=1; break ;;
            %error\ *) status=1; break ;;
            %session-changed\ *|%sessions-changed|%window-add\ *|%window-close\ *|%unlinked-window-add\ *|%unlinked-window-close\ *|%window-pane-changed\ *|%pane-mode-changed\ *|%client-session-changed\ *|%layout-change\ *|%output\ *|%extended-output\ *|%pause\ *|%continue\ *|%client-detached) ;;
            %exit) SIDEBAR_TMUX_CONTROL_ACTIVE=0; return 2 ;;
            *) printf '%s\n' "$line";;
        esac
    done
    [ "$completed" = 1 ] || return 2
    return "$status"
}

sidebar_tmux_control_request_batch()
{
    local command_line line status=0 completed=0 command
    SIDEBAR_TMUX_CONTROL_LAST_SENT=0
    sidebar_tmux_control_available || return 2
    command_line=""
    for command in "$@"; do
        [ -n "$command" ] || continue
        command_line+="$command \\; "
    done
    [ -n "$command_line" ] || return 1
    SIDEBAR_TMUX_CONTROL_LAST_SENT=1
    printf '%s\n' "$command_line" >&"$SIDEBAR_TMUX_CONTROL_IN" || return 1
    while IFS= read -r -u "$SIDEBAR_TMUX_CONTROL_OUT" line; do
        case "$line" in
            %begin\ *) ;;
            %end\ *) completed=1; break ;;
            %error\ *) status=1; break ;;
            %session-changed\ *|%sessions-changed|%window-add\ *|%window-close\ *|%unlinked-window-add\ *|%unlinked-window-close\ *|%window-pane-changed\ *|%pane-mode-changed\ *|%client-session-changed\ *|%layout-change\ *|%output\ *|%extended-output\ *|%pause\ *|%continue\ *|%client-detached) ;;
            %exit) SIDEBAR_TMUX_CONTROL_ACTIVE=0; return 2 ;;
            *) printf '%s\n' "$line";;
        esac
    done
    [ "$completed" = 1 ] || return 2
    return "$status"
}

sidebar_tmux_cmd()
{
    if [ "$SIDEBAR_TMUX_CONTROL_ACTIVE" = 1 ]; then
        sidebar_tmux_control_request "$@"
        case "$?" in
            0) return 0;;
            2) :;;
            *) return 1;;
        esac
    fi
    local tmux_socket="${TMUX:-}"
    tmux_socket="${tmux_socket%%,*}"
    if [ -n "$tmux_socket" ] && [ -S "$tmux_socket" ]; then
        tmux -S "$tmux_socket" "$@"
    else
        tmux "$@"
    fi
}

sidebar_tmux_global_sidebar_pane()
{
    sidebar_tmux_cmd list-panes -a \
        -F '#{pane_id}|#{session_name}|#{window_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' '$4 == "dotfiles-session-sidebar" { print $1 }'
}

sidebar_tmux_sidebar_pane_count()
{
    sidebar_tmux_global_sidebar_pane | sed '/^$/d' | wc -l | tr -d ' '
}

sidebar_tmux_session_id()
{
    local session_name="$1"
    sidebar_tmux_cmd list-sessions -F '#{session_name}|#{session_id}' 2>/dev/null |
        awk -F '|' -v session="$session_name" '$1 == session { print $2; exit }'
}

sidebar_tmux_session_target()
{
    local session_name="$1"
    local session_id
    session_id="$(sidebar_tmux_session_id "$session_name")"
    [ -n "$session_id" ] || return 1
    printf '%s\n' "$session_id"
}

sidebar_tmux_pane_session()
{
    sidebar_tmux_cmd display-message -p -t "$1" '#{session_name}' 2>/dev/null || true
}

sidebar_tmux_pane_window()
{
    sidebar_tmux_cmd display-message -p -t "$1" '#{window_id}' 2>/dev/null || true
}

sidebar_tmux_session_window()
{
    local session_target
    session_target="$(sidebar_tmux_session_target "$1")" || return 0
    sidebar_tmux_cmd display-message -p -t "${session_target}:" '#{window_id}' 2>/dev/null || true
}

sidebar_tmux_work_pane()
{
    local target_window="$1"
    sidebar_tmux_cmd list-panes -t "$target_window" -F '#{pane_id}|#{pane_title}|#{pane_active}' 2>/dev/null |
        awk -F '|' '$2 != "dotfiles-session-sidebar" && $3 == 1 { print $1; exit }'
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        return 1
    fi
}

sidebar_tmux_any_work_pane()
{
    local target_window="$1"
    sidebar_tmux_cmd list-panes -t "$target_window" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' '$2 != "dotfiles-session-sidebar" { print $1; exit }'
}

sidebar_tmux_work_pane_summary()
{
    local target_window="$1"
    sidebar_tmux_cmd list-panes -t "$target_window" \
        -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' '$2 != "dotfiles-session-sidebar" { if (first == "") first=$1; count++ } END { print first "|" (count + 0) }'
}

sidebar_tmux_pane_context()
{
    sidebar_tmux_cmd display-message -p -t "$1" '#{session_name}|#{window_id}' 2>/dev/null || true
}

sidebar_tmux_window_layout()
{
    sidebar_tmux_cmd display-message -p -t "$1" '#{window_layout}' 2>/dev/null || true
}

sidebar_tmux_window_pane_ids()
{
    sidebar_tmux_cmd list-panes -t "$1" -F '#{pane_id}' 2>/dev/null
}

sidebar_tmux_window_active_pane()
{
    sidebar_tmux_cmd list-panes -t "$1" -F '#{pane_id}|#{pane_active}' 2>/dev/null |
        awk -F '|' '$2 == 1 { print $1; exit }'
}

sidebar_tmux_select_layout()
{
    sidebar_tmux_cmd select-layout -t "$1" "$2" >/dev/null 2>&1
}

sidebar_tmux_select_pane()
{
    sidebar_tmux_cmd select-pane -t "$1" >/dev/null 2>&1
}

sidebar_tmux_client_tty_for_session()
{
    local session_name="$1"
    sidebar_tmux_cmd list-clients -F '#{client_control_mode}|#{client_tty}|#{session_name}' 2>/dev/null |
        awk -F '|' -v session="$session_name" '$1 != 1 && $3 == session { print $2; exit }'
}

sidebar_tmux_client_tty_for_window()
{
    local window_id="$1"
    [ -n "$window_id" ] || return 1
    sidebar_tmux_cmd list-clients -F '#{client_control_mode}|#{client_tty}|#{window_id}' 2>/dev/null |
        awk -F '|' -v window="$window_id" '$1 != 1 && $3 == window { print $2; exit }'
}

sidebar_tmux_move_pane()
{
    local sidebar_pane="$1"
    local target_work_pane="$2"
    local width="$3"
    sidebar_tmux_cmd move-pane -d -s "$sidebar_pane" -t "$target_work_pane" -b -h -l "$width"
}

sidebar_tmux_switch_client()
{
    local client_tty="$1"
    local target_session="$2"
    local session_target
    session_target="$(sidebar_tmux_session_target "$target_session")" || return 1
    sidebar_tmux_cmd switch-client -c "$client_tty" -t "$session_target"
}

#!/usr/bin/env bash
# scripts/tmux-command-palette
# tmux 단축키 커맨드 팔레트 (fzf 기반)

# 1. 쉘 스크립트 자체 내장 별칭 사전 (Alias) - Notes 설명이 없는 기본 명령어 보완용
declare -A ALIAS_MAP
ALIAS_MAP["tmux-theme-picker"]="🎨 테마 피커 실행 (Theme Picker)"
ALIAS_MAP["tmux-session-launcher --open-sidebar"]="🗂️ 세션 런처 사이드바 토글"
ALIAS_MAP["next-window"]="➡️ 다음 윈도우로 이동 (Next Window)"
ALIAS_MAP["previous-window"]="⬅️ 이전 윈도우로 이동 (Prev Window)"
ALIAS_MAP["tmux-session-launcher --split-horizontal"]="✂️ 작업 영역 가로 분할 (Split Horizontal)"
ALIAS_MAP["tmux-session-launcher --split-vertical"]="✂️ 작업 영역 세로 분할 (Split Vertical)"
ALIAS_MAP["copy-mode"]="📝 텍스트 복사 모드 진입 (Copy Mode)"

# 2. tmux 내장 Notes (-N 옵션 정보) 추출 및 적재
declare -A KEY_NOTES
while IFS= read -r line; do
    if [ -n "$line" ]; then
        # 첫 번째 필드(단축키)와 나머지 필드(설명) 분리
        key=$(echo "$line" | awk '{print $1}')
        # C-a C-o 처럼 스페이스가 포함된 키 대응을 위해 첫 두 필드가 단축키인지 판별
        key_parts_count=$(echo "$line" | awk '{print $2}' | grep -E "^(C-|M-|S-|[a-zA-Z0-9\?\!\"\'\#\$\&\(\)\*\+\,\-\.\/\:\;\<\=\>\@\[\\\]\^\_\`\{\|\}\~])" | wc -l)
        if [ "$key_parts_count" -gt 0 ]; then
            key=$(echo "$line" | awk '{print $1 " " $2}')
            desc=$(echo "$line" | cut -d' ' -f3- | sed 's/^[[:space:]]*//')
        else
            desc=$(echo "$line" | cut -d' ' -f2- | sed 's/^[[:space:]]*//')
        fi
        
        if [ -n "$key" ] && [ -n "$desc" ]; then
            KEY_NOTES["$key"]="$desc"
        fi
    fi
done < <(tmux list-keys -N 2>/dev/null)

# 3. 모든 단축키 목록 추출 및 정규화
get_hotkeys() {
    tmux list-keys | grep -E "(-T prefix|-T root)" | grep -vE "(Mouse|MouseDown|MouseDrag|DoubleClick|Wheel)" | while read -r line; do
        # 라인 포맷: bind-key -T prefix key command...
        local table=$(echo "$line" | awk '{print $3}')
        local key=$(echo "$line" | awk '{print $4}')
        local raw_cmd=$(echo "$line" | cut -d' ' -f5-)

        # 특수 이스케이프 문자 언이스케이프 보정
        local clean_cmd=$(echo "$raw_cmd" | sed -e 's/\\;/;/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g')

        # 키 매칭용 검색어 조립 (C-a T 또는 M-Left 등)
        local lookup_key=""
        if [ "$table" = "prefix" ]; then
            lookup_key="C-a $key"
        else
            lookup_key="$key"
        fi

        # 1순위: tmux 내장 Notes 설명
        # 2순위: ALIAS_MAP 수동 별칭 매핑
        # 3순위: 날것의 명령어 그대로 노출 (Fallback)
        local display_desc=""
        local is_custom_desc=false
        
        if [ -n "${KEY_NOTES[$lookup_key]}" ]; then
            display_desc="${KEY_NOTES[$lookup_key]}"
            is_custom_desc=true
        elif [ -n "${KEY_NOTES[$key]}" ]; then
            display_desc="${KEY_NOTES[$key]}"
            is_custom_desc=true
        else
            # ALIAS_MAP 매칭 확인
            for pattern in "${!ALIAS_MAP[@]}"; do
                if [[ "$clean_cmd" =~ $pattern ]]; then
                    display_desc="${ALIAS_MAP[$pattern]}"
                    is_custom_desc=true
                    break
                fi
            done
            if [ "$is_custom_desc" = false ]; then
                display_desc="$clean_cmd"
            fi
        fi

        # 정렬 가중치 (0: 핵심 설명 키, 1: 일반 prefix 키, 2: 일반 root 키, 3: 설명 없는 키)
        local weight=3
        if [ "$is_custom_desc" = true ]; then
            weight=0
        elif [ "$table" = "prefix" ]; then
            weight=1
        else
            weight=2
        fi

        # 단축키 라벨 포맷팅
        local key_label=""
        if [ "$table" = "prefix" ]; then
            key_label="[Ctrl+a $key]"
        else
            key_label="[$key]"
        fi

        # 고정 폭(18자) 지정 - 영문/특수문자 괄호만 사용하여 줄 정렬을 완벽하게 맞춤
        local formatted_key
        formatted_key=$(printf "%-18s" "$key_label")

        # 출력 포맷: 가중치 \t 정렬된키 \t 설명 \t 실제명령어
        # 단축키나 명령어에 파이프(|) 기호가 섞여서 필드가 깨지는 오류를 방지하기 위해 탭(\t) 구분자 채택
        printf "%d\t%s\t%s\t%s\n" "$weight" "$formatted_key" "$display_desc" "$clean_cmd"
    done | sort -t$'\t' -k1,1n -k2,2 | sort -u -t$'\t' -k2,2
}

# 4. fzf 기반 대화형 실행기 구동
run_palette() {
    local list
    list=$(get_hotkeys)
    
    if ! command -v fzf >/dev/null 2>&1; then
        tmux display-message "Error: fzf is required for command palette."
        exit 1
    fi

    # fzf 실행 옵션:
    # -d '\t': 탭 문자 기준으로 필드 분할 (단축키에 |가 들어있어도 완벽 방어)
    # --with-nth=2,3: 가중치(필드1)와 명령어(필드4)를 숨기고 단축키(필드2)와 설명(필드3)만 화면에 이쁘게 출력
    # --no-border: tmux 팝업 테두리와 겹쳐 깨지는 버그 해결
    # --margin=0,2: 팝업 좌측/우측 끝 괘선 깨짐 및 어긋남 방지용 좌우 2칸의 안전 여백 확보
    # --height 100%: 팝업 공간을 꽉 채워 렌더링 오차 방지
    # --preview: 하단 영역에 실제 실행될 tmux 명령어 격리 노출
    # --tiebreak=index: 검색 매칭 시 가중치 정렬 순서를 유지하며 첫 번째 매치에 포커스 자동 고정
    local selected
    selected=$(echo "$list" | fzf -d $'\t' --with-nth=2,3 \
        --no-border \
        --margin=0,2 \
        --height 100% \
        --layout=reverse \
        --prompt="⌨️ 단축키 검색 및 실행> " \
        --header="Enter: 실행, Esc/q: 취소 (방향키로 명령 확인)" \
        --preview="echo {} | cut -f4-" \
        --preview-window="down:2:wrap:border-top" \
        --tiebreak=index)

    if [ -n "$selected" ]; then
        # 선택된 결과에서 실제 명령어(네 번째 필드) 추출
        local cmd
        cmd=$(echo "$selected" | cut -f4- | sed 's/^[[:space:]]*//')

        # 팝업 중첩 및 레이스 방지:
        # 스크립트가 exit 0로 끝나면서 팝업이 자동으로 닫히도록 유도하고,
        # 0.15초의 충분한 딜레이 후 tmux run-shell -b 비동기 방식으로 명령어 전달
        (sleep 0.15 && tmux run-shell -b "$cmd") &
        exit 0
    fi
}

run_palette

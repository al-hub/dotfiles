#!/usr/bin/env bash
# scripts/tmux-command-palette
# tmux 단축키 커맨드 팔레트 (fzf 기반)

# 실행 대상 pane 식별자 확보 (비동기 TTY 유실 및 팝업창 소멸 오인 버그 완벽 방지용)
TARGET_PANE="${TMUX_PANE:-}"
# 만약 TARGET_PANE이 비어있거나, 팝업창 자신의 pane을 가리키고 있을 오류를 대비한 2중 Fallback
if [ -z "$TARGET_PANE" ] || [ "$TARGET_PANE" = "$(tmux display-message -p '#{pane_id}' 2>/dev/null)" ]; then
    # -t ! 옵션은 tmux 내에서 '마지막으로 활성화되었던 이전 pane(부모 작업 pane)'을 정확하게 저격함
    LAST_PANE=$(tmux display-message -p -t ! '#{pane_id}' 2>/dev/null || true)
    if [ -n "$LAST_PANE" ]; then
        TARGET_PANE="$LAST_PANE"
    else
        TARGET_PANE=$(tmux display-message -p '#{pane_id}' 2>/dev/null)
    fi
fi

# pane ID(%1 등)에서 특수문자를 제거하여 안전한 고유 파일명 식별자로 변환
PANE_CLEAN_ID=$(echo "$TARGET_PANE" | tr -d '%')
ERR_LOG="/tmp/tmux-cmd-palette-run-${PANE_CLEAN_ID}.err"
STATUS_FILE="/tmp/tmux-cmd-palette-status-${PANE_CLEAN_ID}.log"
EXIT_LOG="/tmp/tmux-cmd-palette-exit-${PANE_CLEAN_ID}.log"

# 임시 매핑 파일 관리용 디렉토리 생성 및 정리 설정
MAP_DIR="/tmp/tmux-cmd-palette-map.$$"
mkdir -p "$MAP_DIR"
MAP_FILE="$MAP_DIR/map"
trap "rm -rf $MAP_DIR" EXIT

# 1. 쉘 스크립트 자체 내장 별칭 사전 (Alias)
# 터미널 폰트 너비 해석 오차(밀림 현상)를 방지하기 위해 이모지를 완전히 배제하고 콤팩트한 한글 텍스트만 사용
declare -A ALIAS_MAP
ALIAS_MAP["tmux-theme-picker"]="[테마] 테마 피커 실행"
ALIAS_MAP["tmux-session-launcher --open-sidebar"]="[세션] 세션 런처 사이드바 토글"
ALIAS_MAP["next-window"]="[윈도우] 다음 윈도우로 이동"
ALIAS_MAP["previous-window"]="[윈도우] 이전 윈도우로 이동"
ALIAS_MAP["tmux-session-launcher --split-horizontal"]="[분할] 작업 영역 가로 분할"
ALIAS_MAP["tmux-session-launcher --split-vertical"]="[분할] 작업 영역 세로 분할"
ALIAS_MAP["copy-mode"]="[복사] 텍스트 복사 모드 진입"

# 2. tmux 내장 Notes (-N 옵션 정보) 추출 및 적재
declare -A KEY_NOTES
while IFS= read -r line; do
    if [ -n "$line" ]; then
        key=$(echo "$line" | awk '{print $1}')
        key_parts_count=$(echo "$line" | awk '{print $2}' | grep -E "^(C-|M-|S-|[a-zA-Z0-9\?\!\"\'\#\$\&\(\)\*\+\,\-\.\/\:\;\<\=\>\@\[\\\]\^\_\`\{\|\}\~])" | wc -l)
        if [ "$key_parts_count" -gt 0 ]; then
            key=$(echo "$line" | awk '{print $1 " " $2}')
            desc=$(echo "$line" | cut -d' ' -f3- | sed 's/^[[:space:]]*//')
        else
            desc=$(echo "$line" | cut -d' ' -f2- | sed 's/^[[:space:]]*//')
        fi
        
        if [ -n "$key" ] && [ -n "$desc" ]; then
            # 사용자가 직접 등록한 설명의 이모지들을 괘선 보호를 위해 필터링하여 안전하게 한글/영문만 남김
            clean_desc=$(echo "$desc" | sed -E 's/[🎨🗂️➡️⬅️✂️📝⌨️]//g' | sed 's/^[[:space:]]*//')
            KEY_NOTES["$key"]="$clean_desc"
        fi
    fi
done < <(tmux list-keys -N 2>/dev/null)

# 3. 모든 단축키 목록 추출 및 정규화
get_hotkeys() {
    idx=1
    > "$MAP_FILE"

    while read -r line; do
        if [[ "$line" =~ -T[[:space:]]+([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]+(.+) ]]; then
            table="${BASH_REMATCH[1]}"
            key="${BASH_REMATCH[2]}"
            raw_cmd="${BASH_REMATCH[3]}"

            clean_cmd=$(echo "$raw_cmd" | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g')

            lookup_key=""
            if [ "$table" = "prefix" ]; then
                lookup_key="C-a $key"
            else
                lookup_key="$key"
            fi

            display_desc=""
            is_custom_desc=false
            
            if [ -n "${KEY_NOTES[$lookup_key]}" ]; then
                display_desc="${KEY_NOTES[$lookup_key]}"
                is_custom_desc=true
            elif [ -n "${KEY_NOTES[$key]}" ]; then
                display_desc="${KEY_NOTES[$key]}"
                is_custom_desc=true
            else
                for pattern in "${!ALIAS_MAP[@]}"; do
                    if [[ "$clean_cmd" =~ $pattern ]]; then
                        display_desc="${ALIAS_MAP[$pattern]}"
                        is_custom_desc=true
                        break
                    fi
                done
                if [ "$is_custom_desc" = false ]; then
                    display_desc="$clean_cmd"
                fi
            fi

            weight=3
            if [ "$is_custom_desc" = true ]; then
                weight=0
            elif [ "$table" = "prefix" ]; then
                weight=1
            else
                weight=2
            fi

            key_label=""
            if [ "$table" = "prefix" ]; then
                key_label="[Ctrl+a $key]"
            else
                key_label="[$key]"
            fi

            formatted_key=$(printf "%-18s" "$key_label")
            truncated_desc="${display_desc:0:30}"

            printf "%d\t%s\n" "$idx" "$clean_cmd" >> "$MAP_FILE"
            printf "%d\t%d\t%s\t%s\t%s\n" "$weight" "$idx" "$formatted_key" "$truncated_desc" "$clean_cmd"
            
            idx=$((idx + 1))
        fi
    done < <(tmux list-keys | grep -E "(-T prefix|-T root)" | grep -vE "(Mouse|MouseDown|MouseDrag|DoubleClick|Wheel)") | sort -t$'\t' -k1,1n -k3,3 | sort -u -t$'\t' -k3,3
}

# 3-1. run-shell/eval-shell 껍데기를 벗겨내고 알맹이 쉘 명령어만 추출해내는 파서 엔진
unwrap_command() {
    local raw="$1"
    # run-shell -b "..." 또는 run-shell "..." 또는 eval-shell "..." 따옴표 쌍 구조 파싱
    if [[ "$raw" =~ ^(run-shell|eval-shell)[[:space:]]*(-b[[:space:]]*)?[\"\'](.+)[\"\']$ ]]; then
        printf '%s\n' "${BASH_REMATCH[3]}"
    elif [[ "$raw" =~ ^(run-shell|eval-shell)[[:space:]]*(-b[[:space:]]*)?([^\"\'[:space:]].*)$ ]]; then
        # 따옴표가 생략된 단일 토큰 명령어 대응
        printf '%s\n' "${BASH_REMATCH[3]}"
    else
        printf '%s\n' "$raw"
    fi
}

# 3-2. 명령어 실행 헬퍼: tmux 내장 명령어 vs 쉘 명령어를 분기하여 올바르게 실행
execute_cmd() {
    local cmd="$1"
    local first_word
    first_word=$(echo "$cmd" | awk '{print $1}')

    if [[ "$first_word" == /* ]] || [[ "$first_word" == "eval" ]] || [[ "$first_word" == "tmux" ]] || command -v "$first_word" >/dev/null 2>&1; then
        # 쉘 명령어 (절대경로, eval, tmux, PATH에 있는 실행파일) → run-shell로 동기 실행
        TMUX="$TMUX" tmux run-shell -t "$TARGET_PANE" "$cmd" 2> "$ERR_LOG"
        echo $? > "$EXIT_LOG"
        echo "SUCCESS" > "$STATUS_FILE"
    else
        # tmux 내장 명령어 (display-popup, next-window 등)
        # run-shell -b는 tmux 서버가 관리하므로 팝업 PTY 파괴(SIGHUP)와 무관하게 실행 보장
        TMUX="$TMUX" tmux run-shell -b "sleep 0.3 && tmux $cmd"
        echo 0 > "$EXIT_LOG"
        echo "SUCCESS" > "$STATUS_FILE"
    fi
}

# 4. fzf 기반 대화형 실행기 구동
run_palette() {
    local list
    list=$(get_hotkeys)

    # 4-1. 자가 진단(Self-Test) 전용 분기 처리
    if [ "$1" = "--test" ]; then
        echo "[Self-Test] Starting tmux-command-palette validation..."
        
        if [ -z "$list" ]; then
            echo "[Self-Test] FAIL: Hotkey list is empty."
            exit 1
        fi
        echo "[Self-Test] PASS: Hotkey list populated."
        
        if [ ! -f "$MAP_FILE" ] || [ ! -s "$MAP_FILE" ]; then
            echo "[Self-Test] FAIL: Map file not created or empty."
            exit 1
        fi
        echo "[Self-Test] PASS: Map file successfully created."
        
        # 역추적 복원 테스트
        test_target_line=$(echo "$list" | grep -E "(tmux-theme-picker|theme)" | head -n 1)
        if [ -n "$test_target_line" ]; then
            test_idx=$(echo "$test_target_line" | cut -f2)
            echo "[Self-Test] Found theme picker index: $test_idx"
            
            recovered_cmd=$(grep -E "^$test_idx[[:space:]]" "$MAP_FILE" | cut -f2-)
            echo "[Self-Test] Recovered command: $recovered_cmd"
            
            if [[ "$recovered_cmd" == *"tmux-theme-picker"* && ! "$recovered_cmd" =~ "-T prefix" ]]; then
                echo "[Self-Test] PASS: Command recovered correctly without prefix clutter!"
            else
                echo "[Self-Test] FAIL: Command recovery mismatch or prefix clutter detected."
                exit 1
            fi
        else
            local sample_line=$(echo "$list" | head -n 1)
            local sample_idx=$(echo "$sample_line" | cut -f2)
            local sample_cmd=$(grep -E "^$sample_idx[[:space:]]" "$MAP_FILE" | cut -f2-)
            if [ -n "$sample_cmd" ]; then
                echo "[Self-Test] PASS: Sample index $sample_idx command recovered: $sample_cmd"
            else
                echo "[Self-Test] FAIL: Sample index recovery failed."
                exit 1
            fi
        fi
        
        echo "[Self-Test] SUCCESS: All self-tests passed!"
        exit 0
    fi

    # 4-2. 격리도가 높은 E2E 가상 임의 명령 실행 검증 모드 (--test-exec-cmd <cmd>)
    # 단축키 데이터 구조나 윈도우 개수에 1%도 얽매이지 않는 완전 격리된 기능 무결성 보증
    if [ "$1" = "--test-exec-cmd" ] && [ -n "$2" ]; then
        local cmd="$2"
        cmd=$(unwrap_command "$cmd")
        echo "[Test-Exec-Cmd] Command to run: $cmd"
        rm -f "$ERR_LOG" "$STATUS_FILE" "$EXIT_LOG"
        echo "STARTED" > "$STATUS_FILE"
        execute_cmd "$cmd"
        exit 0
    fi

    # 4-3. 동적 가상 실행 시뮬레이션 모드 (--test-exec <index>)
    if [ "$1" = "--test-exec" ] && [ -n "$2" ]; then
        local test_idx="$2"
        local cmd
        cmd=$(grep -E "^$test_idx[[:space:]]" "$MAP_FILE" | cut -f2-)
        cmd=$(unwrap_command "$cmd")
        
        if [ -n "$cmd" ]; then
            echo "[Test-Exec] Target index: $test_idx, Command: $cmd"
            rm -f "$ERR_LOG" "$STATUS_FILE" "$EXIT_LOG"
            echo "STARTED" > "$STATUS_FILE"
            execute_cmd "$cmd"
            exit 0
        else
            echo "[Test-Exec] FAIL: Index $test_idx not found in mapping."
            exit 1
        fi
    fi
    
    if ! command -v fzf >/dev/null 2>&1; then
        tmux display-message "Error: fzf is required for command palette."
        exit 1
    fi

    # fzf 실행 옵션
    local selected
    selected=$(echo "$list" | fzf -d $'\t' --with-nth=3,4 \
        --no-border \
        --margin=0,2 \
        --height 100% \
        --layout=reverse \
        --prompt="단축키 검색 및 실행> " \
        --header="Enter: 실행, Esc/q: 취소 (방향키로 명령 확인)" \
        --preview="echo {} | cut -f5-" \
        --preview-window="down:2:nowrap:border-top" \
        --tiebreak=index \
        --no-hscroll)

    if [ -n "$selected" ]; then
        local idx
        # fzf 출력 형식은 [weight, idx, key, desc, cmd] 순이므로 두 번째 필드인 idx를 획득해야 함
        idx=$(echo "$selected" | awk '{print $2}')

        local cmd
        cmd=$(grep -E "^$idx[[:space:]]" "$MAP_FILE" | cut -f2-)
        cmd=$(unwrap_command "$cmd")

        if [ -n "$cmd" ]; then
            rm -f "$ERR_LOG" "$STATUS_FILE" "$EXIT_LOG"
            echo "STARTED" > "$STATUS_FILE"
            execute_cmd "$cmd"
            exit 0
        fi
    fi
}

run_palette "$@"

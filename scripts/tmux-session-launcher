#!/usr/bin/env bash
set -euo pipefail

current_session="$(tmux display-message -p '#S')"
current_path="$(tmux display-message -p '#{pane_current_path}')"
mode="commands"
selected_session="$current_session"

die()
{
    printf 'tmux-session-launcher: %s\n' "$*" >&2
    sleep 1
    exit 1
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

session_exists()
{
    tmux has-session -t "=$1" >/dev/null 2>&1
}

switch_session()
{
    session_name="$1"
    [ -n "$session_name" ] || return 0
    tmux switch-client -t "=$session_name"
}

prompt_continue()
{
    printf '\nPress Enter to return to launcher...'
    IFS= read -r _ || true
}

new_session()
{
    printf '\n'
    printf 'New session name: '
    IFS= read -r session_name || return 0
    [ -n "$session_name" ] || return 0

    if session_exists "$session_name"; then
        selected_session="$session_name"
        return 0
    fi

    tmux new-session -d -s "$session_name" -c "$current_path"
    selected_session="$session_name"
}

delete_session()
{
    if ! session_exists "$selected_session"; then
        printf '\nSession not found: %s\n' "$selected_session"
        prompt_continue
        return 0
    fi

    if [ "$selected_session" = "$current_session" ]; then
        printf '\nCannot delete the current session from the launcher: %s\n' "$selected_session"
        prompt_continue
        return 0
    fi

    printf '\nDelete session "%s"? [y/N]: ' "$selected_session"
    IFS= read -r answer || return 0

    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            tmux kill-session -t "=$selected_session"
            selected_session="$current_session"
            ;;
    esac
}

rename_session()
{
    old_name="$selected_session"

    if ! session_exists "$old_name"; then
        printf '\nSession not found: %s\n' "$old_name"
        prompt_continue
        return 0
    fi

    printf '\nRename session "%s" to: ' "$old_name"
    IFS= read -r new_name || return 0
    [ -n "$new_name" ] || return 0

    if session_exists "$new_name"; then
        printf '\nSession already exists: %s\n' "$new_name"
        prompt_continue
        return 0
    fi

    tmux rename-session -t "=$old_name" "$new_name"
    selected_session="$new_name"
    [ "$current_session" = "$old_name" ] && current_session="$new_name"
}

list_sessions()
{
    tmux list-sessions -F '#{session_name}	#{session_windows}	#{?session_attached,attached,detached}	#{t:session_created}' |
        awk -F '\t' -v current="$current_session" '
            {
                marker = ($1 == current) ? "*" : " "
                printf "%s\t%s\t%s windows\t%s\t%s\n", $1, marker, $2, $3, $4
            }
        '
}

list_commands()
{
    printf 'c:\tnew session\tselected: %s\n' "$selected_session"
    printf 'd:\tdelete session\tselected: %s\n' "$selected_session"
    printf 'r:\trename session\tselected: %s\n' "$selected_session"
}

select_command()
{
    list_commands |
        fzf \
            --delimiter='\t' \
            --with-nth=1,2,3 \
            --prompt='Commands > ' \
            --header='Enter: run command | Tab: sessions | Esc: close' \
            --expect=tab,enter
}

select_session()
{
    list_sessions |
        fzf \
            --delimiter='\t' \
            --with-nth=2,1,3,4,5 \
            --prompt='Sessions > ' \
            --header='Enter: switch session | Tab: commands | Esc: close' \
            --expect=tab,enter
}

parse_selection()
{
    first_line="$(printf '%s\n' "$1" | sed -n '1p')"
    second_line="$(printf '%s\n' "$1" | sed -n '2p')"

    case "$first_line" in
        tab|enter)
            selection_key="$first_line"
            selection_row="$second_line"
            ;;
        *)
            selection_key="enter"
            selection_row="$first_line"
            ;;
    esac
}

run_command()
{
    command_name="$1"

    case "$command_name" in
        c) new_session ;;
        d) delete_session ;;
        r) rename_session ;;
    esac
}

run_commands_mode()
{
    selection="$(select_command || true)"
    [ -n "$selection" ] || exit 0

    parse_selection "$selection"

    if [ "$selection_key" = "tab" ]; then
        mode="sessions"
        return 0
    fi

    command_name="$(printf '%s\n' "$selection_row" | cut -f 1)"
    command_name="${command_name%:}"
    run_command "$command_name"
}

run_sessions_mode()
{
    selection="$(select_session || true)"
    [ -n "$selection" ] || exit 0

    parse_selection "$selection"
    session_name="$(printf '%s\n' "$selection_row" | cut -f 1)"

    if [ -n "$session_name" ]; then
        selected_session="$session_name"
    fi

    case "$selection_key" in
        tab)
            mode="commands"
            ;;
        *)
            switch_session "$selected_session"
            exit 0
            ;;
    esac
}

main()
{
    require_command tmux
    require_command fzf

    while true; do
        case "$mode" in
            commands) run_commands_mode ;;
            sessions) run_sessions_mode ;;
        esac
    done
}

main "$@"

sidebar_runtime_set()
{
    local option="$1" value="$2"
    local opt_clean="${option//[^a-zA-Z0-9_]/_}"
    local ctx="${SIDEBAR_WINDOW_ID:-global}"
    local ctx_clean="${ctx//[^a-zA-Z0-9_]/_}"
    local cache_var="_cache_opt_${ctx_clean}_${opt_clean}"
    printf -v "$cache_var" '%s' "$value"
    sidebar_tmux_cmd set-option -gq "$option" "$value" 2>/dev/null || true
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        sidebar_tmux_cmd set-option -wq -t "$SIDEBAR_WINDOW_ID" "$option" "$value" 2>/dev/null || true
    fi
}

sidebar_runtime_get()
{
    local option="$1"
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        sidebar_tmux_cmd show-option -wqv -t "$SIDEBAR_WINDOW_ID" "$option" 2>/dev/null || true
    else
        sidebar_tmux_cmd show-option -gqv "$option" 2>/dev/null || true
    fi
}


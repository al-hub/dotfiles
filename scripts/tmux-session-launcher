#!/usr/bin/env bash
set -euo pipefail

SIDEBAR_TITLE="dotfiles-session-sidebar"
SIDEBAR_WIDTH="${TMUX_SESSION_SIDEBAR_WIDTH:-35}"
SIDEBAR_BUSY_SECONDS="${TMUX_SESSION_SIDEBAR_BUSY_SECONDS:-10}"
BUSY_START_PREFIX="@dotfiles-session-busy-start-"
SCRIPT_PATH="${BASH_SOURCE[0]}"
current_session="$(tmux display-message -p '#S')"
current_path="$(tmux display-message -p '#{pane_current_path}')"
selected_session="$current_session"
prompt_mode="Commands"

die()
{
    printf 'tmux-session-launcher: %s\n' "$*" >&2
    sleep 1
    exit 1
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

session_exists()
{
    tmux has-session -t "=$1" >/dev/null 2>&1
}

find_sidebar_pane()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux list-panes -t "$target" -F '#{pane_id}	#{pane_title}' 2>/dev/null
    else
        tmux list-panes -F '#{pane_id}	#{pane_title}'
    fi |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }'
}

mark_sidebar_pane()
{
    tmux select-pane -T "$SIDEBAR_TITLE" 2>/dev/null || true
}

current_sidebar_width()
{
    sidebar_pane="$(find_sidebar_pane)"

    if [ -n "$sidebar_pane" ]; then
        tmux display-message -p -t "$sidebar_pane" '#{pane_width}'
    else
        tmux show-option -gqv '@dotfiles-session-sidebar-width'
    fi
}

sidebar_width()
{
    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) printf '%s\n' "$SIDEBAR_WIDTH" ;;
        *) printf '%s\n' "$width" ;;
    esac
}

remember_sidebar_width()
{
    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) return 0 ;;
        *) tmux set-option -gq '@dotfiles-session-sidebar-width' "$width" ;;
    esac
}

open_sidebar()
{
    target="${1:-}"
    refresh="${2:-false}"
    width="${3:-$(sidebar_width)}"
    existing_pane="$(find_sidebar_pane "$target")"

    if [ -n "$existing_pane" ]; then
        tmux resize-pane -t "$existing_pane" -x "$width" 2>/dev/null || true
        if [ "$refresh" = "true" ]; then
            tmux respawn-pane -k -t "$existing_pane" "$SCRIPT_PATH --sidebar"
            tmux select-pane -t "$existing_pane" -T "$SIDEBAR_TITLE"
        fi
        tmux select-pane -t "$existing_pane"
        return 0
    fi

    if [ -n "$target" ]; then
        pane_id="$(
            tmux split-window -t "$target" -h -f -b -l "$width" \
                -c "$current_path" -P -F '#{pane_id}' "$SCRIPT_PATH --sidebar"
        )"
    else
        pane_id="$(
            tmux split-window -h -f -b -l "$width" \
                -c "#{pane_current_path}" -P -F '#{pane_id}' "$SCRIPT_PATH --sidebar"
        )"
    fi

    tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE"
    tmux select-pane -t "$pane_id"
}

ensure_session_sidebar()
{
    session_name="$1"
    refresh="${2:-false}"
    width="${3:-$(sidebar_width)}"
    open_sidebar "=$session_name:" "$refresh" "$width"
}

toggle_current_sidebar()
{
    existing_pane="$(find_sidebar_pane)"

    if [ -n "$existing_pane" ]; then
        remember_sidebar_width
        tmux kill-pane -t "$existing_pane"
        return 0
    fi

    open_sidebar
}

current_pane_is_sidebar()
{
    [ "$(tmux display-message -p '#{pane_title}')" = "$SIDEBAR_TITLE" ]
}

select_work_pane_from_sidebar()
{
    current_pane="$(tmux display-message -p '#{pane_id}')"

    tmux select-pane -R 2>/dev/null || true
    if [ "$(tmux display-message -p '#{pane_id}')" = "$current_pane" ]; then
        work_pane="$(
            tmux list-panes -F '#{pane_id}	#{pane_title}' |
                awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 != title { print $1; exit }'
        )"
        [ -n "$work_pane" ] && tmux select-pane -t "$work_pane"
    fi
}

split_work_pane()
{
    direction="$1"

    if current_pane_is_sidebar; then
        select_work_pane_from_sidebar
        if current_pane_is_sidebar; then
            tmux display-message 'No work pane found for split.'
            return 0
        fi
    fi

    case "$direction" in
        horizontal) tmux split-window -h -c "#{pane_current_path}" ;;
        vertical) tmux split-window -v -c "#{pane_current_path}" ;;
    esac
}

switch_session()
{
    session_name="$1"
    [ -n "$session_name" ] || return 0
    remember_sidebar_width
    width="$(sidebar_width)"
    ensure_session_sidebar "$session_name" "true" "$width"
    tmux switch-client -t "=$session_name"
    ensure_session_sidebar "$session_name" "false" "$width"
    current_session="$session_name"
    selected_session="$session_name"
}

prompt_continue()
{
    printf '\nPress Enter to return to launcher...'
    IFS= read -r _ || true
}

new_session()
{
    printf '\n'
    printf 'New session name: '
    IFS= read -r session_name || return 0
    [ -n "$session_name" ] || return 0

    if session_exists "$session_name"; then
        selected_session="$session_name"
        return 0
    fi

    tmux new-session -d -s "$session_name" -c "$current_path"
    ensure_session_sidebar "$session_name"
    selected_session="$session_name"
}

delete_session()
{
    if ! session_exists "$selected_session"; then
        printf '\nSession not found: %s\n' "$selected_session"
        prompt_continue
        return 0
    fi

    if [ "$selected_session" = "$current_session" ]; then
        printf '\nCannot delete the current session from the launcher: %s\n' "$selected_session"
        prompt_continue
        return 0
    fi

    printf '\nDelete session "%s"? [y/N]: ' "$selected_session"
    IFS= read -r answer || return 0

    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            tmux kill-session -t "=$selected_session"
            selected_session="$current_session"
            ;;
    esac
}

rename_session()
{
    old_name="$selected_session"

    if ! session_exists "$old_name"; then
        printf '\nSession not found: %s\n' "$old_name"
        prompt_continue
        return 0
    fi

    printf '\nRename session "%s" to: ' "$old_name"
    IFS= read -r new_name || return 0
    [ -n "$new_name" ] || return 0

    if session_exists "$new_name"; then
        printf '\nSession already exists: %s\n' "$new_name"
        prompt_continue
        return 0
    fi

    tmux rename-session -t "=$old_name" "$new_name"
    selected_session="$new_name"
    if [ "$current_session" = "$old_name" ]; then
        current_session="$new_name"
    fi
}

is_shell_command()
{
    case "$1" in
        sh|bash|dash|zsh|fish|ksh|mksh|tmux-session-launcher) return 0 ;;
        *) return 1 ;;
    esac
}

session_is_busy()
{
    session_name="$1"
    now="$(date +%s)"
    activity="$(tmux display-message -p -t "=$session_name:" '#{session_activity}' 2>/dev/null || printf '0')"

    case "$activity" in
        ''|*[!0-9]*) activity=0 ;;
    esac

    if [ $((now - activity)) -gt "$SIDEBAR_BUSY_SECONDS" ]; then
        return 1
    fi

    while IFS="$(printf '\t')" read -r pane_session pane_title command_name; do
        [ "$pane_session" = "$session_name" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue
        if ! is_shell_command "$command_name"; then
            return 0
        fi
    done <<EOF
$(tmux list-panes -a -F '#{session_name}	#{pane_title}	#{pane_current_command}' 2>/dev/null)
EOF

    return 1
}

session_option_key()
{
    printf '%s%s\n' "$BUSY_START_PREFIX" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_')"
}

format_duration()
{
    elapsed="$1"
    days=$((elapsed / 86400))
    remain=$((elapsed % 86400))
    hours=$((remain / 3600))
    remain=$((remain % 3600))
    minutes=$((remain / 60))
    seconds=$((remain % 60))

    printf '%d:%02d:%02d:%02d\n' "$days" "$hours" "$minutes" "$seconds"
}

session_elapsed()
{
    session_name="$1"
    option_key="$(session_option_key "$session_name")"

    if session_is_busy "$session_name"; then
        now="$(date +%s)"
        started_at="$(tmux show-option -gqv "$option_key" 2>/dev/null || true)"

        case "$started_at" in
            ''|*[!0-9]*)
                started_at="$now"
                tmux set-option -gq "$option_key" "$started_at"
                ;;
        esac

        format_duration "$((now - started_at))"
    else
        tmux set-option -gu "$option_key" >/dev/null 2>&1 || true
        printf '%s\n' ''
    fi
}

format_session_name()
{
    session_name="$1"
    display_name="$(printf '%-18.18s' "$session_name")"

    if session_is_busy "$session_name"; then
        printf '\033[31m%s\033[0m\n' "$display_name"
    else
        printf '%s\n' "$display_name"
    fi
}

list_sessions()
{
    tmux list-sessions -F '#{session_name}' |
        awk -F '\t' -v current="$current_session" '
            {
                marker = ($1 == current) ? "*" : " "
                print $1 "\t" marker
            }
        ' |
        while IFS="$(printf '\t')" read -r session_name marker; do
            printf '%s\t%s %s %s\n' "$session_name" "$marker" "$(format_session_name "$session_name")" "$(session_elapsed "$session_name")"
        done
}

selected_position()
{
    tmux list-sessions -F '#{session_name}' |
        awk -v selected="$selected_session" '
            $0 == selected { print NR; found = 1; exit }
            END { if (!found) print 1 }
        '
}

select_session()
{
    expect_keys="tab,enter"
    header='Enter: switch | Tab: toggle prompt | Esc(exit): close'
    position="$(selected_position)"

    if [ "$prompt_mode" = "Commands" ]; then
        expect_keys="tab,c,d,r,enter"
        header='Enter: switch | Tab: toggle prompt | c: new | d: delete | r: rename | Esc(exit): close'
    fi

    list_sessions |
        fzf \
            --ansi \
            --delimiter='\t' \
            --with-nth=2 \
            --prompt="$prompt_mode> " \
            --header="$header" \
            --expect="$expect_keys" \
            --print-query \
            --sync \
            --bind="load:pos($position)" \
            --no-clear
}

parse_selection()
{
    first_line="$(printf '%s\n' "$1" | sed -n '1p')"
    second_line="$(printf '%s\n' "$1" | sed -n '2p')"
    third_line="$(printf '%s\n' "$1" | sed -n '3p')"

    case "$second_line" in
        tab|c|d|r|enter)
            selection_key="$second_line"
            selection_query="$first_line"
            selection_row="$third_line"
            ;;
        *)
            selection_key="enter"
            selection_query="$first_line"
            selection_row="$second_line"
            ;;
    esac
}

run_query_command()
{
    case "$1" in
        c|create|new)
            new_session
            return 0
            ;;
        d|delete|remove)
            delete_session
            return 0
            ;;
        r|rename)
            rename_session
            return 0
            ;;
        q|quit|exit)
            exit 0
            ;;
    esac

    return 1
}

run_launcher()
{
    selection="$(select_session || true)"
    [ -n "$selection" ] || exit 0

    parse_selection "$selection"
    session_name="$(printf '%s\n' "$selection_row" | cut -f 1)"

    if [ "$prompt_mode" = "Commands" ] && [ "$selection_key" = "enter" ]; then
        if [ -n "$selection_query" ]; then
            if run_query_command "$selection_query"; then
                return 0
            fi

            printf '\nUnknown command: %s\n' "$selection_query"
            prompt_continue
            return 0
        fi
    fi

    if [ -n "$session_name" ]; then
        selected_session="$session_name"
    fi

    case "$selection_key" in
        tab)
            case "$prompt_mode" in
                Commands) prompt_mode="Sessions" ;;
                *) prompt_mode="Commands" ;;
            esac
            ;;
        c)
            new_session
            ;;
        d)
            delete_session
            ;;
        r)
            rename_session
            ;;
        enter)
            if [ -z "$session_name" ] && [ -n "$selection_query" ]; then
                if [ "$prompt_mode" != "Commands" ]; then
                    printf '\nNo matching session: %s\n' "$selection_query"
                    prompt_continue
                    return 0
                fi
            fi
            switch_session "$selected_session"
            ;;
    esac
}

main()
{
    require_command tmux

    case "${1:-}" in
        --open-sidebar)
            toggle_current_sidebar
            return 0
            ;;
        --ensure-current-sidebar)
            open_sidebar
            return 0
            ;;
        --list-sessions)
            list_sessions
            return 0
            ;;
        --split-horizontal)
            split_work_pane horizontal
            return 0
            ;;
        --split-vertical)
            split_work_pane vertical
            return 0
            ;;
        --sidebar|"")
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac

    require_command fzf
    mark_sidebar_pane

    while true; do
        run_launcher
    done
}

main "$@"

{
    sidebar_domain_epoch_now
}

die()
{
    printf 'tmux-session-launcher: %s\n' "$*" >&2
    sleep 1
    exit 1
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

session_exists()
{
    sidebar_port_session_exists "$1"
}

sidebar_operation_state()
{
    sidebar_tmux_cmd show-option -gqv "$SIDEBAR_OPERATION_OPTION" 2>/dev/null || true
}

sidebar_operation_busy()
{
    case "$(sidebar_operation_state)" in
        saving:*|deleting:*|restoring:*|moving:*) return 0 ;;
        *) return 1 ;;
    esac
}

sidebar_operation_set()
{
    local state="$1" operation_id="${2:-none}"
    sidebar_tmux_cmd set-option -gq "$SIDEBAR_OPERATION_OPTION" "$state:$operation_id" 2>/dev/null || true
    trace_event "operation.state state=$state operation_id=$operation_id"
}

new_sidebar_operation_id()
{
    printf -v sidebar_operation_id_result 'op-%s-%s-%s' \
        "$(date +%s%N)" "${BASHPID:-$$}" "${RANDOM:-0}"
}

sidebar_operation_is_owner()
{
    local expected_id="$1" current_state
    [ -n "$expected_id" ] || return 1
    current_state="$(sidebar_operation_state)"
    case "$current_state" in
        *:"$expected_id") return 0 ;;
        *) return 1 ;;
    esac
}

sidebar_operation_finish()
{
    local state="$1" operation_id="$2"
    if sidebar_operation_is_owner "$operation_id"; then
        sidebar_operation_set "$state" "$operation_id"
        return 0
    fi
    trace_event "operation.owner-mismatch expected=$operation_id actual=$(sidebar_operation_state) final_state=$state"
    return 1
}

# A session switch is a transaction across tmux's pane, client, and layout
# boundaries.  Keep its context in tmux options so the controller, hooks, and
# attached-PTY tests can observe the same operation without parsing prose.
transition_context_begin()
{
    local operation_id="$1" source_session="$2" target_session="$3" target_window="${4:-}"
    if ! transition_lock_acquire; then
        trace_event "transition.begin.skip reason=lock-busy source=$source_session target=$target_session"
        return 1
    fi
    transition_generation=$((transition_generation + 1))
    current_transition_operation_id="$operation_id"
    current_transition_source="$source_session"
    current_transition_target="$target_session"
    current_transition_target_window="$target_window"
    tmux set-option -gq "$SIDEBAR_TRANSITION_OPTION" \
        "operation_id=$operation_id;source=$source_session;target=$target_session;result=running" 2>/dev/null || true
    local render_pending_window="${target_window:-}"
    [ -n "$render_pending_window" ] || render_pending_window="$(sidebar_tmux_session_window "$target_session" || true)"
    [ -n "$render_pending_window" ] &&
        tmux set-option -wq -t "$render_pending_window" "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" \
            "operation_id=$operation_id;target=$target_session" 2>/dev/null || true
    tmux set-option -gq "$SIDEBAR_TRANSITION_GENERATION_OPTION" "$transition_generation" 2>/dev/null || true
    tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 0 2>/dev/null || true
    tmux set-option -gq "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" "" 2>/dev/null || true
    # A refresh flag queued before the switch belongs to the detached target's
    # old frame. The selection-sync marker is authoritative for this
    # operation; consuming the stale flag prevents an unrelated full redraw
    # from winning the transition boundary.
    tmux set-option -gq "@sidebar_force_refresh_$target_session" 0 2>/dev/null || true
    trace_event "transition.refresh-flag.clear target=$target_session operation_id=$operation_id"
    trace_event "transition.begin operation_id=$operation_id generation=$transition_generation source=$source_session target=$target_session"
}

transition_lock_path()
{
    local socket_name lock_root
    [ -n "$SIDEBAR_TRANSITION_LOCK_DIR" ] && {
        printf '%s\n' "$SIDEBAR_TRANSITION_LOCK_DIR"
        return 0
    }
    socket_name="$(tmux display-message -p '#{socket_path}' 2>/dev/null || printf '%s' "${TMUX%%,*}")"
    socket_name="$(printf '%s' "$socket_name" | tr -c 'A-Za-z0-9_.-' '_')"
    lock_root="${TMUX_SESSION_LAUNCHER_LOCK_ROOT:-/tmp}"
    printf '%s/dotfiles-sidebar-transition-%s.lock\n' "$lock_root" "$socket_name"
}

transition_lock_acquire()
{
    local lock_dir owner_pid
    lock_dir="$(transition_lock_path)"
    if mkdir "$lock_dir" 2>/dev/null; then
        printf '%s\n' "${BASHPID:-$$}" > "$lock_dir/pid" 2>/dev/null || true
        SIDEBAR_TRANSITION_LOCK_DIR="$lock_dir"
        trace_event "transition.lock result=acquired path=$lock_dir"
        return 0
    fi
    owner_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        rm -f "$lock_dir/pid" 2>/dev/null || true
        rmdir "$lock_dir" 2>/dev/null || true
        if mkdir "$lock_dir" 2>/dev/null; then
            printf '%s\n' "${BASHPID:-$$}" > "$lock_dir/pid" 2>/dev/null || true
            SIDEBAR_TRANSITION_LOCK_DIR="$lock_dir"
            trace_event "transition.lock result=reclaimed path=$lock_dir owner=$owner_pid"
            return 0
        fi
    fi
    trace_event "transition.lock result=busy path=$lock_dir owner=${owner_pid:-unknown}"
    return 1
}

transition_lock_release()
{
    local lock_dir="${SIDEBAR_TRANSITION_LOCK_DIR:-}"
    [ -n "$lock_dir" ] || return 0
    rm -f "$lock_dir/pid" 2>/dev/null || true
    rmdir "$lock_dir" 2>/dev/null || true
    trace_event "transition.lock result=released path=$lock_dir"
    SIDEBAR_TRANSITION_LOCK_DIR=""
}

transition_is_active()
{
    local state
    state="$(tmux show-option -gqv "$SIDEBAR_TRANSITION_OPTION" 2>/dev/null || true)"
    case "$state" in
        *"result=running"*|*"result=committed"*) return 0 ;;
        *) return 1 ;;
    esac
}

transition_commit_pending()
{
    local state
    state="$(tmux show-option -gqv "$SIDEBAR_TRANSITION_OPTION" 2>/dev/null || true)"
    case "$state" in
        *"result=committed"*) return 0 ;;
        *) return 1 ;;
    esac
}

transition_context_commit()
{
    local operation_id="${1:-$current_transition_operation_id}"
    [ -n "$operation_id" ] || return 0
    tmux set-option -gq "$SIDEBAR_TRANSITION_OPTION" \
        "operation_id=$operation_id;source=${current_transition_source:-none};target=${current_transition_target:-none};result=committed;reason=awaiting-render" 2>/dev/null || true
    transition_phase_set COMMIT "$operation_id"
    trace_event "transition.commit operation_id=$operation_id generation=$transition_generation result=awaiting-render"
}

transition_defer_hook_sync()
{
    local hook="$1"
    tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 1 2>/dev/null || true
    trace_event "transition.hook.defer hook=$hook operation_id=${current_transition_operation_id:-external}"
}

transition_flush_deferred_metadata()
{
    local deferred sidebar_pane window_id
    deferred="$(tmux show-option -gqv "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 2>/dev/null || true)"
    [ "$deferred" = 1 ] || return 0
    tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 0 2>/dev/null || true
    if [ "$(tmux show-option -gqv "$SIDEBAR_MODEL_OPTION" 2>/dev/null || true)" = window-local ]; then
        # Window-local provisioning owns geometry before switch-client. A
        # deferred hook must not synchronously snapshot the target layout in
        # the hot path; that was the measured ~0.9s tail after client switch.
        trace_event "transition.hook.flush operation_id=${current_transition_operation_id:-external} window=local result=skipped-window-local"
        return 0
    fi
    if [ "$(tmux show-option -gqv "$SIDEBAR_FAST_TRANSITION_OPTION" 2>/dev/null || true)" = 1 ]; then
        tmux set-option -gq "$SIDEBAR_FAST_TRANSITION_OPTION" 0 2>/dev/null || true
        trace_event "transition.hook.flush operation_id=${current_transition_operation_id:-external} window=deferred result=skipped-fast-path"
        return 0
    fi
    # A committed switch has already moved the client to the target window.
    # Persist metadata for that window-local sidebar; looking up the old
    # global pane here would reintroduce the pre-switch layout model.
    window_id="$(active_client_window || true)"
    sidebar_pane="$(sidebar_window_pane "$window_id" || true)"
    [ -n "$sidebar_pane" ] || sidebar_pane="$(find_global_sidebar_pane || true)"
    [ -n "$window_id" ] || window_id="$(sidebar_tmux_pane_window "$sidebar_pane" 2>/dev/null || true)"
    if [ -n "$window_id" ] && save_sidebar_layout "$window_id"; then
        trace_event "transition.hook.flush operation_id=${current_transition_operation_id:-external} window=$window_id result=ok"
    else
        trace_event "transition.hook.flush operation_id=${current_transition_operation_id:-external} window=${window_id:-none} result=skipped"
    fi
}

transition_phase_set()
{
    local phase="$1" operation_id="${2:-$current_transition_operation_id}"
    [ -n "$operation_id" ] || return 0
    tmux set-option -gq "$SIDEBAR_TRANSITION_PHASE_OPTION" "$phase" 2>/dev/null || true
    trace_event "transition.phase operation_id=$operation_id generation=$transition_generation phase=$phase"
}

transition_snapshot()
{
    local operation_id="$1" source_session="$2" target_session="$3" sidebar_pane="$4" client_tty="$5"
    local source_layout target_layout pane_state client_state
    trace_event "transition.snapshot.begin operation_id=$operation_id"
    source_layout="$(tmux display-message -p -t "=$source_session:" '#{window_id}:#{window_layout}' 2>/dev/null || true)"
    target_layout="$(tmux display-message -p -t "=$target_session:" '#{window_id}:#{window_layout}' 2>/dev/null || true)"
    pane_state="$(tmux display-message -p -t "$sidebar_pane" '#{session_name}:#{window_id}:#{pane_id}:#{pane_index}:#{pane_left},#{pane_top},#{pane_width},#{pane_height}' 2>/dev/null || true)"
    client_state="$(owner_client_fingerprint "$client_tty")"
    trace_event "transition.snapshot operation_id=$operation_id source_layout=${source_layout:-none} target_layout=${target_layout:-none} sidebar=$pane_state client=$client_state"
    trace_event "transition.snapshot.end operation_id=$operation_id"
}

transition_context_finish()
{
    local result="$1" reason="${2:-none}" operation_id="${3:-$current_transition_operation_id}"
    [ -n "$operation_id" ] || return 0
    if [ "$result" = success ] && [ "$reason" = window-local-ready ]; then
        # Native window-local switches have no layout work to flush. Keep the
        # observable transaction close, but avoid the legacy model lookup and
        # deferred-hook bookkeeping on this latency-sensitive path.
        tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 0 2>/dev/null || true
        tmux set-option -gq "$SIDEBAR_TRANSITION_OPTION" \
            "operation_id=$operation_id;source=${current_transition_source:-none};target=${current_transition_target:-none};result=success;reason=$reason" 2>/dev/null || true
        local finished_window="${current_transition_target_window:-}"
        [ -n "$finished_window" ] || finished_window="$(sidebar_tmux_session_window "${current_transition_target:-}" || true)"
        [ -n "$finished_window" ] &&
            tmux set-option -wq -t "$finished_window" "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" \
                "operation_id=$operation_id;target=${current_transition_target:-none}" 2>/dev/null || true
        transition_phase_set READY "$operation_id"
        trace_event "transition.finish operation_id=$operation_id generation=$transition_generation result=success reason=$reason"
        if [ -n "$METRICS_FILE" ] && [ "${transition_metrics_start_us:-0}" -gt 0 ]; then
            metrics_write "op=switch phase=finish operation_id=$operation_id result=success total_us=$(( $(metrics_now_us) - transition_metrics_start_us ))"
            transition_metrics_start_us=0
        fi
        current_transition_operation_id=""
        current_transition_source=""
        current_transition_target=""
        current_transition_target_window=""
        transition_lock_release
        return 0
    fi
    [ "$result" = success ] || tmux set-option -gq "$SIDEBAR_FAST_TRANSITION_OPTION" 0 2>/dev/null || true
    tmux set-option -gq "$SIDEBAR_TRANSITION_OPTION" \
        "operation_id=$operation_id;source=${current_transition_source:-none};target=${current_transition_target:-none};result=$result;reason=$reason" 2>/dev/null || true
    if [ "$result" != success ]; then
        local failed_window
        failed_window="$(sidebar_tmux_session_window "${current_transition_target:-}" || true)"
        [ -n "$failed_window" ] && tmux set-option -wq -t "$failed_window" "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" "" 2>/dev/null || true
    fi
    if [ "$result" = success ]; then
        if [ "$(tmux show-option -gqv "$SIDEBAR_MODEL_OPTION" 2>/dev/null || true)" = window-local ]; then
            # The switch path never restores layout. Clear deferred hook
            # state directly instead of entering the legacy snapshot helper.
            tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 0 2>/dev/null || true
            trace_event "transition.hook.flush operation_id=${current_transition_operation_id:-external} window=local result=skipped-window-local"
        else
            transition_flush_deferred_metadata
        fi
    else
        tmux set-option -gq "$SIDEBAR_TRANSITION_DEFERRED_OPTION" 0 2>/dev/null || true
    fi
    transition_phase_set "$([ "$result" = success ] && printf READY || printf FAILED)" "$operation_id"
    trace_event "transition.finish operation_id=$operation_id generation=$transition_generation result=$result reason=$reason"
    if [ -n "$METRICS_FILE" ] && [ "${transition_metrics_start_us:-0}" -gt 0 ]; then
        metrics_write "op=switch phase=finish operation_id=$operation_id result=$result total_us=$(( $(metrics_now_us) - transition_metrics_start_us ))"
        transition_metrics_start_us=0
    fi
    current_transition_operation_id=""
    current_transition_source=""
    current_transition_target=""
    transition_lock_release
}

transition_rollback()
{
    local operation_id="$1" source_session="$2" client_tty="$3" sidebar_pane="$4" reason="$5"
    transition_phase_set ROLLBACK "$operation_id"
    trace_event "transition.rollback.begin operation_id=$operation_id reason=$reason source=$source_session"
    # Sidebars are window-local. There is no pane move to undo; leaving the
    # already-provisioned target sidebar in place is safe and avoids a visible
    # source-window gap during rollback.
    trace_event "transition.rollback.sidebar-preserved operation_id=$operation_id source=$source_session pane=${sidebar_pane:-none}"
    if [ -n "$client_tty" ] && [ -n "$source_session" ]; then
        sidebar_tmux_switch_client "$client_tty" "$source_session" >/dev/null 2>&1 || true
    fi
    transition_context_finish failed "$reason" "$operation_id"
    trace_event "transition.rollback.end operation_id=$operation_id reason=$reason"
}

operation_test_delay()
{
    local delay="${TMUX_SESSION_LAUNCHER_TEST_OPERATION_DELAY:-0}"
    case "$delay" in
        ''|0) return 0 ;;
        *[!0-9.]* ) return 0 ;;
    esac
    trace_event "operation.test-delay seconds=$delay operation_id=${1:-none}"
    sleep "$delay"
}

fault_injection()
{
    local step="$1"
    [ -n "$FAIL_STEP" ] && [ "$FAIL_STEP" = "$step" ] || return 0
    trace_event "fault.injected step=$step operation_id=${current_action_id:-none}"
    return 1
}

current_client_tty()
{
    local tty
    tty="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}' 2>/dev/null |
        awk -F '|' '$1 != 1 && $2 != "" { print $2; exit }')"
    if [ -z "$tty" ]; then
        tty="$(tmux display-message -p '#{client_tty}' 2>/dev/null || true)"
    fi
    if [ -z "$tty" ]; then
        tty="$(tmux list-clients -F '#{client_tty}' 2>/dev/null | awk 'NF { print $1; exit }')"
    fi
    printf '%s\n' "$tty"
}

session_identity_fingerprint()
{
    local session_name_value="$1"
    tmux display-message -p -t "=$session_name_value:" '#{session_id}|#{session_created}' 2>/dev/null || true
}

session_client_fingerprint()
{
    local session_name_value="$1"
    tmux list-clients -F '#{client_control_mode}|#{client_tty}|#{session_name}' 2>/dev/null |
        awk -F '|' -v session_name="$session_name_value" '$1 != 1 && $3 == session_name { print $2 }' |
        sort | paste -sd, -
}

owner_client_fingerprint()
{
    local owner="${1:-}" client_state
    [ -n "$owner" ] || owner="$(sidebar_owner_client)"
    [ -n "$owner" ] || {
        printf '%s\n' none
        return 0
    }
    client_state="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}|#{session_name}|#{window_id}' 2>/dev/null |
        awk -F '|' -v owner="$owner" '$1 != 1 && $2 == owner { print $2 "|" $3 "|" $4; exit }')"
    printf '%s\n' "${client_state:-missing}"
}

operation_conflict()
{
    local operation_id="$1" kind="$2" phase="$3" reason="$4"
    trace_event "operation.conflict operation_id=$operation_id kind=$kind phase=$phase reason=$reason"
    sidebar_operation_finish failed "$operation_id" || true
    return 1
}

check_delete_precondition()
{
    local session_name_value="$1" operation_id="$2" expected_identity="$3" expected_clients="$4" expected_owner="$5" phase="$6"
    local actual_identity actual_clients actual_owner actual_owner_session internal_owner_transition=false
    actual_identity="$(session_identity_fingerprint "$session_name_value")"
    [ -n "$actual_identity" ] || {
        operation_conflict "$operation_id" delete "$phase" session-missing
        return 1
    }
    [ "$actual_identity" = "$expected_identity" ] || {
        operation_conflict "$operation_id" delete "$phase" session-identity-changed
        return 1
    }
    actual_clients="$(session_client_fingerprint "$session_name_value")"
    actual_owner="$(owner_client_fingerprint)"
    actual_owner_session="${actual_owner#*|}"
    actual_owner_session="${actual_owner_session%%|*}"
    local expected_tty="${expected_owner%%|*}" actual_tty="${actual_owner%%|*}"
    if [ "$phase" = before-kill ] && [ -n "$expected_clients" ] && [ -z "$actual_clients" ] &&
        { [ -z "$expected_tty" ] || [ "$expected_tty" = "none" ] || [ "$expected_tty" = "missing" ] || [ "$expected_tty" = "$actual_tty" ]; } &&
        [ "$actual_owner" != missing ] && [ "$actual_owner" != none ] &&
        [ "$actual_owner_session" != "$session_name_value" ]; then
        internal_owner_transition=true
        trace_event "operation.precondition operation_id=$operation_id kind=delete phase=$phase owner-transition=internal session=$session_name_value actual-owner=$actual_owner"
    fi
    if [ "$actual_clients" != "$expected_clients" ] && [ "$internal_owner_transition" != true ]; then
        operation_conflict "$operation_id" delete "$phase" client-set-changed
        return 1
    fi
    if [ "$actual_owner" != "$expected_owner" ] && [ "$internal_owner_transition" != true ]; then
        operation_conflict "$operation_id" delete "$phase" owner-client-changed
        return 1
    fi
    transition_lock_release
}

check_restore_precondition()
{
    local operation_id="$1" phase="$2" expected_owner="$3" original_session="$4" expected_original_identity="$5" restore_name_value="$6"
    local actual_owner actual_identity
    actual_owner="$(owner_client_fingerprint)"
    if [ "$actual_owner" = none ] && [ "$expected_owner" != none ]; then
        actual_owner="$(owner_client_fingerprint "${expected_owner%%|*}")"
    fi
    trace_event "operation.precondition operation_id=$operation_id kind=restore phase=$phase expected-owner=$expected_owner actual-owner=$actual_owner target=$restore_name_value"
    if [ "$expected_owner" != none ] && [ "$actual_owner" != "$expected_owner" ]; then
        case "$actual_owner" in
            *"|$restore_name_value|"*)
                # Creating/opening the restore target can legitimately move
                # the owner client before the explicit switch-client step.
                trace_event "operation.precondition operation_id=$operation_id kind=restore phase=$phase owner-transition=internal target=$restore_name_value"
                ;;
            *)
                operation_conflict "$operation_id" restore "$phase" owner-client-changed
                return 1
                ;;
        esac
    fi
    if [ -n "$original_session" ] && [ -n "$expected_original_identity" ]; then
        actual_identity="$(session_identity_fingerprint "$original_session")"
        [ "$actual_identity" = "$expected_original_identity" ] || {
            operation_conflict "$operation_id" restore "$phase" source-session-changed
            return 1
        }
    fi
    if [ "${created:-false}" = true ] && [ -n "${restore_created_identity:-}" ]; then
        actual_identity="$(session_identity_fingerprint "$restore_name_value")"
        [ "$actual_identity" = "$restore_created_identity" ] || {
            operation_conflict "$operation_id" restore "$phase" restored-session-changed
            return 1
        }
    elif session_exists "$restore_name_value"; then
        operation_conflict "$operation_id" restore "$phase" restore-name-collision
        return 1
    fi
}

sidebar_owner_client()
{
    tmux show-option -gqv "$SIDEBAR_OWNER_CLIENT_OPTION" 2>/dev/null || true
}

claim_sidebar_owner()
{
    local client_tty owner
    client_tty="$(current_client_tty)"
    [ -n "$client_tty" ] || return 0
    owner="$(sidebar_owner_client)"
    if [ -n "$owner" ] && ! tmux list-clients -F '#{client_tty}' 2>/dev/null |
        awk -v owner="$owner" '$0 == owner { found=1 } END { exit !found }'; then
        trace_event "sidebar.owner.clear-stale client=$owner"
        tmux set-option -gq "$SIDEBAR_OWNER_CLIENT_OPTION" "" 2>/dev/null || true
        owner=""
    fi
    if [ -z "$owner" ]; then
        tmux set-option -gq "$SIDEBAR_OWNER_CLIENT_OPTION" "$client_tty" 2>/dev/null || true
        trace_event "sidebar.owner.claim client=$client_tty"
    fi
}

sidebar_client_is_owner()
{
    local owner client_tty
    owner="$(sidebar_owner_client)"
    [ -n "$owner" ] || return 0
    client_tty="$(current_client_tty)"
    [ "$owner" = "$client_tty" ]
}

mark_session_managed()
{
    local session_name_value="$1" session_target
    [ -n "$session_name_value" ] || return 1
    session_target="=$session_name_value:"
    sidebar_tmux_cmd has-session -t "$session_target" >/dev/null 2>&1 || return 1
    sidebar_tmux_cmd set-option -q -t "$session_target" "$SIDEBAR_MANAGED_OPTION" 1 2>/dev/null || return 1
}

session_is_managed()
{
    local session_name_value="$1" session_target="=$1:"
    [ "$(tmux show-option -qv -t "$session_target" "$SIDEBAR_MANAGED_OPTION" 2>/dev/null || true)" = 1 ]
}

managed_session_names()
{
    while IFS= read -r session_name_value; do
        session_is_managed "$session_name_value" && printf '%s\n' "$session_name_value"
    done < <(sidebar_tmux_cmd list-sessions -F '#{session_name}' 2>/dev/null || true)
}

_sidebar_hooks_installed=false

install_sidebar_hooks()
{
    if [ "${_sidebar_hooks_installed:-false}" = "true" ]; then
        return 0
    fi
    if [ "$(tmux show-option -gqv "@sidebar_hooks_installed" 2>/dev/null || true)" = "1" ]; then
        _sidebar_hooks_installed=true
        return 0
    fi
    local quoted_script
    quoted_script="$(shell_quote "$SCRIPT_PATH")"
    # Use context formats that this tmux version expands for the corresponding
    # hook. hook_window/hook_client are empty in the asynchronous after-hook
    # command and make tmux display a client-visible "returned 1" message.
    tmux set-hook -g client-session-changed "run-shell -b '$quoted_script --sync-active-window #{client_tty}'" 2>/dev/null || true
    tmux set-hook -g after-select-window "run-shell -b '$quoted_script --sync-active-window #{client_tty}'" 2>/dev/null || true
    tmux set-hook -g after-new-session "run-shell -b '$quoted_script --ensure-sidebar-session #{session_name} >/dev/null 2>&1'" 2>/dev/null || true
    tmux set-hook -g after-new-window "run-shell -b '$quoted_script --ensure-sidebar-window #{window_id} >/dev/null 2>&1'" 2>/dev/null || true
    tmux set-hook -g after-link-window "run-shell -b '$quoted_script --ensure-sidebar-window #{window_id} >/dev/null 2>&1'" 2>/dev/null || true
    tmux set-hook -g after-split-window "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} split'" 2>/dev/null || true
    tmux set-hook -g after-resize-pane "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} manual-resize'" 2>/dev/null || true
    tmux set-hook -g after-select-layout "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} select-layout'" 2>/dev/null || true
    tmux set-hook -g after-join-pane "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} join-pane'" 2>/dev/null || true
    tmux set-hook -g after-break-pane "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} break-pane'" 2>/dev/null || true
    tmux set-hook -g after-kill-pane "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} kill-pane'" 2>/dev/null || true
    tmux set-hook -g after-rotate-window "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} rotate-window'" 2>/dev/null || true
    tmux set-hook -g after-swap-pane "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} swap-pane'" 2>/dev/null || true
    tmux set-hook -g window-resized "run-shell -b '$quoted_script --sync-sidebar-layout #{window_id} window-resized'" 2>/dev/null || true
    tmux set-hook -g window-pane-changed "run-shell -b '$quoted_script --sync-sidebar-focus #{window_id}'" 2>/dev/null || true
    tmux set-option -gq "@sidebar_hooks_installed" 1 2>/dev/null || true
    _sidebar_hooks_installed=true
}

sidebar_layout_hook_guard_active()
{
    local guard now
    guard="$(tmux show-option -gqv "$SIDEBAR_LAYOUT_HOOK_GUARD_OPTION" 2>/dev/null || true)"
    case "$guard" in
        ''|*[!0-9]*) return 1 ;;
    esac
    now="$(date +%s%N)"
    if [ "$guard" -gt "$now" ]; then
        return 0
    fi
    tmux set-option -gq "$SIDEBAR_LAYOUT_HOOK_GUARD_OPTION" 0 2>/dev/null || true
    return 1
}

set_sidebar_layout_hook_guard()
{
    local duration_ms="${1:-500}"
    local duration_ns=$(( duration_ms * 1000000 ))
    tmux set-option -gq "$SIDEBAR_LAYOUT_HOOK_GUARD_OPTION" "$(( $(date +%s%N) + duration_ns ))" 2>/dev/null || true
}

sync_sidebar_layout()
{
    local window_id="$1" source="${2:-internal}" sidebar_pane sidebar_count
    [ -n "$window_id" ] || return 0
    if ! sidebar_enabled; then
        sidebar_pane="$(find_sidebar_pane "$window_id" || true)"
        if [ -n "$sidebar_pane" ]; then
            remove_sidebar_window "$window_id" || true
        fi
        return 0
    fi
    if transition_is_active; then
        transition_defer_hook_sync layout
        return 0
    fi
    if [ "$source" != manual-resize ] && sidebar_layout_hook_guard_active; then
        return 0
    fi
    sidebar_operation_busy && {
        trace_event "sidebar.layout.sync.skip window=$window_id reason=operation-busy state=$(sidebar_operation_state)"
        return 0
    }
    sidebar_pane="$(find_sidebar_pane "$window_id" || true)"
    [ -n "$sidebar_pane" ] || return 0
    sidebar_window_ready "$window_id" || return 0
    sidebar_count="$(tmux list-panes -t "$window_id" -F '#{pane_title}' 2>/dev/null |
        awk -v title="$SIDEBAR_TITLE" '$0 == title { count++ } END { print count + 0 }')"
    if [ "$sidebar_count" -ne 1 ]; then
        trace_event "sidebar.layout.sync.abort window=$window_id reason=sidebar-count count=$sidebar_count"
        return 1
    fi

    tmux set-option -gq "$SIDEBAR_LAYOUT_HOOK_GUARD_OPTION" "$(( $(date +%s%N) + 500000000 ))" 2>/dev/null || true
    sleep "${TMUX_SESSION_SIDEBAR_LAYOUT_DEBOUNCE:-0.05}"
    if [ "$source" = manual-resize ] && ! sidebar_width_apply_guard_active; then
        remember_sidebar_width_for_window "$window_id"
    else
        trace_event "sidebar.width.global-save.skip window=$window_id source=$source reason=non-manual-or-internal"
    fi
    if ! save_sidebar_layout "$window_id"; then
        trace_event "sidebar.layout.sync.abort window=$window_id reason=full-snapshot"
        return 1
    else
        trace_event "sidebar.layout.sync.end window=$window_id pane=$sidebar_pane result=ok"
    fi
}

sync_sidebar_focus()
{
    local window_id="$1"
    [ -n "$window_id" ] || return 0
    if transition_is_active; then
        transition_defer_hook_sync focus
        return 0
    fi
    sidebar_layout_hook_guard_active && return 0
    sidebar_operation_busy && return 0
    find_sidebar_pane "$window_id" >/dev/null || return 0
    sidebar_window_ready "$window_id" || return 0
    save_sidebar_layout "$window_id" || true
    trace_event "sidebar.layout.focus window=$window_id"
}

sync_active_window()
{
    local active_session active_window hook_client="${1:-}" local_pane
    if restore_topology_guard_active; then
        trace_event "sidebar.hook.sync.skip reason=restore-topology-guard"
        return 0
    fi
    if transition_is_active; then
        trace_event "sidebar.hook.sync.skip reason=transition-active state=$(sidebar_tmux_cmd show-option -gqv "$SIDEBAR_TRANSITION_OPTION" 2>/dev/null || true)"
        transition_defer_hook_sync active-window
        return 0
    fi
    active_session="$(tmux display-message -p -c "$hook_client" '#S' 2>/dev/null || tmux display-message -p '#S' 2>/dev/null || true)"
    active_window="$(tmux display-message -p -c "$hook_client" '#{window_id}' 2>/dev/null || tmux display-message -p '#{window_id}' 2>/dev/null || true)"
    [ -n "$active_session" ] && [ -n "$active_window" ] || return 0
    if [ "$(tmux show-option -gqv "$SIDEBAR_ENABLED_OPTION" 2>/dev/null || true)" = 1 ]; then
        reconcile_sidebar_window "$active_window"
        local_pane="$(sidebar_window_pane "$active_window" || true)"
        if [ -n "$local_pane" ]; then
            trace_event "sidebar.hook.local-present window=$active_window session=$active_session pane=$local_pane"
        else
            trace_event "sidebar.hook.provision window=$active_window session=$active_session"
            provision_sidebar_window "$active_window" "$(sidebar_width)" || true
        fi
    fi
}

wait_for_session_absence()
{
    session_name="$1"
    timeout="${2:-50}"
    delay="${3:-0.05}"
    i=0

    while [ "$i" -lt "$timeout" ]; do
        if ! session_exists "$session_name"; then
            debug_log "wait_for_session_absence session=$session_name gone after=$i"
            return 0
        fi
        sleep "$delay"
        i=$((i + 1))
    done

    debug_log "wait_for_session_absence timeout session=$session_name"
    return 1
}

reassert_sidebar_after_session_delete()
{
    local client_tty window_id sidebar_pane
    [ -n "${current_session:-}" ] || return 1
    client_tty="$(current_client_tty || true)"
    window_id="$(tmux display-message -p -t "$client_tty" '#{window_id}' 2>/dev/null || true)"
    sidebar_pane="$(sidebar_window_pane "$window_id" || true)"
    if [ -n "$window_id" ] && [ -n "$sidebar_pane" ] && sidebar_window_ready "$window_id"; then
        # The surviving window already owns its sidebar. Reasserting focus is
        # limited to the local pane and never moves or redraws infrastructure.
        tmux select-pane -t "$sidebar_pane" -T "$SIDEBAR_TITLE" 2>/dev/null || true
        tmux select-pane -t "$sidebar_pane" 2>/dev/null || true
        trace_event "delete.input-focus.reassert session=$current_session client=$client_tty window=$window_id pane=$sidebar_pane"
        return 0
    fi
    trace_event "delete.input-focus.reassert-failed session=$current_session client=${client_tty:-none} window=${window_id:-none} pane=${sidebar_pane:-none}"
    return 1
}

find_sidebar_pane()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux list-panes -t "$target" -F '#{pane_id}	#{pane_title}' 2>/dev/null
    else
        tmux list-panes -F '#{pane_id}	#{pane_title}'
    fi |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }'
}
find_global_sidebar_pane()
{
    sidebar_tmux_global_sidebar_pane
}


sidebar_window_pane()
{
    local window_id="$1" actual_pane stored_pane
    actual_pane="$(sidebar_tmux_cmd list-panes -t "$window_id" \
        -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }' || true)"
    if [ -z "$actual_pane" ]; then
        if [ -n "$window_id" ]; then
            local win_clean="${window_id//[^a-zA-Z0-9_]/_}"
            printf -v "_cache_window_ready_${win_clean}" '0'
            printf -v "_cache_window_pane_${win_clean}" ''
        fi
        stored_pane="$(sidebar_tmux_cmd show-option -wqv -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" 2>/dev/null || true)"
        if [ -n "$stored_pane" ]; then
            sidebar_tmux_cmd set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" "" 2>/dev/null || true
            sidebar_tmux_cmd set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
            trace_event "sidebar.stale-metadata window=$window_id stored_pane=$stored_pane ready=0 reason=pane-missing"
        fi
        return 0
    fi
    printf '%s\n' "$actual_pane"
}

sidebar_provisioning_active()
{
    [ "$(tmux show-option -gqv "$SIDEBAR_PROVISION_OPTION" 2>/dev/null || true)" = 1 ]
}

sidebar_window_ids()
{
    local window_id session_name
    while IFS='|' read -r window_id session_name; do
        [ -n "$window_id" ] || continue
        session_is_managed "$session_name" || continue
        printf '%s\n' "$window_id"
    done < <(sidebar_tmux_cmd list-windows -a \
        -F '#{window_id}|#{session_name}' 2>/dev/null || true) | sort -u
}

resolve_active_client_property()
{
    local fmt="$1" val
    val="$(tmux list-clients -F "#{client_control_mode}|${fmt}" 2>/dev/null |
        awk -F '|' '$1 != 1 && $2 != "" { print $2; exit }')"
    if [ -z "$val" ]; then
        val="$(tmux display-message -p "${fmt}" 2>/dev/null || true)"
    fi
    if [ -z "$val" ]; then
        val="$(tmux list-clients -F "${fmt}" 2>/dev/null | awk 'NF { print $1; exit }')"
    fi
    printf '%s\n' "$val"
}

active_client_window()
{
    resolve_active_client_property '#{window_id}'
}

active_client_session()
{
    resolve_active_client_property '#{session_name}'
}

global_sidebar_window()
{
    local sidebar_pane
    sidebar_pane="$(find_global_sidebar_pane || true)"
    [ -n "$sidebar_pane" ] || return 1
    sidebar_tmux_pane_window "$sidebar_pane"
}

sidebar_window_count()
{
    local window_id="$1"
    [ -n "$(sidebar_window_pane "$window_id" || true)" ] && printf '1\n' || printf '0\n'
}

sidebar_window_ready()
{
    local window_id="$1" pane_id="${2:-}" pane_dead pane_pid ready
    ready="$(sidebar_tmux_cmd show-option -wqv -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 2>/dev/null || true)"
    if [ "$ready" = 1 ]; then
        return 0
    fi
    [ -n "$pane_id" ] || pane_id="$(sidebar_window_pane "$window_id" || true)"
    [ -n "$pane_id" ] || return 1
    pane_dead="$(sidebar_tmux_cmd display-message -p -t "$pane_id" '#{pane_dead}' 2>/dev/null || true)"
    pane_pid="$(sidebar_tmux_cmd display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || true)"
    if [ "$ready" != 1 ]; then
        ready=0
        sidebar_tmux_cmd capture-pane -p -t "$pane_id" 2>/dev/null |
            grep -Fxq 'sessions' && ready=1
    fi
    [ "$pane_dead" = 0 ] && [ -n "$pane_pid" ] && [ "$ready" = 1 ]
}

sidebar_enabled()
{
    [ "$(tmux show-option -gqv "$SIDEBAR_ENABLED_OPTION" 2>/dev/null || true)" = 1 ]
}

set_sidebar_enabled()
{
    tmux set-option -gq "$SIDEBAR_ENABLED_OPTION" "$1" 2>/dev/null || true
    # The logical sidebar state is shared through tmux options, while each
    # managed window owns a stable physical pane.  Do not advertise the old
    # move-one-global-pane model to hooks or diagnostics.
    tmux set-option -gq "$SIDEBAR_MODEL_OPTION" window-local 2>/dev/null || true
}

cached_sidebar_pane_for_session()
{
    local session_name_value="$1"
    [ -n "${cached_session_panes_snapshot[$session_name_value]:-}" ] || return 1
    awk -F '\t' -v title="$SIDEBAR_TITLE" '$3 == title { print $2; exit }' \
        <<< "${cached_session_panes_snapshot[$session_name_value]}"
}

session_command_signature_from_tmux()
{
    local session_name_value="$1"
    local pane_id_value pane_command_value
    session_command_signature_result=""

    while IFS='|' read -r pane_id_value pane_command_value; do
        [ -n "$pane_id_value" ] || continue
        session_command_signature_result+="$pane_id_value:$pane_command_value|"
    done < <(
        tmux list-panes -t "=$session_name_value:" \
            -F '#{pane_id}|#{pane_current_command}' 2>/dev/null || true
    )
}

window_target()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true
    else
        tmux display-message -p '#{window_id}' 2>/dev/null || true
    fi
}

sidebar_window_pane_geometry()
{
    local target="$1"
    tmux list-panes -t "$target" \
        -F '#{pane_id}:#{pane_left},#{pane_top},#{pane_width},#{pane_height}' 2>/dev/null |
        sort
}

save_sidebar_layout()
{
    local target="$1" window_id layout pane_ids geometry active_pane
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 1
    layout="$(sidebar_tmux_window_layout "$window_id")"
    pane_ids="$(sidebar_tmux_window_pane_ids "$window_id" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    geometry="$(sidebar_window_pane_geometry "$window_id" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    active_pane="$(sidebar_tmux_window_active_pane "$window_id")"
    [ -n "$layout" ] && [ -n "$pane_ids" ] && [ -n "$geometry" ] || return 1
    tmux set-option -wq -t "$window_id" "$SIDEBAR_LAYOUT_OPTION" "$layout"
    tmux set-option -wq -t "$window_id" "$SIDEBAR_LAYOUT_PANES_OPTION" "$pane_ids"
    tmux set-option -wq -t "$window_id" "$SIDEBAR_LAYOUT_GEOMETRY_OPTION" "$geometry"
    tmux set-option -wq -t "$window_id" "$SIDEBAR_LAYOUT_ACTIVE_PANE_OPTION" "$active_pane"
    tmux set-option -wq -t "$window_id" "$SIDEBAR_LAYOUT_GENERATION_OPTION" "$(date +%s%N)"
    trace_event "sidebar.layout.snapshot window=$window_id panes=$pane_ids active=${active_pane:-none} geometry=$geometry"
}

sidebar_layout_available()
{
    local window_id="$1"
    [ -n "$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_OPTION" 2>/dev/null || true)" ] &&
        [ -n "$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_PANES_OPTION" 2>/dev/null || true)" ]
}

restore_sidebar_layout()
{
    local window_id="$1" layout restored_layout expected_ids expected_ids_raw actual_ids actual_ids_ordered expected_geometry actual_geometry active_pane
    layout="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_OPTION" 2>/dev/null || true)"
    expected_ids_raw="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_PANES_OPTION" 2>/dev/null || true)"
    expected_geometry="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_GEOMETRY_OPTION" 2>/dev/null || true)"
    active_pane="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_LAYOUT_ACTIVE_PANE_OPTION" 2>/dev/null || true)"
    [ -n "$layout" ] && [ -n "$expected_ids_raw" ] && [ -n "$expected_geometry" ] || return 2

    actual_ids_ordered="$(sidebar_tmux_window_pane_ids "$window_id" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    actual_ids="$(printf '%s\n' "$actual_ids_ordered" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    expected_ids="$(printf '%s\n' "$expected_ids_raw" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    if [ "$actual_ids" != "$expected_ids" ]; then
        trace_event "sidebar.layout.error window=$window_id reason=pane-set expected=$expected_ids actual=$actual_ids"
        return 1
    fi
    trace_event "sidebar.layout.restore.begin window=$window_id layout=$layout"
    restored_layout="$(layout_with_pane_ids "$layout" "${actual_ids_ordered//%/}")"
    trace_event "sidebar.layout.restore.mapping window=$window_id pane-order=$actual_ids_ordered restored=$restored_layout"
    if ! sidebar_tmux_select_layout "$window_id" "$restored_layout"; then
        trace_event "sidebar.layout.error window=$window_id reason=select-layout"
        return 1
    fi
    actual_geometry="$(sidebar_window_pane_geometry "$window_id" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    if [ "$actual_geometry" != "$expected_geometry" ]; then
        trace_event "sidebar.layout.error window=$window_id reason=geometry expected=$expected_geometry actual=$actual_geometry"
        return 1
    fi
    if [ -n "$active_pane" ] && ! sidebar_tmux_select_pane "$active_pane"; then
        trace_event "sidebar.layout.error window=$window_id reason=active-pane pane=$active_pane"
        return 1
    fi
    trace_event "sidebar.layout.restore.end window=$window_id active=${active_pane:-none}"
}

save_work_layout()
{
    target="${1:-}"
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 0
    fault_injection snapshot || return 1

    layout="$(tmux display-message -p -t "$window_id" '#{window_layout}' 2>/dev/null || true)"
    [ -n "$layout" ] || return 0

    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_OPTION" "$layout" 2>/dev/null || true
    work_pane_ids="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title { print $1 }' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    active_work_pane="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}|#{pane_active}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title && $3 == 1 { print $1; exit }')"
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_PANES_OPTION" "$work_pane_ids" 2>/dev/null || true
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_GEOMETRY_OPTION" "$(tmux list-panes -t "$window_id" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height},#{pane_active}' 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')" 2>/dev/null || true
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_GENERATION_OPTION" "$(date +%s%N)" 2>/dev/null || true
    trace_event "layout.snapshot window=$window_id panes=${work_pane_ids:-none} active=${active_work_pane:-none}"
}

snapshot_work_layout_transaction()
{
    local target="$1" window_id sidebar_pane work_pane width holder_window
    local layout work_pane_ids active_work_pane
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 1
    fault_injection snapshot || return 1
    sidebar_pane="$(find_sidebar_pane "$target" || true)"
    if [ -z "$sidebar_pane" ]; then
        save_work_layout "$target"
        return $?
    fi
    work_pane="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title { print $1; exit }')"
    [ -n "$work_pane" ] || return 1
    width="$(tmux display-message -p -t "$sidebar_pane" '#{pane_width}' 2>/dev/null || true)"
    holder_window="$(tmux break-pane -d -s "$sidebar_pane" -P -F '#{window_id}' 2>/dev/null || true)"
    [ -n "$holder_window" ] || return 1
    sleep 0.05
    layout="$(tmux display-message -p -t "$window_id" '#{window_layout}' 2>/dev/null || true)"
    work_pane_ids="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title { print $1 }' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    active_work_pane="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}|#{pane_active}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title && $3 == 1 { print $1; exit }')"
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_OPTION" "$layout" 2>/dev/null || true
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_PANES_OPTION" "$work_pane_ids" 2>/dev/null || true
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_GEOMETRY_OPTION" "$(tmux list-panes -t "$window_id" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height},#{pane_active}' 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')" 2>/dev/null || true
    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_GENERATION_OPTION" "$(date +%s%N)" 2>/dev/null || true
    if ! tmux join-pane -d -s "$sidebar_pane" -t "$work_pane" -b -h -l "$width" 2>/dev/null; then
        tmux join-pane -d -s "$sidebar_pane" -t "$work_pane" -b -h 2>/dev/null || true
        return 1
    fi
    tmux select-pane -t "$sidebar_pane" -T "$SIDEBAR_TITLE" 2>/dev/null || true
    tmux select-pane -t "$sidebar_pane" 2>/dev/null || true
    trace_event "layout.snapshot.transaction window=$window_id holder=$holder_window panes=${work_pane_ids:-none} active=${active_work_pane:-none}"
}

restore_work_layout()
{
    target="${1:-}"
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 0

    layout="$(tmux show-option -wqv -t "$window_id" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"
    [ -n "$layout" ] || return 0

    tmux select-layout -t "$window_id" "$layout" >/dev/null 2>&1 || true
}

prepare_window_for_archive()
{
    target="$1"
    sidebar_pane="$(find_sidebar_pane "$target")"
    work_layout=""
    work_pane_count=""
    layout_pane_count=""

    work_layout="$(tmux show-option -wqv -t "$target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"

    if [ -n "$sidebar_pane" ]; then
        # v3 archives need the work-only layout. Capture it transactionally
        # on the archive path; session switching never calls this helper.
        snapshot_work_layout_transaction "$target" >/dev/null 2>&1 || true
        work_layout="$(tmux show-option -wqv -t "$target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"
        if [ -n "$work_layout" ]; then
            printf '%s\n' "$work_layout"
        else
            printf '\n'
        fi
        return 0
    fi

    tmux display-message -p -t "$target" '#{window_layout}' 2>/dev/null || true
}

prepare_window_for_archive_snapshot()
{
    local target="$1"
    local window_index="$2"
    local window_layout="$3"
    local work_layout=""
    local work_pane_count=0
    local layout_pane_count_value=0
    local sidebar_present=false
    local pane_session pane_window_index pane_index pane_id pane_left pane_top pane_width pane_height
    local pane_active pane_path pane_command pane_title pane_snapshot_window pane_snapshot_active
    local pane_snapshot_layout pane_created
    local ignored_window_name ignored_window_active ignored_window_layout ignored_created

    # archive_panes_snapshot follows the full tmux list-panes format declared
    # in archive_session.  Reading only the first few fields used to assign
    # pane_left to pane_title, so sidebar_present stayed false and the
    # sidebar-inclusive layout was archived alongside work-only panes.
    while IFS="$(printf '\t')" read -r pane_session pane_window_index pane_index pane_id \
        pane_left pane_top pane_width pane_height pane_active pane_path pane_command pane_title \
        pane_snapshot_window pane_snapshot_active pane_snapshot_layout pane_created; do
        [ "$pane_session" = "$target" ] ||
            [ "$pane_session" = "=$target:" ] || continue
        if [ "$pane_title" = "$SIDEBAR_TITLE" ]; then
            sidebar_present=true
        else
            work_pane_count=$((work_pane_count + 1))
        fi
    done <<EOF
$archive_panes_snapshot
EOF

    if [ "$sidebar_present" = "true" ]; then
        snapshot_target="=$target:$window_index"
        if snapshot_work_layout_transaction "$snapshot_target"; then
            tmux show-option -wqv -t "$snapshot_target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true
            return 0
        fi
        work_layout="$(tmux show-option -wqv -t "$target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"
        if [ -n "$work_layout" ]; then
            layout_pane_count_value="$(layout_pane_count "$work_layout")"
            if [ "$work_pane_count" = "$layout_pane_count_value" ]; then
                printf '%s\n' "$work_layout"
                return 0
            fi
        fi
        # Direct tmux split/resize can invalidate the cached work-only layout.
        # Never archive a stale layout or a layout containing the sidebar.
        trace_event "archive.layout-stale session=$target window=$window_index work_panes=$work_pane_count cached_panes=${layout_pane_count_value:-0}"
        printf '\n'
        return 0
    fi

    # A concurrent sidebar provision can leave a full-window layout in the
    # pane snapshot even though only the work pane was serialized. Treat that
    # mismatch as no layout metadata; restoring a two-pane layout onto one
    # recreated pane causes geometry verification to abort the restore.
    layout_pane_count_value="$(layout_pane_count "$window_layout")"
    if [ "$work_pane_count" -gt 0 ] && [ "$layout_pane_count_value" -ne "$work_pane_count" ]; then
        trace_event "archive.layout-stale session=$target window=$window_index work_panes=$work_pane_count layout_panes=$layout_pane_count_value"
        printf '\n'
        return 0
    fi
    printf '%s\n' "$window_layout"
}

layout_pane_count()
{
    layout="$1"

    printf '%s\n' "$layout" |
        awk '{
            count = 0
            while (match($0, /[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+/)) {
                count++
                $0 = substr($0, RSTART + RLENGTH)
            }
            print count
        }'
}

layout_body()
{
    layout="$1"

    case "$layout" in
        [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F],*) printf '%s\n' "${layout#*,}" ;;
        *) printf '%s\n' "$layout" ;;
    esac
}

layout_with_checksum()
{
    body="$1"
    checksum=0
    bytes="$(printf '%s' "$body" | od -An -tu1 -v)"

    for byte in $bytes; do
        checksum=$((((checksum >> 1) | ((checksum & 1) << 15))))
        checksum=$(((checksum + byte) & 65535))
    done

    printf '%04x,%s\n' "$checksum" "$body"
}

layout_with_pane_ids()
{
    layout="$1"
    pane_ids="$2"
    body="$(layout_body "$layout")"
    replaced=""

    replaced="$(
        printf '%s\n' "$body" |
        awk -v pane_ids="$pane_ids" '
            BEGIN {
                split(pane_ids, ids, " ")
                pane_index = 1
            }
            {
                output = ""
                rest = $0
                while (match(rest, /[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+/)) {
                    token = substr(rest, RSTART, RLENGTH)
                    replacement = token
                    if (ids[pane_index] != "") {
                        sub(/,[0-9]+$/, "," ids[pane_index], replacement)
                    }
                    output = output substr(rest, 1, RSTART - 1) replacement
                    rest = substr(rest, RSTART + RLENGTH)
                    pane_index++
                }
                print output rest
            }'
    )"

    layout_with_checksum "$replaced"
}

list_window_panes()
{
    target="$1"
    tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null || true
}

new_pane_from_snapshot()
{
    before="$1"
    target="$2"

    list_window_panes "$target" |
        awk -v before="$before" '
            BEGIN {
                split(before, panes, "\n")
                for (i in panes) {
                    if (panes[i] != "") seen[panes[i]] = 1
                }
            }
            !($0 in seen) { print; exit }
        '
}

target_pane_path()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || printf '%s\n' "$current_path"
    else
        tmux display-message -p '#{pane_current_path}' 2>/dev/null || printf '%s\n' "$current_path"
    fi
}

mark_sidebar_pane()
{
    local pane_id="${TMUX_PANE:-}"
    trace_event "sidebar.pane-title.begin pane=${pane_id:-current}"
    if [ -n "$pane_id" ]; then
        tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE" 2>/dev/null || true
    else
        tmux select-pane -T "$SIDEBAR_TITLE" 2>/dev/null || true
    fi
    trace_event "sidebar.pane-title.end pane=${pane_id:-current}"
}

sidebar_session_name()
{
    local pane_id="${TMUX_PANE:-${SELF_PANE:-}}"
    local session_name

    [ -n "$pane_id" ] || return 0
    session_name="$(
        tmux list-panes -a -F '#{pane_id}	#{session_name}' 2>/dev/null |
            awk -F '	' -v pane_id="$pane_id" '$1 == pane_id { print $2; exit }'
    )"
    if [ -n "$session_name" ]; then
        printf '%s\n' "$session_name"
    fi
}

current_sidebar_width()
{
    sidebar_pane="$(find_sidebar_pane)"
    [ -n "$sidebar_pane" ] || sidebar_pane="$(find_global_sidebar_pane)"

    if [ -n "$sidebar_pane" ]; then
        tmux display-message -p -t "$sidebar_pane" '#{pane_width}'
    else
        tmux show-option -gqv '@dotfiles-session-sidebar-width'
    fi
}

sidebar_width()
{
    case "${_cache_sidebar_width:-}" in
        ''|*[!0-9]*) ;;
        *) printf '%s\n' "$_cache_sidebar_width"; return 0 ;;
    esac

    local remembered width persisted

    # A target window can be narrower while detached. Its live pane width is
    # therefore not a stable sidebar width source for the next transition.
    remembered="$(tmux show-option -gqv '@dotfiles-session-sidebar-width' 2>/dev/null || true)"
    case "$remembered" in
        ''|*[!0-9]*) ;;
        *)
            _cache_sidebar_width="$remembered"
            printf '%s\n' "$remembered"
            return 0
            ;;
    esac

    persisted="$(read_persisted_sidebar_width || true)"
    case "$persisted" in
        ''|*[!0-9]*) ;;
        *)
            _cache_sidebar_width="$persisted"
            tmux set-option -gq '@dotfiles-session-sidebar-width' "$persisted" 2>/dev/null || true
            printf '%s\n' "$persisted"
            return 0
            ;;
    esac

    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) width="$SIDEBAR_WIDTH" ;;
    esac
    _cache_sidebar_width="$width"
    tmux set-option -gq '@dotfiles-session-sidebar-width' "$width" 2>/dev/null || true
    printf '%s\n' "$width"
}

remember_sidebar_width()
{
    local width
    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) return 0 ;;
        *)
            _cache_sidebar_width="$width"
            tmux set-option -gq '@dotfiles-session-sidebar-width' "$width"
            persist_sidebar_width "$width" ||
                trace_event "sidebar.width.persist.skip width=$width reason=state-write-failed"
            ;;
    esac
}

remember_sidebar_width_for_window()
{
    local window_id="$1" sidebar_pane width
    sidebar_pane="$(find_sidebar_pane "$window_id" || true)"
    [ -n "$sidebar_pane" ] || return 0
    width="$(tmux display-message -p -t "$sidebar_pane" '#{pane_width}' 2>/dev/null || true)"
    case "$width" in
        ''|*[!0-9]*) return 0 ;;
        *)
            _cache_sidebar_width="$width"
            tmux set-option -gq '@dotfiles-session-sidebar-width' "$width" 2>/dev/null || true
            persist_sidebar_width "$width" ||
                trace_event "sidebar.width.persist.skip width=$width reason=state-write-failed"
            trace_event "sidebar.width.global-save window=$window_id pane=$sidebar_pane width=$width"
            ;;
    esac
}

read_persisted_sidebar_width()
{
    local width
    [ -r "$SIDEBAR_WIDTH_STATE_FILE" ] || return 1
    IFS= read -r width < "$SIDEBAR_WIDTH_STATE_FILE" || true
    case "$width" in
        ''|*[!0-9]*) return 1 ;;
        *) printf '%s\n' "$width" ;;
    esac
}

persist_sidebar_width()
{
    local width="$1" state_dir tmp_file
    case "$width" in ''|*[!0-9]*) return 1 ;; esac
    _cache_sidebar_width="$width"
    state_dir="$(dirname "$SIDEBAR_WIDTH_STATE_FILE")"
    mkdir -p "$state_dir" 2>/dev/null || return 1
    tmp_file="$(mktemp "$state_dir/.tmux-sidebar-width.XXXXXX" 2>/dev/null || true)"
    [ -n "$tmp_file" ] || return 1
    if ! printf '%s\n' "$width" > "$tmp_file"; then
        rm -f -- "$tmp_file"
        return 1
    fi
    if ! mv -f -- "$tmp_file" "$SIDEBAR_WIDTH_STATE_FILE"; then
        rm -f -- "$tmp_file"
        return 1
    fi
}

sidebar_width_apply_guard_active()
{
    local guard now
    guard="$(tmux show-option -gqv "$SIDEBAR_WIDTH_APPLY_GUARD_OPTION" 2>/dev/null || true)"
    now="$(date +%s%N)"
    case "$guard" in
        ''|*[!0-9]*) return 1 ;;
        *)
            if [ "$guard" -gt "$now" ]; then return 0; fi
            tmux set-option -gq "$SIDEBAR_WIDTH_APPLY_GUARD_OPTION" 0 2>/dev/null || true
            return 1
            ;;
    esac
}

enforce_sidebar_width()
{
    local pane_id="$1" expected="$2" actual attempt
    [ -n "$pane_id" ] || return 1
    case "$expected" in ''|*[!0-9]*) return 1 ;; esac
    if [ "${sidebar_runtime_pane_id:-}" = "$pane_id" ] && [ -n "${sidebar_runtime_geometry:-}" ]; then
        actual="${sidebar_runtime_geometry##*,}"
        if [ "$actual" = "$expected" ]; then
            return 0
        fi
    fi
    for attempt in 1 2 3; do
        actual="$(tmux display-message -p -t "$pane_id" '#{pane_width}' 2>/dev/null || true)"
        if [ "$actual" = "$expected" ]; then
            trace_event "sidebar.width.verify pane=$pane_id expected=$expected actual=$actual attempt=$attempt result=ok"
            return 0
        fi
        trace_event "sidebar.width.reconcile pane=$pane_id expected=$expected actual=${actual:-none} attempt=$attempt"
        tmux set-option -gq "$SIDEBAR_WIDTH_APPLY_GUARD_OPTION" "$(( $(date +%s%N) + 1000000000 ))" 2>/dev/null || true
        tmux resize-pane -t "$pane_id" -x "$expected" 2>/dev/null || true
        sleep 0.02
    done
    actual="$(tmux display-message -p -t "$pane_id" '#{pane_width}' 2>/dev/null || true)"
    trace_event "sidebar.width.verify pane=$pane_id expected=$expected actual=${actual:-none} result=failed"
    return 1
}

reconcile_sidebar_window()
{
    local window_id="$1" existing_pane canonical_pane duplicate_pane
    [ -n "$window_id" ] || return 0
    if ! sidebar_enabled; then
        existing_pane="$(sidebar_window_pane "$window_id" || true)"
        if [ -n "$existing_pane" ]; then
            remove_sidebar_window "$window_id" || true
        fi
        return 0
    fi
    canonical_pane="$(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }')"
    existing_pane="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" 2>/dev/null || true)"
    if [ -n "$existing_pane" ] && tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v pane="$existing_pane" -v title="$SIDEBAR_TITLE" '$1 == pane && $2 == title { found=1 } END { exit found ? 0 : 1 }'; then
        canonical_pane="$existing_pane"
    fi
    [ -n "$canonical_pane" ] || return 0
    while IFS='|' read -r duplicate_pane _; do
        [ -n "$duplicate_pane" ] || continue
        [ "$duplicate_pane" = "$canonical_pane" ] && continue
        trace_event "sidebar.duplicate.reconcile window=$window_id canonical=$canonical_pane removed=$duplicate_pane"
        tmux kill-pane -t "$duplicate_pane" 2>/dev/null || true
    done < <(tmux list-panes -t "$window_id" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 == title { print $1 "|" $2 }')
    tmux set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" "$canonical_pane" 2>/dev/null || true
}

provision_sidebar_window()
{
    local window_id="$1" width="${2:-$(sidebar_width)}"
    local existing_pane global_pane global_window work_pane pane_path pane_id pane_state pane_dead
    [ -n "$window_id" ] || return 1
    trace_event "sidebar.provision.begin window=$window_id width=$width"
    reconcile_sidebar_window "$window_id"
    existing_pane="$(sidebar_window_pane "$window_id" || true)"
    if [ -n "$existing_pane" ]; then
        pane_state="$(tmux display-message -p -t "$existing_pane" '#{pane_dead}|#{pane_current_path}' 2>/dev/null || true)"
        pane_dead="${pane_state%%|*}"
        if [ "$pane_dead" = 1 ]; then
            pane_path="${pane_state#*|}"
            [ -n "$pane_path" ] || pane_path="$REPO_ROOT"
            tmux set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
            trace_event "sidebar.lifecycle.respawn.begin window=$window_id pane=$existing_pane path=$pane_path"
            if tmux respawn-pane -k -t "$existing_pane" -c "$pane_path" "$SCRIPT_PATH --sidebar" 2>/dev/null; then
                tmux set-option -p -q -t "$existing_pane" remain-on-exit on 2>/dev/null || true
                tmux select-pane -t "$existing_pane" -T "$SIDEBAR_TITLE" 2>/dev/null || true
                trace_event "sidebar.lifecycle.respawn.end window=$window_id pane=$existing_pane result=ok"
            else
                trace_event "sidebar.lifecycle.respawn.end window=$window_id pane=$existing_pane result=failed"
                return 1
            fi
        fi
        tmux set-option -p -q -t "$existing_pane" remain-on-exit on 2>/dev/null || true
        tmux set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" "$existing_pane" 2>/dev/null || true
        enforce_sidebar_width "$existing_pane" "$width" || true
        trace_event "sidebar.provision.end window=$window_id pane=$existing_pane result=existing"
        return 0
    fi
    work_pane="$(sidebar_tmux_any_work_pane "$window_id" || true)"
    [ -n "$work_pane" ] || {
        trace_event "sidebar.window.provision.abort window=$window_id reason=no-work-pane"
        return 1
    }
    pane_path="$(target_pane_path "$work_pane")"
    tmux set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
    trace_event "sidebar.window.provision.begin window=$window_id width=$width"
    set_sidebar_layout_hook_guard 1000
    pane_id="$(tmux split-window -P -F '#{pane_id}' -d -t "$work_pane" -h -f -b -l "$width" \
        -c "$pane_path" "$SCRIPT_PATH --sidebar" 2>/dev/null || true)"
    if [ -z "$pane_id" ]; then
        trace_event "sidebar.window.provision.abort window=$window_id reason=split"
        return 1
    fi
    tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE" 2>/dev/null || true
    # Keep the lifecycle container when the sidebar process exits so recovery
    # can respawn the same pane instead of creating a new identity.
    tmux set-option -p -q -t "$pane_id" remain-on-exit on 2>/dev/null || true
    # Keep the target window ready for immediate client switch and keyboard
    # input. This is provisioning-time focus, never a session-switch mutation.
    tmux select-pane -t "$pane_id" 2>/dev/null || true
    # after-new-session/after-new-window hooks can race an explicit provision.
    # Reconcile once after the title is visible so concurrent creators converge
    # on one canonical pane instead of leaving two titled sidebar panes.
    reconcile_sidebar_window "$window_id"
    existing_pane="$(sidebar_window_pane "$window_id" || true)"
    if [ -n "$existing_pane" ] && [ "$existing_pane" != "$pane_id" ]; then
        trace_event "sidebar.window.provision.raced window=$window_id created=$pane_id canonical=$existing_pane"
        return 0
    fi
    tmux set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" "$pane_id" 2>/dev/null || true
    trace_event "sidebar.window.provision.end window=$window_id pane=$pane_id"
    trace_event "sidebar.provision.end window=$window_id pane=$pane_id result=created"
    return 0
}



remove_sidebar_window()
{
    local window_id="$1" pane_id
    if [ -n "$window_id" ]; then
        local win_clean="${window_id//[^a-zA-Z0-9_]/_}"
        printf -v "_cache_window_ready_${win_clean}" '0'
        printf -v "_cache_window_pane_${win_clean}" ''
    fi
    pane_id="$(sidebar_window_pane "$window_id" || true)"
    [ -n "$pane_id" ] || return 0
    trace_event "sidebar.window.remove.begin window=$window_id pane=$pane_id"
    sidebar_tmux_cmd set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
    sidebar_tmux_cmd kill-pane -t "$pane_id" 2>/dev/null || tmux kill-pane -t "$pane_id" 2>/dev/null || return 1
    sidebar_tmux_cmd set-option -wq -t "$window_id" "$SIDEBAR_WINDOW_PANE_OPTION" "" 2>/dev/null || true
    trace_event "sidebar.window.remove.end window=$window_id"
}

wait_for_sidebar_window_ready()
{
    local window_id="$1" attempt
    # Provisioning is a cold path. Its readiness budget is intentionally
    # separate from the native session-switch budget; normal switch never
    # calls this function.
    for attempt in $(seq 1 500); do
        sidebar_window_ready "$window_id" && return 0
        sleep 0.01
    done
    trace_event "sidebar.window.ready.timeout window=$window_id"
    return 1
}

ensure_target_sidebar_window()
{
    local session_name_value="$1" window_id="$2" width="${3:-$(sidebar_width)}"
    local pane_id pane_state pane_dead pane_pid ready
    [ -n "$session_name_value" ] && [ -n "$window_id" ] || return 1
    mark_session_managed "$session_name_value" || return 1

    local win_clean="${window_id//[^a-zA-Z0-9_]/_}"
    local cache_ready_var="_cache_window_ready_${win_clean}"
    local cache_pane_var="_cache_window_pane_${win_clean}"
    if [ "${!cache_ready_var:-}" = 1 ] && [ -n "${!cache_pane_var:-}" ]; then
        pane_id="${!cache_pane_var}"
        trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id pane=$pane_id result=ready-fast"
        printf '%s\n' "$pane_id"
        return 0
    fi

    pane_id="$(sidebar_window_pane "$window_id" || true)"
    if [ -n "$pane_id" ]; then
        # Existing target panes are already behind the cold provisioning
        # barrier. Validate their stable identity with two direct lookups and
        # avoid repeating the list/capture based readiness probe on every
        # native switch.
        ready="$(sidebar_tmux_cmd show-option -wqv -t "$window_id" "$SIDEBAR_WINDOW_READY_OPTION" 2>/dev/null || true)"
        pane_state="$(sidebar_tmux_cmd display-message -p -t "$pane_id" '#{pane_dead}|#{pane_pid}' 2>/dev/null || true)"
        pane_dead="${pane_state%%|*}"
        pane_pid="${pane_state#*|}"
        if [ "$ready" = 1 ] && [ "$pane_dead" = 0 ] && [ -n "$pane_pid" ]; then
            local curr_width
            curr_width="$(sidebar_tmux_cmd display-message -p -t "$pane_id" '#{pane_width}' 2>/dev/null || true)"
            if [ -n "$curr_width" ] && [ "$curr_width" != "$width" ]; then
                sidebar_tmux_cmd resize-pane -t "$pane_id" -x "$width" 2>/dev/null || true
            fi
            printf -v "$cache_ready_var" '1'
            printf -v "$cache_pane_var" '%s' "$pane_id"
            trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id pane=$pane_id pid=$pane_pid result=ready-fast"
            printf '%s\n' "$pane_id"
            return 0
        fi
        # A new session hook can publish the pane metadata before the sidebar
        # process has installed its readiness option. Do not treat that short
        # cold-start interval as a missing target; wait within the existing
        # bounded provisioning budget and verify the pane again below.
        trace_event "sidebar.target.ensure.wait session=$session_name_value window=$window_id pane=$pane_id ready=${ready:-none} dead=${pane_dead:-none} pid=${pane_pid:-none}"
        wait_for_sidebar_window_ready "$window_id" || {
            printf -v "$cache_ready_var" '0'
            printf -v "$cache_pane_var" ''
            trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id pane=$pane_id result=not-ready-existing"
            return 1
        }
    fi
    if [ -z "$pane_id" ]; then
        trace_event "sidebar.target.ensure.begin session=$session_name_value window=$window_id width=$width"
        provision_sidebar_window "$window_id" "$width" || {
            printf -v "$cache_ready_var" '0'
            printf -v "$cache_pane_var" ''
            trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id result=provision-failed"
            return 1
        }
        wait_for_sidebar_window_ready "$window_id" || {
            printf -v "$cache_ready_var" '0'
            printf -v "$cache_pane_var" ''
            trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id result=not-ready"
            return 1
        }
    fi
    pane_id="$(sidebar_window_pane "$window_id" || true)"
    sidebar_window_ready "$window_id" || {
        printf -v "$cache_ready_var" '0'
        printf -v "$cache_pane_var" ''
        trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id pane=${pane_id:-none} result=verify-failed"
        return 1
    }
    printf -v "$cache_ready_var" '1'
    printf -v "$cache_pane_var" '%s' "$pane_id"
    trace_event "sidebar.target.ensure.end session=$session_name_value window=$window_id pane=$pane_id result=ready"
    printf '%s\n' "$pane_id"
}

provision_managed_sidebars()
{
    local width="${1:-$(sidebar_width)}" session_name_value window_id
    local found=0
    set_sidebar_enabled 1
    while IFS= read -r session_name_value; do
        [ -n "$session_name_value" ] || continue
        found=1
        while IFS= read -r window_id; do
            [ -n "$window_id" ] || continue
            provision_sidebar_window "$window_id" "$width" || return 1
            wait_for_sidebar_window_ready "$window_id" || return 1
        done < <(sidebar_tmux_cmd list-windows -t "=$session_name_value:" -F '#{window_id}' 2>/dev/null || true)
    done < <(managed_session_names)
    if [ "$found" -eq 0 ]; then
        session_name_value="$(tmux display-message -p '#S' 2>/dev/null || true)"
        if [ -n "$session_name_value" ]; then
            mark_session_managed "$session_name_value" || true
            while IFS= read -r window_id; do
                [ -n "$window_id" ] || continue
                provision_sidebar_window "$window_id" "$width" || return 1
                wait_for_sidebar_window_ready "$window_id" || return 1
            done < <(sidebar_tmux_cmd list-windows -t "=$session_name_value:" -F '#{window_id}' 2>/dev/null || true)
        fi
    fi
    set_sidebar_enabled 1
    return 0
}

remove_managed_sidebars()
{
    local window_id
    set_sidebar_enabled 0
    while IFS= read -r window_id; do
        [ -n "$window_id" ] || continue
        remove_sidebar_window "$window_id" || return 1
    done < <(sidebar_window_ids)
    set_sidebar_enabled 0
}

open_sidebar()
{
    target="${1:-}"
    refresh="${2:-false}"
    width="${3:-$(sidebar_width)}"
    pane_path="${4:-}"
    preserve_layout="${5:-false}"
    install_sidebar_hooks
    claim_sidebar_owner
    if [ -z "$target" ]; then
        mark_session_managed "$(tmux display-message -p '#S' 2>/dev/null || true)" || true
    fi
    global_existing_pane="$(find_sidebar_pane "${target:-}")"
    if [ -n "$global_existing_pane" ]; then
        if [ -n "$target" ]; then
            target_session_name="$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || true)"
            [ -n "$target_session_name" ] || return 1
            target_window="$(window_target "$target" || true)"
            provision_sidebar_window "$target_window" "$width" || return 1
            wait_for_sidebar_window_ready "$target_window" || return 1
        else
            target_window="$(active_client_window || true)"
            provision_sidebar_window "$target_window" "$width" || return 1
            wait_for_sidebar_window_ready "$target_window" || return 1
            existing_pane="$(sidebar_window_pane "$target_window" || true)"
            owner_client="$(sidebar_owner_client 2>/dev/null || true)"
            if [ -n "$owner_client" ]; then
                tmux select-pane -t "$existing_pane" -c "$owner_client" 2>/dev/null || true
            else
                tmux select-pane -t "$existing_pane" 2>/dev/null || true
            fi
            save_sidebar_layout "$target_window" || true
        fi
        install_sidebar_hooks
        return 0
    fi
    trace_event "sidebar.open.begin target=${target:-current} refresh=$refresh width=$width preserve_layout=$preserve_layout"
    trace_event "sidebar.existing-lookup.begin target=${target:-current}"
    existing_pane="$(find_sidebar_pane "$target")"
    trace_event "sidebar.existing-lookup.end target=${target:-current} pane=${existing_pane:-none}"

    if [ -n "$existing_pane" ]; then
        trace_event "sidebar.existing-resize.begin pane=$existing_pane"
        tmux resize-pane -t "$existing_pane" -x "$width" 2>/dev/null || true
        trace_event "sidebar.existing-resize.end pane=$existing_pane"
        if [ "$refresh" = "true" ]; then
            trace_event "sidebar.existing-respawn.begin pane=$existing_pane"
            tmux respawn-pane -k -t "$existing_pane" "$SCRIPT_PATH --sidebar"
            tmux select-pane -t "$existing_pane" -T "$SIDEBAR_TITLE"
            trace_event "sidebar.existing-respawn.end pane=$existing_pane"
        fi
        tmux select-pane -t "$existing_pane"
        save_sidebar_layout "$(window_target "$existing_pane")" || true
        trace_event "sidebar.open.end target=${target:-current} mode=existing pane=$existing_pane"
        install_sidebar_hooks
        return 0
    fi

    if [ "$preserve_layout" != "true" ]; then
        trace_event "sidebar.layout-save.begin target=${target:-current}"
        save_work_layout "$target"
        trace_event "sidebar.layout-save.end target=${target:-current}"
    fi

    trace_event "sidebar.window-lookup.begin target=${target:-current}"
    target_window="$(window_target "$target")"
    trace_event "sidebar.window-lookup.end target=${target:-current} window=${target_window:-none}"
    before_panes="$(list_window_panes "$target_window")"
    set_sidebar_enabled 1
    mark_session_managed "$(sidebar_tmux_cmd display-message -p '#S' 2>/dev/null || true)" || true
    # Existing layout hooks may still be installed while a new sidebar pane
    # is starting. Keep those hooks from snapshotting a half-initialized TUI.
    tmux set-option -gq "$SIDEBAR_INPUT_READY_OPTION" 0 2>/dev/null || true
    set_sidebar_layout_hook_guard 1000

    if [ -n "$target" ]; then
        [ -n "$pane_path" ] || pane_path="$(target_pane_path "$target")"
        trace_event "sidebar.split.begin target=$target window=${target_window:-none}"
        tmux split-window -t "$target" -h -f -b -l "$width" \
            -c "$pane_path" "$SCRIPT_PATH --sidebar"
        trace_event "sidebar.split.end target=$target window=${target_window:-none}"
    else
        [ -n "$pane_path" ] || pane_path="$current_path"
        trace_event "sidebar.split.begin target=current window=${target_window:-none}"
        tmux split-window -h -f -b -l "$width" \
            -c "$pane_path" "$SCRIPT_PATH --sidebar"
        trace_event "sidebar.split.end target=current window=${target_window:-none}"
    fi

    trace_event "sidebar.new-pane-lookup.begin target=${target:-current}"
    pane_id="$(new_pane_from_snapshot "$before_panes" "$target_window")"
    trace_event "sidebar.new-pane-lookup.end target=${target:-current} pane=${pane_id:-none}"
    if [ -n "$pane_id" ]; then
        tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE"
        tmux select-pane -t "$pane_id"
        save_sidebar_layout "$target_window" || true
    fi
    install_sidebar_hooks
    trace_event "sidebar.open.end target=${target:-current} mode=created pane=${pane_id:-none}"
}

ensure_session_sidebar()
{
    session_name="$1"
    refresh="${2:-false}"
    preserve_layout="${4:-false}"
    ensure_session_sidebar_cache_hit=false
    if [ "$refresh" != "true" ] && [ "${topology_cache_initialized:-false}" = "true" ]; then
        if [ -n "$(cached_sidebar_pane_for_session "$session_name" || true)" ]; then
            ensure_session_sidebar_cache_hit=true
            return 0
        fi
    fi
    width="${3:-$(sidebar_width)}"
    ensure_sidebar_for_session "$session_name" "$width"
}

ensure_sidebar_for_session()
{
    local session_name_value="$1" window_id width="${2:-$(sidebar_width)}" defer_ready="${3:-false}" existing_pane
    [ -n "$session_name_value" ] || return 1
    mark_session_managed "$session_name_value" || return 1
    window_id="$(tmux list-windows -t "=$session_name_value:" -F '#{window_id}' 2>/dev/null | head -n 1)"
    [ -n "$window_id" ] || return 1
    provision_sidebar_window "$window_id" "$width" || return 1
    if [ "$defer_ready" != true ]; then
        wait_for_sidebar_window_ready "$window_id" || return 1
    fi
    set_sidebar_enabled 1
    # Other window-local sidebar processes have their own session snapshots.
    # Refresh them after a new managed session is provisioned so a later
    # keyboard selection sees the same list in every window. This is a
    # creation-time model update, not part of the native switch hot path.
    [ "$defer_ready" = true ] || signal_managed_sidebar_refresh
}

toggle_current_sidebar()
{
    local existing_count owner_client current_client
    owner_client="$(sidebar_owner_client)"
    if [ -n "$owner_client" ]; then
        current_client="$(current_client_tty || true)"
        if [ -n "$current_client" ] && [ "$current_client" != "$owner_client" ] && [ -n "${TMUX_USER_LIVE_CLIENT:-}" ] && [ "$current_client" != "$TMUX_USER_LIVE_CLIENT" ]; then
            trace_event "sidebar.toggle.skip reason=non-owner owner=$owner_client client=${current_client:-none}"
            return 0
        fi
    fi
    if sidebar_provisioning_active; then
        trace_event "sidebar.toggle.suppressed reason=provisioning"
        return 0
    fi

    existing_count="$(sidebar_tmux_sidebar_pane_count)"
    if [ "$existing_count" -gt 0 ]; then
        set_sidebar_enabled 0
        remove_managed_sidebars || {
            trace_event "sidebar.toggle.abort reason=remove-failed"
            return 1
        }
        trace_event "sidebar.toggle.end mode=off windows=$(sidebar_window_ids | wc -l | tr -d ' ')"
        return 0
    fi

    local current_session_name
    current_session_name="$(sidebar_tmux_cmd display-message -p '#S' 2>/dev/null || true)"
    mark_session_managed "$current_session_name" || true
    sidebar_tmux_cmd set-option -gq "$SIDEBAR_PROVISION_OPTION" 1 2>/dev/null || true
    if ! provision_managed_sidebars; then
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_PROVISION_OPTION" 0 2>/dev/null || true
        trace_event "sidebar.toggle.abort reason=provision-failed"
        return 1
    fi
    sidebar_tmux_cmd set-option -gq "$SIDEBAR_PROVISION_OPTION" 0 2>/dev/null || true
    trace_event "sidebar.toggle.end mode=on windows=$(sidebar_window_ids | wc -l | tr -d ' ')"
}

toggle_sidebar_for_session()
{
    local session_name_value="$1" window_id pane_id found=0
    [ -n "$session_name_value" ] || return 1
    while IFS= read -r window_id; do
        [ -n "$window_id" ] || continue
        pane_id="$(sidebar_window_pane "$window_id" || true)"
        [ -n "$pane_id" ] || continue
        found=1
        remove_sidebar_window "$window_id" || return 1
    done < <(tmux list-windows -t "=$session_name_value:" -F '#{window_id}' 2>/dev/null | sort -u)
    if [ "$found" -eq 0 ]; then
        ensure_sidebar_for_session "$session_name_value"
    elif [ "$(sidebar_tmux_sidebar_pane_count)" -eq 0 ]; then
        set_sidebar_enabled 0
    fi
}

toggle_sidebar_for_pane()
{
    local pane_id_value="$1"
    local pane_title_value target_window

    [ -n "$pane_id_value" ] || return 1
    pane_title_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_title}' 2>/dev/null || true)"
    if [ "$pane_title_value" = "$SIDEBAR_TITLE" ]; then
        remember_sidebar_width
        target_window="$(window_target "$pane_id_value")"
        tmux kill-pane -t "$pane_id_value"
        restore_work_layout "$target_window"
    else
        [ -z "$(find_global_sidebar_pane)" ] || return 0
        open_sidebar "$pane_id_value"
    fi
}

current_pane_is_sidebar()
{
    [ "$(tmux display-message -p '#{pane_title}')" = "$SIDEBAR_TITLE" ]
}

current_window_work_pane()
{
    target_window="${1:-$(window_target)}"
    pane_id="$(
        tmux list-panes -t "$target_window" -F '#{pane_id}	#{pane_title}	#{pane_active}' 2>/dev/null |
            awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 != title && $3 == 1 { print $1; exit }'
    )"
    if [ -n "$pane_id" ]; then
        printf '%s\n' "$pane_id"
        return 0
    fi

    tmux list-panes -t "$target_window" -F '#{pane_id}	#{pane_title}' 2>/dev/null |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 != title { print $1; exit }'
}

split_work_pane()
{
    direction="$1"
    work_path=""
    target_window=""
    target_work_pane=""
    before_panes=""
    new_pane_id=""

    if current_pane_is_sidebar; then
        target_work_pane="$(current_window_work_pane)"
        if [ -z "$target_work_pane" ]; then
            tmux display-message 'No work pane found for split.'
            return 0
        fi
        tmux select-pane -t "$target_work_pane" 2>/dev/null || true
    fi

    target_window="$(window_target)"
    if [ -n "$target_work_pane" ]; then
        work_path="$(target_pane_path "$target_work_pane")"
        target_window="$(window_target "$target_work_pane")"
    else
        work_path="$(target_pane_path)"
    fi

    before_panes="$(list_window_panes "$target_window")"

    case "$direction" in
        horizontal)
            if [ -n "$target_work_pane" ]; then
                tmux split-window -t "$target_work_pane" -h -c "$work_path"
            else
                tmux split-window -h -c "$work_path"
            fi
            ;;
        vertical)
            if [ -n "$target_work_pane" ]; then
                tmux split-window -t "$target_work_pane" -v -c "$work_path"
            else
                tmux split-window -v -c "$work_path"
            fi
            ;;
    esac

    new_pane_id="$(new_pane_from_snapshot "$before_panes" "$target_window")"
    [ -n "$new_pane_id" ] && tmux select-pane -t "$new_pane_id" 2>/dev/null || true
}



wait_for_sidebar_input_ready()
{
    local window_id="$1" pane_id="${2:-}" attempt ready
    for attempt in $(seq 1 100); do
        ready="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_INPUT_READY_OPTION" 2>/dev/null || true)"
        if [ "$ready" = 1 ] && sidebar_window_ready "$window_id" "$pane_id"; then
            trace_event "sidebar.input-ready.barrier window=$window_id pane=$pane_id attempts=$attempt result=ready"
            return 0
        fi
        sleep 0.002
    done
    trace_event "sidebar.input-ready.barrier window=$window_id pane=$pane_id attempts=100 result=timeout ready=${ready:-none}"
    return 1
}

sidebar_selection_sync_ack_ready()
{
    local window_id="$1" session_name_value="$2" ack
    ack="$(tmux show-option -wqv -t "$window_id" "$SIDEBAR_SELECTION_SYNC_ACK_OPTION" 2>/dev/null || true)"
    [ "$ack" = "$session_name_value" ]
}

sidebar_content_ready()
{
    local window_id="$1" session_name_value="$2" pane_id content
    pane_id="$(sidebar_window_pane "$window_id" || true)"
    [ -n "$pane_id" ] || return 1
    content="$(tmux capture-pane -p -J -t "$pane_id" 2>/dev/null || true)"
    printf '%s\n' "$content" | grep -Fxq 'sessions' || return 1
    printf '%s\n' "$content" | grep -Fq -- "$session_name_value" || return 1
    # The selection marker is the user-visible proof that the repaired pane
    # has rendered the target state, rather than merely starting a shell.
    printf '%s\n' "$content" |
        sed $'s/\033\[[0-9;]*m//g' |
        grep -Eq "(^>[*]?[[:space:]]+$session_name_value([[:space:]]|$)|^\*?[[:space:]]+$session_name_value([[:space:]]|$))"
}

wait_for_sidebar_content_ready()
{
    local window_id="$1" session_name_value="$2" attempt
    if sidebar_window_ready "$window_id" && sidebar_content_ready "$window_id" "$session_name_value"; then
        trace_event "sidebar.content-ready window=$window_id session=$session_name_value attempts=0 result=ready"
        return 0
    fi
    for attempt in $(seq 1 250); do
        if sidebar_window_ready "$window_id" &&
            (sidebar_content_ready "$window_id" "$session_name_value" ||
             sidebar_selection_sync_ack_ready "$window_id" "$session_name_value"); then
            trace_event "sidebar.content-ready window=$window_id session=$session_name_value attempts=$attempt result=ready"
            return 0
        fi
        sleep 0.002
    done
    trace_event "sidebar.content-ready window=$window_id session=$session_name_value attempts=250 result=timeout"
    return 1
}

signal_managed_sidebar_refresh()
{
    local window_id sidebar_pane sidebar_pid
    while IFS= read -r window_id; do
        [ -n "$window_id" ] || continue
        sidebar_pane="$(sidebar_window_pane "$window_id" || true)"
        # A just-split pane has not installed its USR2 trap yet. Signaling it
        # during that window would terminate the shell before the TUI reaches
        # readiness, leaving a silent pane and a false ensure failure.
        if ! sidebar_window_ready "$window_id"; then
            trace_event "sidebar.window.refresh.skip window=$window_id pane=${sidebar_pane:-none} reason=not-ready"
            continue
        fi
        sidebar_pid="$(tmux display-message -p -t "$sidebar_pane" '#{pane_pid}' 2>/dev/null || true)"
        if [ -n "$sidebar_pid" ] && kill -USR2 "$sidebar_pid" 2>/dev/null; then
            trace_event "sidebar.window.refresh.signal window=$window_id pane=$sidebar_pane pid=$sidebar_pid"
        else
            trace_event "sidebar.window.refresh.signal-failed window=$window_id pane=${sidebar_pane:-none} pid=${sidebar_pid:-none}"
        fi
    done < <(sidebar_window_ids)
}

signal_managed_sidebar_refresh_batch()
{
    local session_name_value pane_id pane_pid
    while IFS='|' read -r session_name_value pane_id pane_pid; do
        [ -n "$pane_id" ] || continue
        [ -n "$pane_pid" ] && kill -USR2 "$pane_pid" 2>/dev/null &&
            trace_event "sidebar.window.refresh.batch-signal session=$session_name_value pane=$pane_id pid=$pane_pid"
    done < <(sidebar_tmux_cmd list-panes -a -F '#{session_name}|#{pane_id}|#{pane_title}|#{pane_pid}|#{pane_dead}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$3 == title && $5 == 0 { print $1 "|" $2 "|" $4 }')
}

wait_for_managed_sidebar_session()
{
    local session_name_value="$1" target_window="${2:-}" window_id sidebar_pane attempt ready
    [ -n "$session_name_value" ] || return 0
    for attempt in $(seq 1 40); do
        ready=1
        while IFS= read -r window_id; do
            [ -n "$window_id" ] || continue
            [ -z "$target_window" ] || [ "$window_id" = "$target_window" ] || continue
            sidebar_pane="$(sidebar_window_pane "$window_id" || true)"
            if [ -z "$sidebar_pane" ] || ! tmux capture-pane -p -t "$sidebar_pane" 2>/dev/null |
                grep -F -q -- "$session_name_value"; then
                ready=0
                break
            fi
        done < <(sidebar_window_ids)
        [ "$ready" -eq 1 ] && return 0
        sleep 0.05
    done
    trace_event "sidebar.window.refresh.timeout session=$session_name_value"
    return 1
}

wait_for_managed_sidebar_snapshot()
{
    local attempt window_id sidebar_pane session_name_value content ready managed_sessions window_ids deadline_ms
    managed_sessions="$(managed_session_names)"
    window_ids="$(tmux list-panes -a -F '#{session_name}|#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$3 == title { print $1 "|" $2 }')"
    deadline_ms=$(( $(date +%s%N) / 1000000 + 15000 ))
    attempt=0
    while [ "$(( $(date +%s%N) / 1000000 ))" -lt "$deadline_ms" ]; do
        attempt=$((attempt + 1))
        ready=1
        while IFS='|' read -r session_name_value sidebar_pane; do
            session_is_managed "$session_name_value" || continue
            [ -n "$sidebar_pane" ] || continue
            content="$(tmux capture-pane -p -J -t "$sidebar_pane" 2>/dev/null || true)"
            if [ -z "$sidebar_pane" ] ||
                ! printf '%s\n' "$content" | grep -Fxq 'sessions' ||
                ! printf '%s\n' "$content" | grep -Eq '^>[*]?([[:space:]]|$)'; then
                ready=0
                break
            fi
            while IFS= read -r session_name_value; do
                [ -n "$session_name_value" ] || continue
                if ! printf '%s\n' "$content" | grep -Fq -- "$session_name_value"; then
                    ready=0
                    break
                fi
            done <<< "$managed_sessions"
            [ "$ready" -eq 1 ] || break
        done < <(sidebar_window_ids)
        if [ "$ready" -eq 1 ]; then
            trace_event "sidebar.managed-snapshot-ready attempts=$attempt result=ready"
            return 0
        fi
        sleep 0.05
    done
    trace_event "sidebar.managed-snapshot-ready attempts=$attempt result=timeout"
    return 1
}

switch_session()
{
    local session_name="$1" client_tty target_window source_window sidebar_pane sidebar_pid pane_window
    local target_layout_before target_layout_after
    local source_session="" operation_id metrics_start=""
    local client_switch_us=0 switch_metrics_start_us=0 switch_phase_start_us=0
    local selection_sync_ready=false selection_sync_ack="" sidebar_ready=""
    [ -n "$session_name" ] || return 0
    if ! session_exists "$session_name"; then
        collect_sessions 2>/dev/null || true
        render_full stale_session 2>/dev/null || true
        message_line "session switch failed: session '$session_name' does not exist"
        return 1
    fi
    pane_window="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{window_id}' 2>/dev/null || true)"
    # The TUI's cached current_session can lag behind a client/window hook.
    # Resolve the source from the pane that owns this process so a stale
    # observer cannot initiate a switch from the wrong session.
    source_session="$(tmux display-message -p -t "${TMUX_PANE:-}" '#S' 2>/dev/null || true)"
    [ -n "$source_session" ] || source_session="$current_session"
    trace_event "switch.source-context pane=${TMUX_PANE:-none} window=${pane_window:-none} source=$source_session cached=${current_session:-none} target=$session_name"
    client_tty="$(sidebar_tmux_client_tty_for_window "$pane_window" || true)"
    if [ -z "$client_tty" ]; then
        trace_event "switch.skip reason=sidebar-window-detached pane=${TMUX_PANE:-none} window=${pane_window:-none} source=$source_session target=$session_name"
        return 0
    fi
    target_window="$(sidebar_tmux_session_window "$session_name" || true)"
    source_window="$(sidebar_tmux_session_window "$source_session" || true)"
    if [ -z "$client_tty" ] || [ -z "$target_window" ]; then
        message_line "session switch failed: target session is not available"
        trace_event "switch.abort reason=target-session-missing session=$session_name window=${target_window:-none}"
        return 1
    fi
    [ "$source_session" = "$session_name" ] && return 0
    # Multiple window-local sidebar processes observe the same shared
    # selection transition. Only the first process may own the client switch;
    # a duplicate Enter must not start a second transaction that can race
    # sidebar provision/reconcile and invalidate target pane metadata.
    if transition_is_active; then
        trace_event "switch.skip reason=transition-active source=$source_session target=$session_name state=$(tmux show-option -gqv "$SIDEBAR_TRANSITION_OPTION" 2>/dev/null || true)"
        return 0
    fi
    new_sidebar_operation_id
    operation_id="$sidebar_operation_id_result"
    # Publish before target readiness work. A target sidebar can already have
    # a pending refresh from session creation; the marker lets it coalesce
    # that frame instead of flushing a full render before switch-client.
    tmux set-option -wq -t "$target_window" "$SIDEBAR_SELECTION_SYNC_ACK_OPTION" "" 2>/dev/null || true
    tmux set-option -wq -t "$target_window" "$SIDEBAR_SELECTION_SYNC_OPTION" "$session_name" 2>/dev/null || true
    trace_event "switch.target-sidebar.selection-sync-published session=$session_name window=$target_window value=$(tmux show-option -wqv -t "$target_window" "$SIDEBAR_SELECTION_SYNC_OPTION" 2>/dev/null || true)"
    if ! transition_context_begin "$operation_id" "$source_session" "$session_name" "$target_window"; then
        trace_event "switch.skip reason=transition-lock-busy source=$source_session target=$session_name"
        return 0
    fi
    if [ -n "$METRICS_FILE" ]; then
        switch_metrics_start_us="$(metrics_now_us)"
        transition_metrics_start_us="$switch_metrics_start_us"
        switch_phase_start_us="$switch_metrics_start_us"
        metrics_phase=action
        metrics_write "op=switch phase=begin operation_id=$operation_id source=$source_session target=$session_name"
    fi
    transition_phase_set VALIDATE_TARGET "$operation_id"
    trace_event "switch.begin mode=window-local source=$source_session target=$session_name window=$target_window client=$client_tty"
    if [ -n "$METRICS_FILE" ]; then
        metrics_switch_phase "$operation_id" validate "$switch_phase_start_us"
        switch_phase_start_us="$(metrics_now_us)"
    fi
    transition_phase_set ENSURE_TARGET_SIDEBAR "$operation_id"
    sidebar_pane="$(ensure_target_sidebar_window "$session_name" "$target_window" "$(sidebar_width)" || true)"
    if [ -z "$sidebar_pane" ]; then
        tmux set-option -wq -t "$target_window" "$SIDEBAR_SELECTION_SYNC_OPTION" "" 2>/dev/null || true
        transition_context_finish failed target-sidebar-unavailable "$operation_id"
        message_line "session switch failed: target sidebar is not ready"
        trace_event "switch.abort reason=target-sidebar-unavailable session=$session_name window=$target_window"
        return 1
    fi
    if [ -n "$METRICS_FILE" ]; then
        metrics_switch_phase "$operation_id" ensure-target-sidebar "$switch_phase_start_us"
        switch_phase_start_us="$(metrics_now_us)"
    fi
    transition_phase_set VERIFY_TARGET_SIDEBAR "$operation_id"
    IFS='|' read -r sidebar_pid target_layout_before <<< "$(tmux display-message -p -t "$sidebar_pane" '#{pane_pid}|#{window_layout}' 2>/dev/null || true)"
    trace_event "switch.target-layout.snapshot session=$session_name window=$target_window layout=${target_layout_before:-none}"
    trace_event "switch.target-sidebar.ready session=$session_name window=$target_window pane=$sidebar_pane pid=${sidebar_pid:-none}"
    # The target is detached until switch-client. Publishing the marker is
    # sufficient; signaling and waiting here can race the target read loop and
    # cause the pane to be recreated at the switch boundary. The post-switch
    # fallback signal/content barrier remains authoritative.
    trace_event "selection.sync.barrier session=$session_name window=$target_window pane=$sidebar_pane result=deferred-before-switch"
    transition_phase_set SWITCH_CLIENT "$operation_id"
    [ -n "$METRICS_FILE" ] && metrics_start="$(metrics_now_us)"
    if ! sidebar_tmux_switch_client "$client_tty" "$session_name" 2>/dev/null; then
        tmux set-option -wq -t "$target_window" "$SIDEBAR_SELECTION_SYNC_OPTION" "" 2>/dev/null || true
        transition_context_finish failed switch-client "$operation_id"
        message_line "session switch failed: client switch was refused"
        trace_event "switch.abort reason=client-switch-failed session=$session_name"
        return 1
    fi
    [ -n "$METRICS_FILE" ] && client_switch_us=$(( $(metrics_now_us) - metrics_start ))
    # A client-session-changed/after-select-window hook can race the final
    # switch boundary while tmux is reflowing a multi-pane target. A single
    # presence check can lose that race between the check and switch finish,
    # leaving the user on a target with no sidebar. Recheck a small bounded
    # number of times and repair only when the pane is absent; normal switches
    # still take the fast path without provisioning or sleeping.
    for repair_attempt in 1 2 3 4 5; do
        sidebar_pane="$(sidebar_window_pane "$target_window" || true)"
        if [ -n "$sidebar_pane" ] && sidebar_window_ready "$target_window"; then
            trace_event "switch.sidebar-repair.stable session=$session_name window=$target_window attempt=$repair_attempt pane=$sidebar_pane result=ready"
            break
        fi
        trace_event "switch.sidebar-repair.begin session=$session_name window=$target_window attempt=$repair_attempt reason=target-pane-absent"
        if provision_sidebar_window "$target_window" "$(sidebar_width)" &&
            wait_for_sidebar_window_ready "$target_window"; then
            sidebar_pane="$(sidebar_window_pane "$target_window" || true)"
            sidebar_pid="$(tmux display-message -p -t "$sidebar_pane" '#{pane_pid}' 2>/dev/null || true)"
            trace_event "switch.sidebar-repair.end session=$session_name window=$target_window attempt=$repair_attempt pane=$sidebar_pane result=ready"
            break
        fi
        trace_event "switch.sidebar-repair.end session=$session_name window=$target_window attempt=$repair_attempt result=failed"
        sleep 0.02
    done
    # tmux can report a different detached layout during switch-client even
    # though the target pane set is unchanged. Do not call select-layout here:
    # that re-enters after-select-layout/window-resized hooks while the native
    # transition is settling and can trigger a second full render or a sidebar
    # repair race. Archive/restore remains responsible for authoritative
    # topology application; native switching only records the observation.
    target_layout_after="$(tmux display-message -p -t "$target_window" '#{window_layout}' 2>/dev/null || true)"
    if [ -n "$target_layout_before" ] && [ -n "$target_layout_after" ] &&
        [ "$target_layout_before" != "$target_layout_after" ]; then
        debug_log "switch target-layout observation differs session=$session_name window=$target_window before=$target_layout_before after=$target_layout_after"
        trace_event "switch.target-layout.observe session=$session_name window=$target_window before=$target_layout_before after=$target_layout_after result=deferred-to-layout-owner"
    fi
    # A concurrent tmux layout hook can remove the target sidebar while the
    # detached window is being reconciled. Repair only this observed failure;
    # the normal path keeps the existing pane and does no extra provisioning.
    # Let after-select-layout/window-resized hooks settle before deciding that
    # the pane survived; tmux can publish the new layout before the pane map is
    # stable.
    for target_layout_stability_attempt in 1 2 3; do
        sidebar_pane="$(sidebar_window_pane "$target_window" || true)"
        [ -n "$sidebar_pane" ] && break
        sleep 0.05
    done
    if [ -z "$sidebar_pane" ]; then
        trace_event "switch.target-sidebar.repair-after-layout.begin session=$session_name window=$target_window"
        for target_layout_repair_attempt in 1 2 3; do
            provision_sidebar_window "$target_window" "$(sidebar_width)" || true
            wait_for_sidebar_window_ready "$target_window" || true
            sidebar_pane="$(sidebar_window_pane "$target_window" || true)"
            if [ -n "$sidebar_pane" ] && sidebar_window_ready "$target_window"; then
                break
            fi
            sleep 0.05
        done
        trace_event "switch.target-sidebar.repair-after-layout.end session=$session_name window=$target_window attempt=${target_layout_repair_attempt:-0} pane=${sidebar_pane:-none} result=$([ -n "$sidebar_pane" ] && printf ready || printf failed)"
    fi
    # Window-local sidebars must remain provisioned in managed source windows
    # as well as in the target. A client switch can expose a narrow hook/pane
    # teardown race where the source sidebar disappears while the target is
    # made ready. Repair only the absent source pane; an existing source pane
    # stays on the zero-cost path.
    if [ -n "$source_window" ] && [ "$source_window" != "$target_window" ] &&
        session_is_managed "$source_session" &&
        [ -z "$(sidebar_window_pane "$source_window" || true)" ]; then
        trace_event "switch.source-sidebar.repair.begin session=$source_session window=$source_window"
        source_repair_ready=false
        for source_repair_attempt in 1 2 3 4 5; do
            source_sidebar_pane="$(sidebar_window_pane "$source_window" || true)"
            if [ -z "$source_sidebar_pane" ]; then
                provision_sidebar_window "$source_window" "$(sidebar_width)" || true
                wait_for_sidebar_window_ready "$source_window" || true
                source_sidebar_pane="$(sidebar_window_pane "$source_window" || true)"
            fi
            if [ -n "$source_sidebar_pane" ] && sidebar_window_ready "$source_window"; then
                source_repair_ready=true
                break
            fi
            sleep 0.05
        done
        trace_event "switch.source-sidebar.repair.end session=$source_session window=$source_window pane=${source_sidebar_pane:-none} result=$([ "$source_repair_ready" = true ] && printf ready || printf failed)"
    fi
    # tmux may reflow a detached target to its smaller cached width during
    # switch-client. Re-assert the canonical width after the client is on the
    # target so subsequent switches do not inherit the reflowed width.
    enforce_sidebar_width "$sidebar_pane" "$(sidebar_width)" ||
        trace_event "switch.sidebar-width-unresolved session=$session_name pane=$sidebar_pane"
    # A target window can retain its previous work-pane focus across
    # switch-client. The selection loop remains in the sidebar after a
    # successful session switch, so make that input boundary explicit.
    if [ -n "$sidebar_pane" ]; then
        tmux select-pane -t "$sidebar_pane" >/dev/null 2>&1 || {
            transition_context_finish failed sidebar-focus "$operation_id"
            sidebar_operation_set idle "$operation_id"
            trace_event "switch.abort reason=sidebar-focus-failed session=$session_name window=$target_window pane=$sidebar_pane"
            return 1
        }
        trace_event "switch.sidebar-focus session=$session_name window=$target_window pane=$sidebar_pane"
    fi
    if ! wait_for_sidebar_input_ready "$target_window" "$sidebar_pane"; then
        transition_context_finish failed sidebar-input-unready "$operation_id"
        sidebar_operation_set idle "$operation_id"
        message_line "session switch failed: sidebar input is not ready"
        trace_event "switch.abort reason=sidebar-input-unready session=$session_name window=$target_window pane=${sidebar_pane:-none}"
        return 1
    fi
    if [ -n "$METRICS_FILE" ]; then
        metrics_switch_phase "$operation_id" switch-client "$switch_phase_start_us"
        switch_phase_start_us="$(metrics_now_us)"
    fi
    current_session="$session_name"
    selected_session="$session_name"
    transition_phase_set VERIFY_CLIENT "$operation_id"
    # The target marker is normally synchronized before switch-client. Keep a
    # post-switch signal only for the timeout fallback, where the target loop
    # may still need one more refresh cycle to converge.
    IFS='|' read -r sidebar_ready selection_sync_ack <<< "$(tmux display-message -p -t "$target_window" "#{$SIDEBAR_WINDOW_READY_OPTION}|#{$SIDEBAR_SELECTION_SYNC_ACK_OPTION}" 2>/dev/null || true)"
    if [ "$sidebar_ready" = 1 ] && [ "$selection_sync_ack" = "$session_name" ]; then
        trace_event "switch.target-sidebar.selection-sync-complete session=$session_name pane=$sidebar_pane pid=${sidebar_pid:-none}"
    else
        if sidebar_content_ready "$target_window" "$session_name"; then
            trace_event "switch.target-sidebar.selection-sync-content-ready session=$session_name window=$target_window pane=$sidebar_pane ack=${selection_sync_ack:-none} result=signal-skipped"
        elif [ "$selection_sync_ready" != true ] || [ "$selection_sync_ack" != "$session_name" ]; then
            signal_sidebar_refresh "$session_name" "$sidebar_pane" "$sidebar_pid"
            trace_event "switch.target-sidebar.selection-sync-fallback session=$session_name pane=$sidebar_pane pid=${sidebar_pid:-none} ack=${selection_sync_ack:-pending} result=deferred-handler"
        else
            trace_event "switch.target-sidebar.selection-sync-complete session=$session_name pane=$sidebar_pane pid=${sidebar_pid:-none}"
        fi
        if ! wait_for_sidebar_content_ready "$target_window" "$session_name"; then
            transition_context_finish failed sidebar-content-unready "$operation_id"
            sidebar_operation_set idle "$operation_id"
            message_line "session switch failed: sidebar content is not ready"
            trace_event "switch.abort reason=sidebar-content-unready session=$session_name window=$target_window pane=${sidebar_pane:-none}"
            return 1
        fi
    fi
    [ -n "$METRICS_FILE" ] && metrics_write "op=switch phase=dispatch operation_id=$operation_id session=$session_name client_switch_us=$client_switch_us elapsed_us=$(( $(metrics_now_us) - switch_metrics_start_us ))"
    transition_phase_set STABILIZE "$operation_id"
    transition_context_finish success window-local-ready "$operation_id"
    sidebar_operation_set idle "$operation_id"
    trace_event "switch.end mode=window-local session=$session_name pane=$sidebar_pane client=$client_tty result=ready"
    # Diagnostic capture must not extend the user-visible transition boundary.
    # The transaction is complete once switch.end is emitted; record the
    # resulting client state asynchronously from the user's perspective.
    trace_client_state "after-client-switch" "$client_tty"
}

is_shell_command()
{
    case "$1" in
        sh|bash|dash|zsh|fish|ksh|mksh|tmux-session-launcher) return 0 ;;
        *) return 1 ;;
    esac
}

is_passive_command()
{
    case "$1" in
        sh|bash|dash|zsh|fish|ksh|mksh|tmux-session-launcher|top|btop|htop|watch) return 0 ;;
        *) return 1 ;;
    esac
}

session_has_shell_pane()
{
    local session_name_value="$1" pane_id_value pane_command_value
    while IFS= read -r pane_id_value; do
        [ -n "$pane_id_value" ] || continue
        pane_command_value="${cached_pane_command[$pane_id_value]:-}"
        if is_shell_command "$pane_command_value"; then
            return 0
        fi
    done <<EOF
${session_ai_probe_pane_ids[$session_name_value]:-}
EOF
    return 1
}

session_has_shell_child_ai_process()
{
    local session_name_value="$1"
    local probe_pane_id probe_command

    while IFS= read -r probe_pane_id; do
        [ -n "$probe_pane_id" ] || continue
        probe_command="${cached_pane_command[$probe_pane_id]:-}"
        is_shell_command "$probe_command" || continue
        if pane_has_ai_cli_process "$probe_pane_id"; then
            return 0
        fi
    done <<EOF
${session_ai_probe_pane_ids[$session_name_value]:-}
EOF
    return 1
}

is_ai_cli_command()
{
    case "$1" in
        codex|claude|gemini|opencode|ollama|agy) return 0 ;;
        *) return 1 ;;
    esac
}

pane_has_ai_cli_process()
{
    local pane_id_value="$1"
    local pane_pid_value="${cached_pane_pid[$pane_id_value]:-}"
    local proc_index=0 proc_current="" proc_child="" proc_children="" proc_args="" proc_seen=0
    local procfs_tree_available=false
    local -a proc_queue=()
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    if [ -z "$pane_pid_value" ]; then
        pane_pid_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    fi
    if [ -z "$pane_pid_value" ]; then
        if [ "$timing_enabled" = "1" ]; then
            timing_end="$(debug_now_us)"
            debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start ))"
        fi
        return 1
    fi

    proc_args=""
    if [ -r "/proc/$pane_pid_value/cmdline" ]; then
        while IFS= read -r -d '' proc_child || [ -n "$proc_child" ]; do
            proc_args+=" $proc_child"
        done < "/proc/$pane_pid_value/cmdline"
    fi
    case "$proc_args" in
        *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*) return 0 ;;
    esac

    # Walk /proc children directly, preserving recursive pgrep behavior
    # without spawning pgrep/grep for every selected shell.
    if [ -r "/proc/$pane_pid_value/task/$pane_pid_value/children" ]; then
        procfs_tree_available=true
        proc_children="$(< "/proc/$pane_pid_value/task/$pane_pid_value/children")"
    fi
    for proc_child in $proc_children; do
        proc_queue+=("$proc_child")
    done
    while [ "$proc_index" -lt "${#proc_queue[@]}" ] && [ "$proc_seen" -lt 128 ]; do
        proc_current="${proc_queue[$proc_index]}"
        proc_index=$((proc_index + 1))
        proc_seen=$((proc_seen + 1))
        proc_args=""
        if [ -r "/proc/$proc_current/cmdline" ]; then
            while IFS= read -r -d '' proc_child || [ -n "$proc_child" ]; do
                proc_args+=" $proc_child"
            done < "/proc/$proc_current/cmdline"
        fi
        case "$proc_args" in
            *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*)
                if [ "$timing_enabled" = "1" ]; then
                    timing_end="$(debug_now_us)"
                    debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=hit us=$(( timing_end - timing_start ))"
                fi
                return 0
                ;;
        esac
        proc_children=""
        if [ -r "/proc/$proc_current/task/$proc_current/children" ]; then
            proc_children="$(< "/proc/$proc_current/task/$proc_current/children")"
        fi
        for proc_child in $proc_children; do
            proc_queue+=("$proc_child")
        done
    done

    # An empty procfs child list is a valid, complete miss: the shell simply
    # has no AI child. Do not fall through to tmux/pgrep in the normal Linux
    # path; those compatibility probes were previously executed after every
    # successful procfs traversal and dominated the state-refresh hot path.
    if [ "$procfs_tree_available" = true ]; then
        if [ "$timing_enabled" = "1" ]; then
            timing_end="$(debug_now_us)"
            debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start )) source=procfs"
        fi
        return 1
    fi

    # Some tmux/PTY combinations expose the pane process but not its child
    # list through procfs. Keep the old observer as a compatibility fallback;
    # normal cached procfs paths do not reach it.
    fallback_pane_pid="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    [ -n "$fallback_pane_pid" ] && pane_pid_value="$fallback_pane_pid"
    if pgrep -a -P "$pane_pid_value" 2>/dev/null |
        grep -Eq '(^|[[:space:]/])(codex|claude|gemini|opencode|ollama|agy)([[:space:]]|$)'; then
        return 0
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start ))"
    fi
    return 1
}

pane_ai_process_alive()
{
    local pane_id_value="$1"
    local pane_pid_value=""
    local proc_cmdline=""

    pane_pid_value="${cached_pane_pid[$pane_id_value]:-}"
    [ -n "$pane_pid_value" ] ||
        pane_pid_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    [ -n "$pane_pid_value" ] || return 0
    kill -0 "$pane_pid_value" 2>/dev/null || return 1

    if [ -r "/proc/$pane_pid_value/cmdline" ]; then
        IFS= read -r -d '' proc_cmdline < "/proc/$pane_pid_value/cmdline" || true
        case "$proc_cmdline" in
            *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*) return 0 ;;
        esac
        pane_has_ai_cli_process "$pane_id_value"
        return $?
    fi

    return 0
}

session_ai_pane_for_session()
{
    session_name="$1"

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title command_name; do
        [ "$pane_session" = "$session_name" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue
        if is_ai_cli_command "$command_name" || pane_has_ai_cli_process "$pane_id"; then
            printf '%s\n' "$pane_id"
            return 0
        fi
    done <<EOF
$(tmux list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}' 2>/dev/null)
EOF

    return 1
}

session_ai_fingerprint_for_pane()
{
    pane_id="$1"
    capture_text=""
    fingerprint=""
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    trace_event "ai.fingerprint.begin pane_id=$pane_id"

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    if [ -n "${TEST_CAPTURE+x}" ]; then
        capture_text="$(
            tmux capture-pane -p -t "$pane_id" -S -12 2>/dev/null |
                tr -d '\r' |
                sed -e 's/[[:space:]]*$//' |
                sed '/^[[:space:]]*$/d' |
                awk 'NR==1 { first = $0; prev = $0; next }
                     { print prev; prev = $0 }
                     END { if (NR == 1) print first }' |
                sed -E 's/spinner [0-9]+/spinner/g'
        )"
        fingerprint="$(printf '%s' "$capture_text" | cksum | awk '{ print $1 ":" $2 }')"
    else
        activity="${cached_pane_activity[$pane_id]:-}"
        if [ -z "$activity" ]; then
            activity="$(tmux display-message -p -t "$pane_id" '#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}' 2>/dev/null || printf '0')"
        fi
        fingerprint="act:$activity"
    fi

    if [ "$timing_enabled" = "1" ]; then
        if [ -n "$capture_text" ]; then
            capture_lines="$(printf '%s\n' "$capture_text" | awk 'END{print NR}')"
            capture_tail_preview="$(printf '%s\n' "$capture_text" | tail -n 3 | tr '\n' '|')"
        else
            capture_lines=0
            capture_tail_preview=""
        fi
        debug_log "fingerprint pane_id=$pane_id lines=$capture_lines fp=$fingerprint tail=${capture_tail_preview%|}"
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing session_ai_fingerprint_for_pane pane_id=$pane_id us=$(( timing_end - timing_start ))"
    fi

    trace_event "ai.fingerprint.end pane_id=$pane_id"

    printf '%s\n' "$fingerprint"
}

session_animation_seed_val()
{
    local key="$1"
    local seed=0
    local index char ascii

    for ((index = 0; index < ${#key}; index++)); do
        char="${key:index:1}"
        printf -v ascii '%d' "'$char"
        seed=$(( (seed * 33 + ascii) % 24 ))
    done
    session_animation_seed_result="$seed"
}

session_animation_seed_for()
{
    session_animation_seed_val "$1"
    printf '%d\n' "$session_animation_seed_result"
}


# Keep the adapter narrow: known AI CLI panes can animate while they are active,
# and non-AI work panes fall back to the existing busy/idle heuristic.
session_activity_age()
{
    session_name="$1"
    now="${current_epoch_second:-}"
    [ -n "$now" ] || now="$(epoch_now)"
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    activity="$(tmux display-message -p -t "=$session_name:" '#{session_activity}' 2>/dev/null || printf '0')"

    case "$activity" in
        ''|*[!0-9]*) activity=0 ;;
    esac

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing session_activity_age session=$session_name us=$(( timing_end - timing_start ))"
    fi

    printf '%s\n' "$((now - activity))"
}

session_cli_state_for_session()
{
    session_name="$1"
    probe_processes="${2:-false}"
    capture_fingerprint="${3:-true}"
    allow_shell_child_probe="${4:-false}"
    session_cli_state_result=""
    session_ai_fingerprint_result=""

    trace_event "ai.state.begin session=$session_name probe=$probe_processes fingerprint=$capture_fingerprint shell_child=$allow_shell_child_probe"

    pane_id="${session_ai_direct_pane_id[$session_name]:-}"

    if [ -n "$pane_id" ]; then
        direct_process_alive=true
        if [ "$probe_processes" = "true" ]; then
            pane_pid="$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || true)"
            if [ -n "$pane_pid" ] && ! pane_ai_process_alive "$pane_id"; then
                direct_process_alive=false
            fi
        fi
        if [ "$direct_process_alive" = "true" ] && [ "$capture_fingerprint" = "true" ]; then
            fingerprint="$(session_ai_fingerprint_for_pane "$pane_id")"
            if [ -n "$fingerprint" ]; then
                session_ai_fingerprint["$session_name"]="$fingerprint"
                session_cli_state_result="active"
                session_ai_fingerprint_result="$fingerprint"
                trace_event "ai.state.end session=$session_name result=active source=direct"
                return 0
            fi
        elif [ "$direct_process_alive" = "true" ]; then
            fingerprint="${cached_session_ai_fingerprint[$session_name]:-}"
            if [ -n "$fingerprint" ]; then
                session_ai_fingerprint_result="$fingerprint"
                session_cli_state_result="${cached_session_cli_state[$session_name]:-active}"
                trace_event "ai.state.end session=$session_name result=$session_cli_state_result source=cache"
                return 0
            fi
        else
            unset 'session_ai_direct_pane_id[$session_name]'
            session_ai_fingerprint["$session_name"]=""
        fi
    fi

    probe_ids="${session_ai_probe_pane_ids[$session_name]:-}"
    if [ "$probe_processes" = "true" ] && [ -n "$probe_ids" ]; then
        while IFS= read -r probe_pane_id; do
            [ -n "$probe_pane_id" ] || continue
            # A passive shell cannot reveal an AI child without an expensive
            # process-tree walk.  AI-named or otherwise non-passive panes are
            # already represented by the pane command and remain eligible.
            # For non-selected sessions, only an explicitly AI-named command
            # is worth probing; the selected session is the on-demand escape
            # hatch for shell-child AI detection.
            if [ "$allow_shell_child_probe" != true ] &&
                ! is_ai_cli_command "${cached_pane_command[$probe_pane_id]:-}"; then
                continue
            fi
            if is_passive_command "${cached_pane_command[$probe_pane_id]:-}" &&
                { [ "$allow_shell_child_probe" != true ] ||
                    ! is_shell_command "${cached_pane_command[$probe_pane_id]:-}"; } &&
                [ "$probe_pane_id" != "$pane_id" ]; then
                continue
            fi
            if pane_has_ai_cli_process "$probe_pane_id"; then
                fingerprint="$(session_ai_fingerprint_for_pane "$probe_pane_id")"
                if [ -n "$fingerprint" ]; then
                    session_ai_direct_pane_id["$session_name"]="$probe_pane_id"
                    session_ai_fingerprint["$session_name"]="$fingerprint"
                    session_cli_state_result="active"
                    session_ai_fingerprint_result="$fingerprint"
                    trace_event "ai.state.end session=$session_name result=active source=probe pane_id=$probe_pane_id"
                    return 0
                fi
            fi
        done <<EOF
$probe_ids
EOF
    fi

    if session_is_busy "$session_name"; then
        session_cli_state_result="active"
    else
        session_cli_state_result="idle"
    fi
    trace_event "ai.state.end session=$session_name result=$session_cli_state_result source=activity"
}

session_is_busy()
{
    session_name="$1"
    activity_age="${session_activity_age_cache[$session_name]:-}"

    [ -n "$activity_age" ] || activity_age="$(session_activity_age "$session_name")"
    [ "$activity_age" -le "$SIDEBAR_BUSY_SECONDS" ] || return 1
    [ "${session_has_busy_command[$session_name]:-false}" = "true" ] || return 1

    return 0
}

session_status()
{
    if session_is_busy "$1"; then
        printf '%s\n' busy
    else
        printf '%s\n' idle
    fi
}

format_duration()
{
    sidebar_domain_format_duration "$1"
}

session_age()
{
    created="$1"
    now="${EPOCHSECONDS:-$SECONDS}"

    case "$created" in
        ''|*[!0-9]*) created="$now" ;;
    esac

    format_duration "$((now - created))"
}

session_age_value()
{
    local created_value="$1"
    local now_value="${EPOCHSECONDS:-$SECONDS}"
    case "$created_value" in
        ''|*[!0-9]*) created_value="$now_value" ;;
    esac
    duration_elapsed=$((now_value - created_value))
    [ "$duration_elapsed" -lt 0 ] && duration_elapsed=0
    duration_days=$((duration_elapsed / 86400))
    duration_remain=$((duration_elapsed % 86400))
    duration_hours=$((duration_remain / 3600))
    duration_remain=$((duration_remain % 3600))
    duration_minutes=$((duration_remain / 60))
    duration_seconds=$((duration_remain % 60))
    printf -v session_age_result '%d:%02d:%02d:%02d' \
        "$duration_days" "$duration_hours" "$duration_minutes" "$duration_seconds"
}

pane_width()
{
    printf '%s\n' "${cached_pane_width:-35}"
}

pane_height()
{
    printf '%s\n' "${cached_pane_height:-20}"
}

update_pane_geometry()
{
    local width height
    if [ -n "$SELF_PANE" ]; then
        width="$(tmux display-message -p -t "$SELF_PANE" '#{pane_width}' 2>/dev/null || printf '35')"
        height="$(tmux display-message -p -t "$SELF_PANE" '#{pane_height}' 2>/dev/null || printf '20')"
    else
        width="$(tmux display-message -p '#{pane_width}' 2>/dev/null || printf '35')"
        height="$(tmux display-message -p '#{pane_height}' 2>/dev/null || printf '20')"
    fi
    case "$width" in ''|*[!0-9]*) width=35 ;; esac
    case "$height" in ''|*[!0-9]*) height=20 ;; esac
    cached_pane_width="$width"
    cached_pane_height="$height"
}

truncate_text()
{
    text="$1"
    max_width="$2"

    if [ "$max_width" -le 0 ]; then
        printf '%s\n' ''
    else
        printf '%.*s\n' "$max_width" "$text"
    fi
}

move_cursor()
{
    printf '\033[%s;%sH' "$1" "$2"
}

clear_line()
{
    printf '\033[2K'
}

hide_cursor()
{
    printf '\033[?25l'
}

show_cursor()
{
    printf '\033[?25h'
}

collect_sessions_fast_path_active()
{
    [ "${prompt_active:-false}" = "true" ] && return 0
    maintenance_cooldown_active && return 0
    [ "${post_operation_fast_read:-false}" = "true" ] && return 0
    sidebar_operation_busy && return 0
    IFS= read -rsn1 -t 0 key_pending 2>/dev/null && return 0
    return 1
}

collect_sessions()
{
    local force_scan="${1:-false}"
    local requested_scan_session="${2:-}"
    local fast_path_active=false
    if collect_sessions_fast_path_active; then
        fast_path_active=true
    fi
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"

    timing_start=""
    timing_end=""
    list_sessions_start=""
    list_panes_start=""
    parse_panes_start=""
    parse_sessions_start=""
    local metrics_start="" metrics_phase_start="" metrics_list_sessions_start="" metrics_parse_sessions_start=""
    local metrics_list_sessions_us=0 metrics_list_panes_us=0
    local metrics_parse_panes_us=0 metrics_parse_sessions_us=0
    local metrics_status_us=0 metrics_seed_us=0 metrics_ai_us=0
    local metrics_status_count=0 metrics_seed_count=0 metrics_ai_count=0
    local metrics_status_cache_hits=0 metrics_status_cache_misses=0
    local metrics_seed_cache_hits=0 metrics_seed_cache_misses=0
    local metrics_ai_cache_hits=0 metrics_ai_refreshes=0
    local metrics_scan_scope=cache metrics_operation_id="" metrics_pane_scan_scope=cache
    local incremental_pane_scan=false old_requested_panes_snapshot=""
    local previous_snapshot_signature="$snapshot_signature"
    local incoming_session_signature="" row_cache_reusable=false target_row_index=""
    if [ -n "$METRICS_FILE" ]; then
        metrics_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_operation_id="$metrics_operation_id_result"
        if [ "$force_scan" = true ] || [ "$topology_cache_initialized" != true ]; then
            metrics_scan_scope=full
        elif [ -n "$requested_scan_session" ]; then
            metrics_scan_scope=target-requested-full-row
        fi
    fi
    if [ "$topology_cache_initialized" = true ] &&
        [ "$force_scan" != true ] && [ -n "$requested_scan_session" ]; then
        incremental_pane_scan=true
        metrics_pane_scan_scope=target
        old_requested_panes_snapshot="${cached_session_panes_snapshot[$requested_scan_session]:-}"
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi
    trace_event "collect.sessions.begin force=$force_scan requested=${requested_scan_session:-none}"
    current_epoch_second="$(epoch_now)"
    full_render_required=false
    full_render_required_reason=""
    old_current_session="$current_session"
    current_session="$(sidebar_tmux_cmd display-message -p '#S' 2>/dev/null || true)"
    old_selected="$selected_session"
    debug_log "collect_sessions start force_scan=$force_scan current_session=$current_session old_selected=$old_selected"
    previous_session_animate=()
    for index in "${!session_names[@]}"; do
        previous_session_animate["${session_names[$index]}"]="${session_animate[$index]}"
    done
    declare -A previous_session_ai_direct_pane_id=()
    declare -A previous_pane_activity=()
    local s_name prev_pane_id curr_pane_id stable_count session_switch_occurred resize_occurred client_switch_occurred pane_generation_changed
    for s_name in "${!session_ai_direct_pane_id[@]}"; do
        previous_session_ai_direct_pane_id["$s_name"]="${session_ai_direct_pane_id[$s_name]}"
    done
    for pane_id in "${!cached_pane_activity[@]}"; do
        previous_pane_activity["$pane_id"]="${cached_pane_activity[$pane_id]}"
    done
    # Sample geometry once per snapshot; render and animation helpers use only
    # these cached values.
    update_pane_geometry
    local current_width="$cached_pane_width"
    local current_height="$cached_pane_height"
    local resize_occurred=false
    if [ -n "$old_pane_width" ] && [ -n "$old_pane_height" ]; then
        if [ "$current_width" != "$old_pane_width" ] || [ "$current_height" != "$old_pane_height" ]; then
            resize_occurred=true
        fi
    fi
    old_pane_width="$current_width"
    old_pane_height="$current_height"
    if [ "$resize_occurred" = "true" ]; then
        mark_full_render_required geometry-invalidated
    fi
    local client_sessions=""
    client_sessions="$(sidebar_tmux_cmd list-clients -F '#{client_control_mode}|#{client_session}' 2>/dev/null |
        awk -F '|' '$1 != 1 { print $2 }' || true)"
    local client_switch_occurred=false
    if [ -n "${old_client_sessions:-}" ] && [ "$client_sessions" != "$old_client_sessions" ]; then
        client_switch_occurred=true
    fi
    old_client_sessions="$client_sessions"
    if [ "$client_switch_occurred" = "true" ]; then
        mark_full_render_required client-switch-refresh
    fi
    local my_session
    my_session="$(sidebar_session_name || true)"
    if [ -n "$my_session" ]; then
        if [ "${sidebar_session_cached:-}" != "$my_session" ]; then
            sidebar_session_cached="$my_session"
            selected_session="$my_session"
            # Pane moves are also used by async history restore. Do not reset
            # the current TUI view on an owner change: the next physical key
            # must remain in history mode when the user is restoring archives.
            mark_full_render_required sidebar-session-change
        fi
    else
        my_session="${sidebar_session_cached:-}"
    fi
    [ -n "$my_session" ] ||
        my_session="$(sidebar_tmux_cmd display-message -p '#S' -t "${TMUX_PANE:-}" 2>/dev/null || true)"

    local client_session_is_my_session=false
    if [ -n "$my_session" ] && printf '%s\n' "$client_sessions" | grep -F -x -q "$my_session"; then
        client_session_is_my_session=true
    fi

    local is_my_session_attached=false
    if [ -n "$my_session" ] && printf '%s\n' "$client_sessions" | grep -F -x -q "$my_session"; then
        is_my_session_attached=true
    fi

    local session_switch_occurred=false
    if [ -n "${old_current_session:-}" ] && [ "$current_session" != "$old_current_session" ]; then
        session_switch_occurred=true
    fi

    if [ "$is_my_session_attached" = "true" ] && [ "${was_my_session_attached:-}" != "true" ]; then
        if [ -z "${selected_session:-}" ] || ! session_exists "$selected_session"; then
            selected_session="$my_session"
            old_selected="$my_session"
            trace_event "selection.refresh.reset reason=client-session-attached session=$my_session"
        else
            trace_event "selection.refresh.preserve reason=client-session-attached selected=$selected_session current=$my_session"
        fi
        mark_full_render_required client-session-attached
    fi
    if [ "$client_switch_occurred" = "true" ] && [ "$client_session_is_my_session" = "true" ]; then
        if [ -z "${selected_session:-}" ] || ! session_exists "$selected_session"; then
            selected_session="$my_session"
            old_selected="$my_session"
            trace_event "selection.refresh.reset reason=client-list-change session=$my_session"
        else
            trace_event "selection.refresh.preserve reason=client-list-change selected=$selected_session current=$my_session"
        fi
        mark_full_render_required client-session-switch
    fi
    was_my_session_attached="$is_my_session_attached"
    if [ "$timing_enabled" = "1" ]; then
        list_sessions_start="$(debug_now_us)"
    fi
    if [ -n "$metrics_start" ]; then
        metrics_list_sessions_start="$(metrics_now_us)"
    fi
    sessions_snapshot="$(sidebar_tmux_cmd list-sessions -F '#{session_name}	#{session_created}	#{session_activity}' 2>/dev/null || true)"
    while IFS="$(printf '\t')" read -r signature_name signature_created _signature_activity; do
        [ -n "$signature_name" ] || continue
        incoming_session_signature+="${signature_name}:${signature_created}|"
    done <<EOF
$sessions_snapshot
EOF
    if [ "$incremental_pane_scan" = true ] &&
        [ "$incoming_session_signature" = "$previous_snapshot_signature" ] &&
        [ -n "${cached_session_row_index[$requested_scan_session]:-}" ]; then
        row_cache_reusable=true
        local signature_check_name
        for signature_check_name in "${session_names[@]}"; do
            if [ -n "$signature_check_name" ] && [[ "$incoming_session_signature" != *"${signature_check_name}:"* ]]; then
                row_cache_reusable=false
                break
            fi
        done
        target_row_index="${cached_session_row_index[$requested_scan_session]:-}"
    fi
    if [ "$row_cache_reusable" = true ]; then
        session_topology_changed=false
        metrics_scan_scope=target-requested-target-row
        session_activity_age_cache=()
        session_animation_refresh_indexes=()
        snapshot_signature="$incoming_session_signature"
        found_selected=true
        index=0
    else
        session_topology_changed=true
        session_names=()
        session_created=()
        session_status=()
        session_cli_state=()
        session_animate=()
        session_animation_seed=()
        session_animation_refresh_indexes=()
        session_activity_age_cache=()
        session_has_busy_command=()
        cached_session_row_index=()
        snapshot_signature=""
        found_selected=false
        index=0
    fi
    if [ "$incremental_pane_scan" != true ]; then
        session_ai_probe_pane_ids=()
        session_ai_direct_pane_id=()
        cached_session_command_signature=()
    else
        unset "session_ai_probe_pane_ids[$requested_scan_session]"
        unset "session_ai_direct_pane_id[$requested_scan_session]"
        unset "cached_session_command_signature[$requested_scan_session]"
        unset "session_has_busy_command[$requested_scan_session]"
        while IFS="$(printf '\t')" read -r old_pane_session old_pane_id _old_title _old_command _old_activity _old_pid; do
            [ "$old_pane_session" = "$requested_scan_session" ] || continue
            unset "cached_pane_activity[$old_pane_id]"
            unset "cached_pane_pid[$old_pane_id]"
            unset "cached_pane_command[$old_pane_id]"
        done <<EOF
$old_requested_panes_snapshot
EOF
    fi
    trace_event "collect.list-sessions.end"
    if [ -n "$metrics_start" ]; then
        metrics_list_sessions_us=$(( $(metrics_now_us) - metrics_list_sessions_start ))
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions list-sessions us=$(( timing_end - list_sessions_start )) count=$(printf '%s\n' "$sessions_snapshot" | sed '/^$/d' | wc -l)"
        list_panes_start="$(debug_now_us)"
    fi
    if [ "$topology_cache_initialized" != "true" ] || [ "$force_scan" = "true" ]; then
        metrics_pane_scan_scope=all
        if [ -n "$metrics_start" ]; then
            metrics_phase_start="$(metrics_now_us)"
        fi
        trace_event "collect.list-panes.begin mode=all"
        cached_session_panes_snapshot=()
        panes_snapshot="$(sidebar_tmux_cmd list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}	#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}	#{pane_pid}' 2>/dev/null || true)"
        while IFS="$(printf '\t')" read -r pane_session pane_id pane_title pane_command pane_activity pane_pid; do
            [ -n "$pane_session" ] || continue
            if [ -n "${cached_session_panes_snapshot[$pane_session]:-}" ]; then
                cached_session_panes_snapshot["$pane_session"]+=$'\n'
            fi
            cached_session_panes_snapshot["$pane_session"]+="$pane_session"$'\t'"$pane_id"$'\t'"$pane_title"$'\t'"$pane_command"$'\t'"$pane_activity"$'\t'"$pane_pid"
        done <<EOF
$panes_snapshot
EOF
        topology_cache_initialized=true
        if [ -n "$metrics_phase_start" ]; then
            metrics_list_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
        fi
    elif [ -n "$requested_scan_session" ]; then
        metrics_pane_scan_scope=target
        if [ -n "$metrics_start" ]; then
            metrics_phase_start="$(metrics_now_us)"
        fi
        trace_event "collect.list-panes.begin mode=session session=$requested_scan_session"
        cached_session_panes_snapshot["$requested_scan_session"]="$(
            sidebar_tmux_cmd list-panes -t "=$requested_scan_session:" \
                -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}	#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}	#{pane_pid}' \
                2>/dev/null || true
        )"
        if [ -n "$metrics_phase_start" ]; then
            metrics_list_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
        fi
    fi
    trace_event "collect.list-panes.end mode=${requested_scan_session:+session}${requested_scan_session:-cache}"

    panes_snapshot=""
    for pane_session in "${!cached_session_panes_snapshot[@]}"; do
        [ -n "${cached_session_panes_snapshot[$pane_session]:-}" ] || continue
        [ -n "$panes_snapshot" ] && panes_snapshot+=$'\n'
        panes_snapshot+="${cached_session_panes_snapshot[$pane_session]}"
    done
    cached_panes_snapshot="$panes_snapshot"
    panes_to_parse="$panes_snapshot"
    if [ "$incremental_pane_scan" = true ]; then
        panes_to_parse="${cached_session_panes_snapshot[$requested_scan_session]:-}"
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions list-panes us=$(( timing_end - list_panes_start )) count=$(printf '%s\n' "$panes_snapshot" | sed '/^$/d' | wc -l)"
        parse_panes_start="$(debug_now_us)"
    fi
    trace_event "collect.parse-panes.begin"
    if [ -n "$metrics_start" ]; then
        metrics_phase_start="$(metrics_now_us)"
    fi

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title pane_command pane_activity pane_pid; do
        [ -n "$pane_session" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue

        cached_pane_activity["$pane_id"]="$pane_activity"
        cached_pane_pid["$pane_id"]="$pane_pid"
        cached_pane_command["$pane_id"]="$pane_command"
        cached_session_command_signature["$pane_session"]+="$pane_id:$pane_command|"

        if [ "${session_ai_probe_pane_ids[$pane_session]:-}" != "" ]; then
            session_ai_probe_pane_ids["$pane_session"]="${session_ai_probe_pane_ids[$pane_session]}
$pane_id"
        else
            session_ai_probe_pane_ids["$pane_session"]="$pane_id"
        fi

        if ! is_shell_command "$pane_command"; then
            session_has_busy_command["$pane_session"]="true"
        fi

        if is_ai_cli_command "$pane_command"; then
            session_ai_direct_pane_id["$pane_session"]="$pane_id"
        fi
    done <<EOF
$panes_to_parse
EOF
    if [ -n "$metrics_phase_start" ]; then
        metrics_parse_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions parse-panes us=$(( timing_end - parse_panes_start ))"
        parse_sessions_start="$(debug_now_us)"
    fi
    trace_event "collect.parse-panes.end"
    trace_event "collect.parse-sessions.begin"
    if [ -n "$metrics_start" ]; then
        metrics_parse_sessions_start="$(metrics_now_us)"
    fi

    while IFS="$(printf '\t')" read -r name created activity; do
        [ -n "$name" ] || continue
        if [ "$row_cache_reusable" = true ]; then
            [ "$name" = "$requested_scan_session" ] || continue
            index="$target_row_index"
        fi
        trace_event "collect.session.begin session=$name"
        case "$activity" in ''|*[!0-9]*) activity=0 ;; esac
        activity_age=$((current_epoch_second - activity))
        [ "$activity_age" -lt 0 ] && activity_age=0
        session_activity_age_cache["$name"]="$activity_age"
        pane_generation_changed=false
        if [ "${previous_session_ai_direct_pane_id[$name]:-}" != "${session_ai_direct_pane_id[$name]:-}" ]; then
            pane_generation_changed=true
        fi
        trace_event "collect.session.status.begin session=$name"
        status_cache_hit=false
        cached_status_age="${cached_session_status_activity_age[$name]:-}"
        cached_status_busy="${cached_session_status_busy_command[$name]:-false}"
        activity_boundary_changed=false
        if [ -n "$cached_status_age" ] && {
            { [ "$cached_status_age" -le "$SIDEBAR_BUSY_SECONDS" ] &&
                [ "$activity_age" -gt "$SIDEBAR_BUSY_SECONDS" ]; } ||
            { [ "$cached_status_age" -gt "$SIDEBAR_BUSY_SECONDS" ] &&
                [ "$activity_age" -le "$SIDEBAR_BUSY_SECONDS" ]; };
        }; then
            activity_boundary_changed=true
        fi
        if [ -n "${cached_session_status[$name]:-}" ] &&
            [ "${cached_session_status_created[$name]:-}" = "$created" ] &&
            [ "$cached_status_busy" = "${session_has_busy_command[$name]:-false}" ] &&
            [ "$force_scan" != true ] && [ "$name" != "$requested_scan_session" ] &&
            [ "$pane_generation_changed" != true ] &&
            [ "$activity_boundary_changed" != true ]; then
            status_value="${cached_session_status[$name]}"
            status_cache_hit=true
            cached_session_status_activity_age["$name"]="$activity_age"
        else
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            if [ "$activity_age" -le "$SIDEBAR_BUSY_SECONDS" ] && [ "${session_has_busy_command[$name]:-false}" = "true" ]; then
                status_value="busy"
            else
                status_value="idle"
            fi
            if [ -n "$metrics_start" ]; then
                metrics_status_us=$((metrics_status_us + $(metrics_now_us) - metrics_phase_start))
                metrics_status_cache_misses=$((metrics_status_cache_misses + 1))
            fi
            cached_session_status["$name"]="$status_value"
            cached_session_status_created["$name"]="$created"
            cached_session_status_activity_age["$name"]="$activity_age"
            cached_session_status_busy_command["$name"]="${session_has_busy_command[$name]:-false}"
        fi
        if [ -n "$metrics_start" ]; then
            metrics_status_count=$((metrics_status_count + 1))
            [ "$status_cache_hit" = true ] &&
                metrics_status_cache_hits=$((metrics_status_cache_hits + 1))
        fi
        trace_event "collect.session.status.end session=$name"
        cli_state_value=""
        ai_fingerprint_value=""
        previous_ai_fingerprint_value="${session_ai_fingerprint[$name]:-}"

        # Hot path에서는 캐시만 사용한다. 전체 강제 스캔은 명시적 이벤트에서만,
        # 특정 session 갱신은 입력 직후 해당 session에 대해서만 수행한다.
        if [ "$fast_path_active" != "true" ] && {
            [ "$force_scan" = "true" ] ||
            [ "$name" = "$requested_scan_session" ] ||
            [ "$pane_generation_changed" = "true" ] ||
            [ -z "${cached_session_cli_state[$name]:-}" ]; }; then
            if [ -n "$metrics_start" ]; then
                metrics_ai_refreshes=$((metrics_ai_refreshes + 1))
            fi
            probe_processes=false
            capture_fingerprint=true
            if [ "$force_scan" = "true" ] ||
                [ "$name" = "$requested_scan_session" ] ||
                [ -z "${cached_session_cli_state[$name]:-}" ]; then
                probe_processes=true
            fi
            direct_probe_pane="${session_ai_direct_pane_id[$name]:-}"
            if [ -n "$direct_probe_pane" ] &&
                [ -n "${cached_pane_activity[$direct_probe_pane]:-}" ] &&
                [ "${cached_pane_activity[$direct_probe_pane]}" = "${previous_pane_activity[$direct_probe_pane]:-}" ] &&
                [ "${cached_session_cli_state[$name]:-}" = "active" ] &&
                [ "${session_ai_stable_count[$name]:-0}" -lt 2 ] &&
                [ -n "${cached_session_cli_state[$name]:-}" ]; then
                capture_fingerprint=false
                probe_processes=false
            fi
            allow_shell_child_probe=false
            if [ "$name" = "$requested_scan_session" ]; then
                allow_shell_child_probe=true
            fi
            trace_event "collect.ai-probe.begin session=$name probe=$probe_processes fingerprint=$capture_fingerprint"
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            session_cli_state_for_session "$name" "$probe_processes" "$capture_fingerprint" "$allow_shell_child_probe"
            if [ -n "$metrics_start" ]; then
                metrics_ai_us=$((metrics_ai_us + $(metrics_now_us) - metrics_phase_start))
                metrics_ai_count=$((metrics_ai_count + 1))
            fi
            trace_event "collect.ai-probe.end session=$name"
            cached_session_cli_state["$name"]="$session_cli_state_result"
            cached_session_ai_fingerprint["$name"]="$session_ai_fingerprint_result"
        elif [ -n "$metrics_start" ]; then
            metrics_ai_cache_hits=$((metrics_ai_cache_hits + 1))
        fi

        if [ -z "${cached_session_cli_state[$name]:-}" ]; then
            if [ "${session_has_busy_command[$name]:-false}" = "true" ]; then
                cached_session_cli_state["$name"]="active"
            else
                cached_session_cli_state["$name"]="idle"
            fi
            cached_session_ai_fingerprint["$name"]=""
        fi

        cli_state_value="${cached_session_cli_state[$name]}"
        ai_fingerprint_value="${cached_session_ai_fingerprint[$name]:-}"
        ai_fingerprint_value="${ai_fingerprint_value%-focused}"
        ai_fingerprint_value="${ai_fingerprint_value%-focus}"

        local actual_fingerprint="$ai_fingerprint_value"
        if [ "$session_switch_occurred" = "true" ] || [ "$resize_occurred" = "true" ] || [ "$client_switch_occurred" = "true" ]; then
            ai_fingerprint_value="$previous_ai_fingerprint_value"
        fi

        prev_pane_id="${previous_session_ai_direct_pane_id[$name]:-}"
        curr_pane_id="${session_ai_direct_pane_id[$name]:-}"
        if [ "$prev_pane_id" != "$curr_pane_id" ]; then
            session_ai_fingerprint["$name"]=""
            session_ai_stable_count["$name"]=0
            previous_ai_fingerprint_value=""
        fi

        animate_value="false"
        if [ "$cli_state_value" = "active" ] && [ -n "$ai_fingerprint_value" ]; then
            if [ "$previous_ai_fingerprint_value" = "$ai_fingerprint_value" ]; then
                stable_count=$(( ${session_ai_stable_count[$name]:-0} + 1 ))
                session_ai_stable_count["$name"]="$stable_count"
                if [ "$stable_count" -ge 2 ]; then
                    cli_state_value="waiting"
                else
                    animate_value="true"
                fi
            else
                session_ai_stable_count["$name"]=0
                animate_value="true"
            fi
        fi
        if [ "${TMUX_SESSION_LAUNCHER_DEBUG:-0}" = "1" ]; then
            debug_log "state session=$name prev_fp=$previous_ai_fingerprint_value fp=$ai_fingerprint_value state=$cli_state_value animate=$animate_value"
        fi
        trace_event "collect.session.animation-seed.begin session=$name"
        seed_cache_hit=false
        if [ "${cached_session_animation_seed[$name]:-}" != "" ] &&
            [ "${cached_session_animation_seed_created[$name]:-}" = "$created" ]; then
            animation_seed_value="${cached_session_animation_seed[$name]}"
            seed_cache_hit=true
        else
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            session_animation_seed_val "${name}:${created}"
            animation_seed_value="$session_animation_seed_result"
            if [ -n "$metrics_start" ]; then
                metrics_seed_us=$((metrics_seed_us + $(metrics_now_us) - metrics_phase_start))
                metrics_seed_cache_misses=$((metrics_seed_cache_misses + 1))
            fi
            cached_session_animation_seed["$name"]="$animation_seed_value"
            cached_session_animation_seed_created["$name"]="$created"
        fi
        if [ -n "$metrics_start" ]; then
            metrics_seed_count=$((metrics_seed_count + 1))
            [ "$seed_cache_hit" = true ] &&
                metrics_seed_cache_hits=$((metrics_seed_cache_hits + 1))
        fi
        trace_event "collect.session.animation-seed.end session=$name"

        if [ "$row_cache_reusable" = true ]; then
            session_created[$index]="$created"
            session_status[$index]="$status_value"
            session_cli_state[$index]="$cli_state_value"
            session_animation_seed[$index]="$animation_seed_value"
            session_animate[$index]="$animate_value"
        else
            session_names+=("$name")
            session_created+=("$created")
            session_status+=("$status_value")
            session_cli_state+=("$cli_state_value")
            session_animation_seed+=("$animation_seed_value")
            session_animate+=("$animate_value")
            cached_session_row_index["$name"]="$index"
        fi
        session_ai_fingerprint["$name"]="$actual_fingerprint"
        if [ "${previous_session_animate[$name]:-}" != "$animate_value" ]; then
            session_animation_refresh_indexes+=("$index")
        fi
        if [ "$row_cache_reusable" != true ]; then
            snapshot_signature="${snapshot_signature}${name}:${created}|"
        fi

        if [ "$name" = "$old_selected" ]; then
            selected_index="$index"
            found_selected=true
        fi
        if [ "$row_cache_reusable" != true ]; then
            index=$((index + 1))
        fi
        trace_event "collect.session.end session=$name"
    done <<EOF
$sessions_snapshot
EOF
    if [ -n "$metrics_start" ]; then
        metrics_parse_sessions_us=$(( $(metrics_now_us) - metrics_parse_sessions_start ))
        metrics_write "op=collect phase=summary operation_id=$metrics_operation_id scan_scope=$metrics_scan_scope row_cache_reusable=$row_cache_reusable pane_scan_scope=$metrics_pane_scan_scope incremental_pane_scan=$incremental_pane_scan force=$force_scan requested=${requested_scan_session:-none} sessions=${#session_names[@]} list_sessions_us=$metrics_list_sessions_us list_panes_us=$metrics_list_panes_us parse_panes_us=$metrics_parse_panes_us parse_sessions_us=$metrics_parse_sessions_us status_us=$metrics_status_us status_count=$metrics_status_count status_cache_hits=$metrics_status_cache_hits status_cache_misses=$metrics_status_cache_misses ai_us=$metrics_ai_us ai_count=$metrics_ai_count ai_cache_hits=$metrics_ai_cache_hits ai_refreshes=$metrics_ai_refreshes seed_us=$metrics_seed_us seed_count=$metrics_seed_count seed_cache_hits=$metrics_seed_cache_hits seed_cache_misses=$metrics_seed_cache_misses total_us=$(( $(metrics_now_us) - metrics_start ))"
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions parse-sessions us=$(( timing_end - parse_sessions_start )) total_us=$(( timing_end - timing_start )) session_count=${#session_names[@]}"
    fi
    trace_event "collect.parse-sessions.end count=${#session_names[@]}"

    if [ "$current_session" != "$old_current_session" ]; then
        mark_full_render_required session-change
        # A window-local sidebar survives native switch-client. Its previous
        # selection can therefore belong to the session we just left. Align
        # the marker with the newly observed current session before rendering
        # so returning to a multi-window target never leaves a stale peer
        # selected for the next Enter/delete/archive action. During an active
        # transition, however, preserve a valid physical selection update
        # that arrived after switch-client and before this refresh completed.
        if transition_is_active && [ -n "${selected_session:-}" ] &&
            session_exists "$selected_session" && [ "$selected_session" != "$old_current_session" ]; then
            trace_event "selection.refresh.preserve reason=transition-selection selected=$selected_session current=$current_session"
        else
            found_selected=false
        fi
        for index in "${!session_names[@]}"; do
            if [ "${session_names[$index]}" = "$old_current_session" ] ||
                [ "${session_names[$index]}" = "$current_session" ]; then
                session_animation_refresh_indexes+=("$index")
            fi
            if [ "${session_names[$index]}" = "$current_session" ] && [ "$found_selected" != true ]; then
                selected_index="$index"
                selected_session="$current_session"
                found_selected=true
            fi
        done
    fi

    if [ "${#session_names[@]}" -eq 0 ]; then
        selected_session=""
        selected_index=0
        return 0
    fi

    if [ "$found_selected" != true ]; then
        selected_index=0
        for index in "${!session_names[@]}"; do
            if [ "${session_names[$index]}" = "$current_session" ]; then
                selected_index="$index"
                break
            fi
        done
    fi

    selected_session="${session_names[$selected_index]}"
    if [ "$client_switch_occurred" = "true" ] && [ "$client_session_is_my_session" = "true" ]; then
        if [ -z "${selected_session:-}" ] || ! session_exists "$selected_session"; then
            align_selection_to_session "$my_session"
            trace_event "selection.refresh.align reason=client-list-change session=$my_session"
        else
            trace_event "selection.refresh.align-skip reason=valid-selection selected=$selected_session current=$my_session"
        fi
    fi
    ensure_selection_visible
    trace_event "collect.sessions.end count=${#session_names[@]} selected=$selected_session"
    debug_log "collect_sessions end current_session=$current_session selected_session=$selected_session selected_index=$selected_index count=${#session_names[@]}"
}

ensure_selection_visible()
{
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        visible_rows=$(((height - 4) / 2))
    else
        visible_rows=$((height - 3))
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    if [ "$selected_index" -lt "$scroll_offset" ]; then
        scroll_offset="$selected_index"
    elif [ "$selected_index" -ge $((scroll_offset + visible_rows)) ]; then
        scroll_offset=$((selected_index - visible_rows + 1))
    fi

    [ "$scroll_offset" -lt 0 ] && scroll_offset=0
    return 0
}

align_selection_to_session()
{
    local target_session="$1"
    local selection_index

    [ -n "$target_session" ] || return 0
    for selection_index in "${!session_names[@]}"; do
        if [ "${session_names[$selection_index]}" = "$target_session" ]; then
            selected_index="$selection_index"
            selected_session="$target_session"
            ensure_selection_visible
            return 0
        fi
    done
}

row_is_visible()
{
    index="$1"
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        visible_rows=$(((height - 4) / 2))
    else
        visible_rows=$((height - 3))
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    [ "$index" -ge "$scroll_offset" ] && [ "$index" -lt $((scroll_offset + visible_rows)) ]
}

row_mark_value()
{
    index="$1"
    name="${session_names[$index]}"

    if [ "$index" -eq "$selected_index" ] && [ "$name" = "$current_session" ]; then
        row_mark_result='>*'
    elif [ "$index" -eq "$selected_index" ]; then
        row_mark_result='> '
    elif [ "$name" = "$current_session" ]; then
        row_mark_result=' *'
    else
        row_mark_result='  '
    fi
}

session_visible_rows()
{
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        rows=$(((height - 4) / 2))
    else
        rows=$((height - 3))
    fi

    [ "$rows" -lt 1 ] && rows=1
    printf '%s\n' "$rows"
}

history_start_line()
{
    if [ "$view_mode" = "history" ]; then
        printf '%s\n' "$((2 + $(session_visible_rows) + 1))"
    else
        printf '%s\n' 0
    fi
}

history_visible_rows()
{
    height="${cached_pane_height:-20}"
    start="$(history_start_line)"
    rows=$((height - start))

    [ "$rows" -lt 1 ] && rows=1
    printf '%s\n' "$rows"
}

render_header()
{
    width="${cached_pane_width:-35}"
    move_cursor 1 1
    clear_line
    printf '%s' "$(truncate_text 'sessions' "$width")"
}

render_footer()
{
    width="${cached_pane_width:-35}"
    height="${cached_pane_height:-20}"
    help='j/k Enter c/r/d o/a q'

    if [ "$width" -ge 30 ]; then
        help='j/k | Enter | c/r/d | o/a | q'
    fi

    move_cursor "$height" 1
    clear_line
    printf '%s' "$(truncate_text "$help" "$width")"
}

history_title_from_file()
{
    basename "$1" | sed 's/\.tsv$//'
}

collect_history()
{
    history_files=()
    history_titles=()
    history_checked=()
    history_signature=""
    mkdir -p "$HISTORY_DIR"

    while IFS= read -r file_path; do
        [ -n "$file_path" ] || continue
        history_files+=("$file_path")
        local fname="${file_path##*/}"
        history_titles+=("${fname%.tsv}")
        history_checked+=("false")
        history_signature="${history_signature}${file_path}|"
    done <<EOF
$(find "$HISTORY_DIR" -maxdepth 1 -type f -name '*.tsv' 2>/dev/null | sort -r)
EOF

    if [ "${#history_files[@]}" -eq 0 ]; then
        history_index=0
    elif [ "$history_index" -ge "${#history_files[@]}" ]; then
        history_index=$((${#history_files[@]} - 1))
    fi
}

align_history_selection_to_session()
{
    local target_session="$1" index archive_session
    [ -n "$target_session" ] || return 0
    for index in "${!history_files[@]}"; do
        archive_session="$(awk -F '\t' '$1 == "session" { print $2; exit }' "${history_files[$index]}" 2>/dev/null || true)"
        if [ "$archive_session" = "$target_session" ]; then
            history_index="$index"
            trace_event "history.selection.align session=$target_session index=$index"
            return 0
        fi
    done
}

ensure_history_visible()
{
    visible_rows="$(history_visible_rows)"
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    if [ "$history_index" -lt "$history_scroll_offset" ]; then
        history_scroll_offset="$history_index"
    elif [ "$history_index" -ge $((history_scroll_offset + visible_rows)) ]; then
        history_scroll_offset=$((history_index - visible_rows + 1))
    fi

    [ "$history_scroll_offset" -lt 0 ] && history_scroll_offset=0
    return 0
}

history_row_mark()
{
    index="$1"
    checked=' '

    if [ "${history_checked[$index]}" = "true" ]; then
        checked='x'
    fi

    if [ "$index" -eq "$history_index" ]; then
        printf '>%s\n' "$checked"
    else
        printf ' %s\n' "$checked"
    fi
}

render_history()
{
    width="${cached_pane_width:-35}"
    start="$(history_start_line)"
    visible_rows="$(history_visible_rows)"
    index="$history_scroll_offset"
    end=$((history_scroll_offset + visible_rows))
    line="$((start - 1))"

    move_cursor "$line" 1
    clear_line
    printf '%s' "$(truncate_text 'open: Space mark, a all, Enter restore, d delete' "$width")"

    line="$start"
    while [ "$line" -lt "${cached_pane_height:-20}" ]; do
        move_cursor "$line" 1
        clear_line
        line=$((line + 1))
    done

    line="$start"
    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#history_files[@]}" ]; do
        mark="$(history_row_mark "$index")"
        title="$(truncate_text "${history_titles[$index]}" "$((width - 4))")"
        move_cursor "$line" 1
        clear_line
        printf '%s %s' "$mark" "$title"
        index=$((index + 1))
        line=$((line + 1))
    done
}

print_session_name()
{
    format_session_name "$@"
    printf '%s' "$session_name_result"
}

format_session_name()
{
    local name="$1"
    local width="$2"
    local animate="$3"
    local seed="${4:-0}"
    local text="${name:0:width}"
    local text_width="${#text}"
    local padding=$((width - text_width))
    local result='' char phase color colored

    if [ "$animate" = "true" ] && [ "$SIDEBAR_ANIMATION_ENABLED" = "true" ]; then
        for ((i = 0; i < text_width; i++)); do
            char="${text:i:1}"
            phase=$(((i - animation_frame + seed + 24) % 24))
            case "$phase" in
                0) color=255 ;;
                1) color=254 ;;
                2) color=252 ;;
                3) color=250 ;;
                4) color=248 ;;
                5) color=246 ;;
                *) color=241 ;;
            esac
            printf -v colored '\033[38;5;%sm%s' "$color" "$char"
            result+="$colored"
        done
        result+=$'\033[0m'
    else
        result="$text"
    fi

    if [ "$padding" -gt 0 ]; then
        printf -v padding_text '%*s' "$padding" ''
        result+="$padding_text"
    fi

    session_name_result="$result"
}

render_row()
{
    format_row "$1"
    printf '%s' "$row_render_result"
}

format_row()
{
    index="$1"
    line=$((2 + index - scroll_offset))
    width="${cached_pane_width:-35}"
    row_mark_value "$index"
    mark="$row_mark_result"
    session_age_value "${session_created[$index]}"
    age="$session_age_result"
    age_width=10
    name_width=$((width - 2 - 1 - age_width - 2))

    [ "$name_width" -lt 1 ] && name_width=1
    if [ "$width" -lt 16 ]; then
        format_session_name "${session_names[$index]}" "$((width - 3))" \
            "${session_animate[$index]}" "${session_animation_seed[$index]}"
        printf -v row_render_result '\033[%s;1H\033[2K%s %s' \
            "$line" "$mark" "$session_name_result"
    else
        format_session_name "${session_names[$index]}" "$name_width" \
            "${session_animate[$index]}" "${session_animation_seed[$index]}"
        printf -v row_render_result '\033[%s;1H\033[2K%s %s %s ' \
            "$line" "$mark" "$session_name_result" "$age"
    fi
}

render_selection_pair()
{
    local old_index="$1"
    local new_index="$2"
    local selection_render_buffer

    format_row "$old_index"
    selection_render_buffer="$row_render_result"
    format_row "$new_index"
    selection_render_buffer+="$row_render_result"
    printf '%s' "$selection_render_buffer"
}

render_marker_delta()
{
    local old_current="$1" old_selected_index="$2" old_selected_session="$3"
    local -a changed_indexes=()
    local index name old_current_index old_selected_name_index current_index selected_name_index duplicate
    local marker_buffer=""

    old_current_index="$(session_index_for_name "$old_current" || true)"
    old_selected_name_index="$(session_index_for_name "$old_selected_session" || true)"
    current_index="$(session_index_for_name "$current_session" || true)"
    selected_name_index="$(session_index_for_name "$selected_session" || true)"
    for index in "$old_current_index" "$old_selected_name_index" "$old_selected_index" \
        "$current_index" "$selected_name_index"; do
        case "$index" in
            ''|*[!0-9]*) continue ;;
        esac
        duplicate=false
        for name in "${changed_indexes[@]}"; do
            if [ "$name" = "$index" ]; then
                duplicate=true
                break
            fi
        done
        [ "$duplicate" = false ] && changed_indexes+=("$index")
    done

    for index in "${changed_indexes[@]}"; do
        row_is_visible "$index" || continue
        format_row "$index"
        marker_buffer+="$row_render_result"
    done
    if [ -n "$marker_buffer" ]; then
        printf '%s' "$marker_buffer"
        render_marker_column_all
        trace_event "render.marker-delta old_current=${old_current:-none} old_selected=${old_selected_session:-none} current=$current_session selected=$selected_session rows=${#changed_indexes[@]}"
    else
        render_visible_rows
        render_marker_column_all
        trace_event "render.marker-delta.fallback reason=rows-not-visible current=$current_session selected=$selected_session"
    fi
}

render_marker_column_all()
{
    local index line rendered=0
    index="$scroll_offset"
    height="${cached_pane_height:-20}"
    visible_rows=$((height - 3))
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    while [ "$index" -lt "$((scroll_offset + visible_rows))" ] &&
        [ "$index" -lt "${#session_names[@]}" ]; do
        line=$((2 + index - scroll_offset))
        row_mark_value "$index"
        printf '\033[%s;1H%s' "$line" "$row_mark_result"
        rendered=$((rendered + 1))
        index=$((index + 1))
    done
    trace_event "render.marker-column-all session=$current_session selected=$selected_session rows=$rendered"
}

session_index_for_name()
{
    local target="$1" index
    for index in "${!session_names[@]}"; do
        if [ "${session_names[$index]}" = "$target" ]; then
            printf '%s\n' "$index"
            return 0
        fi
    done
    return 1
}

render_transition_delta()
{
    local source_session="${1:-}" target_session="${2:-}" old_index new_index
    local metrics_render_start="" metrics_render_end=""
    [ -n "$target_session" ] || return 1
    [ "$view_mode" = sessions ] || return 1
    old_index="$(session_index_for_name "$source_session" || true)"
    new_index="$(session_index_for_name "$target_session" || true)"
    [ -n "$new_index" ] || return 1

    # A session switch must not change the visible list geometry. If either
    # row would require scrolling, leave the decision to the full-render
    # recovery path rather than emitting a partial, misleading frame.
    if [ -n "$old_index" ] && row_is_visible "$old_index" && row_is_visible "$new_index"; then
        if [ -n "$METRICS_FILE" ]; then
            metrics_render_start="$(metrics_now_us)"
        fi
        trace_event "render.delta.begin reason=enter-session-switch source=$source_session target=$target_session old_index=$old_index new_index=$new_index"
        render_selection_pair "$old_index" "$new_index"
        if [ -n "$METRICS_FILE" ]; then
            metrics_render_end="$(metrics_now_us)"
            metrics_write "op=render phase=delta operation_id=${current_transition_operation_id:-none} reason=enter-session-switch duration_us=$((metrics_render_end - metrics_render_start))"
        fi
        trace_event "render.delta.end reason=enter-session-switch source=$source_session target=$target_session old_index=$old_index new_index=$new_index"
        return 0
    fi
    return 1
}

render_animated_name_cells()
{
    local height="${cached_pane_height:-20}"
    local visible_rows=$((height - 3))
    local animation_buffer="" animation_cell
    local metrics_frame_start="" metrics_frame_end="" metrics_format_start="" metrics_format_end=""
    local metrics_emit_start="" metrics_emit_end="" rendered_cells=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_now_us_value
        metrics_frame_start="$metrics_now_us_result"
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    local end=$((scroll_offset + visible_rows))
    index="$scroll_offset"

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        if [ "${session_animate[$index]}" = "true" ]; then
            line=$((2 + index - scroll_offset))
            width="${cached_pane_width:-35}"
            name_width=$((width - 2 - 1 - 10 - 2))
            [ "$name_width" -lt 1 ] && name_width=1
            if [ -n "$METRICS_FILE" ]; then
                metrics_now_us_value
                metrics_format_start="$metrics_now_us_result"
            fi
            format_session_name "${session_names[$index]}" "$name_width" \
                "${session_animate[$index]}" "${session_animation_seed[$index]}"
            if [ -n "$METRICS_FILE" ]; then
                metrics_now_us_value
                metrics_format_end="$metrics_now_us_result"
                animation_metrics_format_us=$((animation_metrics_format_us + metrics_format_end - metrics_format_start))
            fi
            printf -v animation_cell '\033[%s;4H%s' "$line" "$session_name_result"
            animation_buffer+="$animation_cell"
            rendered_cells=$((rendered_cells + 1))
        fi
        index=$((index + 1))
    done
    if [ -n "$animation_buffer" ]; then
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            metrics_emit_start="$metrics_now_us_result"
        fi
        printf '%s' "$animation_buffer"
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            metrics_emit_end="$metrics_now_us_result"
            animation_metrics_emit_us=$((animation_metrics_emit_us + metrics_emit_end - metrics_emit_start))
        fi
    fi
    if [ -n "$metrics_frame_start" ]; then
        metrics_now_us_value
        metrics_frame_end="$metrics_now_us_result"
        animation_metrics_frames=$((animation_metrics_frames + 1))
        animation_metrics_cells=$((animation_metrics_cells + rendered_cells))
        animation_metrics_frame_us=$((animation_metrics_frame_us + metrics_frame_end - metrics_frame_start))
    fi
}

refresh_sidebar_state_if_due()
{
    now_epoch="${EPOCHSECONDS:-$SECONDS}"
    if [ -z "${last_state_refresh_epoch:-}" ] ||
        [ $((now_epoch - last_state_refresh_epoch)) -ge "$SIDEBAR_STATE_REFRESH_SECONDS" ]; then
        # Passive sessions do not need a full state scan when their pane
        # topology and command names are unchanged.  A single target-scoped
        # snapshot still detects a shell -> command transition.
        if [ -n "${selected_session:-}" ] &&
            [ -z "${session_ai_direct_pane_id[$selected_session]:-}" ]; then
            if session_has_shell_pane "$selected_session"; then
                # A selected shell only needs a cheap process-tree probe.  Do
                # not rebuild the target snapshot when no AI child exists.
                if ! session_has_shell_child_ai_process "$selected_session"; then
                    last_state_refresh_epoch="$now_epoch"
                    return 1
                fi
            else
            # A stable pane command signature is enough to keep ordinary
            # non-AI sessions on their cached state.  The previous busy-command
            # guard forced a full snapshot for fixtures such as `sleep`, even
            # though no AI fingerprint could change without a command/pane
            # transition.  AI-named panes remain on the fingerprint path above.
            session_command_signature_from_tmux "$selected_session"
            if [ "${session_command_signature_result:-}" = \
                "${cached_session_command_signature[$selected_session]:-}" ]; then
                last_state_refresh_epoch="$now_epoch"
                return 1
            fi
            fi
        fi
        refresh_if_needed
        last_state_refresh_epoch="$now_epoch"
        return 0
    fi

    return 1
}

state_refresh_due()
{
    local now_epoch_value="${EPOCHSECONDS:-$SECONDS}"
    [ -z "${last_state_refresh_epoch:-}" ] ||
        [ $((now_epoch_value - last_state_refresh_epoch)) -ge "$SIDEBAR_STATE_REFRESH_SECONDS" ]
}

render_visible_rows()
{
    height="${cached_pane_height:-20}"
    visible_rows="$(session_visible_rows)"
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    end=$((scroll_offset + visible_rows))
    index="$scroll_offset"
    line=2

    while [ "$line" -lt "$height" ]; do
        move_cursor "$line" 1
        clear_line
        line=$((line + 1))
    done

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        render_row "$index"
        index=$((index + 1))
    done
}

render_visible_session_rows()
{
    render_visible_rows "$@"
}

render_full()
{
    local render_reason="${1:-direct}"
    local metrics_render_start="" metrics_render_end=""
    render_generation=$((render_generation + 1))
    trace_event "render.full.begin generation=$render_generation reason=$render_reason session=$current_session selected=$selected_session"
    if [ -n "$METRICS_FILE" ]; then
        metrics_render_start="$(metrics_now_us)"
    fi
    update_pane_geometry
    last_width="${cached_pane_width:-35}"
    last_height="${cached_pane_height:-20}"
    debug_log "render_full start generation=$render_generation reason=$render_reason current_session=$current_session selected_session=$selected_session view_mode=$view_mode count=${#session_names[@]}"

    local buffer
    buffer="$(
        printf '\033[H\033[2J'
        hide_cursor
        render_header
        render_visible_rows
        if [ "$view_mode" = "history" ]; then
            render_history
        fi
        render_footer
    )"
    printf '%s' "$buffer"
    render_marker_column_all

    if [ -n "$metrics_render_start" ]; then
        metrics_render_end="$(metrics_now_us)"
        animation_metrics_full_renders=$((animation_metrics_full_renders + 1))
        animation_metrics_full_render_us=$((animation_metrics_full_render_us + metrics_render_end - metrics_render_start))
    fi

    debug_log "render_full end generation=$render_generation reason=$render_reason current_session=$current_session selected_session=$selected_session view_mode=$view_mode"
    trace_event "render.full.end generation=$render_generation reason=$render_reason session=$current_session selected=$selected_session"
}

mark_full_render_required()
{
    local reason="${1:-unspecified}"
    full_render_required=true
    # Geometry invalidation has precedence over lower-priority state changes.
    case "$full_render_required_reason:$reason" in
        geometry-invalidated:*|topology-invalidated:*) ;;
        *) full_render_required_reason="$reason" ;;
    esac
}

native_selection_sync_pending()
{
    local requested_session local_session
    [ -n "${SIDEBAR_WINDOW_ID:-}" ] || return 1
    requested_session="$(tmux show-option -wqv -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_SELECTION_SYNC_OPTION" 2>/dev/null || true)"
    [ -n "$requested_session" ] || return 1
    local_session="$(sidebar_session_name || true)"
    [ "$requested_session" = "$local_session" ]
}

selection_sync_window_pending()
{
    [ -n "${SIDEBAR_WINDOW_ID:-}" ] || return 1
    [ -n "$(tmux show-option -wqv -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_SELECTION_SYNC_OPTION" 2>/dev/null || true)" ]
}

transition_render_pending_for_current_session()
{
    local state target
    [ -n "${SIDEBAR_WINDOW_ID:-}" ] || return 1
    state="$(tmux show-option -wqv -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" 2>/dev/null || true)"
    target="${state##*target=}"
    [ -n "$target" ] && [ "$target" = "$current_session" ]
}

request_full_render()
{
    local reason="${1:-unspecified}"
    render_request_pending=true
    render_request_reason="$reason"
    trace_event "render.request reason=$reason generation=$((render_generation + 1))"
}

flush_full_render_request()
{
    local reason="${render_request_reason:-unspecified}"
    [ "$render_request_pending" = true ] || return 0
    render_request_pending=false
    render_request_reason=""
    if [ "$reason" = "enter-session-switch" ] && transition_commit_pending; then
        transition_phase_set RENDER_DELTA "$current_transition_operation_id"
        if render_transition_delta "$current_transition_source" "$current_transition_target"; then
            transition_context_finish success none "$current_transition_operation_id"
            transition_render_coalesced=true
            return 0
        fi
        trace_event "render.delta.fallback reason=geometry-or-selection-not-visible operation_id=$current_transition_operation_id"
        transition_phase_set RENDER_ONCE "$current_transition_operation_id"
        render_full enter-session-switch-fallback
        transition_context_finish success delta-render-fallback "$current_transition_operation_id"
        transition_render_coalesced=true
        return 0
    fi
    render_full "$reason"
}

render_age_cells()
{
    local age_buffer="" age_cell
    index="$scroll_offset"
    height="${cached_pane_height:-20}"
    visible_rows=$((height - 3))
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    end=$((scroll_offset + visible_rows))
    width="${cached_pane_width:-35}"
    [ "$width" -lt 16 ] && return 0

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        line=$((2 + index - scroll_offset))
        session_age_value "${session_created[$index]}"
        printf -v age_cell '\033[%s;%sH%s' "$line" "$((width - 10))" "$session_age_result"
        age_buffer+="$age_cell"
        index=$((index + 1))
    done
    [ -n "$age_buffer" ] && printf '%s' "$age_buffer"
}

render_animation_state_changes()
{
    local animation_buffer="" metrics_render_start="" metrics_render_end="" rendered_rows=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_render_start="$(metrics_now_us)"
    fi
    for index in "${session_animation_refresh_indexes[@]}"; do
        if row_is_visible "$index"; then
            format_row "$index"
            animation_buffer+="$row_render_result"
            rendered_rows=$((rendered_rows + 1))
        fi
    done
    [ -n "$animation_buffer" ] && printf '%s' "$animation_buffer"
    if [ -n "$metrics_render_start" ]; then
        metrics_render_end="$(metrics_now_us)"
        animation_metrics_state_renders=$((animation_metrics_state_renders + 1))
        animation_metrics_state_rows=$((animation_metrics_state_rows + rendered_rows))
        animation_metrics_state_render_us=$((animation_metrics_state_render_us + metrics_render_end - metrics_render_start))
    fi
    session_animation_refresh_indexes=()
}

refresh_if_needed()
{
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi
    old_signature="$snapshot_signature"
    old_width="$last_width"
    old_height="$last_height"

    debug_log "refresh_if_needed start old_signature=$old_signature old_width=$old_width old_height=$old_height"
    # The periodic refresh is the only idle-time state probe.  It refreshes the
    # selected session while all other sessions remain on their cached values.
    collect_sessions false "$selected_session"
    if [ "$full_render_required" = "true" ] ||
        [ "$old_signature" != "$snapshot_signature" ] ||
        [ "$old_width" != "${cached_pane_width:-35}" ] ||
        [ "$old_height" != "${cached_pane_height:-20}" ]; then
        debug_log "refresh_if_needed render because signature_or_size_changed new_signature=$snapshot_signature new_width=${cached_pane_width:-35} new_height=${cached_pane_height:-20}"
        render_full periodic-refresh
        session_animation_refresh_indexes=()
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing refresh_if_needed total_us=$(( timing_end - timing_start ))"
    fi
    debug_log "refresh_if_needed end current_session=$current_session selected_session=$selected_session signature=$snapshot_signature"
}

restore_terminal()
{
    stop_tick_timer
    show_cursor
    [ -n "$stty_state" ] && stty "$stty_state" 2>/dev/null || true
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
    fi
    sidebar_tmux_control_stop
}

handle_tick_signal()
{
    tick_signal_pending=true
}

handle_refresh_signal()
{
    refresh_signal_pending=true
    selection_sync_signal_pending=true
    # Signal handlers only publish intent. tmux IPC and selection mutation are
    # deferred to the main event loop; executing them from this trap can
    # interrupt Bash builtins and trigger the longjmp/uninitialized-stack
    # failure seen during rapid attached-PTY transitions.
    trace_event "selection.sync.signal-deferred window=${SIDEBAR_WINDOW_ID:-none}"
}

handle_geometry_signal()
{
    # WINCH can arrive while Bash is inside read/command substitution. Keep
    # the handler async-signal-safe; geometry inspection and tracing belong to
    # the main event loop to avoid re-entrant Bash longjmp failures.
    geometry_signal_pending=true
}

start_tick_timer()
{
    local parent_pid="$$"

    (
        trap 'exit 0' TERM INT HUP
        trap '' USR1
        while :; do
            sleep "$SIDEBAR_TICK_INTERVAL"
            kill -USR1 "$parent_pid" 2>/dev/null || exit 0
        done
    ) &
    tick_timer_pid="$!"
}

stop_tick_timer()
{
    if [ -n "$tick_timer_pid" ]; then
        kill "$tick_timer_pid" 2>/dev/null || true
        wait "$tick_timer_pid" 2>/dev/null || true
        tick_timer_pid=""
    fi
}

setup_terminal()
{
    stty_state="$(stty -g 2>/dev/null || true)"
    stty -echo -icanon time 0 min 0 2>/dev/null || true
    trap restore_terminal EXIT INT TERM
    trap handle_geometry_signal WINCH
    trap handle_tick_signal USR1
    trap handle_refresh_signal USR2
}

render_prompt_box()
{
    local prompt="$1"
    update_pane_geometry
    local height="${cached_pane_height:-20}"
    printf '\033[%s;1H\033[2K%s' "$height" "$prompt" >/dev/tty 2>/dev/null || printf '\033[%s;1H\033[2K%s' "$height" "$prompt"
}

cleanup_prompt_traps()
{
    stty -echo -icanon time 0 min 0 2>/dev/null || true
    trap handle_refresh_signal USR2 2>/dev/null || true
    trap handle_geometry_signal WINCH 2>/dev/null || true
    prompt_active=false
    post_operation_fast_read=true
}

prompt_text()
{
    prompt="$1"
    local prompt_type="generic"
    prompt_result=""
    prompt_cancelled=false
    height="${cached_pane_height:-20}"

    case "$prompt" in
        New:*) prompt_type=create ;;
        Rename:*) prompt_type=rename ;;
        Save\ Session:*) prompt_type=save ;;
        Delete\ history:*) prompt_type=history-delete ;;
        Delete\ *) prompt_type=delete ;;
        Filter:*|Search:*) prompt_type=filter ;;
    esac
    sidebar_tmux_cmd set-option -gq "@dotfiles_sidebar_prompt_ready" 1 2>/dev/null || true
    sidebar_tmux_cmd set-option -wq "@dotfiles_sidebar_prompt_ready" 1 2>/dev/null || true
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        sidebar_tmux_cmd set-option -wq -t "$SIDEBAR_WINDOW_ID" "@dotfiles_sidebar_prompt_ready" 1 2>/dev/null || true
    fi
    sidebar_runtime_set "$SIDEBAR_PROMPT_READY_OPTION" 1
    prompt_active=true
    trap cleanup_prompt_traps RETURN 2>/dev/null || true
    trap '' USR2 WINCH

    if [ "$prompt_type" = "delete" ] || [ "$prompt_type" = "history-delete" ]; then
        stty < /dev/tty -echo -icanon min 1 time 0 2>/dev/null || true
        render_prompt_box "$prompt"
        local char=""
        IFS= read -r -n 1 char </dev/tty 2>/dev/null || true
        case "$char" in
            $'\033'|[Qq]|[Nn])
                prompt_cancelled=true
                prompt_result=""
                ;;
            [Yy])
                prompt_result="y"
                ;;
            'a'|'A')
                prompt_result="All"
                ;;
            $'\n'|$'\r'|"")
                prompt_result=""
                ;;
            *)
                prompt_cancelled=true
                prompt_result=""
                ;;
        esac
    else
        stty < /dev/tty echo icanon icrnl min 1 time 0 2>/dev/null || stty -F /dev/tty echo icanon icrnl min 1 time 0 2>/dev/null || stty echo icanon icrnl 2>/dev/tty 2>/dev/null || true
        render_prompt_box "$prompt"
        debug_log "prompt_text before read"
        if ! IFS= read -r prompt_result </dev/tty 2>/dev/null; then
            if ! IFS= read -r prompt_result 2>/dev/null; then
                prompt_cancelled=true
                prompt_result=""
            fi
        fi
        debug_log "prompt_text after read result='$prompt_result' cancelled='$prompt_cancelled'"
        prompt_result="${prompt_result%%$'\r'}"
        case "$prompt_result" in
            $'\033'*|[Qq]|[Nn])
                prompt_cancelled=true
                prompt_result=""
                ;;
        esac
    fi

    sidebar_runtime_set "$SIDEBAR_PROMPT_READY_OPTION" 0
    sidebar_tmux_cmd set-option -gq "@dotfiles_sidebar_prompt_ready" 0 2>/dev/null || true
    sidebar_tmux_cmd set-option -sq "@dotfiles_sidebar_prompt_ready" 0 2>/dev/null || true
    sidebar_tmux_cmd set-option -wq "@dotfiles_sidebar_prompt_ready" 0 2>/dev/null || true
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        sidebar_tmux_cmd set-option -wq -t "$SIDEBAR_WINDOW_ID" "@dotfiles_sidebar_prompt_ready" 0 2>/dev/null || true
    fi

    trace_event "prompt.result action_id=${current_action_id:-none} type=$prompt_type result=$([ "$prompt_cancelled" = true ] && printf cancelled || printf complete) length=${#prompt_result} terminator=canonical-line"
    stty -echo -icanon time 0 min 0 2>/dev/null || true
    trap handle_refresh_signal USR2
    trap handle_geometry_signal WINCH
    prompt_active=false
    post_operation_fast_read=true
    trace_event "prompt.end action_id=${current_action_id:-none} type=$prompt_type"
}

prompt_line()
{
    prompt_text "$@"
}

message_line()
{
    message="$1"
    height="${cached_pane_height:-20}"

    move_cursor "$height" 1
    clear_line
    printf '%s' "$(truncate_text "$message" "${cached_pane_width:-35}")"
    sleep 1
}

debug_log()
{
    debug_file="${TMUX_SESSION_LAUNCHER_DEBUG_FILE:-/tmp/tmux-session-launcher-debug.log}"
    debug_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"

    if [ "$debug_enabled" != "1" ]; then
        return 0
    fi

    {
        printf '%s pid=%s pane=%s %s\n' "$(debug_now_us)" "${BASHPID:-$$}" \
            "${TMUX_PANE:-${SELF_PANE:-none}}" "$*"
    } >> "$debug_file" 2>/dev/null || true
}

trace_event()
{
    [ "${TMUX_SESSION_LAUNCHER_TRACE:-0}" = "1" ] || return 0
    trace_file="${TMUX_SESSION_LAUNCHER_TRACE_FILE:-/tmp/tmux-session-launcher-trace.log}"
    trace_pane="${TMUX_PANE:-${SELF_PANE:-none}}"
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s pane=%s %s\n' "$EPOCHREALTIME" "$trace_pane" "$*" >> "$trace_file" 2>/dev/null || true
    else
        printf '%s pane=%s %s\n' "$(debug_now_us)" "$trace_pane" "$*" >> "$trace_file" 2>/dev/null || true
    fi
}

trace_key_hex()
{
    local key_value="$1"
    [ -n "$key_value" ] || {
        printf '%s\n' none
        return 0
    }
    printf '%s' "$key_value" | od -An -tx1 | tr -d ' \n'
}

trace_client_state()
{
    local context="$1" client_tty="$2" client_state
    [ "${TMUX_SESSION_LAUNCHER_TRACE:-0}" = 1 ] || [ -n "$METRICS_FILE" ] || return 0
    [ -n "$client_tty" ] || return 0
    # This is diagnostic-only. One client-targeted format replaces the former
    # list-clients + pane display pair, which otherwise added measurable tail
    # latency to every switch while tracing was enabled.
    client_state="$(tmux display-message -p -t "$client_tty" \
        '#{client_control_mode}|#{client_tty}|#{session_name}|#{window_id}|#{pane_id}|#{client_activity}|#{client_key_table}|#{client_prefix}|#{pane_tty}|#{pane_input_off}|#{pane_pid}' 2>/dev/null || true)"
    trace_event "client.state context=$context tty=$client_tty state=${client_state:-none}"
}

debug_now_us()
{
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s\n' "${EPOCHREALTIME/./}"
    else
        date +%s%6N
    fi
}

maintenance_cooldown_active()
{
    local now_us elapsed_us cooldown_us
    [ -n "${last_input_epoch_us:-}" ] || return 1
    cooldown_us=$((SIDEBAR_KEY_MAINTENANCE_COOLDOWN_MS * 1000))
    [ "$cooldown_us" -gt 0 ] || return 1
    now_us="$(debug_now_us)"
    elapsed_us=$((now_us - last_input_epoch_us))
    [ "$elapsed_us" -ge 0 ] && [ "$elapsed_us" -lt "$cooldown_us" ]
}

safe_file_part()
{
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_' ;;
        *) printf '%s' "$1" ;;
    esac
}

tmux_history_file()
{
    printf '%s\n' "${HISTFILE:-$HOME/.cache/dotfiles/tmux.zsh_history}"
}

archivable_window_count()
{
    session_name="$1"
    count=0

    while IFS= read -r window_index; do
        if tmux list-panes -t "=$session_name:$window_index" -F '#{pane_title}' 2>/dev/null |
            awk -v title="$SIDEBAR_TITLE" '$0 != title { found = 1 } END { exit found ? 0 : 1 }'; then
            count=$((count + 1))
        fi
    done <<EOF
$(tmux list-windows -t "=$session_name:" -F '#{window_index}' 2>/dev/null)
EOF

    printf '%s\n' "$count"
}

archive_shell_history()
{
    history_file="$(tmux_history_file)"
    [ -f "$history_file" ] || return 0

    tail -n 200 "$history_file" 2>/dev/null |
        while IFS= read -r history_line; do
            printf 'history\t%s\n' "$history_line"
        done
}

append_archive_history()
{
    archive_path="$1"
    history_file="$(tmux_history_file)"
    history_dir="$(dirname "$history_file")"

    [ -d "$history_dir" ] || mkdir -p "$history_dir"
    while IFS="$(printf '\t')" read -r record history_line; do
        [ "$record" = history ] || continue
        printf '%s\n' "$history_line"
    done < "$archive_path" >> "$history_file"
}

validate_archive_file()
{
    local archive_path_value="$1"
    [ -s "$archive_path_value" ] || return 1
    awk -F '\t' '
        BEGIN { version = ""; session = 0; windows = 0; panes = 0; ends = 0; valid = 1 }
        $1 == "version" { version = $2 }
        $1 == "session" && $2 != "" { session = 1 }
        $1 == "window" { windows++; if (NF < 5) valid = 0 }
        $1 == "pane" {
            panes++
            if ((version == "2" || version == "3") && NF < 10) valid = 0
            if (version != "2" && version != "3" && NF < 3) valid = 0
        }
        $1 == "endwindow" { ends++ }
        END {
            if (version != "1" && version != "2" && version != "3") valid = 0
            if (!session || windows == 0 || panes == 0 || windows != ends) valid = 0
            exit(valid ? 0 : 1)
        }
    ' "$archive_path_value"
}

append_archive_history_once()
{
    local archive_path_value="$1" marker_path marker_tmp
    marker_path="${archive_path_value}${ARCHIVE_HISTORY_MARKER_SUFFIX}"
    [ -f "$marker_path" ] && return 0
    marker_tmp="${marker_path}.pending-${BASHPID:-$$}"
    if ! append_archive_history "$archive_path_value"; then
        rm -f "$marker_tmp"
        return 1
    fi
    if ! printf 'archive=%s\n' "$(basename "$archive_path_value")" > "$marker_tmp"; then
        rm -f "$marker_tmp"
        return 1
    fi
    if ! mv -n "$marker_tmp" "$marker_path" 2>/dev/null; then
        if [ ! -f "$marker_path" ]; then
            rm -f "$marker_tmp"
            return 1
        fi
        rm -f "$marker_tmp"
    fi
    trace_event "restore.history.imported archive=$archive_path_value marker=$marker_path"
}

clear_restored_work_panes()
{
    session_name="$1"

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title; do
        [ "$pane_session" = "$session_name" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue
        tmux send-keys -t "$pane_id" C-l 2>/dev/null || true
        tmux clear-history -t "$pane_id" 2>/dev/null || true
    done <<EOF
$(tmux list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}' 2>/dev/null)
EOF
}

verify_restored_geometry()
{
    local target="$1" expected="$2" actual
    [ -n "$expected" ] || return 0
    actual="$(tmux list-panes -t "$target" -F '#{pane_left},#{pane_top},#{pane_width},#{pane_height}' 2>/dev/null | sort | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    expected="$(printf '%s\n' "$expected" | tr ' ' '\n' | awk -F ',' 'NF >= 4 { print $1 "," $2 "," $3 "," $4 }' | sort | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    if [ "$actual" != "$expected" ]; then
        trace_event "restore.geometry.error target=$target expected=$expected actual=$actual"
        return 1
    fi
}

apply_restored_window_layout()
{
    target="$1"
    layout="$2"
    pane_ids="$3"
    geometry_manifest="${4:-}"
    restored_layout=""

    [ -n "$target" ] || return 0
    [ -n "$layout" ] || return 0

    trace_event "restore.layout.begin target=$target panes=${pane_ids:-none}"
    fault_injection restore-layout || return 1
    restored_layout="$(layout_with_pane_ids "$layout" "$pane_ids")"
    if ! tmux select-layout -t "$target" "$restored_layout" >/dev/null 2>&1; then
        trace_event "restore.layout.error target=$target reason=select-layout"
        return 1
    fi
    if ! tmux set-option -wq -t "$target" "$WORK_LAYOUT_OPTION" "$restored_layout" 2>/dev/null; then
        trace_event "restore.layout.error target=$target reason=save-layout"
        return 1
    fi
    verify_restored_geometry "$target" "$geometry_manifest" || return 1
    trace_event "restore.layout.end target=$target"
}

restore_archived_sidebar_layout()
{
    local target="$1" layout="$2" archived_panes="$3" archived_active="$4"
    local archived_sidebar_pane="$5" restored_work_panes="$6"
    local sidebar_pane mapped_panes old_pane new_pane work_index=1 active_pane

    trace_event "restore.sidebar-layout.resolve target=$target archived-sidebar=$archived_sidebar_pane archived-work=$restored_work_panes"
    [ -n "$target" ] && [ -n "$layout" ] && [ -n "$archived_panes" ] || {
        trace_event "restore.sidebar-layout.error target=$target reason=missing-metadata"
        return 1
    }
    sidebar_pane="$(tmux list-panes -t "$target" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }')"
    [ -n "$sidebar_pane" ] || {
        trace_event "restore.sidebar-layout.error target=$target reason=sidebar-not-found"
        return 1
    }

    mapped_panes=""
    for old_pane in $archived_panes; do
        if [ "${old_pane#%}" = "${archived_sidebar_pane#%}" ]; then
            new_pane="${sidebar_pane#%}"
        else
            new_pane="$(printf '%s\n' "$restored_work_panes" | awk -v slot="$work_index" '{ split($0, panes, " "); print panes[slot]; exit }')"
            work_index=$((work_index + 1))
        fi
        [ -n "$new_pane" ] || {
            trace_event "restore.sidebar-layout.error target=$target reason=work-pane-map old=$old_pane index=$work_index"
            return 1
        }
        mapped_panes+="${mapped_panes:+ }$new_pane"
        if [ "${old_pane#%}" = "${archived_active#%}" ]; then
            active_pane="$new_pane"
        fi
    done

    trace_event "restore.sidebar-layout.begin target=$target archived-panes=$archived_panes mapped-panes=$mapped_panes"
    restored_layout="$(layout_with_pane_ids "$layout" "$mapped_panes")"
    tmux select-layout -t "$target" "$restored_layout" >/dev/null 2>&1 || {
        trace_event "restore.sidebar-layout.error target=$target reason=select-layout"
        return 1
    }
    [ "${archived_active#%}" = "${archived_sidebar_pane#%}" ] && active_pane="$sidebar_pane"
    [ -n "$active_pane" ] && tmux select-pane -t "$active_pane" >/dev/null 2>&1 || true
    trace_event "restore.sidebar-layout.end target=$target sidebar=$sidebar_pane active=${active_pane:-none}"
}

restore_window_focus()
{
    local target="$1" active_pane="${2:-}"
    [ -n "$target" ] || return 0
    [ -n "$active_pane" ] || return 0
    trace_event "restore.focus.begin target=$target pane=$active_pane"
    if ! tmux select-pane -t "$active_pane" >/dev/null 2>&1; then
        trace_event "restore.focus.error target=$target pane=$active_pane"
        return 1
    fi
    trace_event "restore.focus.end target=$target pane=$active_pane"
}

archive_session()
{
    local archive_pane_session archive_pane_window archive_pane_index archive_pane_path
    local archive_pane_command archive_pane_title archive_pane_line
    local window_pane_count
    local metrics_archive_start="" metrics_archive_operation_id=""
    local metrics_archive_snapshot_us=0 metrics_archive_write_us=0 metrics_archive_rename_us=0
    local metrics_archive_phase_start=""
    declare -A archive_window_pane_counts=()
    declare -A archive_window_pane_lines=()
    declare -A archive_window_names=()
    declare -A archive_window_active=()
    declare -A archive_window_layouts=()
    declare -A archive_window_geometry=()
    declare -A archive_window_created=()
    declare -A archive_window_sidebar_layout=()
    declare -A archive_window_sidebar_panes=()
    declare -A archive_window_sidebar_active=()
    declare -A archive_window_sidebar_pane=()
    declare -A archive_window_seen=()
    declare -A archive_window_all_panes=()
    declare -A archive_window_all_active=()
    declare -a archive_window_order=()

    session_name="$1"
    local existence_checked="${2:-false}"
    [ -n "$session_name" ] || return 1
    [ "$existence_checked" = "true" ] || session_exists "$session_name" || return 1
    if [ -n "$METRICS_FILE" ]; then
        metrics_archive_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_archive_operation_id="$metrics_operation_id_result"
    fi

    trace_event "archive.begin session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    if ! mkdir -p "$HISTORY_DIR"; then
        trace_event "archive.prepare.error session=$session_name reason=history-directory"
        return 1
    fi
    printf -v stamp '%(%Y%m%d-%H%M%S)T' -1
    archive_base="${stamp}-${BASHPID:-$$}-$(safe_file_part "$session_name")"
    archive_path="$HISTORY_DIR/${archive_base}-pending.tsv"
    trace_event "archive.snapshot.begin session=$session_name"
    archive_global_sidebar_pane="$(find_global_sidebar_pane || true)"
    # Archive every window in the session. The empty-window target form
    # (=$session_name:) resolves to the client's current window and silently
    # drops inactive windows from the archive.
    # The trailing colon is required for an exact session target. Without it,
    # a numeric session such as `0` can be resolved against the current
    # client context after fallback switch and produce an empty archive.
    archive_panes_snapshot="$(tmux list-panes -s -t "=$session_name:" \
        -F '#{session_name}	#{window_index}	#{pane_index}	#{pane_id}	#{pane_left}	#{pane_top}	#{pane_width}	#{pane_height}	#{pane_active}	#{pane_current_path}	#{pane_current_command}	#{pane_title}	#{window_name}	#{window_active}	#{window_layout}	#{session_created}' \
        2>/dev/null || true)"
    trace_event "archive.panes_snapshot session=$session_name scope=session-all-windows"
    while IFS="$(printf '\t')" read -r archive_pane_session archive_pane_window \
        archive_pane_index archive_pane_id archive_pane_left archive_pane_top archive_pane_width \
        archive_pane_height archive_pane_active archive_pane_path archive_pane_command \
        archive_pane_title archive_window_name_value archive_window_active_value \
        archive_window_layout_value archive_window_created_value; do
        [ "$archive_pane_session" = "=$session_name:" ] ||
            [ "$archive_pane_session" = "$session_name" ] || continue
        if [ -z "${archive_window_seen[$archive_pane_window]+set}" ]; then
            archive_window_seen["$archive_pane_window"]=1
            archive_window_order+=( "$archive_pane_window" )
            archive_window_names["$archive_pane_window"]="$archive_window_name_value"
            archive_window_active["$archive_pane_window"]="$archive_window_active_value"
            archive_window_layouts["$archive_pane_window"]="$archive_window_layout_value"
            archive_window_created["$archive_pane_window"]="$archive_window_created_value"
            archive_window_sidebar_layout["$archive_pane_window"]="$(tmux show-option -wqv -t "=$session_name:$archive_pane_window" "$SIDEBAR_LAYOUT_OPTION" 2>/dev/null || true)"
            archive_window_sidebar_panes["$archive_pane_window"]="$(tmux show-option -wqv -t "=$session_name:$archive_pane_window" "$SIDEBAR_LAYOUT_PANES_OPTION" 2>/dev/null || true)"
            archive_window_sidebar_active["$archive_pane_window"]="$(tmux show-option -wqv -t "=$session_name:$archive_pane_window" "$SIDEBAR_LAYOUT_ACTIVE_PANE_OPTION" 2>/dev/null || true)"
            if [ -n "$archive_global_sidebar_pane" ]; then
                archive_window_sidebar_pane["$archive_pane_window"]="$(printf '%s\n' "${archive_window_sidebar_panes[$archive_pane_window]}" | tr ' ' '\n' | grep -F "$archive_global_sidebar_pane" | head -1)"
            fi
        fi
        archive_window_all_panes["$archive_pane_window"]+="${archive_window_all_panes["$archive_pane_window"]:+ }$archive_pane_id"
        [ "$archive_pane_active" = "1" ] && archive_window_all_active["$archive_pane_window"]="$archive_pane_id"
        if [ "$archive_pane_title" = "$SIDEBAR_TITLE" ]; then
            [ -n "${archive_window_sidebar_pane["$archive_pane_window"]:-}" ] ||
                archive_window_sidebar_pane["$archive_pane_window"]="$archive_pane_id"
            continue
        fi
        archive_window_pane_counts["$archive_pane_window"]=$((
            ${archive_window_pane_counts["$archive_pane_window"]:-0} + 1
        ))
        archive_pane_line="$archive_pane_index$(printf '\t')$archive_pane_id$(printf '\t')$archive_pane_left$(printf '\t')$archive_pane_top$(printf '\t')$archive_pane_width$(printf '\t')$archive_pane_height$(printf '\t')$archive_pane_active$(printf '\t')$archive_pane_path$(printf '\t')$archive_pane_command$(printf '\t')$archive_pane_title"
        archive_window_pane_lines["$archive_pane_window"]+="${archive_window_pane_lines["$archive_pane_window"]:+$'\n'}$archive_pane_line"
        archive_window_geometry["$archive_pane_window"]+="${archive_window_geometry["$archive_pane_window"]:+ }$archive_pane_left,$archive_pane_top,$archive_pane_width,$archive_pane_height,$archive_pane_active"
    done <<< "$archive_panes_snapshot"
    trace_event "archive.snapshot.end session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_snapshot_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    trace_event "archive.write.begin session=$session_name"
    if ! {
        printf 'version\t3\n'
        printf 'session\t%s\n' "$session_name"
        printf -v archived_at '%(%s)T' -1
        printf 'archived_at\t%s\n' "$archived_at"
        window_count=0
        created_value=""
        for window_index in "${archive_window_order[@]}"; do
            window_name="${archive_window_names[$window_index]}"
            window_active="${archive_window_active[$window_index]}"
            window_layout="${archive_window_layouts[$window_index]}"
            [ -n "$window_layout" ] || window_layout="-"
            window_created="${archive_window_created[$window_index]}"
            [ -n "$created_value" ] || created_value="$window_created"
        window_pane_count="${archive_window_pane_counts["$window_index"]:-0}"
        [ "$window_pane_count" -gt 0 ] || continue
        window_count=$((window_count + 1))
        # A sidebar may be fully live while its cached window option is still
        # empty (for example immediately after a direct tmux layout change).
        # Archive the live full-window layout as the fallback so restore can
        # map the sidebar and active pane instead of provisioning a fresh
        # sidebar and losing focus metadata.
        if [ -n "${archive_window_sidebar_pane[$window_index]:-}" ] &&
            [ -z "${archive_window_sidebar_layout[$window_index]:-}" ]; then
            archive_window_sidebar_layout["$window_index"]="$(tmux display-message -p -t "=$session_name:$window_index" '#{window_layout}' 2>/dev/null || true)"
            trace_event "archive.sidebar-layout.fallback session=$session_name window=$window_index layout=${archive_window_sidebar_layout[$window_index]:-none}"
        fi
        original_window_layout="$window_layout"
            window_layout="$(prepare_window_for_archive_snapshot "$session_name" "$window_index" "$window_layout")"
            [ -n "$window_layout" ] || window_layout="-"
            work_geometry="$(tmux show-option -wqv -t "=$session_name:$window_index" "$WORK_LAYOUT_GEOMETRY_OPTION" 2>/dev/null || true)"
            [ -n "$work_geometry" ] || work_geometry="${archive_window_geometry["$window_index"]:-}"
            printf 'window\t%s\t%s\t%s\t%s\t%s\n' "$window_index" "$window_name" "$window_active" "$window_layout" "$work_geometry"
            while IFS="$(printf '\t')" read -r pane_index pane_id pane_left pane_top pane_width pane_height pane_active pane_path pane_command pane_title; do
                printf 'pane\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$pane_index" "$pane_id" "$pane_left" "$pane_top" "$pane_width" "$pane_height" "$pane_active" "$pane_path" "$pane_command" "$pane_title"
            done <<< "${archive_window_pane_lines["$window_index"]:-}"
            if [ -n "${archive_window_sidebar_layout["$window_index"]:-}" ]; then
                printf 'sidebar_layout\t%s\t%s\t%s\t%s\t%s\n' \
                    "$window_index" "$original_window_layout" \
                    "${archive_window_all_panes["$window_index"]:-}" \
                    "${archive_window_all_active["$window_index"]:-}" \
                    "${archive_window_sidebar_pane["$window_index"]:-}"
            fi
            printf 'endwindow\n'
        done
        printf 'created\t%s\n' "$created_value"
        archive_shell_history
    } > "$archive_path"; then
        rm -f "$archive_path"
        trace_event "archive.write.error session=$session_name"
        return 1
    fi
    trace_event "archive.write.end session=$session_name windows=$window_count"
    trace_event "archive.window-count session=$session_name count=$window_count"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_write_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    final_path="$HISTORY_DIR/${archive_base}-${window_count}w.tsv"
    trace_event "archive.rename.begin session=$session_name"
    if ! validate_archive_file "$archive_path"; then
        rm -f "$archive_path"
        trace_event "archive.validation.error session=$session_name"
        return 1
    fi
    if ! mv "$archive_path" "$final_path"; then
        rm -f "$archive_path"
        trace_event "archive.rename.error session=$session_name"
        return 1
    fi
    archive_path_result="$final_path"
    trace_event "archive.rename.end session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_rename_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
    fi
    trace_event "archive.end session=$session_name windows=$window_count"
    if [ -n "$metrics_archive_start" ]; then
        metrics_write "op=archive phase=complete operation_id=$metrics_archive_operation_id session=$session_name windows=$window_count snapshot_us=$metrics_archive_snapshot_us write_us=$metrics_archive_write_us rename_us=$metrics_archive_rename_us total_us=$(( $(metrics_now_us) - metrics_archive_start ))"
    fi

    printf '%s\n' "$final_path"
}

archive_all_sessions()
{
    local should_archive="$1" session_name failed=0

    while IFS= read -r session_name; do
        [ -n "$session_name" ] || continue
        if [ "$should_archive" = "true" ]; then
            if ! archive_session "$session_name" >/dev/null; then
                failed=1
                trace_event "archive.all.error session=$session_name"
            fi
        fi
    done <<EOF
$(managed_session_names)
EOF
    return "$failed"
}

delete_all_sessions_after_archive()
{
    local should_archive="${1:-false}" operation_id="${2:-}" managed_sessions session_name
    local expected_owner actual_owner expected_identity expected_clients current_managed
    declare -A expected_identities=() expected_client_sets=()

    trace_event "operation.worker.begin operation_id=$operation_id type=delete-all archive=$should_archive worker=${BASHPID:-$$}"
    operation_test_delay "$operation_id"

    managed_sessions="$(managed_session_names)"
    [ -n "$managed_sessions" ] || {
        sidebar_operation_finish idle "$operation_id" || true
        return 0
    }
    expected_owner="$(owner_client_fingerprint)"
    while IFS= read -r session_name; do
        [ -n "$session_name" ] || continue
        expected_identities["$session_name"]="$(session_identity_fingerprint "$session_name")"
        expected_client_sets["$session_name"]="$(session_client_fingerprint "$session_name")"
    done <<< "$managed_sessions"

    if [ "$should_archive" = "true" ] && ! archive_all_sessions "$should_archive"; then
        trace_event "archive.all.abort reason=archive-failed"
        sidebar_operation_finish failed "$operation_id" || true
        return 1
    fi
    actual_owner="$(owner_client_fingerprint)"
    [ "$actual_owner" = "$expected_owner" ] || {
        operation_conflict "$operation_id" delete-all before-kill owner-client-changed
        return 1
    }
    while IFS= read -r session_name; do
        [ -n "$session_name" ] || continue
        expected_identity="${expected_identities[$session_name]:-}"
        expected_clients="${expected_client_sets[$session_name]:-}"
        [ "$(session_identity_fingerprint "$session_name")" = "$expected_identity" ] || {
            operation_conflict "$operation_id" delete-all before-kill session-identity-changed
            return 1
        }
        [ "$(session_client_fingerprint "$session_name")" = "$expected_clients" ] || {
            operation_conflict "$operation_id" delete-all before-kill client-set-changed
            return 1
        }
    done <<< "$managed_sessions"
    current_managed="$(tmux display-message -p '#S' 2>/dev/null || true)"
    # Kill non-current sessions first. Killing the attached client's current
    # session can terminate the run-shell worker before the remaining managed
    # sessions are processed.
    while IFS= read -r session_name; do
        [ -n "$session_name" ] || continue
        [ "$session_name" = "$current_managed" ] && continue
        tmux kill-session -t "=$session_name" 2>/dev/null || true
    done <<< "$managed_sessions"
    if [ -n "$current_managed" ] &&
        printf '%s\n' "$managed_sessions" | grep -Fxq "$current_managed"; then
        tmux kill-session -t "=$current_managed" 2>/dev/null || true
    fi
    # The attached TUI client can keep the server alive for one event-loop
    # turn after its last session is killed. If no external session remains,
    # explicitly terminate the now-empty managed server. External sessions
    # remain untouched. Record the decision before kill-server because the
    # tmux option namespace disappears with the server.
    local remaining_sessions
    remaining_sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
    if [ -z "$remaining_sessions" ]; then
        trace_event "operation.worker.server-terminate operation_id=$operation_id managed_remaining=0 external_remaining=0 result=requested"
        tmux kill-server 2>/dev/null || true
    else
        trace_event "operation.worker.server-preserved operation_id=$operation_id managed_remaining=0 external_remaining=$(printf '%s\n' "$remaining_sessions" | sed '/^$/d' | wc -l | tr -d ' ') result=preserved"
    fi
    sidebar_operation_finish idle "$operation_id" || true
    trace_event "operation.worker.end operation_id=$operation_id type=delete-all result=complete"
}

fallback_session()
{
    deleting="$1"

    tmux list-sessions -F '#{session_name}' 2>/dev/null |
        awk -v deleting="$deleting" '$0 != deleting { print; exit }'
}

shell_quote()
{
    printf '%q' "$1"
}

delete_session_after_archive()
{
    local session_name="$1"
    local should_archive="${2:-false}"
    local operation_id="${3:-}"
    local expected_identity="${4:-}" expected_clients="${5:-}" expected_owner="${6:-}"
    local current_client_session="" target_clients="" target_has_clients=false
    local next_session="" archive_fast_path=false
    local sidebar_before="" sidebar_before_session=""
    local metrics_delete_start="" metrics_delete_operation_id=""
    local metrics_delete_phase_start="" metrics_delete_preflight_us=0
    local metrics_delete_fallback_us=0 metrics_delete_archive_us=0 metrics_delete_kill_us=0

    trace_event "operation.worker.begin operation_id=$operation_id type=delete-session session=$session_name archive=$should_archive worker=${BASHPID:-$$}"
    operation_test_delay "$operation_id"
    [ -n "$expected_identity" ] || expected_identity="$(session_identity_fingerprint "$session_name")"
    [ -n "$expected_clients" ] || expected_clients="$(session_client_fingerprint "$session_name")"
    [ -n "$expected_owner" ] || expected_owner="$(owner_client_fingerprint)"
    check_delete_precondition "$session_name" "$operation_id" "$expected_identity" "$expected_clients" "$expected_owner" worker-start || return 1

    # archive_session performs the authoritative existence check.  The
    # archive fast path can therefore avoid a duplicate tmux has-session IPC;
    # delete-only keeps the original early return semantics below.
    if [ "$should_archive" != "true" ]; then
        session_exists "$session_name" || {
            sidebar_operation_finish idle "$operation_id" || true
            return 0
        }
    fi

    if [ -n "$METRICS_FILE" ]; then
        metrics_delete_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_delete_operation_id="$metrics_operation_id_result"
        metrics_phase=action
        metrics_delete_phase_start="$(metrics_now_us)"
    fi

    # Capture the target's client attachment as data.  `list-clients` exits
    # successfully for an existing session even when it has no clients, so
    # checking only its exit status cannot distinguish the fast-path case.
    if ! target_clients="$(tmux list-clients -t "=$session_name" -F '#{client_control_mode}|#{session_name}' 2>/dev/null |
        awk -F '|' '$1 != 1 { print $2 }')"; then
        sidebar_operation_finish idle "$operation_id" || true
        return 0
    fi
    [ -n "$target_clients" ] && target_has_clients=true
    if [ -n "$metrics_delete_start" ]; then
        metrics_delete_preflight_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
        metrics_delete_phase_start="$(metrics_now_us)"
    fi
    if [ "$should_archive" = "true" ] && [ "$target_has_clients" = false ]; then
        archive_fast_path=true
        # An unconnected target cannot require client migration.  Let tmux
        # remove the last session naturally instead of spending another IPC
        # round trip discovering a fallback session.
        next_session=""
    else
        session_exists "$session_name" || {
            sidebar_operation_finish idle "$operation_id" || true
            return 0
        }
        next_session="$(fallback_session "$session_name")"
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_fallback_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        current_client_session="$(tmux display-message -p '#S' 2>/dev/null || true)"
    fi

    debug_log "delete_session_after_archive start session=$session_name should_archive=$should_archive current_client_session=$current_client_session target_has_clients=$target_has_clients next_session=$next_session archive_fast_path=$archive_fast_path"

    if [ "$archive_fast_path" = false ] &&
        { [ "$current_client_session" = "$session_name" ] || [ "$target_has_clients" = true ]; }; then
        if [ -n "$next_session" ]; then
            debug_log "delete_session_after_archive switch-client to fallback session=$next_session from session=$session_name"
            tmux switch-client -t "=$next_session" 2>/dev/null || true
            trace_event "delete.native-switch session=$session_name fallback=$next_session"
        else
            debug_log "delete_session_after_archive no fallback session for session=$session_name"
        fi
    fi

    if [ "$should_archive" = "true" ]; then
        debug_log "delete_session_after_archive archive session=$session_name"
        trace_event "archive.delete-wrapper.begin session=$session_name"
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        if ! archive_session "$session_name" true >/dev/null; then
            trace_event "operation.worker.end operation_id=$operation_id type=delete-session session=$session_name result=archive-failed"
            sidebar_operation_finish failed "$operation_id" || true
            return 1
        fi
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_archive_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        trace_event "archive.delete-wrapper.end session=$session_name"
    fi

    if ! check_delete_precondition "$session_name" "$operation_id" "$expected_identity" "$expected_clients" "$expected_owner" before-kill; then
        if [ -n "${archive_path_result:-}" ]; then
            rm -f "$archive_path_result" "${archive_path_result}${ARCHIVE_HISTORY_MARKER_SUFFIX}" 2>/dev/null || true
            trace_event "operation.conflict.archive-preserved operation_id=$operation_id path=$archive_path_result"
        fi
        return 1
    fi

    if [ "$archive_fast_path" = true ]; then
        debug_log "delete_session_after_archive kill-session fast path session=$session_name"
        tmux kill-session -t "=$session_name" 2>/dev/null || true
    elif [ -n "$next_session" ]; then
        debug_log "delete_session_after_archive kill-session session=$session_name next_session=$next_session"
        tmux switch-client -t "=$next_session" 2>/dev/null || true
        tmux kill-session -t "=$session_name" 2>/dev/null || true
    else
        debug_log "delete_session_after_archive kill-server session=$session_name"
        tmux kill-server
    fi

    # Deletion changes the session snapshot for every window-local sidebar,
    # not only the sidebar that initiated the action.  Without an explicit
    # fan-out refresh, another sidebar can keep a deleted numeric session (in
    # particular `0`) visible and accept it as a stale Enter target.
    if tmux list-sessions >/dev/null 2>&1; then
        trace_event "delete.refresh-managed begin deleted=$session_name operation_id=$operation_id"
        signal_managed_sidebar_refresh
        trace_event "delete.refresh-managed end deleted=$session_name operation_id=$operation_id"
    fi

    if [ -n "$metrics_delete_start" ]; then
        metrics_delete_kill_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
        metrics_write "op=archive-wrapper phase=complete operation_id=$metrics_delete_operation_id session=$session_name fast_path=$archive_fast_path preflight_us=$metrics_delete_preflight_us fallback_lookup_us=$metrics_delete_fallback_us archive_us=$metrics_delete_archive_us kill_us=$metrics_delete_kill_us total_us=$(( $(metrics_now_us) - metrics_delete_start ))"
    fi
    sidebar_operation_finish idle "$operation_id" || true
    trace_event "operation.worker.end operation_id=$operation_id type=delete-session session=$session_name result=complete"
}

run_session_delete()
{
    local session_name="$1" should_archive="$2"
    local expected_identity expected_clients expected_owner
    new_sidebar_operation_id
    local operation_id="$sidebar_operation_id_result"
    expected_identity="$(session_identity_fingerprint "$session_name")"
    expected_clients="$(session_client_fingerprint "$session_name")"
    expected_owner="$(owner_client_fingerprint)"
    local quoted_script="$(shell_quote "$SCRIPT_PATH")"
    local quoted_session="$(shell_quote "$session_name")"
    local quoted_archive="$(shell_quote "$should_archive")"
    local quoted_operation="$(shell_quote "$operation_id")"
    local quoted_identity="$(shell_quote "$expected_identity")"
    local quoted_clients="$(shell_quote "$expected_clients")"
    local quoted_owner="$(shell_quote "$expected_owner")"

    debug_log "run_session_delete session=$session_name should_archive=$should_archive operation_id=$operation_id"
    trace_event "operation.begin operation_id=$operation_id type=delete-session session=$session_name archive=$should_archive"
    sidebar_operation_set deleting "$operation_id"
    if ! tmux run-shell -b "$quoted_script --delete-session-after-archive $quoted_session $quoted_archive $quoted_operation $quoted_identity $quoted_clients $quoted_owner"; then
        sidebar_operation_finish failed "$operation_id" || true
        trace_event "operation.launch.error operation_id=$operation_id type=delete-session session=$session_name"
        return 1
    fi
    trace_event "operation.launch operation_id=$operation_id type=delete-session session=$session_name"
}

run_all_sessions_delete()
{
    should_archive="$1"
    new_sidebar_operation_id
    operation_id="$sidebar_operation_id_result"
    quoted_script="$(shell_quote "$SCRIPT_PATH")"
    quoted_archive="$(shell_quote "$should_archive")"
    quoted_operation="$(shell_quote "$operation_id")"

    trace_event "operation.begin operation_id=$operation_id type=delete-all archive=$should_archive"
    sidebar_operation_set deleting "$operation_id"
    if ! tmux run-shell -b "$quoted_script --delete-all-sessions-after-archive $quoted_archive $quoted_operation"; then
        sidebar_operation_finish failed "$operation_id" || true
        trace_event "operation.launch.error operation_id=$operation_id type=delete-all"
        return 1
    fi
    trace_event "operation.launch operation_id=$operation_id type=delete-all"
}

archive_selected_indices()
{
    selected_any=false
    for index in "${!history_files[@]}"; do
        if [ "${history_checked[$index]}" = "true" ]; then
            printf '%s\n' "$index"
            selected_any=true
        fi
    done

    if [ "$selected_any" = "false" ] && [ "${#history_files[@]}" -gt 0 ]; then
        printf '%s\n' "$history_index"
    fi
}

restore_abort()
{
    local reason="$1"
    [ "${restore_batch_mode:-false}" = true ] ||
        tmux set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
    trace_event "restore.abort session=${restore_name:-unknown} reason=$reason"
    if [ -n "${restore_client_tty:-}" ] && [ -n "${restore_original_session:-}" ] &&
        session_exists "$restore_original_session"; then
        tmux switch-client -c "$restore_client_tty" -t "=$restore_original_session" 2>/dev/null || true
    fi
    if [ "${created:-false}" = true ] && [ -n "${restore_name:-}" ] &&
        [ "$(session_identity_fingerprint "$restore_name")" = "${restore_created_identity:-}" ]; then
        tmux kill-session -t "=$restore_name" 2>/dev/null || true
    elif [ "${created:-false}" = true ] && [ -n "${restore_name:-}" ]; then
        trace_event "operation.conflict.restore-preserved operation_id=${restore_operation_id:-none} session=$restore_name"
    fi
    if [ "${restore_batch_mode:-false}" != true ]; then
        sidebar_operation_finish failed "${restore_operation_id:-${metrics_restore_operation_id:-restore-$reason}}" || true
    fi
    return 1
}

restore_archive()
{
    archive_path="$1"
    [ -f "$archive_path" ] || return 1
    local metrics_restore_start="" metrics_restore_operation_id="" restore_operation_id="${2:-}"
    restore_batch_mode="${3:-false}"
    local restore_client_tty="" restore_original_session="" sidebar_pane_before="" sidebar_pid_before=""
    local restore_original_identity="" restore_owner_identity="" restore_created_identity=""
    declare -A restore_window_targets=()
    declare -A restore_window_work_panes=()
    declare -A restore_window_sidebar_layouts=()
    declare -A restore_window_sidebar_panes=()
    declare -A restore_window_sidebar_active=()
    declare -A restore_window_sidebar_pane=()
    declare -A restore_window_active_work_panes=()
    if [ -z "$restore_operation_id" ]; then
        new_sidebar_operation_id
        restore_operation_id="$sidebar_operation_id_result"
    fi
    if [ -n "$METRICS_FILE" ]; then
        metrics_restore_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_restore_operation_id="$metrics_operation_id_result"
    fi
    trace_event "operation.begin operation_id=$restore_operation_id type=restore archive=$archive_path"
    # The parent owns the shared operation state during a batch. Background
    # workers must not overwrite that owner ID or the finalizer would observe
    # a false ownership conflict.
    [ "$restore_batch_mode" = true ] || sidebar_operation_set restoring "$restore_operation_id"
    # tmux fires after-new-session/after-new-window asynchronously while the
    # archive is being materialized. Those hooks must not provision or move a
    # sidebar in the middle of the restore transaction; the explicit restore
    # path provisions it once after pane identity and layout are complete.
    tmux set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 1 2>/dev/null || true
    trace_event "restore.topology-guard.begin operation_id=$restore_operation_id"
    operation_test_delay "$restore_operation_id"
    archive_version="$(awk -F '\t' '$1 == "version" { print $2; exit }' "$archive_path")"
    case "$archive_version" in
        2|3) trace_event "restore.archive-format version=$archive_version" ;;
        *) archive_version=1; trace_event "restore.archive-format version=1 legacy" ;;
    esac
    if { [ "$archive_version" = 2 ] || [ "$archive_version" = 3 ]; } && ! validate_archive_file "$archive_path"; then
        trace_event "restore.abort session=${restore_name:-unknown} reason=invalid-archive"
        [ "$restore_batch_mode" = true ] || sidebar_operation_finish failed "$restore_operation_id" || true
        return 1
    fi
    restore_client_tty="$(sidebar_owner_client)"
    [ -n "$restore_client_tty" ] || restore_client_tty="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}' 2>/dev/null |
        awk -F '|' '$1 != 1 { print $2; exit }' || true)"
    if [ -n "$restore_client_tty" ]; then
        restore_original_session="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}|#{session_name}' 2>/dev/null |
            awk -F '|' -v tty="$restore_client_tty" '$1 != 1 && $2 == tty { print $3; exit }' || true)"
    fi

    original_name="$(awk -F '\t' '$1 == "session" { print $2; exit }' "$archive_path")"
    [ -n "$original_name" ] || original_name="restored"

    restore_name="$original_name"
    restore_original_identity="$(session_identity_fingerprint "$restore_original_session")"
    restore_owner_identity="$(owner_client_fingerprint "$restore_client_tty")"
    if session_exists "$restore_name"; then
        message_line "Exists: $restore_name"
        [ "$restore_batch_mode" = true ] || sidebar_operation_finish failed "$restore_operation_id" || true
        return 1
    fi

    created=false
    current_window=""
    current_window_target=""
    current_window_pane_ids=""
    first_window=true
    first_pane_in_window=true
    active_window=""
    active_window_target=""
    active_window_index=""
    window_layout=""
    window_geometry=""
    current_window_active_pane=""
    created_target=""
    pane_id=""
    restored_work_pane_ids=""

    while IFS="$(printf '\t')" read -r record a b c d e f g h i j; do
        case "$record" in
            window)
                if [ "$first_window" = "false" ] && [ -n "$current_window_target" ]; then
                    if ! apply_restored_window_layout "$current_window_target" "$window_layout" "$current_window_pane_ids" "$window_geometry"; then
                        restore_abort layout
                        return 1
                    fi
                    if ! restore_window_focus "$current_window_target" "$current_window_active_pane"; then
                        restore_abort focus
                        return 1
                    fi
                fi
                window_index="$a"
                window_name="$b"
                window_active="$c"
                window_layout="$d"
                window_geometry="${e:-}"
                # '-' preserves an intentionally empty layout field across
                # Bash's tab-delimited `read`; do not let geometry shift into
                # the layout slot and reach tmux select-layout.
                [ "$window_layout" = "-" ] && window_layout=""
                current_window="$window_name"
                current_window_target=""
                current_window_pane_ids=""
                current_window_active_pane=""
                first_pane_in_window=true
                if [ "$window_active" = "1" ]; then
                    active_window="$window_name"
                    active_window_index="$window_index"
                fi
                trace_event "restore.window.begin session=$restore_name index=$window_index name=$window_name active=$window_active"
                ;;
            sidebar_layout)
                restore_window_sidebar_layouts["$a"]="$b"
                restore_window_sidebar_panes["$a"]="$c"
                restore_window_sidebar_active["$a"]="$d"
                restore_window_sidebar_pane["$a"]="$e"
                trace_event "restore.sidebar-layout.archive index=$a panes=$c sidebar=$e"
                ;;
            pane)
                trace_event "restore.pane.begin session=$restore_name window=$current_window index=$a"
                if [ "$archive_version" = 2 ] || [ "$archive_version" = 3 ]; then
                    archive_pane_id="$b"
                    archive_pane_geometry="$c,$d,$e,$f,$g"
                    pane_path="$h"
                    pane_command="$i"
                    pane_title="$j"
                    trace_event "restore.identity.archive window=$current_window index=$a pane=$archive_pane_id geometry=$archive_pane_geometry"
                else
                    pane_path="$b"
                    pane_command="$c"
                    pane_title=""
                fi
                [ -d "$pane_path" ] || pane_path="$HOME"
                if [ "$created" = "false" ]; then
                    new_target="$(
                        tmux new-session -d -P -F '#{window_id}|#{pane_id}' \
                            -s "$restore_name" -n "$current_window" -c "$pane_path"
                    )"
                    IFS='|' read -r created_target pane_id <<< "$new_target"
                    current_window_target="$created_target"
                    current_window_pane_ids="${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                    restore_window_targets["$window_index"]="$created_target"
                    [ "$window_active" = "1" ] && active_window_target="$created_target"
                    created=true
                    first_window=false
                    first_pane_in_window=false
                elif [ "$first_pane_in_window" = "true" ]; then
                    new_target="$(
                        tmux new-window -P -F '#{window_id}|#{pane_id}' \
                            -t "=$restore_name:" -n "$current_window" -c "$pane_path"
                    )"
                    IFS='|' read -r created_target pane_id <<< "$new_target"
                    current_window_target="$created_target"
                    current_window_pane_ids="${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                    restore_window_targets["$window_index"]="$created_target"
                    [ "$window_active" = "1" ] && active_window_target="$created_target"
                    first_pane_in_window=false
                else
                    pane_id="$(tmux split-window -P -F '#{pane_id}' -t "$current_window_target" -c "$pane_path")"
                    current_window_pane_ids="${current_window_pane_ids}${current_window_pane_ids:+ }${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                fi
                if [ -n "${pane_title:-}" ]; then
                    tmux select-pane -t "$pane_id" -T "$pane_title" 2>/dev/null || true
                fi
                if { [ "$archive_version" = 2 ] || [ "$archive_version" = 3 ]; } && [ "$g" = "1" ]; then
                    current_window_active_pane="$pane_id"
                fi
                trace_event "restore.pane.end session=$restore_name window=$current_window pane=$pane_id"
                ;;
            endwindow)
                if [ -n "$current_window_target" ]; then
                    if ! apply_restored_window_layout "$current_window_target" "$window_layout" "$current_window_pane_ids" "$window_geometry"; then
                        restore_abort layout
                        return 1
                    fi
                    if ! restore_window_focus "$current_window_target" "$current_window_active_pane"; then
                        restore_abort focus
                        return 1
                    fi
                fi
                if [ -n "$current_window" ]; then
                    tmux rename-window -t "$current_window_target" "$current_window" >/dev/null 2>&1 || {
                        trace_event "restore.window.error session=$restore_name index=$window_index reason=rename"
                        restore_abort window-name
                        return 1
                    }
                    trace_event "restore.window.end session=$restore_name index=$window_index target=$current_window_target name=$current_window"
                fi
                restore_window_work_panes["$window_index"]="$current_window_pane_ids"
                restore_window_active_work_panes["$window_index"]="$current_window_active_pane"
                current_window=""
                current_window_target=""
                current_window_pane_ids=""
                current_window_active_pane=""
                ;;
        esac
    done < "$archive_path"
    trace_event "restore.panes.end session=$restore_name created=$created"

    restore_created_identity="$(session_identity_fingerprint "$restore_name")"
    check_restore_precondition "$restore_operation_id" after-create "$restore_owner_identity" "$restore_original_session" "$restore_original_identity" "$restore_name" || {
        restore_abort external-conflict
        return 1
    }

    if [ "$created" = "false" ]; then
        create_session_with_active_client_geometry "$restore_name" "$HOME"
    fi
    mark_session_managed "$restore_name" || true

    if [ -n "$active_window_target" ]; then
        trace_event "restore.select-window.begin session=$restore_name target=$active_window_target name=$active_window"
        if ! tmux select-window -t "$active_window_target" >/dev/null 2>&1; then
            restore_abort select-window
            return 1
        fi
        trace_event "restore.select-window.end session=$restore_name target=$active_window_target"
    fi
    selected_session="$restore_name"
    restore_client_tty="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}' 2>/dev/null |
        awk -F '|' '$1 != 1 { print $2; exit }' || true)"
    trace_event "restore.sidebar.provision.begin session=$restore_name model=window-local"
    if ! ensure_sidebar_for_session "$restore_name" "$(sidebar_width)" "$restore_batch_mode"; then
        restore_abort ensure-sidebar
        return 1
    fi
    # A restored session can contain more than one window. The session-level
    # helper provisions the first window only, so explicitly provision every
    # restored target before applying each archived full-window layout.
    for restore_window_target in "${restore_window_targets[@]}"; do
        [ -n "$restore_window_target" ] || continue
        if ! provision_sidebar_window "$restore_window_target" "$(sidebar_width)"; then
            trace_event "restore.sidebar.provision.error session=$restore_name window=$restore_window_target"
            restore_abort ensure-sidebar
            return 1
        fi
        if [ "$restore_batch_mode" != true ] &&
            ! wait_for_sidebar_window_ready "$restore_window_target"; then
            trace_event "restore.sidebar.ready-timeout session=$restore_name window=$restore_window_target"
            restore_abort ensure-sidebar-ready
            return 1
        fi
    done
    # Restore is a cold path. Do not expose the restored session until every
    # local sidebar has rendered the restored session name and the active
    # window has a ready input boundary.
    if [ "$restore_batch_mode" != true ]; then
        wait_for_managed_sidebar_session "$restore_name" "$active_window_target" || {
            trace_event "restore.sidebar.ready-timeout session=$restore_name"
            restore_abort ensure-sidebar-ready
            return 1
        }
    fi
    # The work-only layout is needed while panes are created, but the final
    # user-visible geometry also includes the sidebar. Reapply the archived
    # full-window layout only after the new sidebar pane has been provisioned
    # and mapped to the archived pane identity.
    for window_index in "${!restore_window_targets[@]}"; do
        if [ -n "${restore_window_sidebar_layouts[$window_index]:-}" ]; then
            restore_archived_sidebar_layout \
                "${restore_window_targets[$window_index]}" \
                "${restore_window_sidebar_layouts[$window_index]}" \
                "${restore_window_sidebar_panes[$window_index]:-}" \
                "${restore_window_sidebar_active[$window_index]:-}" \
                "${restore_window_sidebar_pane[$window_index]:-}" \
                "${restore_window_work_panes[$window_index]:-}" || {
                restore_abort sidebar-layout
                return 1
            }
        fi
    done
    trace_event "restore.sidebar.provision.end session=$restore_name model=window-local"
    check_restore_precondition "$restore_operation_id" before-client-switch "$restore_owner_identity" "$restore_original_session" "$restore_original_identity" "$restore_name" || {
        restore_abort external-conflict
        return 1
    }
    if [ "$restore_batch_mode" = true ]; then
        trace_event "restore.prepare.complete operation_id=$restore_operation_id session=$restore_name"
    else
        trace_event "restore.switch-client.begin session=$restore_name client=$restore_client_tty"
        if [ -n "$restore_client_tty" ]; then
            if ! sidebar_tmux_switch_client "$restore_client_tty" "$restore_name" 2>/dev/null; then
                restore_abort switch-client
                return 1
            fi
        else
            if ! tmux switch-client -t "$(sidebar_tmux_session_target "$restore_name")" 2>/dev/null; then
                restore_abort switch-client
                return 1
            fi
        fi
        trace_event "restore.switch-client.end session=$restore_name"
        for restore_window_index in "${!restore_window_targets[@]}"; do
            restore_focus_target="${restore_window_active_work_panes[$restore_window_index]:-}"
            [ -n "$restore_focus_target" ] || continue
            tmux select-pane -t "$restore_focus_target" >/dev/null 2>&1 || {
                restore_abort sidebar-focus
                return 1
            }
            restore_focus_now="$(tmux list-panes -t "${restore_window_targets[$restore_window_index]}" -F '#{pane_id}|#{pane_active}' 2>/dev/null | awk -F '|' '$2 == 1 { print $1; exit }')"
            trace_event "restore.focus.after-switch target=${restore_window_targets[$restore_window_index]} expected=$restore_focus_target actual=${restore_focus_now:-none}"
        done
        for restore_window_index in "${!restore_window_targets[@]}"; do
            restore_window_active_now="$(tmux list-panes -t "${restore_window_targets[$restore_window_index]}" -F '#{pane_id}|#{pane_active}|#{pane_title}' 2>/dev/null | awk -F '|' '$2 == 1 { print; exit }')"
            trace_event "restore.window-active phase=after-switch index=$restore_window_index target=${restore_window_targets[$restore_window_index]} active=${restore_window_active_now:-none}"
        done
        restore_active_window="$(tmux display-message -p -t "$restore_client_tty" '#{window_id}' 2>/dev/null || true)"
        if [ -n "$restore_active_window" ]; then
            wait_for_sidebar_window_ready "$restore_active_window" || {
                trace_event "restore.sidebar.active-ready-timeout session=$restore_name window=$restore_active_window"
                restore_abort ensure-active-sidebar-ready
                return 1
            }
        fi
        current_session="$restore_name"
        trace_event "restore.history.begin session=$restore_name"
        if ! append_archive_history_once "$archive_path"; then
            restore_abort history-import
            return 1
        fi
        trace_event "restore.history.end session=$restore_name"
        for restore_window_index in "${!restore_window_targets[@]}"; do
            restore_window_active_now="$(tmux list-panes -t "${restore_window_targets[$restore_window_index]}" -F '#{pane_id}|#{pane_active}|#{pane_title}' 2>/dev/null | awk -F '|' '$2 == 1 { print; exit }')"
            trace_event "restore.window-active phase=before-complete index=$restore_window_index target=${restore_window_targets[$restore_window_index]} active=${restore_window_active_now:-none}"
        done
    fi
    if [ -n "$metrics_restore_start" ]; then
        metrics_write "op=restore phase=complete operation_id=$metrics_restore_operation_id session=$restore_name duration_us=$(( $(metrics_now_us) - metrics_restore_start )) sidebar_mode=$SIDEBAR_ASYNC_RESTORE"
    fi
    if [ "$restore_batch_mode" = true ]; then
        trace_event "operation.prepare.complete operation_id=$restore_operation_id type=restore session=$restore_name"
    else
        sidebar_operation_finish idle "$restore_operation_id" || true
        tmux set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        trace_event "restore.topology-guard.end operation_id=$restore_operation_id result=complete"
        trace_event "operation.complete operation_id=$restore_operation_id type=restore session=$restore_name"
    fi
}

wait_for_sidebar_transition()
{
    local target_session="$1"
    local client_tty="${2:-}"
    local expected_pid="${3:-}"
    local deadline=$(( $(date +%s%N) / 1000000 + 3000 ))
    local sidebar_pane owner_session client_session client_window sidebar_window active_pane sidebar_pid sidebar_tty sidebar_input_off
    local input_ready transition_signature="" previous_signature="" transition_reason=""
    local stable_samples=0

    fault_injection transition || return 1

    while [ "$(( $(date +%s%N) / 1000000 ))" -lt "$deadline" ]; do
        sidebar_pane="$(find_global_sidebar_pane || true)"
        owner_session="$(sidebar_tmux_pane_session "$sidebar_pane" || true)"
        # This function is an observation barrier. Do not mutate client or
        # pane focus while polling readiness: repeated switch-client/select-
        # pane calls expose intermediate redraws and can retrigger hooks.
        client_session="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}|#{session_name}' 2>/dev/null |
            awk -F '|' -v tty="$client_tty" '$1 != 1 && $2 == tty { print $3; exit }')"
        client_window="$(tmux display-message -p -t "$client_tty" '#{window_id}' 2>/dev/null || true)"
        sidebar_window="$(sidebar_tmux_pane_window "$sidebar_pane" || true)"
        active_pane="$(tmux display-message -p -t "$client_tty" '#{pane_id}' 2>/dev/null || true)"
        sidebar_pid="$(tmux display-message -p -t "$sidebar_pane" '#{pane_pid}' 2>/dev/null || true)"
        sidebar_tty="$(tmux display-message -p -t "$sidebar_pane" '#{pane_tty}' 2>/dev/null || true)"
        sidebar_input_off="$(tmux display-message -p -t "$sidebar_pane" '#{pane_input_off}' 2>/dev/null || true)"
        input_ready="$(tmux show-option -gqv "$SIDEBAR_INPUT_READY_OPTION" 2>/dev/null || true)"
        transition_reason="sidebar-pane"
        [ -n "$sidebar_pane" ] && transition_reason="owner-session"
        [ "$owner_session" = "$target_session" ] && transition_reason="client-session"
        [ "$client_session" = "$target_session" ] && transition_reason="client-window"
        [ "$client_window" = "$sidebar_window" ] && transition_reason="active-pane"
        [ "$active_pane" = "$sidebar_pane" ] && transition_reason="sidebar-pid"
        { [ -z "$expected_pid" ] || [ "$sidebar_pid" = "$expected_pid" ]; } && transition_reason="ready"
        transition_signature="$transition_reason|$sidebar_pane|$owner_session|$client_session|$client_window|$sidebar_window|$active_pane|$sidebar_pid|$sidebar_tty|$sidebar_input_off|$input_ready"
        if [ "$transition_signature" != "$previous_signature" ]; then
            trace_event "transition.check action_id=${current_action_id:-none} target=$target_session reason=$transition_reason sidebar=$sidebar_pane owner=$owner_session client=$client_session client_window=$client_window sidebar_window=$sidebar_window active=$active_pane pid=$sidebar_pid sidebar_tty=$sidebar_tty input_off=${sidebar_input_off:-unset} expected_pid=${expected_pid:-none} input_ready=${input_ready:-unset} stable_samples=$stable_samples"
            previous_signature="$transition_signature"
        fi
        if [ -n "$sidebar_pane" ] &&
            [ "$owner_session" = "$target_session" ] &&
            [ "$client_session" = "$target_session" ] &&
            [ "$client_window" = "$sidebar_window" ] &&
            [ "$active_pane" = "$sidebar_pane" ] &&
            { [ -z "$expected_pid" ] || [ "$sidebar_pid" = "$expected_pid" ]; }; then
            stable_samples=$((stable_samples + 1))
        else
            stable_samples=0
        fi
        if [ "$stable_samples" -ge 2 ]; then
            trace_event "transition.ready action_id=${current_action_id:-none} target=$target_session elapsed_ms=$(( 3000 - (deadline - $(date +%s%N) / 1000000) )) stable_samples=$stable_samples input_ready=${input_ready:-unset}"
            return 0
        fi
        sleep 0.02
    done
    trace_event "transition.timeout action_id=${current_action_id:-none} target=$target_session reason=${transition_reason:-unknown}"
    return 1
}

wait_for_batch_sidebar_content()
{
    local attempt archive_path session_name_value window_id ready
    for attempt in $(seq 1 200); do
        ready=1
        for archive_path in "$@"; do
            session_name_value="$(awk -F '\t' '$1 == "session" { print $2; exit }' "$archive_path" 2>/dev/null || true)"
            window_id="$(sidebar_tmux_session_window "$session_name_value" || true)"
            if [ -z "$window_id" ] || ! sidebar_content_ready "$window_id" "$session_name_value"; then
                ready=0
                break
            fi
        done
        if [ "$ready" -eq 1 ]; then
            trace_event "sidebar.batch-content-ready archives=$# attempts=$attempt result=ready"
            return 0
        fi
        sleep 0.01
    done
    trace_event "sidebar.batch-content-ready archives=$# attempts=200 result=timeout"
    return 1
}

restore_batch_finalize()
{
    local operation_id="$1" target_session="$2" restored_count="$3"
    local selected_count="$4" client_tty target_window restore_active_window
    local archive_path history_imported=0 history_failed=0 finalize_start
    shift 4
    finalize_start="$(metrics_now_us)"
    client_tty="$(sidebar_owner_client || true)"
    [ -n "$client_tty" ] || client_tty="$(tmux list-clients -F '#{client_control_mode}|#{client_tty}' 2>/dev/null |
        awk -F '|' '$1 != 1 { print $2; exit }' || true)"
    trace_event "restore.batch.finalize.begin operation_id=$operation_id target=$target_session client=$client_tty restored=$restored_count selected=$selected_count"

    local expected_owner="$(owner_client_fingerprint "$client_tty")"
    if [ -z "$target_session" ] || [ -z "$client_tty" ] ||
        [ "$(owner_client_fingerprint)" != "$expected_owner" ] ||
        ! session_exists "$target_session"; then
        trace_event "operation.precondition operation_id=$operation_id kind=restore phase=batch-finalize expected-owner=$expected_owner actual-owner=$(owner_client_fingerprint) target=$target_session"
        trace_event "restore.batch.finalize.error operation_id=$operation_id reason=precondition"
        restore_batch_mode=false
        sidebar_operation_finish failed "$operation_id" || true
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        return 1
    fi

    trace_event "sidebar.batch-refresh.begin operation_id=$operation_id"
    signal_managed_sidebar_refresh_batch
    if ! wait_for_managed_sidebar_snapshot; then
        trace_event "restore.batch.finalize.error operation_id=$operation_id reason=managed-sidebar-snapshot-not-ready"
        restore_batch_mode=false
        sidebar_operation_finish failed "$operation_id" || true
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        return 1
    fi
    trace_event "sidebar.batch-refresh.end operation_id=$operation_id result=ready"
    if ! sidebar_tmux_switch_client "$client_tty" "$target_session" 2>/dev/null; then
        trace_event "restore.batch.finalize.error operation_id=$operation_id reason=switch-client target=$target_session"
        restore_batch_mode=false
        sidebar_operation_finish failed "$operation_id" || true
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        return 1
    fi
    restore_active_window="$(sidebar_tmux_cmd display-message -p -t "$client_tty" '#{window_id}' 2>/dev/null || true)"
    target_window="$(sidebar_tmux_session_window "$target_session" || true)"
    wait_for_managed_sidebar_session "$target_session" "${restore_active_window:-$target_window}" || {
        trace_event "restore.batch.finalize.error operation_id=$operation_id reason=sidebar-not-ready target=$target_session"
        restore_batch_mode=false
        sidebar_operation_finish failed "$operation_id" || true
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        return 1
    }
    [ -n "$restore_active_window" ] && wait_for_sidebar_window_ready "$restore_active_window" || true
    current_session="$target_session"

    while [ "$#" -gt 0 ]; do
        archive_path="$1"
        shift
        if append_archive_history_once "$archive_path"; then
            history_imported=$((history_imported + 1))
        else
            history_failed=$((history_failed + 1))
            trace_event "restore.batch.history.error operation_id=$operation_id archive=$archive_path"
        fi
    done
    restore_batch_mode=false
    sidebar_operation_finish idle "$operation_id" || true
    sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
    local finalize_duration_us=$(( $(metrics_now_us) - finalize_start ))
    [ -n "$METRICS_FILE" ] && metrics_write "op=batch-restore phase=finalize operation_id=$operation_id target=$target_session restored=$restored_count selected=$selected_count history=$history_imported/$restored_count history_failed=$history_failed duration_us=$finalize_duration_us"
    trace_event "restore.batch.finalize.end operation_id=$operation_id target=$target_session history=$history_imported/$restored_count history_failed=$history_failed duration_us=$finalize_duration_us"
    return 0
}

restore_selected_archives()
{
    local selected_count=0 restored_count=0 index archive_path archive_session
    local batch_operation_id target_session batch_start batch_duration_us concurrency active_count=0
    local wait_pid wait_status
    local -a selected_indices=() restored_archives=() restored_sessions=()
    local -a batch_pids=()
    declare -A batch_pid_archives=() batch_pid_sessions=()
    while IFS= read -r index; do
        [ -n "$index" ] || continue
        selected_indices+=("$index")
    done <<EOF
$(archive_selected_indices)
EOF
    selected_count="${#selected_indices[@]}"
    debug_log "history restore selected count=$selected_count index=$history_index file=${history_files[$history_index]:-none}"

    if [ "$selected_count" -le 1 ]; then
        for index in "${selected_indices[@]}"; do
            new_sidebar_operation_id
            if restore_archive "${history_files[$index]}" "$sidebar_operation_id_result" false; then
                restored_count=$((restored_count + 1))
            else
                message_line "Restore failed: ${history_titles[$index]:-archive-$index}"
            fi
        done
    else
        batch_start="$(metrics_now_us)"
        new_sidebar_operation_id
        batch_operation_id="$sidebar_operation_id_result"
        sidebar_operation_set restoring "$batch_operation_id"
        sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 1 2>/dev/null || true
        trace_event "restore.batch.begin operation_id=$batch_operation_id selected=$selected_count"
        [ -n "$METRICS_FILE" ] && metrics_write "op=batch-restore phase=begin operation_id=$batch_operation_id selected=$selected_count"
        message_line "Restoring: 0/$selected_count"
        concurrency="${TMUX_SESSION_RESTORE_CONCURRENCY:-2}"
        case "$concurrency" in
            ''|*[!0-9]*) concurrency=2 ;;
        esac
        [ "$concurrency" -gt 0 ] || concurrency=1
        for index in "${selected_indices[@]}"; do
            archive_path="${history_files[$index]}"
            archive_session="$(awk -F '\t' '$1 == "session" { print $2; exit }' "$archive_path" 2>/dev/null || true)"
            while [ "$active_count" -ge "$concurrency" ]; do
                wait_pid="${batch_pids[0]}"
                if wait "$wait_pid"; then
                    wait_status=0
                else
                    wait_status=$?
                fi
                if [ "$wait_status" -eq 0 ]; then
                    restored_count=$((restored_count + 1))
                    restored_archives+=("${batch_pid_archives[$wait_pid]}")
                    restored_sessions+=("${batch_pid_sessions[$wait_pid]}")
                    trace_event "restore.batch.progress operation_id=$batch_operation_id completed=$restored_count selected=$selected_count"
                else
                    message_line "Restore failed: ${batch_pid_sessions[$wait_pid]:-archive}"
                fi
                unset 'batch_pid_archives[$wait_pid]' 'batch_pid_sessions[$wait_pid]'
                batch_pids=("${batch_pids[@]:1}")
                active_count=$((active_count - 1))
            done
            (restore_archive "$archive_path" "$batch_operation_id" true >/dev/null 2>&1) &
            wait_pid=$!
            batch_pids+=("$wait_pid")
            batch_pid_archives["$wait_pid"]="$archive_path"
            batch_pid_sessions["$wait_pid"]="$archive_session"
            active_count=$((active_count + 1))
        done
        while [ "$active_count" -gt 0 ]; do
            wait_pid="${batch_pids[0]}"
            if wait "$wait_pid"; then
                wait_status=0
            else
                wait_status=$?
            fi
            if [ "$wait_status" -eq 0 ]; then
                restored_count=$((restored_count + 1))
                restored_archives+=("${batch_pid_archives[$wait_pid]}")
                restored_sessions+=("${batch_pid_sessions[$wait_pid]}")
                trace_event "restore.batch.progress operation_id=$batch_operation_id completed=$restored_count selected=$selected_count"
            else
                message_line "Restore failed: ${batch_pid_sessions[$wait_pid]:-archive}"
            fi
            unset 'batch_pid_archives[$wait_pid]' 'batch_pid_sessions[$wait_pid]'
            batch_pids=("${batch_pids[@]:1}")
            active_count=$((active_count - 1))
        done
        if [ "$restored_count" -gt 0 ]; then
            target_session="${restored_sessions[0]}"
            restore_batch_finalize "$batch_operation_id" "$target_session" "$restored_count" "$selected_count" "${restored_archives[@]}" || true
        else
            restore_batch_mode=false
            sidebar_operation_finish failed "$batch_operation_id" || true
            sidebar_tmux_cmd set-option -gq "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" 0 2>/dev/null || true
        fi
        batch_duration_us=$(( $(metrics_now_us) - batch_start ))
        [ -n "$METRICS_FILE" ] && metrics_write "op=batch-restore phase=complete operation_id=$batch_operation_id selected=$selected_count restored=$restored_count concurrency=$concurrency duration_us=$batch_duration_us"
        trace_event "restore.batch.end operation_id=$batch_operation_id selected=$selected_count restored=$restored_count duration_us=$batch_duration_us"
    fi
    if [ "$restored_count" -ne "$selected_count" ]; then
        trace_event "history.restore.summary selected=$selected_count restored=$restored_count result=incomplete"
        message_line "Restore incomplete: $restored_count/$selected_count"
    else
        trace_event "history.restore.summary selected=$selected_count restored=$restored_count result=complete"
    fi
    topology_cache_initialized=false
    signal_managed_sidebar_refresh_batch || true
    discard_pending_input
}

tui_restore_archives()
{
    restore_selected_archives
    topology_cache_initialized=false
    signal_managed_sidebar_refresh_batch || true
}

delete_selected_archives()
{
    prompt_line 'Delete history? y/N '
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    answer="$prompt_result"
    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            while IFS= read -r index; do
                rm -f "${history_files[$index]}"
            done <<EOF
$(archive_selected_indices)
EOF
            ;;
    esac
}

create_session_with_active_client_geometry()
{
    local target_name="$1"
    local target_path="${2:-$HOME}"
    local client_tty client_x client_y
    client_tty="$(sidebar_tmux_cmd list-clients -F '#{client_tty}' 2>/dev/null | head -n 1 || true)"
    if [ -n "$client_tty" ]; then
        client_x="$(sidebar_tmux_cmd display-message -c "$client_tty" -p '#{client_width}' 2>/dev/null || true)"
        client_y="$(sidebar_tmux_cmd display-message -c "$client_tty" -p '#{client_height}' 2>/dev/null || true)"
    else
        client_x="$(sidebar_tmux_cmd display-message -p '#{client_width}' 2>/dev/null || true)"
        client_y="$(sidebar_tmux_cmd display-message -p '#{client_height}' 2>/dev/null || true)"
    fi
    case "$client_x" in ''|*[!0-9]*) client_x="" ;; esac
    case "$client_y" in ''|*[!0-9]*) client_y="" ;; esac

    if [ -n "$client_x" ] && [ -n "$client_y" ] && [ "$client_x" -gt 0 ] && [ "$client_y" -gt 0 ]; then
        sidebar_tmux_cmd new-session -d -s "$target_name" -c "$target_path" -x "$client_x" -y "$client_y"
    else
        sidebar_tmux_cmd new-session -d -s "$target_name" -c "$target_path"
    fi
}

tui_new_session()
{
    local session_name current_path
    current_path="$PWD"
    prompt_line 'New: '
    debug_log "tui_new_session after prompt_line result='$prompt_result' cancelled='$prompt_cancelled'"
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    session_name="$prompt_result"
    [ -n "$session_name" ] || return 0

    if session_exists "$session_name"; then
        selected_session="$session_name"
        return 0
    fi

    create_session_with_active_client_geometry "$session_name" "$current_path"
    mark_session_managed "$session_name" || true

    local created="${EPOCHSECONDS:-$SECONDS}"
    session_names+=("$session_name")
    session_created+=("$created")
    session_status+=("idle")
    session_cli_state+=("idle")
    session_animation_seed_val "${session_name}:${created}"
    session_animation_seed+=("${session_animation_seed_result:-0}")
    session_animate+=("false")
    local new_idx=$(( ${#session_names[@]} - 1 ))
    cached_session_row_index["$session_name"]="$new_idx"
    selected_session="$session_name"
    selected_index="$new_idx"

    ensure_selection_visible
    render_visible_session_rows

    sidebar_runtime_set "$SIDEBAR_WINDOW_READY_OPTION" 1
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_READY_OPTION" 1 2>/dev/null || true
    fi

    # The after-new-session hook provisions the target window's stable local
    local gen
    gen="$(sidebar_tmux_cmd show-option -wqv -t "${SIDEBAR_WINDOW_ID:-}" "$SIDEBAR_ACTION_GENERATION_OPTION" 2>/dev/null || echo 0)"
    sidebar_runtime_set "$SIDEBAR_ACTION_GENERATION_OPTION" "$(( ${gen:-0} + 1 ))"
    sidebar_runtime_set "$SIDEBAR_INPUT_READY_OPTION" 1
    trace_event "session.create.end session=$session_name sidebar=hook-provision"
}
execute_tui_session_delete_action()
{
    local archive_flag="${1:-false}"
    debug_log "tui_delete_session confirm action selected=$selected_session current=$current_session archive=$archive_flag"
    deleted_session="$selected_session"
    deleting_current_session=false
    if [ "$selected_session" = "$current_session" ]; then
        next_session="$(fallback_session "$deleted_session")"
        debug_log "tui_delete_session deleting current selected=$deleted_session next_session=$next_session"
        if [ -n "$next_session" ]; then
            current_session="$next_session"
        fi
        deleting_current_session=true
    fi
    debug_log "tui_delete_session before run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
    run_session_delete "$deleted_session" "$archive_flag"
    debug_log "tui_delete_session after run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
    if [ "$deleting_current_session" = "false" ]; then
        wait_for_session_absence "$deleted_session" || true
    fi
    if [ "$deleting_current_session" = "true" ]; then
        debug_log "tui_delete_session exit after deleting current selected=$deleted_session"
        wait_for_session_absence "$deleted_session" 100 0.05 || true
        reassert_sidebar_after_session_delete || message_line "Sidebar focus is still settling"
        discard_pending_input
        selected_session="$current_session"
        collect_sessions false "$selected_session"
        render_full delete-current
        return 0
    fi
    discard_pending_input
    selected_session="$current_session"
}

tui_delete_session()
{
    [ -n "$selected_session" ] || return 0

    prompt_line "Delete $selected_session? y/Enter/All(a/A) "
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    answer="$prompt_result"
    if [ "$answer" = "All" ]; then
        prompt_line "Save Session? y/N "
        if [ "$prompt_cancelled" = "true" ]; then
            return 0
        fi
        case "$prompt_result" in
            [Yy]|[Yy][Ee][Ss]) run_all_sessions_delete true ;;
            *) run_all_sessions_delete false ;;
        esac
        exit 0
    fi

    if ! session_exists "$selected_session"; then
        message_line "Missing: $selected_session"
        return 0
    fi

    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            execute_tui_session_delete_action true
            ;;
        '')
            execute_tui_session_delete_action false
            ;;
    esac
}

tui_rename_session()
{
    old_name="$selected_session"
    [ -n "$old_name" ] || return 0

    if ! session_exists "$old_name"; then
        message_line "Missing: $old_name"
        return 0
    fi

    prompt_line "Rename: $old_name "
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    new_name="${prompt_result:-$old_name}"
    [ -n "$new_name" ] || return 0

    if session_exists "$new_name"; then
        message_line "Exists: $new_name"
        return 0
    fi

    sidebar_tmux_cmd rename-session -t "=$old_name" "$new_name" 2>/dev/null ||
        sidebar_tmux_cmd rename-session -t "$old_name" "$new_name" 2>/dev/null ||
        tmux rename-session -t "=$old_name" "$new_name" 2>/dev/null ||
        tmux rename-session -t "$old_name" "$new_name"

    selected_session="$new_name"
    if [ "$current_session" = "$old_name" ]; then
        current_session="$new_name"
    fi
    for index in "${!session_names[@]}"; do
        if [ "${session_names[$index]}" = "$old_name" ]; then
            session_names[$index]="$new_name"
            if [ -n "${cached_session_row_index[$old_name]:-}" ]; then
                cached_session_row_index["$new_name"]="$index"
                unset "cached_session_row_index[$old_name]" 2>/dev/null || true
            fi
            selected_index="$index"
            break
        fi
    done
    topology_cache_initialized=false
    collect_sessions
    signal_managed_sidebar_refresh_batch || true
    render_full session-renamed
}

move_selection()
{
    direction="$1"
    local metrics_input_start="" metrics_input_operation_id=""
    local metrics_input_phase_start=""
    local metrics_input_update_us=0 metrics_input_visibility_us=0 metrics_input_render_us=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_input_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_input_operation_id="$metrics_operation_id_result"
    fi
    selection_trace_id=$((selection_trace_id + 1))
    trace_id="$selection_trace_id"
    trace_event "selection.update.begin id=$trace_id direction=$direction index=$selected_index"
    old_index="$selected_index"
    count="${#session_names[@]}"

    [ "$count" -eq 0 ] && return 0

    case "$direction" in
        next) selected_index=$(((selected_index + 1) % count)) ;;
        prev) selected_index=$(((selected_index + count - 1) % count)) ;;
    esac

    selected_session="${session_names[$selected_index]}"
    if [ -n "$metrics_input_start" ]; then
        metrics_input_update_us=$(( $(metrics_now_us) - metrics_input_start ))
        metrics_input_phase_start="$(metrics_now_us)"
    fi
    ensure_selection_visible
    if [ -n "$metrics_input_start" ]; then
        metrics_input_visibility_us=$(( $(metrics_now_us) - metrics_input_phase_start ))
        metrics_input_phase_start="$(metrics_now_us)"
    fi

    trace_event "selection.render.begin id=$trace_id old_index=$old_index new_index=$selected_index"
    if row_is_visible "$old_index" && row_is_visible "$selected_index"; then
        render_selection_pair "$old_index" "$selected_index"
    else
        render_visible_rows
    fi
    gen="$(sidebar_tmux_cmd show-option -wqv -t "${SIDEBAR_WINDOW_ID:-}" "$SIDEBAR_ACTION_GENERATION_OPTION" 2>/dev/null || echo 0)"
    sidebar_runtime_set "$SIDEBAR_ACTION_GENERATION_OPTION" "$(( ${gen:-0} + 1 ))"
    trace_event "selection.render.end id=$trace_id old_index=$old_index new_index=$selected_index"
    trace_event "selection.update.end id=$trace_id index=$selected_index session=$selected_session"
    if [ -n "$metrics_input_start" ]; then
        metrics_input_render_us=$(( $(metrics_now_us) - metrics_input_phase_start ))
        metrics_write "op=input phase=selection operation_id=$metrics_input_operation_id direction=$direction old_index=$old_index new_index=$selected_index update_us=$metrics_input_update_us visibility_us=$metrics_input_visibility_us render_us=$metrics_input_render_us duration_us=$(( $(metrics_now_us) - metrics_input_start )) render=selection-pair"
    fi
}

read_key()
{
    timeout="${1:-0.2}"
    key=""
    rest=""
    key_result=""
    key_raw=""

    if [ "$timeout" = "block" ]; then
        IFS= read -rsn1 key || return 1
    elif ! IFS= read -rsn1 -t "$timeout" key; then
        [ -n "$key" ] || return 1
    fi
    key_raw="$key"

    if [ "$key" = $'\033' ]; then
        IFS= read -rsn2 -t 1 rest || true
        key_raw+="$rest"
        case "$rest" in
            '[A') key_result=up ;;
            '[B') key_result=down ;;
            '') key_result=esc ;;
            *) key_result=other ;;
        esac
        return 0
    fi

    case "$key" in
        j) key_result=down ;;
        k) key_result=up ;;
        c) key_result=create ;;
        r) key_result=rename ;;
        d) key_result=delete ;;
        /) key_result=filter ;;
        o) key_result=history ;;
        ' ') key_result=mark ;;
        a) key_result=mark-all ;;
        q) key_result=quit ;;
        ''|$'\n'|$'\r')
            key_result=enter
            [ -n "$key_raw" ] || key_raw=$'\r'
            ;;
        *) key_result=other ;;
    esac
}

discard_pending_input()
{
    local key rest raw
    while IFS= read -rsn1 -t 0.01 key; do
        rest=""
        if [ "$key" = $'\033' ]; then
            IFS= read -rsn2 -t 0.01 rest || true
        fi
        raw="$key$rest"
        trace_event "input.rejected action_id=${current_action_id:-none} key_name=pending key_hex=$(trace_key_hex "$raw") reason=operation-complete-drain"
    done
}

toggle_history_mode()
{
    if [ "$view_mode" = "history" ]; then
        view_mode="sessions"
    else
        view_mode="history"
        collect_history
        align_history_selection_to_session "$current_session"
        ensure_history_visible
    fi
    render_full history-toggle
}

move_history_selection()
{
    direction="$1"
    count="${#history_files[@]}"
    [ "$count" -eq 0 ] && return 0

    case "$direction" in
        next) history_index=$(((history_index + 1) % count)) ;;
        prev) history_index=$(((history_index + count - 1) % count)) ;;
    esac
    debug_log "history selection direction=$direction index=$history_index file=${history_files[$history_index]}"

    ensure_history_visible
    render_history
}

toggle_history_mark()
{
    [ "${#history_files[@]}" -eq 0 ] && return 0
    if [ "${history_checked[$history_index]}" = "true" ]; then
        history_checked[$history_index]="false"
    else
        history_checked[$history_index]="true"
    fi
    render_history
}

toggle_history_mark_all()
{
    local index
    [ "${#history_files[@]}" -gt 0 ] || return 0
    for index in "${!history_files[@]}"; do
        history_checked[$index]=true
    done
    trace_event "history.mark-all count=${#history_files[@]}"
    render_history
}

handle_mouse_select()
{
    pane_id="$1"
    mouse_y="$2"
    mouse_x="$3"
    mouse_word="${4:-}"
    mouse_event_id="mouse-${BASHPID:-$$}-$(date +%s%N)"
    mouse_line=""

    trace_event "input.event event_id=$mouse_event_id source=mouse type=select pane=$pane_id y=$mouse_y x=$mouse_x"
    trace_event "mouse.select.begin event_id=$mouse_event_id pane=$pane_id y=$mouse_y x=$mouse_x word=${mouse_word:-none}"

    [ -n "$pane_id" ] || { trace_event "mouse.select.ignore event_id=$mouse_event_id reason=missing-pane"; return 0; }
    [ -n "$mouse_y" ] || { trace_event "mouse.select.ignore event_id=$mouse_event_id reason=missing-y"; return 0; }
    [ -n "$mouse_x" ] || { trace_event "mouse.select.ignore event_id=$mouse_event_id reason=missing-x"; return 0; }
    [ "$(tmux display-message -p -t "$pane_id" '#{pane_title}' 2>/dev/null || true)" = "$SIDEBAR_TITLE" ] || {
        trace_event "mouse.select.ignore event_id=$mouse_event_id reason=not-sidebar pane=$pane_id"
        return 0
    }

    SELF_PANE="$pane_id"
    collect_sessions
    width="$(pane_width)"
    name_start=4
    name_end=$((width - 12))

    case "$mouse_x" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "$mouse_y" in
        ''|*[!0-9]*) return 0 ;;
    esac
    # tmux reports mouse_y relative to the pane content origin. The sidebar
    # renderer reserves its header row, so convert to the one-based screen
    # line used by row_screen_line before selecting a session.
    mouse_line=$((mouse_y + 2))
    trace_event "mouse.select.normalize event_id=$mouse_event_id y=$mouse_y screen_line=$mouse_line x=$mouse_x"

    [ "$mouse_x" -ge "$name_start" ] || { trace_event "mouse.select.ignore event_id=$mouse_event_id reason=x-before-name"; return 0; }
    [ "$mouse_x" -le "$name_end" ] || { trace_event "mouse.select.ignore event_id=$mouse_event_id reason=x-after-name"; return 0; }

    row_index=$((mouse_line - 2 + scroll_offset))
    if [ "$row_index" -lt 0 ] ||
        [ "$row_index" -ge "${#session_names[@]}" ]; then
        alt_index=$((mouse_line - 1 + scroll_offset))
        if [ "$alt_index" -lt 0 ] ||
            [ "$alt_index" -ge "${#session_names[@]}" ]; then
            trace_event "mouse.select.ignore event_id=$mouse_event_id reason=row-out-of-range line=$mouse_line word=${mouse_word:-none}"
            return 0
        fi
        row_index="$alt_index"
    fi

    session_name="${session_names[$row_index]}"
    trace_event "mouse.select.target event_id=$mouse_event_id session=$session_name row=$row_index word=${mouse_word:-none}"
    switch_session "$session_name"
}

run_tui()
{
    local action_generation=0
    trace_event "sidebar.process.begin pane=${TMUX_PANE:-none}"
    setup_terminal
    if sidebar_tmux_control_start; then
        trace_event "tmux.control.start result=ok pid=$SIDEBAR_TMUX_CONTROL_PID"
    else
        trace_event "tmux.control.start result=fallback mode=cli"
    fi
    SIDEBAR_WINDOW_ID="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
    if [ -n "$SIDEBAR_WINDOW_ID" ]; then
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_PANE_OPTION" "${TMUX_PANE:-}" 2>/dev/null || true
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_READY_OPTION" 0 2>/dev/null || true
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_MODEL_OPTION" window-local 2>/dev/null || true
    fi
    trace_event "sidebar.setup.end pane=${TMUX_PANE:-none}"
    mark_sidebar_pane
    claim_sidebar_owner
    mark_session_managed "$current_session" || true
    set_sidebar_enabled 1
    install_sidebar_hooks
    # A newly provisioned sidebar can start while an archive restore owns the
    # shared operation. Do not let its startup initialization erase that
    # operation before the parent finalizer completes.
    case "$(sidebar_operation_state)" in
        ''|idle:*) sidebar_operation_set idle startup ;;
        *) trace_event "operation.state.skip state=$(sidebar_operation_state) reason=sidebar-startup" ;;
    esac
    trace_event "sidebar.collect.begin pane=${TMUX_PANE:-none}"
    collect_sessions
    trace_event "sidebar.collect.end pane=${TMUX_PANE:-none}"
    trace_event "sidebar.first-render.begin pane=${TMUX_PANE:-none}"
    render_full initial
    trace_event "sidebar.first-render.end pane=${TMUX_PANE:-none}"
    sidebar_runtime_set "$SIDEBAR_ACTION_GENERATION_OPTION" 0
    sidebar_runtime_set "$SIDEBAR_INPUT_READY_OPTION" 1
    sidebar_runtime_set "$SIDEBAR_PROMPT_READY_OPTION" 0
    if [ -n "$SIDEBAR_WINDOW_ID" ]; then
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_READY_OPTION" 1 2>/dev/null || true
        tmux set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_WINDOW_GENERATION_OPTION" "$(date +%s%N)" 2>/dev/null || true
        trace_event "sidebar.window.ready window=$SIDEBAR_WINDOW_ID pane=${TMUX_PANE:-none}"
    fi
    last_tick="$(epoch_now)"
    sidebar_session_cached="$(sidebar_session_name || true)"
    [ -n "$sidebar_session_cached" ] || sidebar_session_cached="$current_session"
    last_force_refresh_check_epoch="$last_tick"
    post_operation_fast_read=true
    if [ "$SIDEBAR_SIGNAL_TIMER_ENABLED" = "true" ]; then
        start_tick_timer
    fi

    while true; do
        if [ -n "$METRICS_FILE" ]; then
            maintenance_metrics_loops=$((maintenance_metrics_loops + 1))
            metrics_phase=read
            metrics_proc_cpu_ticks
            maintenance_read_cpu_start="$metrics_proc_cpu_ticks_result"
            metrics_now_us_value
            maintenance_read_start="$metrics_now_us_result"
        fi
        read_timeout="$SIDEBAR_IDLE_INTERVAL"
        has_animation=false
        for index in "${!session_animate[@]}"; do
            if [ "${session_animate[$index]}" = "true" ]; then
                has_animation=true
                read_timeout="$SIDEBAR_ANIMATION_INTERVAL"
                break
            fi
        done
        # A passive sidebar does not need to wake at the animation cadence.
        # Input still interrupts read immediately, while the slower timeout
        # avoids repeatedly executing the Bash loop when no animation is due.
        if [ "$SIDEBAR_ADAPTIVE_IDLE_READ" = "true" ] && [ "$has_animation" = "false" ]; then
            read_timeout="$SIDEBAR_ADAPTIVE_IDLE_TIMEOUT"
        fi
        # A native switch publishes its target before switch-client. Keep the
        # target sidebar on the short polling boundary while that marker is
        # pending; otherwise the passive 1s read timeout can delay the delta
        # marker until after the client has visibly changed.
        if native_selection_sync_pending; then
            read_timeout="$SIDEBAR_POLL_TIMEOUT"
        fi
        if [ "$post_operation_fast_read" = "true" ] || IFS= read -rsn1 -t 0 key_pending 2>/dev/null; then
            read_timeout=0.001
        fi
        if [ "$SIDEBAR_EVENT_LOOP_ENABLED" = "true" ] &&
            [ "$SIDEBAR_SIGNAL_TIMER_ENABLED" = "true" ] &&
            [ "$has_animation" = "false" ] &&
            [ "$post_operation_fast_read" != "true" ]; then
            read_timeout=block
        fi

        trace_event "read.begin timeout=$read_timeout"
        key=""
        if read_key "$read_timeout"; then
            key="$key_result"
            post_operation_fast_read=true
            last_input_epoch_us="$(debug_now_us)"
            action_trace_id=$((action_trace_id + 1))
            current_action_id="${TMUX_PANE:-${SELF_PANE:-none}}-$BASHPID-$action_trace_id"
            trace_event "input.read.result action_id=$current_action_id result=key key_name=$key key_hex=$(trace_key_hex "$key_raw")"
        else
            post_operation_fast_read=false
            trace_event "input.read.result result=timeout timeout=$read_timeout"
        fi
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            maintenance_read_end="$metrics_now_us_result"
            metrics_proc_cpu_ticks
            maintenance_metrics_read_cpu_ticks=$((maintenance_metrics_read_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_read_cpu_start))
            maintenance_metrics_read_us=$((maintenance_metrics_read_us + maintenance_read_end - maintenance_read_start))
            if [ -n "$key" ]; then
                maintenance_metrics_read_keys=$((maintenance_metrics_read_keys + 1))
            else
                maintenance_metrics_read_timeouts=$((maintenance_metrics_read_timeouts + 1))
            fi
        fi

        if [ -n "$key" ] && sidebar_operation_busy; then
            trace_event "input.rejected action_id=${current_action_id:-none} key_name=$key reason=operation-busy state=$(sidebar_operation_state)"
            message_line "Busy: $(sidebar_operation_state)"
            key=""
            current_action_id=""
        fi
        if [ -n "$key" ]; then
            sidebar_runtime_set "$SIDEBAR_INPUT_READY_OPTION" 0
            trace_event "input.dispatch.begin action_id=$current_action_id key_name=$key view_mode=$view_mode current=$current_session selected=$selected_session"
        fi
        if [ "$geometry_signal_pending" = true ]; then
            geometry_signal_pending=false
            old_width="${cached_pane_width:-}"
            old_height="${cached_pane_height:-}"
            update_pane_geometry
            if [ -z "$old_width" ] || [ -z "$old_height" ] ||
                [ "$old_width" != "$cached_pane_width" ] || [ "$old_height" != "$cached_pane_height" ]; then
                mark_full_render_required geometry-invalidated
                trace_event "geometry.signal changed old=${old_width:-none},${old_height:-none} new=$cached_pane_width,$cached_pane_height"
            else
                trace_event "geometry.signal unchanged geometry=$cached_pane_width,$cached_pane_height"
            fi
        fi
        case "$key" in
            up)
                trace_event "selection.begin direction=prev"
                if [ "$view_mode" = "history" ]; then
                    move_history_selection prev
                else
                    move_selection prev
                fi
                ;;
            down)
                trace_event "selection.begin direction=next"
                if [ "$view_mode" = "history" ]; then
                    move_history_selection next
                else
                    move_selection next
                fi
                ;;
            enter)
                trace_event "action.begin type=enter session=$selected_session"
                debug_log "enter action view_mode=$view_mode history_index=$history_index selected=$selected_session"
                switch_result=0
                if [ "$view_mode" = "history" ]; then
                    history_restore_in_progress=true
                    tui_restore_archives
                    collect_history
                    # Keep the history view open after a single restore. The
                    # user can continue with Down + Enter to restore another
                    # archive; switching back to sessions here made the next
                    # Enter merely switch an existing session and looked like
                    # a stalled duplicate restore.
                    history_restore_in_progress=false
                    request_full_render history-restore
                else
                    switch_result=0
                    switch_session "$selected_session" || switch_result=$?
                    if [ "$switch_result" -eq 0 ]; then
                        refresh_signal_pending=false
                        trace_event "render.coalesce.skip session=$selected_session reason=window-local-sidebar-ready"
                    else
                        request_full_render transition-failed
                    fi
                fi
                if [ "$switch_result" -ne 0 ] || [ "$view_mode" = history ]; then
                    collect_sessions false "$selected_session"
                fi
                ;;
            create)
                tui_new_session
                collect_sessions true
                render_full create-session
                ;;
            rename)
                tui_rename_session
                collect_sessions true
                render_full rename-session
                ;;
            delete)
                if [ "$view_mode" = "history" ]; then
                    delete_selected_archives
                    collect_history
                else
                    debug_log "main delete before tui_delete_session current_session=$current_session selected_session=$selected_session"
                    tui_delete_session
                    debug_log "main delete after tui_delete_session current_session=$current_session selected_session=$selected_session"
                fi
                collect_sessions true
                debug_log "main delete after collect_sessions current_session=$current_session selected_session=$selected_session"
                render_full delete-session
                ;;
            filter)
                prompt_line "Filter: "
                ;;
            history)
                toggle_history_mode
                ;;
            mark)
                if [ "$view_mode" = "history" ]; then
                    toggle_history_mark
                fi
                ;;
            mark-all)
                if [ "$view_mode" = "history" ]; then
                    toggle_history_mark_all
                fi
                ;;
            esc)
                if [ "$view_mode" = "history" ]; then
                    view_mode="sessions"
                    render_full history-exit
                fi
                ;;
            quit)
                exit 0
                ;;
        esac

        if [ -n "$key" ]; then
            trace_event "input.dispatch.end action_id=$current_action_id key_name=$key current=$current_session selected=$selected_session view_mode=$view_mode"
        fi

        selection_sync_signal_tick="$selection_sync_signal_pending"
        selection_sync_signal_pending=false
        flush_full_render_request
        if [ "$full_render_required" = "true" ]; then
            trace_event "render.full.check reason=${full_render_required_reason:-unspecified} sync_window=$(sidebar_tmux_cmd show-option -wqv -t "${SIDEBAR_WINDOW_ID:-}" "$SIDEBAR_SELECTION_SYNC_OPTION" 2>/dev/null || true)"
            native_transition_render_skip=false
            case "$full_render_required_reason" in
                geometry-invalidated|topology-invalidated|external-layout-change)
                    if (selection_sync_window_pending || transition_render_pending_for_current_session) && [ "${session_topology_changed:-false}" != "true" ]; then
                        native_transition_render_skip=true
                        if transition_render_pending_for_current_session; then
                            sidebar_tmux_cmd set-option -wq -t "$SIDEBAR_WINDOW_ID" "$SIDEBAR_TRANSITION_RENDER_PENDING_OPTION" "" 2>/dev/null || true
                            trace_event "render.coalesce.consume reason=post-transition-geometry session=$current_session"
                        fi
                    fi
                    ;;
                *)
                    if selection_sync_window_pending && [ "${session_topology_changed:-false}" != "true" ]; then
                        native_transition_render_skip=true
                    fi
                    ;;
            esac
            if [ "$native_transition_render_skip" = true ]; then
                trace_event "render.full.skip reason=native-session-transition full_reason=${full_render_required_reason:-unspecified} session=$current_session selected=$selected_session"
            elif [ "$transition_render_coalesced" = true ] && [ "${session_topology_changed:-false}" != "true" ]; then
                trace_event "render.coalesce.skip reason=transition-render-already-flushed session=$current_session"
            else
                render_full full-render-required
                trace_event "render.full reason=full-render-required"
            fi
            full_render_required=false
            full_render_required_reason=""
            session_animation_refresh_indexes=()
        fi

        now="${EPOCHSECONDS:-$SECONDS}"
        maintenance_tick=false
        refresh_signal_tick="$refresh_signal_pending"
        refresh_signal_pending=false
        if [ "$transition_render_coalesced" = true ]; then
            refresh_signal_tick=false
            trace_event "render.coalesce.skip reason=stale-refresh-signal session=$current_session"
            transition_render_coalesced=false
            trace_event "render.coalesce.end session=$current_session"
        fi
        if [ "$tick_signal_pending" = "true" ] ||
            [ "$refresh_signal_tick" = "true" ] ||
            [ "$now" != "$last_tick" ]; then
            tick_signal_pending=false
            if [ "$now" != "$last_tick" ]; then
                maintenance_tick=true
                if [ -n "$key" ]; then
                    trace_event "maintenance.defer type=age reason=key"
                elif maintenance_cooldown_active; then
                    trace_event "maintenance.defer type=age reason=recent-input"
                else
                    if [ -n "$METRICS_FILE" ]; then
                        metrics_phase=age
                        metrics_proc_cpu_ticks
                        maintenance_age_cpu_start="$metrics_proc_cpu_ticks_result"
                        metrics_now_us_value
                        maintenance_age_start="$metrics_now_us_result"
                    fi
                    render_age_cells
                    if [ -n "$METRICS_FILE" ]; then
                        metrics_now_us_value
                        metrics_proc_cpu_ticks
                        maintenance_metrics_age_cpu_ticks=$((maintenance_metrics_age_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_age_cpu_start))
                        maintenance_metrics_age_us=$((maintenance_metrics_age_us + metrics_now_us_result - maintenance_age_start))
                        maintenance_metrics_age_calls=$((maintenance_metrics_age_calls + 1))
                    fi
                fi
                last_tick="$now"
            fi

            if [ "$maintenance_tick" = true ] || [ "$refresh_signal_tick" = true ]; then
                if [ -n "$key" ]; then
                    trace_event "maintenance.defer type=refresh reason=key"
                elif maintenance_cooldown_active && [ "$refresh_signal_tick" != "true" ]; then
                    trace_event "maintenance.defer type=refresh reason=recent-input"
                else
                    if [ "$refresh_signal_tick" = true ] ||
                        [ -z "$last_force_refresh_check_epoch" ] ||
                        [ $((now - last_force_refresh_check_epoch)) -ge "$SIDEBAR_FORCE_REFRESH_CHECK_SECONDS" ]; then
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_phase=force
                            metrics_proc_cpu_ticks
                            maintenance_force_cpu_start="$metrics_proc_cpu_ticks_result"
                            metrics_now_us_value
                            maintenance_force_start="$metrics_now_us_result"
                            maintenance_metrics_force_checks=$((maintenance_metrics_force_checks + 1))
                        fi
                        local force_refresh_flag="@sidebar_force_refresh_${sidebar_session_cached:-$current_session}"
                        local force_refresh sidebar_owner_session
                        force_refresh="$(sidebar_tmux_cmd show-option -gqv "$force_refresh_flag" 2>/dev/null || true)"
                        sidebar_owner_session="$(sidebar_session_name || true)"
                        [ -n "$sidebar_owner_session" ] || sidebar_owner_session="${sidebar_session_cached:-$current_session}"
                        selection_sync_handled=false
                        trace_event "render.force.check reason=$force_refresh sync_window=$(sidebar_tmux_cmd show-option -wqv -t "${SIDEBAR_WINDOW_ID:-}" "$SIDEBAR_SELECTION_SYNC_OPTION" 2>/dev/null || true) owner=$sidebar_owner_session"
                        if [ "$refresh_signal_tick" = "true" ] && sync_sidebar_selection_delta; then
                            selection_sync_handled=true
                        elif selection_sync_window_pending; then
                            # A managed refresh flag may already be set when
                            # the native switch starts. Keep that stale
                            # refresh from winning the target's first cycle;
                            # the queued selection signal will render the
                            # marker delta after client ownership settles.
                            trace_event "render.full.skip reason=native-session-transition force_reason=$force_refresh session=$sidebar_owner_session"
                            sidebar_tmux_cmd set-option -gq "$force_refresh_flag" 0 2>/dev/null || true
                        elif [ "$force_refresh" = "1" ] || [ "$refresh_signal_tick" = "true" ]; then
                            collect_sessions false "$sidebar_owner_session"
                            align_selection_to_session "$sidebar_owner_session"
                            render_full force-refresh
                            session_animation_refresh_indexes=()
                            last_state_refresh_epoch="${EPOCHSECONDS:-$SECONDS}"
                            tmux set-option -g "$force_refresh_flag" 0 2>/dev/null || true
                            [ "$sidebar_owner_session" = "${sidebar_session_cached:-}" ] ||
                                tmux set-option -g "@sidebar_force_refresh_$sidebar_owner_session" 0 2>/dev/null || true
                        fi
                        last_force_refresh_check_epoch="$now"
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_now_us_value
                            metrics_proc_cpu_ticks
                            maintenance_metrics_force_cpu_ticks=$((maintenance_metrics_force_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_force_cpu_start))
                            maintenance_metrics_force_us=$((maintenance_metrics_force_us + metrics_now_us_result - maintenance_force_start))
                        fi
                    fi

                    if [ "$maintenance_tick" = true ] && state_refresh_due; then
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_phase=state
                            metrics_proc_cpu_ticks
                            maintenance_state_cpu_start="$metrics_proc_cpu_ticks_result"
                            metrics_now_us_value
                            maintenance_state_start="$metrics_now_us_result"
                            maintenance_metrics_state_calls=$((maintenance_metrics_state_calls + 1))
                        fi
                        if refresh_sidebar_state_if_due; then
                            render_animation_state_changes
                        fi
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_now_us_value
                            metrics_proc_cpu_ticks
                            maintenance_metrics_state_cpu_ticks=$((maintenance_metrics_state_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_state_cpu_start))
                            maintenance_metrics_state_us=$((maintenance_metrics_state_us + metrics_now_us_result - maintenance_state_start))
                        fi
                    else
                        [ -n "$METRICS_FILE" ] && maintenance_metrics_state_skips=$((maintenance_metrics_state_skips + 1))
                    fi
                fi
            fi
        fi

        if [ -z "$key" ] && [ "$view_mode" = "sessions" ] &&
            [ "$SIDEBAR_ANIMATION_ENABLED" = "true" ]; then
            animation_tick_counter=$((animation_tick_counter + 1))
            if [ "$animation_tick_counter" -ge 1 ]; then
                animation_tick_counter=0
                animation_frame=$(((animation_frame + 1) % 24))
                for index in "${!session_animate[@]}"; do
                    [ "${session_animate[$index]}" = "true" ] && {
                        render_animated_name_cells
                        break
                    }
                done
            fi
        fi

        if [ -n "$key" ]; then
            action_generation=$((action_generation + 1))
            sidebar_runtime_set "$SIDEBAR_INPUT_READY_OPTION" 1
            sidebar_runtime_set "$SIDEBAR_ACTION_GENERATION_OPTION" "$action_generation"
            trace_event "action.complete action_id=$current_action_id generation=$action_generation key_name=$key current=$current_session selected=$selected_session view_mode=$view_mode"
            current_action_id=""
        fi
        metrics_flush
    done
}

# shellcheck disable=SC1090
source "$SIDEBAR_CONTROLLER_PATH"

main()
{
    require_command tmux
    trace_event "launcher.process.begin args=$*"
    debug_log "main start args=$* current_session=$(tmux display-message -p '#S' 2>/dev/null || true)"

    case "${1:-}" in
        --open-sidebar)
            open_sidebar
            return 0
            ;;
        --toggle-sidebar)
            toggle_current_sidebar
            return 0
            ;;
        --toggle-sidebar-session)
            toggle_sidebar_for_session "${2:-}"
            return 0
            ;;
        --toggle-sidebar-pane)
            toggle_sidebar_for_pane "${2:-}"
            return 0
            ;;
        --ensure-current-sidebar)
            open_sidebar
            return 0
            ;;
        --install-sidebar-hooks)
            install_sidebar_hooks
            return 0
            ;;
        --ensure-sidebar-window)
            if restore_topology_guard_active; then
                trace_event "sidebar.ensure-window.skip reason=restore-topology-guard window=${2:-none}"
                return 0
            fi
            provision_sidebar_window "${2:-}" "${3:-$(sidebar_width)}"
            return $?
            ;;
        --ensure-sidebar-session)
            if restore_topology_guard_active; then
                trace_event "sidebar.ensure-session.skip reason=restore-topology-guard session=${2:-none}"
                return 0
            fi
            ensure_sidebar_for_session "${2:-}"
            return 0
            ;;
        --sync-active-window)
            sync_active_window
            return 0
            ;;
        --sync-sidebar-layout)
            sync_sidebar_layout "${2:-}" "${3:-internal}"
            return $?
            ;;
        --sync-sidebar-focus)
            sync_sidebar_focus "${2:-}"
            return 0
            ;;
        --list-sessions)
            collect_sessions
            for index in "${!session_names[@]}"; do
                printf '%s\t%s\t%s\n' "${session_names[$index]}" "${session_created[$index]}" "${session_status[$index]}"
            done
            return 0
            ;;
        --split-horizontal)
            split_work_pane horizontal
            return 0
            ;;
        --split-vertical)
            split_work_pane vertical
            return 0
            ;;
        --mouse-select)
            handle_mouse_select "${2:-}" "${3:-}" "${4:-}" "${5:-}"
            return 0
            ;;
        --delete-session-after-archive)
            delete_session_after_archive "${2:-}" "${3:-false}" "${4:-}" "${5:-}" "${6:-}" "${7:-}"
            return 0
            ;;
        --delete-all-sessions-after-archive)
            delete_all_sessions_after_archive "${2:-false}" "${3:-}"
            return 0
            ;;
        --restore-archive)
            restore_archive "${2:-}" "${3:-}"
            return $?
            ;;
        --sidebar|"")
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac

    run_tui
    debug_log "main end args=$*"
}

main "$@"

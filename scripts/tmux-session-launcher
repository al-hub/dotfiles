#!/usr/bin/env bash
set -euo pipefail

LAUNCHER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIDEBAR_ADAPTER_PATH="$LAUNCHER_DIR/tmux-sidebar-tmux-adapter"
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    launcher_test_dir="${LAUNCHER:-}"
    [ -n "$launcher_test_dir" ] && launcher_test_dir="$(cd "$(dirname "$launcher_test_dir")" && pwd)"
    [ -n "$launcher_test_dir" ] && SIDEBAR_ADAPTER_PATH="$launcher_test_dir/tmux-sidebar-tmux-adapter"
}
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    printf 'tmux-session-launcher: missing tmux adapter: %s\n' "$SIDEBAR_ADAPTER_PATH" >&2
    exit 1
}
SIDEBAR_CONTROLLER_PATH="$LAUNCHER_DIR/tmux-sidebar-controller"
[ -r "$SIDEBAR_CONTROLLER_PATH" ] || {
    launcher_test_dir="${LAUNCHER:-}"
    [ -n "$launcher_test_dir" ] && launcher_test_dir="$(cd "$(dirname "$launcher_test_dir")" && pwd)"
    [ -n "$launcher_test_dir" ] && SIDEBAR_CONTROLLER_PATH="$launcher_test_dir/tmux-sidebar-controller"
}
# shellcheck disable=SC1090
source "$SIDEBAR_ADAPTER_PATH"

SIDEBAR_TITLE="dotfiles-session-sidebar"
SIDEBAR_WIDTH="${TMUX_SESSION_SIDEBAR_WIDTH:-35}"
SIDEBAR_BUSY_SECONDS="${TMUX_SESSION_SIDEBAR_BUSY_SECONDS:-10}"
SIDEBAR_ANIMATION_ENABLED="${TMUX_SESSION_SIDEBAR_ANIMATION_ENABLED:-true}"
SIDEBAR_POLL_TIMEOUT="${TMUX_SESSION_SIDEBAR_POLL_TIMEOUT:-0.15}"
SIDEBAR_STATE_REFRESH_SECONDS="${TMUX_SESSION_SIDEBAR_STATE_REFRESH_SECONDS:-5}"
SIDEBAR_FORCE_REFRESH_CHECK_SECONDS="${TMUX_SESSION_SIDEBAR_FORCE_REFRESH_CHECK_SECONDS:-1}"
SIDEBAR_KEY_MAINTENANCE_COOLDOWN_MS="${TMUX_SESSION_SIDEBAR_KEY_MAINTENANCE_COOLDOWN_MS:-250}"
SIDEBAR_ANIMATION_INTERVAL="${TMUX_SESSION_SIDEBAR_ANIMATION_INTERVAL:-0.25}"
SIDEBAR_IDLE_INTERVAL="${TMUX_SESSION_SIDEBAR_IDLE_INTERVAL:-$SIDEBAR_POLL_TIMEOUT}"
SIDEBAR_ADAPTIVE_IDLE_READ="${TMUX_SESSION_SIDEBAR_ADAPTIVE_IDLE_READ:-true}"
SIDEBAR_ADAPTIVE_IDLE_TIMEOUT="${TMUX_SESSION_SIDEBAR_ADAPTIVE_IDLE_TIMEOUT:-1.0}"
SIDEBAR_TICK_INTERVAL="${TMUX_SESSION_SIDEBAR_TICK_INTERVAL:-0.25}"
SIDEBAR_SIGNAL_TIMER_ENABLED="${TMUX_SESSION_SIDEBAR_SIGNAL_TIMER_ENABLED:-false}"
SIDEBAR_EVENT_LOOP_ENABLED="${TMUX_SESSION_SIDEBAR_EVENT_LOOP_ENABLED:-false}"
SIDEBAR_ASYNC_RESTORE="${TMUX_SESSION_SIDEBAR_ASYNC_RESTORE:-true}"
METRICS_FILE="${TMUX_SESSION_LAUNCHER_METRICS_FILE:-}"
METRICS_COMMAND_FILE="${METRICS_FILE:+${METRICS_FILE}.commands}"
METRICS_RUN_ID="${TMUX_SESSION_LAUNCHER_METRICS_RUN_ID:-none}"
METRICS_FLUSH_SECONDS="${TMUX_SESSION_LAUNCHER_METRICS_FLUSH_SECONDS:-2}"
HISTORY_DIR="${TMUX_SESSION_HISTORY_DIR:-$HOME/.cache/dotfiles/tmux-session-history}"
WORK_LAYOUT_OPTION="@dotfiles-session-work-layout"
SCRIPT_PATH="${BASH_SOURCE[0]}"
SELF_PANE="${TMUX_PANE:-}"
current_session="$(tmux display-message -p '#S')"
current_path="$(tmux display-message -p '#{pane_current_path}')"
selected_session="$current_session"
selection_trace_id=0

declare -a session_names=()
declare -a session_created=()
declare -a session_status=()
declare -a session_cli_state=()
declare -A session_ai_fingerprint=()
declare -A cached_session_cli_state=()
declare -A cached_session_ai_fingerprint=()
declare -A cached_session_status=()
declare -A cached_session_status_created=()
declare -A cached_session_status_activity_age=()
declare -A cached_session_status_busy_command=()
declare -A cached_session_animation_seed=()
declare -A cached_session_animation_seed_created=()
declare -A cached_session_row_index=()
declare -A session_activity_age_cache=()
declare -A session_has_busy_command=()
declare -A session_ai_probe_pane_ids=()
declare -A session_ai_direct_pane_id=()
declare -A cached_session_panes_snapshot=()
declare -A cached_session_command_signature=()
declare -A cached_pane_activity=()
declare -A cached_pane_pid=()
declare -A cached_pane_command=()
declare -A session_ai_stable_count=()
declare -A previous_session_animate=()
declare -a session_animate=()
declare -a session_animation_seed=()
declare -a session_animation_refresh_indexes=()
declare -a history_files=()
declare -a history_titles=()
declare -a history_checked=()
# Hot-path helpers write into these scratch variables instead of printing and
# reparsing stdout, which keeps the session refresh loop cheaper.
session_cli_state_result=""
session_ai_fingerprint_result=""
snapshot_signature=""
history_signature=""
selected_index=0
history_index=0
scroll_offset=0
history_scroll_offset=0
last_width=0
old_pane_width=""
old_pane_height=""
cached_pane_width=""
cached_pane_height=""
old_client_sessions=""
cached_panes_snapshot=""
topology_cache_initialized=false
last_height=0
stty_state=""
prompt_result=""
prompt_cancelled=false
view_mode="sessions"
history_restore_in_progress=false
animation_frame=0
animation_tick_counter=0
key_result=""
full_render_required=false
sidebar_session_cached=""
last_force_refresh_check_epoch=""
last_input_epoch_us=""
tick_timer_pid=""
tick_signal_pending=false
refresh_signal_pending=false
metrics_buffer=""
metrics_last_flush_epoch=""
metrics_operation_seq=0
animation_metrics_frames=0
animation_metrics_cells=0
animation_metrics_frame_us=0
animation_metrics_format_us=0
animation_metrics_emit_us=0
animation_metrics_state_renders=0
animation_metrics_state_rows=0
animation_metrics_state_render_us=0
animation_metrics_full_renders=0
animation_metrics_full_render_us=0
maintenance_metrics_loops=0
maintenance_metrics_read_timeouts=0
maintenance_metrics_read_keys=0
maintenance_metrics_read_us=0
maintenance_metrics_age_calls=0
maintenance_metrics_age_us=0
maintenance_metrics_force_checks=0
maintenance_metrics_force_us=0
maintenance_metrics_state_calls=0
maintenance_metrics_state_us=0
maintenance_metrics_state_skips=0
maintenance_metrics_read_cpu_ticks=0
maintenance_metrics_age_cpu_ticks=0
maintenance_metrics_force_cpu_ticks=0
maintenance_metrics_state_cpu_ticks=0
metrics_phase=startup
metrics_external_tmux_startup=0
metrics_external_tmux_read=0
metrics_external_tmux_age=0
metrics_external_tmux_force=0
metrics_external_tmux_state=0
metrics_external_tmux_input=0
metrics_external_tmux_action=0
metrics_external_tmux_other=0
metrics_external_pgrep_startup=0
metrics_external_pgrep_read=0
metrics_external_pgrep_age=0
metrics_external_pgrep_force=0
metrics_external_pgrep_state=0
metrics_external_pgrep_input=0
metrics_external_pgrep_action=0
metrics_external_pgrep_other=0

metrics_now_us()
{
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s\n' "${EPOCHREALTIME/./}"
    else
        date +%s%6N
    fi
}

metrics_now_us_value()
{
    if [ -n "${EPOCHREALTIME:-}" ]; then
        metrics_now_us_result="${EPOCHREALTIME/./}"
    else
        metrics_now_us_result="$(date +%s%6N)"
    fi
}

metrics_proc_cpu_ticks()
{
    if [ -r "/proc/$$/stat" ]; then
        metrics_proc_cpu_ticks_result="$(awk '{print $14 + $15}' "/proc/$$/stat" 2>/dev/null || printf '0')"
    else
        metrics_proc_cpu_ticks_result=0
    fi
}

metrics_external_count()
{
    [ -n "$METRICS_FILE" ] || return 0
    local command_name="$1" phase="${metrics_phase:-other}" prefix
    printf '%s\t%s\n' "$phase" "$command_name" >> "$METRICS_COMMAND_FILE" 2>/dev/null || true
    case "$command_name" in
        tmux) prefix=metrics_external_tmux_ ;;
        pgrep) prefix=metrics_external_pgrep_ ;;
        *) return 0 ;;
    esac
    case "$phase" in
        startup|read|age|force|state|input|action) eval "${prefix}${phase}=\$((\${prefix}${phase} + 1))" ;;
        *) eval "${prefix}other=\$((\${prefix}other + 1))" ;;
    esac
}

if [ "$(type -t tmux 2>/dev/null || true)" != function ]; then
    tmux()
    {
        metrics_external_count tmux
        command tmux "$@"
    }
fi

if [ "$(type -t pgrep 2>/dev/null || true)" != function ]; then
    pgrep()
    {
        metrics_external_count pgrep
        command pgrep "$@"
    }
fi

metrics_write()
{
    [ -n "$METRICS_FILE" ] || return 0
    # Metrics are disabled by default. When enabled, callers append to an
    # in-memory buffer; the main loop flushes it at a coarse interval so the
    # hot path does not perform one file append per collection.
    metrics_line="run=$METRICS_RUN_ID pane=${TMUX_PANE:-${SELF_PANE:-none}} $*"
    if [ -n "$metrics_buffer" ]; then
        metrics_buffer+=$'\n'
    fi
    metrics_buffer+="$metrics_line"
}

metrics_flush()
{
    local force="${1:-false}" now_epoch
    [ -n "$METRICS_FILE" ] || return 0
    if [ "$force" != true ]; then
        metrics_emit_animation_summary
        metrics_emit_maintenance_summary
    fi
    [ -n "$metrics_buffer" ] || return 0
    now_epoch="${EPOCHSECONDS:-$SECONDS}"
    if [ "$force" != true ] && [ -n "$metrics_last_flush_epoch" ] &&
        [ $((now_epoch - metrics_last_flush_epoch)) -lt "$METRICS_FLUSH_SECONDS" ]; then
        return 0
    fi
    printf '%s\n' "$metrics_buffer" >> "$METRICS_FILE" 2>/dev/null || true
    metrics_buffer=""
    metrics_last_flush_epoch="$now_epoch"
}

metrics_next_operation_id()
{
    metrics_operation_seq=$((metrics_operation_seq + 1))
    metrics_operation_id_result="${METRICS_RUN_ID}-${TMUX_PANE:-${SELF_PANE:-none}}-${BASHPID:-$$}-${metrics_operation_seq}"
}

metrics_emit_animation_summary()
{
    [ -n "$METRICS_FILE" ] || return 0
    metrics_write "op=animation phase=summary frames=$animation_metrics_frames cells=$animation_metrics_cells frame_total_us=$animation_metrics_frame_us format_total_us=$animation_metrics_format_us emit_total_us=$animation_metrics_emit_us state_renders=$animation_metrics_state_renders state_rows=$animation_metrics_state_rows state_render_total_us=$animation_metrics_state_render_us full_renders=$animation_metrics_full_renders full_render_total_us=$animation_metrics_full_render_us"
}

metrics_emit_maintenance_summary()
{
    [ -n "$METRICS_FILE" ] || return 0
    local command_counts=""
    if [ -s "$METRICS_COMMAND_FILE" ]; then
        command_counts="$(awk -F '\t' '
            { key=$1 "_" $2; count[key]++ }
            END {
                for (i=1; i<=8; i++) {
                    phase=(i==1 ? "startup" : i==2 ? "read" : i==3 ? "age" : i==4 ? "force" : i==5 ? "state" : i==6 ? "input" : i==7 ? "action" : "other")
                    printf "%s_tmux=%d %s_pgrep=%d%s", phase, count[phase "_tmux"] + 0, phase, count[phase "_pgrep"] + 0, (i < 8 ? " " : "")
                }
            }' "$METRICS_COMMAND_FILE" 2>/dev/null || true)"
    fi
    metrics_write "op=maintenance phase=summary loops=$maintenance_metrics_loops read_timeouts=$maintenance_metrics_read_timeouts read_keys=$maintenance_metrics_read_keys read_us=$maintenance_metrics_read_us age_calls=$maintenance_metrics_age_calls age_us=$maintenance_metrics_age_us age_cpu_ticks=$maintenance_metrics_age_cpu_ticks force_checks=$maintenance_metrics_force_checks force_us=$maintenance_metrics_force_us force_cpu_ticks=$maintenance_metrics_force_cpu_ticks state_calls=$maintenance_metrics_state_calls state_us=$maintenance_metrics_state_us state_skips=$maintenance_metrics_state_skips state_cpu_ticks=$maintenance_metrics_state_cpu_ticks read_cpu_ticks=$maintenance_metrics_read_cpu_ticks command_counts=$command_counts"
}

trap 'metrics_emit_animation_summary; metrics_flush true' EXIT

epoch_now()
{
    if [ -n "${EPOCHSECONDS:-}" ]; then
        printf '%s\n' "$EPOCHSECONDS"
    else
        date +%s
    fi
}

die()
{
    printf 'tmux-session-launcher: %s\n' "$*" >&2
    sleep 1
    exit 1
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

session_exists()
{
    tmux has-session -t "=$1" >/dev/null 2>&1
}

wait_for_session_absence()
{
    session_name="$1"
    timeout="${2:-50}"
    delay="${3:-0.05}"
    i=0

    while [ "$i" -lt "$timeout" ]; do
        if ! session_exists "$session_name"; then
            debug_log "wait_for_session_absence session=$session_name gone after=$i"
            return 0
        fi
        sleep "$delay"
        i=$((i + 1))
    done

    debug_log "wait_for_session_absence timeout session=$session_name"
    return 1
}

find_sidebar_pane()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux list-panes -t "$target" -F '#{pane_id}	#{pane_title}' 2>/dev/null
    else
        tmux list-panes -F '#{pane_id}	#{pane_title}'
    fi |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 == title { print $1; exit }'
}

find_global_sidebar_pane()
{
    sidebar_tmux_global_sidebar_pane
}

cached_sidebar_pane_for_session()
{
    local session_name_value="$1"
    [ -n "${cached_session_panes_snapshot[$session_name_value]:-}" ] || return 1
    awk -F '\t' -v title="$SIDEBAR_TITLE" '$3 == title { print $2; exit }' \
        <<< "${cached_session_panes_snapshot[$session_name_value]}"
}

session_command_signature_from_tmux()
{
    local session_name_value="$1"
    local pane_id_value pane_command_value
    session_command_signature_result=""

    while IFS='|' read -r pane_id_value pane_command_value; do
        [ -n "$pane_id_value" ] || continue
        session_command_signature_result+="$pane_id_value:$pane_command_value|"
    done < <(
        tmux list-panes -t "=$session_name_value:" \
            -F '#{pane_id}|#{pane_current_command}' 2>/dev/null || true
    )
}

window_target()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux display-message -p -t "$target" '#{window_id}' 2>/dev/null || true
    else
        tmux display-message -p '#{window_id}' 2>/dev/null || true
    fi
}

save_work_layout()
{
    target="${1:-}"
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 0

    layout="$(tmux display-message -p -t "$window_id" '#{window_layout}' 2>/dev/null || true)"
    [ -n "$layout" ] || return 0

    tmux set-option -wq -t "$window_id" "$WORK_LAYOUT_OPTION" "$layout" 2>/dev/null || true
}

restore_work_layout()
{
    target="${1:-}"
    window_id="$(window_target "$target")"
    [ -n "$window_id" ] || return 0

    layout="$(tmux show-option -wqv -t "$window_id" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"
    [ -n "$layout" ] || return 0

    tmux select-layout -t "$window_id" "$layout" >/dev/null 2>&1 || true
}

prepare_window_for_archive()
{
    target="$1"
    sidebar_pane="$(find_sidebar_pane "$target")"
    work_layout=""
    work_pane_count=""
    layout_pane_count=""

    work_layout="$(tmux show-option -wqv -t "$target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"

    if [ -n "$sidebar_pane" ] && [ -n "$work_layout" ]; then
        work_pane_count="$(
            tmux list-panes -t "$target" -F '#{pane_title}' 2>/dev/null |
                awk -v title="$SIDEBAR_TITLE" '$0 != title { count++ } END { print count + 0 }'
        )"
        layout_pane_count="$(layout_pane_count "$work_layout")"
        if [ "$work_pane_count" = "$layout_pane_count" ]; then
            printf '%s\n' "$work_layout"
            return 0
        fi
    fi

    if [ -n "$sidebar_pane" ]; then
        printf '\n'
        return 0
    fi

    tmux display-message -p -t "$target" '#{window_layout}' 2>/dev/null || true
}

prepare_window_for_archive_snapshot()
{
    local target="$1"
    local window_index="$2"
    local window_layout="$3"
    local work_layout=""
    local work_pane_count=0
    local layout_pane_count_value=0
    local sidebar_present=false
    local pane_session pane_window_index pane_name pane_active pane_snapshot_layout pane_created
    local pane_index pane_path pane_command pane_title
    local ignored_window_name ignored_window_active ignored_window_layout ignored_created

    while IFS="$(printf '\t')" read -r pane_session pane_index pane_path pane_command pane_title \
        ignored_window_name ignored_window_active ignored_window_layout ignored_created; do
        [ "$pane_session" = "$target" ] || continue
        if [ "$pane_title" = "$SIDEBAR_TITLE" ]; then
            sidebar_present=true
        else
            work_pane_count=$((work_pane_count + 1))
        fi
    done <<EOF
$archive_panes_snapshot
EOF

    if [ "$sidebar_present" = "true" ]; then
        work_layout="$(tmux show-option -wqv -t "$target" "$WORK_LAYOUT_OPTION" 2>/dev/null || true)"
        if [ -n "$work_layout" ]; then
            layout_pane_count_value="$(layout_pane_count "$work_layout")"
            if [ "$work_pane_count" = "$layout_pane_count_value" ]; then
                printf '%s\n' "$work_layout"
                return 0
            fi
        fi
        printf '\n'
        return 0
    fi

    printf '%s\n' "$window_layout"
}

layout_pane_count()
{
    layout="$1"

    printf '%s\n' "$layout" |
        awk '{
            count = 0
            while (match($0, /[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+/)) {
                count++
                $0 = substr($0, RSTART + RLENGTH)
            }
            print count
        }'
}

layout_body()
{
    layout="$1"

    case "$layout" in
        [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F],*) printf '%s\n' "${layout#*,}" ;;
        *) printf '%s\n' "$layout" ;;
    esac
}

layout_with_checksum()
{
    body="$1"
    checksum=0
    bytes="$(printf '%s' "$body" | od -An -tu1 -v)"

    for byte in $bytes; do
        checksum=$((((checksum >> 1) | ((checksum & 1) << 15))))
        checksum=$(((checksum + byte) & 65535))
    done

    printf '%04x,%s\n' "$checksum" "$body"
}

layout_with_pane_ids()
{
    layout="$1"
    pane_ids="$2"
    body="$(layout_body "$layout")"
    replaced=""

    replaced="$(
        printf '%s\n' "$body" |
        awk -v pane_ids="$pane_ids" '
            BEGIN {
                split(pane_ids, ids, " ")
                pane_index = 1
            }
            {
                output = ""
                rest = $0
                while (match(rest, /[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+/)) {
                    token = substr(rest, RSTART, RLENGTH)
                    replacement = token
                    if (ids[pane_index] != "") {
                        sub(/,[0-9]+$/, "," ids[pane_index], replacement)
                    }
                    output = output substr(rest, 1, RSTART - 1) replacement
                    rest = substr(rest, RSTART + RLENGTH)
                    pane_index++
                }
                print output rest
            }'
    )"

    layout_with_checksum "$replaced"
}

list_window_panes()
{
    target="$1"
    tmux list-panes -t "$target" -F '#{pane_id}' 2>/dev/null || true
}

new_pane_from_snapshot()
{
    before="$1"
    target="$2"

    list_window_panes "$target" |
        awk -v before="$before" '
            BEGIN {
                split(before, panes, "\n")
                for (i in panes) {
                    if (panes[i] != "") seen[panes[i]] = 1
                }
            }
            !($0 in seen) { print; exit }
        '
}

target_pane_path()
{
    target="${1:-}"

    if [ -n "$target" ]; then
        tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null || printf '%s\n' "$current_path"
    else
        tmux display-message -p '#{pane_current_path}' 2>/dev/null || printf '%s\n' "$current_path"
    fi
}

mark_sidebar_pane()
{
    local pane_id="${TMUX_PANE:-}"
    trace_event "sidebar.pane-title.begin pane=${pane_id:-current}"
    if [ -n "$pane_id" ]; then
        tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE" 2>/dev/null || true
    else
        tmux select-pane -T "$SIDEBAR_TITLE" 2>/dev/null || true
    fi
    trace_event "sidebar.pane-title.end pane=${pane_id:-current}"
}

sidebar_session_name()
{
    local pane_id="${TMUX_PANE:-${SELF_PANE:-}}"
    local session_name

    [ -n "$pane_id" ] || return 0
    session_name="$(
        tmux list-panes -a -F '#{pane_id}	#{session_name}' 2>/dev/null |
            awk -F '	' -v pane_id="$pane_id" '$1 == pane_id { print $2; exit }'
    )"
    if [ -n "$session_name" ]; then
        printf '%s\n' "$session_name"
    fi
}

current_sidebar_width()
{
    sidebar_pane="$(find_sidebar_pane)"
    [ -n "$sidebar_pane" ] || sidebar_pane="$(find_global_sidebar_pane)"

    if [ -n "$sidebar_pane" ]; then
        tmux display-message -p -t "$sidebar_pane" '#{pane_width}'
    else
        tmux show-option -gqv '@dotfiles-session-sidebar-width'
    fi
}

sidebar_width()
{
    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) printf '%s\n' "$SIDEBAR_WIDTH" ;;
        *) printf '%s\n' "$width" ;;
    esac
}

remember_sidebar_width()
{
    width="$(current_sidebar_width)"

    case "$width" in
        ''|*[!0-9]*) return 0 ;;
        *) tmux set-option -gq '@dotfiles-session-sidebar-width' "$width" ;;
    esac
}

open_sidebar()
{
    target="${1:-}"
    refresh="${2:-false}"
    width="${3:-$(sidebar_width)}"
    pane_path="${4:-}"
    preserve_layout="${5:-false}"
    global_existing_pane="$(find_global_sidebar_pane)"
    if [ -n "$global_existing_pane" ]; then
        if [ -n "$target" ]; then
            target_session_name="$(tmux display-message -p -t "$target" '#{session_name}' 2>/dev/null || true)"
            [ -n "$target_session_name" ] || return 1
            sidebar_controller_move_to_session "$target_session_name"
        else
            tmux select-pane -t "$global_existing_pane" 2>/dev/null || true
        fi
        return 0
    fi
    trace_event "sidebar.open.begin target=${target:-current} refresh=$refresh width=$width preserve_layout=$preserve_layout"
    trace_event "sidebar.existing-lookup.begin target=${target:-current}"
    existing_pane="$(find_sidebar_pane "$target")"
    trace_event "sidebar.existing-lookup.end target=${target:-current} pane=${existing_pane:-none}"

    if [ -n "$existing_pane" ]; then
        trace_event "sidebar.existing-resize.begin pane=$existing_pane"
        tmux resize-pane -t "$existing_pane" -x "$width" 2>/dev/null || true
        trace_event "sidebar.existing-resize.end pane=$existing_pane"
        if [ "$refresh" = "true" ]; then
            trace_event "sidebar.existing-respawn.begin pane=$existing_pane"
            tmux respawn-pane -k -t "$existing_pane" "$SCRIPT_PATH --sidebar"
            tmux select-pane -t "$existing_pane" -T "$SIDEBAR_TITLE"
            trace_event "sidebar.existing-respawn.end pane=$existing_pane"
        fi
        tmux select-pane -t "$existing_pane"
        trace_event "sidebar.open.end target=${target:-current} mode=existing pane=$existing_pane"
        return 0
    fi

    if [ "$preserve_layout" != "true" ]; then
        trace_event "sidebar.layout-save.begin target=${target:-current}"
        save_work_layout "$target"
        trace_event "sidebar.layout-save.end target=${target:-current}"
    fi

    trace_event "sidebar.window-lookup.begin target=${target:-current}"
    target_window="$(window_target "$target")"
    trace_event "sidebar.window-lookup.end target=${target:-current} window=${target_window:-none}"
    before_panes="$(list_window_panes "$target_window")"

    if [ -n "$target" ]; then
        [ -n "$pane_path" ] || pane_path="$(target_pane_path "$target")"
        trace_event "sidebar.split.begin target=$target window=${target_window:-none}"
        tmux split-window -t "$target" -h -f -b -l "$width" \
            -c "$pane_path" "$SCRIPT_PATH --sidebar"
        trace_event "sidebar.split.end target=$target window=${target_window:-none}"
    else
        [ -n "$pane_path" ] || pane_path="$current_path"
        trace_event "sidebar.split.begin target=current window=${target_window:-none}"
        tmux split-window -h -f -b -l "$width" \
            -c "$pane_path" "$SCRIPT_PATH --sidebar"
        trace_event "sidebar.split.end target=current window=${target_window:-none}"
    fi

    trace_event "sidebar.new-pane-lookup.begin target=${target:-current}"
    pane_id="$(new_pane_from_snapshot "$before_panes" "$target_window")"
    trace_event "sidebar.new-pane-lookup.end target=${target:-current} pane=${pane_id:-none}"
    if [ -n "$pane_id" ]; then
        tmux select-pane -t "$pane_id" -T "$SIDEBAR_TITLE"
        tmux select-pane -t "$pane_id"
    fi
    trace_event "sidebar.open.end target=${target:-current} mode=created pane=${pane_id:-none}"
}

ensure_session_sidebar()
{
    session_name="$1"
    refresh="${2:-false}"
    preserve_layout="${4:-false}"
    ensure_session_sidebar_cache_hit=false
    if [ "$refresh" != "true" ] && [ "${topology_cache_initialized:-false}" = "true" ]; then
        if [ -n "$(cached_sidebar_pane_for_session "$session_name" || true)" ]; then
            ensure_session_sidebar_cache_hit=true
            return 0
        fi
    fi
    width="${3:-$(sidebar_width)}"
    open_sidebar "=$session_name:" "$refresh" "$width" "" "$preserve_layout"
}

ensure_sidebar_for_session()
{
    local session_name_value="$1"
    local sidebar_pane target_pane

    [ -n "$session_name_value" ] || return 1
    if [ -n "$(find_global_sidebar_pane)" ]; then
        sidebar_controller_move_to_session "$session_name_value"
        return $?
    fi
    sidebar_pane="$(tmux list-panes -a -F '#{session_name}|#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v session="$session_name_value" -v title="$SIDEBAR_TITLE" \
            '$1 == session && $3 == title { print $2; exit }')"
    [ -n "$sidebar_pane" ] && return 0

    target_pane="$(tmux list-panes -a -F '#{session_name}|#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v session="$session_name_value" -v title="$SIDEBAR_TITLE" \
            '$1 == session && $3 != title { print $2; exit }')"
    [ -n "$target_pane" ] || return 1
    open_sidebar "$target_pane"
}

toggle_current_sidebar()
{
    existing_pane="$(find_global_sidebar_pane)"

    if [ -n "$existing_pane" ]; then
        active_session="$(tmux display-message -p '#S' 2>/dev/null || true)"
        active_window="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
        target_window="$(window_target "$existing_pane")"
        if [ "$active_window" != "$target_window" ]; then
            if sidebar_controller_move_to_session "$active_session"; then
                tmux set-option -g "@sidebar_force_refresh_$active_session" 1 2>/dev/null || true
                signal_sidebar_refresh "$active_session"
                return 0
            fi
            return 1
        fi
        remember_sidebar_width
        tmux kill-pane -t "$existing_pane"
        restore_work_layout "$target_window"
        return 0
    fi

    open_sidebar
}

toggle_sidebar_for_session()
{
    local session_name_value="$1"
    local existing_pane target_pane sidebar_panes

    [ -n "$session_name_value" ] || return 1
    existing_pane="$(find_global_sidebar_pane)"
    if [ -n "$existing_pane" ]; then
        if [ "$(sidebar_tmux_pane_session "$existing_pane")" = "$session_name_value" ]; then
            remember_sidebar_width
            target_window="$(window_target "$existing_pane")"
            tmux kill-pane -t "$existing_pane"
            restore_work_layout "$target_window"
        fi
        return 0
    fi
    sidebar_panes="$(tmux list-panes -t "=$session_name_value" \
        -F '#{pane_id}\t#{pane_title}' 2>/dev/null |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 == title { print $1 }')"
    debug_log "toggle_session session=$session_name_value panes=${sidebar_panes//$'\n'/,}"
    existing_pane="${sidebar_panes%%$'\n'*}"
    if [ -n "$existing_pane" ]; then
        remember_sidebar_width
        target_window="$(window_target "$existing_pane")"
        for attempt in 1 2 3; do
            sidebar_panes="$(tmux list-panes -t "=$session_name_value" \
                -F '#{pane_id}\t#{pane_title}' 2>/dev/null |
                awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 == title { print $1 }')"
            [ -n "$sidebar_panes" ] || break
            while IFS= read -r existing_pane; do
                [ -n "$existing_pane" ] && tmux kill-pane -t "$existing_pane"
            done <<EOF
$sidebar_panes
EOF
            debug_log "toggle_session killed session=$session_name_value panes=${sidebar_panes//$'\n'/,} attempt=$attempt"
            sleep 0.05
        done
        restore_work_layout "$target_window"
        return 0
    fi

    target_pane="$(tmux list-panes -t "=$session_name_value" -F '#{pane_id}' 2>/dev/null | head -n 1)"
    [ -n "$target_pane" ] || return 1
    open_sidebar "$target_pane"
}

toggle_sidebar_for_pane()
{
    local pane_id_value="$1"
    local pane_title_value target_window

    [ -n "$pane_id_value" ] || return 1
    pane_title_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_title}' 2>/dev/null || true)"
    if [ "$pane_title_value" = "$SIDEBAR_TITLE" ]; then
        remember_sidebar_width
        target_window="$(window_target "$pane_id_value")"
        tmux kill-pane -t "$pane_id_value"
        restore_work_layout "$target_window"
    else
        [ -z "$(find_global_sidebar_pane)" ] || return 0
        open_sidebar "$pane_id_value"
    fi
}

current_pane_is_sidebar()
{
    [ "$(tmux display-message -p '#{pane_title}')" = "$SIDEBAR_TITLE" ]
}

current_window_work_pane()
{
    target_window="${1:-$(window_target)}"
    pane_id="$(
        tmux list-panes -t "$target_window" -F '#{pane_id}	#{pane_title}	#{pane_active}' 2>/dev/null |
            awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 != title && $3 == 1 { print $1; exit }'
    )"
    if [ -n "$pane_id" ]; then
        printf '%s\n' "$pane_id"
        return 0
    fi

    tmux list-panes -t "$target_window" -F '#{pane_id}	#{pane_title}' 2>/dev/null |
        awk -F '\t' -v title="$SIDEBAR_TITLE" '$2 != title { print $1; exit }'
}

split_work_pane()
{
    direction="$1"
    work_path=""
    target_window=""
    target_work_pane=""
    before_panes=""
    new_pane_id=""

    if current_pane_is_sidebar; then
        target_work_pane="$(current_window_work_pane)"
        if [ -z "$target_work_pane" ]; then
            tmux display-message 'No work pane found for split.'
            return 0
        fi
        tmux select-pane -t "$target_work_pane" 2>/dev/null || true
    fi

    target_window="$(window_target)"
    if [ -n "$target_work_pane" ]; then
        work_path="$(target_pane_path "$target_work_pane")"
        target_window="$(window_target "$target_work_pane")"
    else
        work_path="$(target_pane_path)"
    fi

    before_panes="$(list_window_panes "$target_window")"

    case "$direction" in
        horizontal)
            if [ -n "$target_work_pane" ]; then
                tmux split-window -t "$target_work_pane" -h -c "$work_path"
            else
                tmux split-window -h -c "$work_path"
            fi
            ;;
        vertical)
            if [ -n "$target_work_pane" ]; then
                tmux split-window -t "$target_work_pane" -v -c "$work_path"
            else
                tmux split-window -v -c "$work_path"
            fi
            ;;
    esac

    new_pane_id="$(new_pane_from_snapshot "$before_panes" "$target_window")"
    [ -n "$new_pane_id" ] && tmux select-pane -t "$new_pane_id" 2>/dev/null || true
}

wait_for_sidebar_refresh()
{
    local session_name="$1"
    local refresh_flag="@sidebar_force_refresh_$session_name"
    local sidebar_pane attempt refresh_value

    sidebar_pane="$(find_sidebar_pane "=$session_name:" 2>/dev/null || true)"

    for attempt in $(seq 1 20); do
        refresh_value="$(tmux show-option -gqv "$refresh_flag" 2>/dev/null || true)"
        if [ "$refresh_value" != "1" ] &&
            [ -n "$sidebar_pane" ] &&
            tmux capture-pane -p -t "$sidebar_pane" 2>/dev/null |
                grep -F -q ">* $session_name"; then
            return 0
        fi
        sleep 0.05
    done
    return 0
}

signal_sidebar_refresh()
{
    local session_name_value="$1"
    local sidebar_pane sidebar_pid

    [ -n "$session_name_value" ] || return 0
    sidebar_pane="$(cached_sidebar_pane_for_session "$session_name_value" || true)"
    [ -n "$sidebar_pane" ] ||
        sidebar_pane="$(find_sidebar_pane "=$session_name_value:" 2>/dev/null || true)"
    [ -n "$sidebar_pane" ] || return 0

    sidebar_pid="$(tmux display-message -p -t "$sidebar_pane" '#{pane_pid}' 2>/dev/null || true)"
    if [ -n "$sidebar_pid" ] && kill -USR2 "$sidebar_pid" 2>/dev/null; then
        trace_event "switch.force-refresh.signal session=$session_name_value pane=$sidebar_pane pid=$sidebar_pid"
    else
        trace_event "switch.force-refresh.signal-failed session=$session_name_value pane=$sidebar_pane pid=${sidebar_pid:-none}"
    fi
}

switch_session()
{
    local session_name="$1"
    local client_tty sidebar_pane owner_session
    local metrics_switch_start="" metrics_switch_operation_id=""
    local metrics_switch_phase_start=""
    local metrics_switch_ensure_us=0 metrics_switch_force_us=0
    local metrics_switch_lookup_us=0 metrics_switch_client_us=0
    local metrics_switch_final_force_us=0
    local sidebar_move_us=0 move_start=""
    [ -n "$session_name" ] || return 0
    session_exists "$session_name" || {
        message_line "session switch failed: session does not exist"
        return 1
    }
    if [ -n "$METRICS_FILE" ]; then
        metrics_switch_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_switch_operation_id="$metrics_operation_id_result"
    fi
    trace_event "switch.begin session=$session_name"
    if [ -n "$metrics_switch_start" ]; then
        metrics_switch_phase_start="$(metrics_now_us)"
    fi
    sidebar_pane="$(find_global_sidebar_pane)"
    owner_session="$(sidebar_tmux_pane_session "$sidebar_pane")"
    client_tty="$(sidebar_tmux_client_tty_for_session "$owner_session")"
    if [ -z "$sidebar_pane" ] || [ -z "$owner_session" ] || [ -z "$client_tty" ]; then
        message_line "session switch failed: active sidebar client is unavailable"
        trace_event "switch.abort reason=sidebar-client-unavailable session=$session_name"
        return 1
    fi
    if [ -n "$metrics_switch_start" ]; then
        metrics_switch_lookup_us=$(( $(metrics_now_us) - metrics_switch_phase_start ))
        metrics_switch_phase_start="$(metrics_now_us)"
    fi
    trace_event "switch.sidebar.move.begin session=$session_name pane=$sidebar_pane"
    [ -n "$metrics_switch_start" ] && move_start="$(metrics_now_us)"
    if ! sidebar_controller_move_to_session "$session_name"; then
        message_line "session switch failed: sidebar move was refused"
        trace_event "switch.abort reason=sidebar-move-failed session=$session_name pane=$sidebar_pane"
        return 1
    fi
    [ -n "$metrics_switch_start" ] && sidebar_move_us=$(( $(metrics_now_us) - move_start ))
    trace_event "switch.sidebar.move.end session=$session_name pane=$sidebar_pane"
    if [ -n "$metrics_switch_start" ]; then
        metrics_switch_ensure_us="$sidebar_move_us"
        metrics_switch_phase_start="$(metrics_now_us)"
    fi
    trace_event "switch.client.begin session=$session_name"
    if ! sidebar_tmux_switch_client "$client_tty" "$session_name" 2>/dev/null; then
        sidebar_controller_move_to_session "$owner_session" >/dev/null 2>&1 || true
        message_line "session switch failed: client switch was refused"
        trace_event "switch.abort reason=client-switch-failed session=$session_name pane=$sidebar_pane"
        return 1
    fi
    trace_event "switch.client.end session=$session_name"
    if [ -n "$metrics_switch_start" ]; then
        metrics_switch_client_us=$(( $(metrics_now_us) - metrics_switch_phase_start ))
        metrics_switch_phase_start="$(metrics_now_us)"
    fi
    current_session="$session_name"
    selected_session="$session_name"
    tmux select-pane -t "$sidebar_pane" -T "$SIDEBAR_TITLE" 2>/dev/null || true
    trace_event "switch.force-refresh.final.begin session=$session_name"
    tmux set-option -g "@sidebar_force_refresh_$session_name" 1 2>/dev/null || true
    signal_sidebar_refresh "$session_name"
    trace_event "switch.force-refresh.final.end session=$session_name"
    if [ -n "$metrics_switch_start" ]; then
        metrics_switch_final_force_us=$(( $(metrics_now_us) - metrics_switch_phase_start ))
    fi
    if [ -n "$metrics_switch_start" ]; then
        metrics_write "op=switch phase=complete operation_id=$metrics_switch_operation_id session=$session_name sidebar_move_us=$metrics_switch_ensure_us force_refresh_us=$metrics_switch_force_us client_lookup_us=$metrics_switch_lookup_us client_switch_us=$metrics_switch_client_us final_force_refresh_us=$metrics_switch_final_force_us total_us=$(( $(metrics_now_us) - metrics_switch_start ))"
    fi
    trace_event "switch.end session=$session_name"
}

is_shell_command()
{
    case "$1" in
        sh|bash|dash|zsh|fish|ksh|mksh|tmux-session-launcher) return 0 ;;
        *) return 1 ;;
    esac
}

is_passive_command()
{
    case "$1" in
        sh|bash|dash|zsh|fish|ksh|mksh|tmux-session-launcher|top|btop|htop|watch) return 0 ;;
        *) return 1 ;;
    esac
}

session_has_shell_pane()
{
    local session_name_value="$1" pane_id_value pane_command_value
    while IFS= read -r pane_id_value; do
        [ -n "$pane_id_value" ] || continue
        pane_command_value="${cached_pane_command[$pane_id_value]:-}"
        if is_shell_command "$pane_command_value"; then
            return 0
        fi
    done <<EOF
${session_ai_probe_pane_ids[$session_name_value]:-}
EOF
    return 1
}

session_has_shell_child_ai_process()
{
    local session_name_value="$1"
    local probe_pane_id probe_command

    while IFS= read -r probe_pane_id; do
        [ -n "$probe_pane_id" ] || continue
        probe_command="${cached_pane_command[$probe_pane_id]:-}"
        is_shell_command "$probe_command" || continue
        if pane_has_ai_cli_process "$probe_pane_id"; then
            return 0
        fi
    done <<EOF
${session_ai_probe_pane_ids[$session_name_value]:-}
EOF
    return 1
}

is_ai_cli_command()
{
    case "$1" in
        codex|claude|gemini|opencode|ollama|agy) return 0 ;;
        *) return 1 ;;
    esac
}

pane_has_ai_cli_process()
{
    local pane_id_value="$1"
    local pane_pid_value="${cached_pane_pid[$pane_id_value]:-}"
    local proc_index=0 proc_current="" proc_child="" proc_children="" proc_args="" proc_seen=0
    local procfs_tree_available=false
    local -a proc_queue=()
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    if [ -z "$pane_pid_value" ]; then
        pane_pid_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    fi
    if [ -z "$pane_pid_value" ]; then
        if [ "$timing_enabled" = "1" ]; then
            timing_end="$(debug_now_us)"
            debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start ))"
        fi
        return 1
    fi

    proc_args=""
    if [ -r "/proc/$pane_pid_value/cmdline" ]; then
        while IFS= read -r -d '' proc_child || [ -n "$proc_child" ]; do
            proc_args+=" $proc_child"
        done < "/proc/$pane_pid_value/cmdline"
    fi
    case "$proc_args" in
        *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*) return 0 ;;
    esac

    # Walk /proc children directly, preserving recursive pgrep behavior
    # without spawning pgrep/grep for every selected shell.
    if [ -r "/proc/$pane_pid_value/task/$pane_pid_value/children" ]; then
        procfs_tree_available=true
        proc_children="$(< "/proc/$pane_pid_value/task/$pane_pid_value/children")"
    fi
    for proc_child in $proc_children; do
        proc_queue+=("$proc_child")
    done
    while [ "$proc_index" -lt "${#proc_queue[@]}" ] && [ "$proc_seen" -lt 128 ]; do
        proc_current="${proc_queue[$proc_index]}"
        proc_index=$((proc_index + 1))
        proc_seen=$((proc_seen + 1))
        proc_args=""
        if [ -r "/proc/$proc_current/cmdline" ]; then
            while IFS= read -r -d '' proc_child || [ -n "$proc_child" ]; do
                proc_args+=" $proc_child"
            done < "/proc/$proc_current/cmdline"
        fi
        case "$proc_args" in
            *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*)
                if [ "$timing_enabled" = "1" ]; then
                    timing_end="$(debug_now_us)"
                    debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=hit us=$(( timing_end - timing_start ))"
                fi
                return 0
                ;;
        esac
        proc_children=""
        if [ -r "/proc/$proc_current/task/$proc_current/children" ]; then
            proc_children="$(< "/proc/$proc_current/task/$proc_current/children")"
        fi
        for proc_child in $proc_children; do
            proc_queue+=("$proc_child")
        done
    done

    # An empty procfs child list is a valid, complete miss: the shell simply
    # has no AI child. Do not fall through to tmux/pgrep in the normal Linux
    # path; those compatibility probes were previously executed after every
    # successful procfs traversal and dominated the state-refresh hot path.
    if [ "$procfs_tree_available" = true ]; then
        if [ "$timing_enabled" = "1" ]; then
            timing_end="$(debug_now_us)"
            debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start )) source=procfs"
        fi
        return 1
    fi

    # Some tmux/PTY combinations expose the pane process but not its child
    # list through procfs. Keep the old observer as a compatibility fallback;
    # normal cached procfs paths do not reach it.
    fallback_pane_pid="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    [ -n "$fallback_pane_pid" ] && pane_pid_value="$fallback_pane_pid"
    if pgrep -a -P "$pane_pid_value" 2>/dev/null |
        grep -Eq '(^|[[:space:]/])(codex|claude|gemini|opencode|ollama|agy)([[:space:]]|$)'; then
        return 0
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing pane_has_ai_cli_process pane_id=$pane_id_value result=miss us=$(( timing_end - timing_start ))"
    fi
    return 1
}

pane_ai_process_alive()
{
    local pane_id_value="$1"
    local pane_pid_value=""
    local proc_cmdline=""

    pane_pid_value="${cached_pane_pid[$pane_id_value]:-}"
    [ -n "$pane_pid_value" ] ||
        pane_pid_value="$(tmux display-message -p -t "$pane_id_value" '#{pane_pid}' 2>/dev/null || true)"
    [ -n "$pane_pid_value" ] || return 0
    kill -0 "$pane_pid_value" 2>/dev/null || return 1

    if [ -r "/proc/$pane_pid_value/cmdline" ]; then
        IFS= read -r -d '' proc_cmdline < "/proc/$pane_pid_value/cmdline" || true
        case "$proc_cmdline" in
            *codex*|*claude*|*gemini*|*opencode*|*ollama*|*agy*) return 0 ;;
        esac
        pane_has_ai_cli_process "$pane_id_value"
        return $?
    fi

    return 0
}

session_ai_pane_for_session()
{
    session_name="$1"

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title command_name; do
        [ "$pane_session" = "$session_name" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue
        if is_ai_cli_command "$command_name" || pane_has_ai_cli_process "$pane_id"; then
            printf '%s\n' "$pane_id"
            return 0
        fi
    done <<EOF
$(tmux list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}' 2>/dev/null)
EOF

    return 1
}

session_ai_fingerprint_for_pane()
{
    pane_id="$1"
    capture_text=""
    fingerprint=""
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    trace_event "ai.fingerprint.begin pane_id=$pane_id"

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    if [ -n "${TEST_CAPTURE+x}" ]; then
        capture_text="$(
            tmux capture-pane -p -t "$pane_id" -S -12 2>/dev/null |
                tr -d '\r' |
                sed -e 's/[[:space:]]*$//' |
                sed '/^[[:space:]]*$/d' |
                awk 'NR==1 { first = $0; prev = $0; next }
                     { print prev; prev = $0 }
                     END { if (NR == 1) print first }' |
                sed -E 's/spinner [0-9]+/spinner/g'
        )"
        fingerprint="$(printf '%s' "$capture_text" | cksum | awk '{ print $1 ":" $2 }')"
    else
        activity="${cached_pane_activity[$pane_id]:-}"
        if [ -z "$activity" ]; then
            activity="$(tmux display-message -p -t "$pane_id" '#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}' 2>/dev/null || printf '0')"
        fi
        fingerprint="act:$activity"
    fi

    if [ "$timing_enabled" = "1" ]; then
        if [ -n "$capture_text" ]; then
            capture_lines="$(printf '%s\n' "$capture_text" | awk 'END{print NR}')"
            capture_tail_preview="$(printf '%s\n' "$capture_text" | tail -n 3 | tr '\n' '|')"
        else
            capture_lines=0
            capture_tail_preview=""
        fi
        debug_log "fingerprint pane_id=$pane_id lines=$capture_lines fp=$fingerprint tail=${capture_tail_preview%|}"
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing session_ai_fingerprint_for_pane pane_id=$pane_id us=$(( timing_end - timing_start ))"
    fi

    trace_event "ai.fingerprint.end pane_id=$pane_id"

    printf '%s\n' "$fingerprint"
}

session_animation_seed_for()
{
    local key="$1"
    local seed=0
    local index char ascii

    # The seed only needs to be stable per session.  Keep the hash deliberately
    # small and calculate it with Bash builtins so a snapshot does not spawn a
    # checksum process for every session.
    for ((index = 0; index < ${#key}; index++)); do
        char="${key:index:1}"
        printf -v ascii '%d' "'$char"
        seed=$(( (seed * 33 + ascii) % 24 ))
    done
    printf '%d\n' "$seed"
}

# Keep the adapter narrow: known AI CLI panes can animate while they are active,
# and non-AI work panes fall back to the existing busy/idle heuristic.
session_activity_age()
{
    session_name="$1"
    now="${current_epoch_second:-}"
    [ -n "$now" ] || now="$(epoch_now)"
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi

    activity="$(tmux display-message -p -t "=$session_name:" '#{session_activity}' 2>/dev/null || printf '0')"

    case "$activity" in
        ''|*[!0-9]*) activity=0 ;;
    esac

    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing session_activity_age session=$session_name us=$(( timing_end - timing_start ))"
    fi

    printf '%s\n' "$((now - activity))"
}

session_cli_state_for_session()
{
    session_name="$1"
    probe_processes="${2:-false}"
    capture_fingerprint="${3:-true}"
    allow_shell_child_probe="${4:-false}"
    session_cli_state_result=""
    session_ai_fingerprint_result=""

    trace_event "ai.state.begin session=$session_name probe=$probe_processes fingerprint=$capture_fingerprint shell_child=$allow_shell_child_probe"

    pane_id="${session_ai_direct_pane_id[$session_name]:-}"

    if [ -n "$pane_id" ]; then
        direct_process_alive=true
        if [ "$probe_processes" = "true" ]; then
            pane_pid="$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null || true)"
            if [ -n "$pane_pid" ] && ! pane_ai_process_alive "$pane_id"; then
                direct_process_alive=false
            fi
        fi
        if [ "$direct_process_alive" = "true" ] && [ "$capture_fingerprint" = "true" ]; then
            fingerprint="$(session_ai_fingerprint_for_pane "$pane_id")"
            if [ -n "$fingerprint" ]; then
                session_ai_fingerprint["$session_name"]="$fingerprint"
                session_cli_state_result="active"
                session_ai_fingerprint_result="$fingerprint"
                trace_event "ai.state.end session=$session_name result=active source=direct"
                return 0
            fi
        elif [ "$direct_process_alive" = "true" ]; then
            fingerprint="${cached_session_ai_fingerprint[$session_name]:-}"
            if [ -n "$fingerprint" ]; then
                session_ai_fingerprint_result="$fingerprint"
                session_cli_state_result="${cached_session_cli_state[$session_name]:-active}"
                trace_event "ai.state.end session=$session_name result=$session_cli_state_result source=cache"
                return 0
            fi
        else
            unset 'session_ai_direct_pane_id[$session_name]'
            session_ai_fingerprint["$session_name"]=""
        fi
    fi

    probe_ids="${session_ai_probe_pane_ids[$session_name]:-}"
    if [ "$probe_processes" = "true" ] && [ -n "$probe_ids" ]; then
        while IFS= read -r probe_pane_id; do
            [ -n "$probe_pane_id" ] || continue
            # A passive shell cannot reveal an AI child without an expensive
            # process-tree walk.  AI-named or otherwise non-passive panes are
            # already represented by the pane command and remain eligible.
            # For non-selected sessions, only an explicitly AI-named command
            # is worth probing; the selected session is the on-demand escape
            # hatch for shell-child AI detection.
            if [ "$allow_shell_child_probe" != true ] &&
                ! is_ai_cli_command "${cached_pane_command[$probe_pane_id]:-}"; then
                continue
            fi
            if is_passive_command "${cached_pane_command[$probe_pane_id]:-}" &&
                { [ "$allow_shell_child_probe" != true ] ||
                    ! is_shell_command "${cached_pane_command[$probe_pane_id]:-}"; } &&
                [ "$probe_pane_id" != "$pane_id" ]; then
                continue
            fi
            if pane_has_ai_cli_process "$probe_pane_id"; then
                fingerprint="$(session_ai_fingerprint_for_pane "$probe_pane_id")"
                if [ -n "$fingerprint" ]; then
                    session_ai_direct_pane_id["$session_name"]="$probe_pane_id"
                    session_ai_fingerprint["$session_name"]="$fingerprint"
                    session_cli_state_result="active"
                    session_ai_fingerprint_result="$fingerprint"
                    trace_event "ai.state.end session=$session_name result=active source=probe pane_id=$probe_pane_id"
                    return 0
                fi
            fi
        done <<EOF
$probe_ids
EOF
    fi

    if session_is_busy "$session_name"; then
        session_cli_state_result="active"
    else
        session_cli_state_result="idle"
    fi
    trace_event "ai.state.end session=$session_name result=$session_cli_state_result source=activity"
}

session_is_busy()
{
    session_name="$1"
    activity_age="${session_activity_age_cache[$session_name]:-}"

    [ -n "$activity_age" ] || activity_age="$(session_activity_age "$session_name")"
    [ "$activity_age" -le "$SIDEBAR_BUSY_SECONDS" ] || return 1
    [ "${session_has_busy_command[$session_name]:-false}" = "true" ] || return 1

    return 0
}

session_status()
{
    if session_is_busy "$1"; then
        printf '%s\n' busy
    else
        printf '%s\n' idle
    fi
}

format_duration()
{
    elapsed="$1"
    days=$((elapsed / 86400))
    remain=$((elapsed % 86400))
    hours=$((remain / 3600))
    remain=$((remain % 3600))
    minutes=$((remain / 60))
    seconds=$((remain % 60))

    printf '%d:%02d:%02d:%02d\n' "$days" "$hours" "$minutes" "$seconds"
}

session_age()
{
    created="$1"
    now="${EPOCHSECONDS:-$SECONDS}"

    case "$created" in
        ''|*[!0-9]*) created="$now" ;;
    esac

    format_duration "$((now - created))"
}

session_age_value()
{
    local created_value="$1"
    local now_value="${EPOCHSECONDS:-$SECONDS}"
    case "$created_value" in
        ''|*[!0-9]*) created_value="$now_value" ;;
    esac
    duration_elapsed=$((now_value - created_value))
    [ "$duration_elapsed" -lt 0 ] && duration_elapsed=0
    duration_days=$((duration_elapsed / 86400))
    duration_remain=$((duration_elapsed % 86400))
    duration_hours=$((duration_remain / 3600))
    duration_remain=$((duration_remain % 3600))
    duration_minutes=$((duration_remain / 60))
    duration_seconds=$((duration_remain % 60))
    printf -v session_age_result '%d:%02d:%02d:%02d' \
        "$duration_days" "$duration_hours" "$duration_minutes" "$duration_seconds"
}

pane_width()
{
    printf '%s\n' "${cached_pane_width:-35}"
}

pane_height()
{
    printf '%s\n' "${cached_pane_height:-20}"
}

update_pane_geometry()
{
    local width height
    if [ -n "$SELF_PANE" ]; then
        width="$(tmux display-message -p -t "$SELF_PANE" '#{pane_width}' 2>/dev/null || printf '35')"
        height="$(tmux display-message -p -t "$SELF_PANE" '#{pane_height}' 2>/dev/null || printf '20')"
    else
        width="$(tmux display-message -p '#{pane_width}' 2>/dev/null || printf '35')"
        height="$(tmux display-message -p '#{pane_height}' 2>/dev/null || printf '20')"
    fi
    case "$width" in ''|*[!0-9]*) width=35 ;; esac
    case "$height" in ''|*[!0-9]*) height=20 ;; esac
    cached_pane_width="$width"
    cached_pane_height="$height"
}

truncate_text()
{
    text="$1"
    max_width="$2"

    if [ "$max_width" -le 0 ]; then
        printf '%s\n' ''
    else
        printf '%.*s\n' "$max_width" "$text"
    fi
}

move_cursor()
{
    printf '\033[%s;%sH' "$1" "$2"
}

clear_line()
{
    printf '\033[2K'
}

hide_cursor()
{
    printf '\033[?25l'
}

show_cursor()
{
    printf '\033[?25h'
}

collect_sessions()
{
    local force_scan="${1:-false}"
    local requested_scan_session="${2:-}"
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""
    list_sessions_start=""
    list_panes_start=""
    parse_panes_start=""
    parse_sessions_start=""
    local metrics_start="" metrics_phase_start="" metrics_list_sessions_start="" metrics_parse_sessions_start=""
    local metrics_list_sessions_us=0 metrics_list_panes_us=0
    local metrics_parse_panes_us=0 metrics_parse_sessions_us=0
    local metrics_status_us=0 metrics_seed_us=0 metrics_ai_us=0
    local metrics_status_count=0 metrics_seed_count=0 metrics_ai_count=0
    local metrics_status_cache_hits=0 metrics_status_cache_misses=0
    local metrics_seed_cache_hits=0 metrics_seed_cache_misses=0
    local metrics_ai_cache_hits=0 metrics_ai_refreshes=0
    local metrics_scan_scope=cache metrics_operation_id="" metrics_pane_scan_scope=cache
    local incremental_pane_scan=false old_requested_panes_snapshot=""
    local previous_snapshot_signature="$snapshot_signature"
    local incoming_session_signature="" row_cache_reusable=false target_row_index=""
    if [ -n "$METRICS_FILE" ]; then
        metrics_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_operation_id="$metrics_operation_id_result"
        if [ "$force_scan" = true ] || [ "$topology_cache_initialized" != true ]; then
            metrics_scan_scope=full
        elif [ -n "$requested_scan_session" ]; then
            metrics_scan_scope=target-requested-full-row
        fi
    fi
    if [ "$topology_cache_initialized" = true ] &&
        [ "$force_scan" != true ] && [ -n "$requested_scan_session" ]; then
        incremental_pane_scan=true
        metrics_pane_scan_scope=target
        old_requested_panes_snapshot="${cached_session_panes_snapshot[$requested_scan_session]:-}"
    fi

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi
    trace_event "collect.sessions.begin force=$force_scan requested=${requested_scan_session:-none}"
    current_epoch_second="$(epoch_now)"
    full_render_required=false
    old_current_session="$current_session"
    current_session="$(tmux display-message -p '#S')"
    old_selected="$selected_session"
    debug_log "collect_sessions start force_scan=$force_scan current_session=$current_session old_selected=$old_selected"
    previous_session_animate=()
    for index in "${!session_names[@]}"; do
        previous_session_animate["${session_names[$index]}"]="${session_animate[$index]}"
    done
    declare -A previous_session_ai_direct_pane_id=()
    declare -A previous_pane_activity=()
    local s_name prev_pane_id curr_pane_id stable_count session_switch_occurred resize_occurred client_switch_occurred pane_generation_changed
    for s_name in "${!session_ai_direct_pane_id[@]}"; do
        previous_session_ai_direct_pane_id["$s_name"]="${session_ai_direct_pane_id[$s_name]}"
    done
    for pane_id in "${!cached_pane_activity[@]}"; do
        previous_pane_activity["$pane_id"]="${cached_pane_activity[$pane_id]}"
    done
    # Sample geometry once per snapshot; render and animation helpers use only
    # these cached values.
    update_pane_geometry
    local current_width="$cached_pane_width"
    local current_height="$cached_pane_height"
    local resize_occurred=false
    if [ -n "$old_pane_width" ] && [ -n "$old_pane_height" ]; then
        if [ "$current_width" != "$old_pane_width" ] || [ "$current_height" != "$old_pane_height" ]; then
            resize_occurred=true
        fi
    fi
    old_pane_width="$current_width"
    old_pane_height="$current_height"
    if [ "$resize_occurred" = "true" ]; then
        full_render_required=true
    fi
    local client_sessions=""
    client_sessions="$(tmux list-clients -F '#{client_session}' 2>/dev/null || true)"
    local client_switch_occurred=false
    if [ -n "${old_client_sessions:-}" ] && [ "$client_sessions" != "$old_client_sessions" ]; then
        client_switch_occurred=true
    fi
    old_client_sessions="$client_sessions"
    if [ "$client_switch_occurred" = "true" ]; then
        full_render_required=true
    fi
    local my_session
    my_session="$(sidebar_session_name || true)"
    if [ -n "$my_session" ]; then
        if [ "${sidebar_session_cached:-}" != "$my_session" ]; then
            sidebar_session_cached="$my_session"
            selected_session="$my_session"
            # Pane moves are also used by async history restore. Do not reset
            # the current TUI view on an owner change: the next physical key
            # must remain in history mode when the user is restoring archives.
            full_render_required=true
        fi
    else
        my_session="${sidebar_session_cached:-}"
    fi
    [ -n "$my_session" ] ||
        my_session="$(tmux display-message -p '#S' -t "${TMUX_PANE:-}" 2>/dev/null || true)"

    local client_session_is_my_session=false
    if [ -n "$my_session" ] && printf '%s\n' "$client_sessions" | grep -F -x -q "$my_session"; then
        client_session_is_my_session=true
    fi

    local is_my_session_attached=false
    if [ -n "$my_session" ] && printf '%s\n' "$client_sessions" | grep -F -x -q "$my_session"; then
        is_my_session_attached=true
    fi

    local session_switch_occurred=false
    if [ -n "${old_current_session:-}" ] && [ "$current_session" != "$old_current_session" ]; then
        session_switch_occurred=true
    fi

    if [ "$is_my_session_attached" = "true" ] && [ "${was_my_session_attached:-}" != "true" ]; then
        selected_session="$my_session"
        old_selected="$my_session"
        full_render_required=true
    fi
    if [ "$client_switch_occurred" = "true" ] && [ "$client_session_is_my_session" = "true" ]; then
        selected_session="$my_session"
        old_selected="$my_session"
        full_render_required=true
    fi
    was_my_session_attached="$is_my_session_attached"
    if [ "$timing_enabled" = "1" ]; then
        list_sessions_start="$(debug_now_us)"
    fi
    if [ -n "$metrics_start" ]; then
        metrics_list_sessions_start="$(metrics_now_us)"
    fi
    sessions_snapshot="$(tmux list-sessions -F '#{session_name}	#{session_created}	#{session_activity}' 2>/dev/null || true)"
    while IFS="$(printf '\t')" read -r signature_name signature_created _signature_activity; do
        [ -n "$signature_name" ] || continue
        incoming_session_signature+="${signature_name}:${signature_created}|"
    done <<EOF
$sessions_snapshot
EOF
    if [ "$incremental_pane_scan" = true ] &&
        [ "$incoming_session_signature" = "$previous_snapshot_signature" ] &&
        [ -n "${cached_session_row_index[$requested_scan_session]:-}" ]; then
        row_cache_reusable=true
        target_row_index="${cached_session_row_index[$requested_scan_session]}"
    fi
    if [ "$row_cache_reusable" = true ]; then
        metrics_scan_scope=target-requested-target-row
        session_activity_age_cache=()
        session_animation_refresh_indexes=()
        snapshot_signature="$incoming_session_signature"
        found_selected=true
        index=0
    else
        session_names=()
        session_created=()
        session_status=()
        session_cli_state=()
        session_animate=()
        session_animation_seed=()
        session_animation_refresh_indexes=()
        session_activity_age_cache=()
        session_has_busy_command=()
        cached_session_row_index=()
        snapshot_signature=""
        found_selected=false
        index=0
    fi
    if [ "$incremental_pane_scan" != true ]; then
        session_ai_probe_pane_ids=()
        session_ai_direct_pane_id=()
        cached_session_command_signature=()
    else
        unset "session_ai_probe_pane_ids[$requested_scan_session]"
        unset "session_ai_direct_pane_id[$requested_scan_session]"
        unset "cached_session_command_signature[$requested_scan_session]"
        unset "session_has_busy_command[$requested_scan_session]"
        while IFS="$(printf '\t')" read -r old_pane_session old_pane_id _old_title _old_command _old_activity _old_pid; do
            [ "$old_pane_session" = "$requested_scan_session" ] || continue
            unset "cached_pane_activity[$old_pane_id]"
            unset "cached_pane_pid[$old_pane_id]"
            unset "cached_pane_command[$old_pane_id]"
        done <<EOF
$old_requested_panes_snapshot
EOF
    fi
    trace_event "collect.list-sessions.end"
    if [ -n "$metrics_start" ]; then
        metrics_list_sessions_us=$(( $(metrics_now_us) - metrics_list_sessions_start ))
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions list-sessions us=$(( timing_end - list_sessions_start )) count=$(printf '%s\n' "$sessions_snapshot" | sed '/^$/d' | wc -l)"
        list_panes_start="$(debug_now_us)"
    fi
    if [ "$topology_cache_initialized" != "true" ] || [ "$force_scan" = "true" ]; then
        metrics_pane_scan_scope=all
        if [ -n "$metrics_start" ]; then
            metrics_phase_start="$(metrics_now_us)"
        fi
        trace_event "collect.list-panes.begin mode=all"
        cached_session_panes_snapshot=()
        panes_snapshot="$(tmux list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}	#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}	#{pane_pid}' 2>/dev/null || true)"
        while IFS="$(printf '\t')" read -r pane_session pane_id pane_title pane_command pane_activity pane_pid; do
            [ -n "$pane_session" ] || continue
            if [ -n "${cached_session_panes_snapshot[$pane_session]:-}" ]; then
                cached_session_panes_snapshot["$pane_session"]+=$'\n'
            fi
            cached_session_panes_snapshot["$pane_session"]+="$pane_session"$'\t'"$pane_id"$'\t'"$pane_title"$'\t'"$pane_command"$'\t'"$pane_activity"$'\t'"$pane_pid"
        done <<EOF
$panes_snapshot
EOF
        topology_cache_initialized=true
        if [ -n "$metrics_phase_start" ]; then
            metrics_list_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
        fi
    elif [ -n "$requested_scan_session" ]; then
        metrics_pane_scan_scope=target
        if [ -n "$metrics_start" ]; then
            metrics_phase_start="$(metrics_now_us)"
        fi
        trace_event "collect.list-panes.begin mode=session session=$requested_scan_session"
        cached_session_panes_snapshot["$requested_scan_session"]="$(
            tmux list-panes -t "=$requested_scan_session:" \
                -F '#{session_name}	#{pane_id}	#{pane_title}	#{pane_current_command}	#{pane_activity}:#{history_size}:#{cursor_y}:#{cursor_x}	#{pane_pid}' \
                2>/dev/null || true
        )"
        if [ -n "$metrics_phase_start" ]; then
            metrics_list_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
        fi
    fi
    trace_event "collect.list-panes.end mode=${requested_scan_session:+session}${requested_scan_session:-cache}"

    panes_snapshot=""
    for pane_session in "${!cached_session_panes_snapshot[@]}"; do
        [ -n "${cached_session_panes_snapshot[$pane_session]:-}" ] || continue
        [ -n "$panes_snapshot" ] && panes_snapshot+=$'\n'
        panes_snapshot+="${cached_session_panes_snapshot[$pane_session]}"
    done
    cached_panes_snapshot="$panes_snapshot"
    panes_to_parse="$panes_snapshot"
    if [ "$incremental_pane_scan" = true ]; then
        panes_to_parse="${cached_session_panes_snapshot[$requested_scan_session]:-}"
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions list-panes us=$(( timing_end - list_panes_start )) count=$(printf '%s\n' "$panes_snapshot" | sed '/^$/d' | wc -l)"
        parse_panes_start="$(debug_now_us)"
    fi
    trace_event "collect.parse-panes.begin"
    if [ -n "$metrics_start" ]; then
        metrics_phase_start="$(metrics_now_us)"
    fi

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title pane_command pane_activity pane_pid; do
        [ -n "$pane_session" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue

        cached_pane_activity["$pane_id"]="$pane_activity"
        cached_pane_pid["$pane_id"]="$pane_pid"
        cached_pane_command["$pane_id"]="$pane_command"
        cached_session_command_signature["$pane_session"]+="$pane_id:$pane_command|"

        if [ "${session_ai_probe_pane_ids[$pane_session]:-}" != "" ]; then
            session_ai_probe_pane_ids["$pane_session"]="${session_ai_probe_pane_ids[$pane_session]}
$pane_id"
        else
            session_ai_probe_pane_ids["$pane_session"]="$pane_id"
        fi

        if ! is_shell_command "$pane_command"; then
            session_has_busy_command["$pane_session"]="true"
        fi

        if is_ai_cli_command "$pane_command"; then
            session_ai_direct_pane_id["$pane_session"]="$pane_id"
        fi
    done <<EOF
$panes_to_parse
EOF
    if [ -n "$metrics_phase_start" ]; then
        metrics_parse_panes_us=$(( $(metrics_now_us) - metrics_phase_start ))
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions parse-panes us=$(( timing_end - parse_panes_start ))"
        parse_sessions_start="$(debug_now_us)"
    fi
    trace_event "collect.parse-panes.end"
    trace_event "collect.parse-sessions.begin"
    if [ -n "$metrics_start" ]; then
        metrics_parse_sessions_start="$(metrics_now_us)"
    fi

    while IFS="$(printf '\t')" read -r name created activity; do
        [ -n "$name" ] || continue
        if [ "$row_cache_reusable" = true ]; then
            [ "$name" = "$requested_scan_session" ] || continue
            index="$target_row_index"
        fi
        trace_event "collect.session.begin session=$name"
        case "$activity" in ''|*[!0-9]*) activity=0 ;; esac
        activity_age=$((current_epoch_second - activity))
        [ "$activity_age" -lt 0 ] && activity_age=0
        session_activity_age_cache["$name"]="$activity_age"
        pane_generation_changed=false
        if [ "${previous_session_ai_direct_pane_id[$name]:-}" != "${session_ai_direct_pane_id[$name]:-}" ]; then
            pane_generation_changed=true
        fi
        trace_event "collect.session.status.begin session=$name"
        status_cache_hit=false
        cached_status_age="${cached_session_status_activity_age[$name]:-}"
        cached_status_busy="${cached_session_status_busy_command[$name]:-false}"
        activity_boundary_changed=false
        if [ -n "$cached_status_age" ] && {
            { [ "$cached_status_age" -le "$SIDEBAR_BUSY_SECONDS" ] &&
                [ "$activity_age" -gt "$SIDEBAR_BUSY_SECONDS" ]; } ||
            { [ "$cached_status_age" -gt "$SIDEBAR_BUSY_SECONDS" ] &&
                [ "$activity_age" -le "$SIDEBAR_BUSY_SECONDS" ]; };
        }; then
            activity_boundary_changed=true
        fi
        if [ -n "${cached_session_status[$name]:-}" ] &&
            [ "${cached_session_status_created[$name]:-}" = "$created" ] &&
            [ "$cached_status_busy" = "${session_has_busy_command[$name]:-false}" ] &&
            [ "$force_scan" != true ] && [ "$name" != "$requested_scan_session" ] &&
            [ "$pane_generation_changed" != true ] &&
            [ "$activity_boundary_changed" != true ]; then
            status_value="${cached_session_status[$name]}"
            status_cache_hit=true
            cached_session_status_activity_age["$name"]="$activity_age"
        else
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            status_value="$(session_status "$name")"
            if [ -n "$metrics_start" ]; then
                metrics_status_us=$((metrics_status_us + $(metrics_now_us) - metrics_phase_start))
                metrics_status_cache_misses=$((metrics_status_cache_misses + 1))
            fi
            cached_session_status["$name"]="$status_value"
            cached_session_status_created["$name"]="$created"
            cached_session_status_activity_age["$name"]="$activity_age"
            cached_session_status_busy_command["$name"]="${session_has_busy_command[$name]:-false}"
        fi
        if [ -n "$metrics_start" ]; then
            metrics_status_count=$((metrics_status_count + 1))
            [ "$status_cache_hit" = true ] &&
                metrics_status_cache_hits=$((metrics_status_cache_hits + 1))
        fi
        trace_event "collect.session.status.end session=$name"
        cli_state_value=""
        ai_fingerprint_value=""
        previous_ai_fingerprint_value="${session_ai_fingerprint[$name]:-}"

        # Hot path에서는 캐시만 사용한다. 전체 강제 스캔은 명시적 이벤트에서만,
        # 특정 session 갱신은 입력 직후 해당 session에 대해서만 수행한다.
        if [ "$force_scan" = "true" ] ||
            [ "$name" = "$requested_scan_session" ] ||
            [ "$pane_generation_changed" = "true" ] ||
            [ -z "${cached_session_cli_state[$name]:-}" ]; then
            if [ -n "$metrics_start" ]; then
                metrics_ai_refreshes=$((metrics_ai_refreshes + 1))
            fi
            probe_processes=false
            capture_fingerprint=true
            if [ "$force_scan" = "true" ] ||
                [ "$name" = "$requested_scan_session" ] ||
                [ -z "${cached_session_cli_state[$name]:-}" ]; then
                probe_processes=true
            fi
            direct_probe_pane="${session_ai_direct_pane_id[$name]:-}"
            if [ -n "$direct_probe_pane" ] &&
                [ -n "${cached_pane_activity[$direct_probe_pane]:-}" ] &&
                [ "${cached_pane_activity[$direct_probe_pane]}" = "${previous_pane_activity[$direct_probe_pane]:-}" ] &&
                [ "${cached_session_cli_state[$name]:-}" = "active" ] &&
                [ "${session_ai_stable_count[$name]:-0}" -lt 2 ] &&
                [ -n "${cached_session_cli_state[$name]:-}" ]; then
                capture_fingerprint=false
                probe_processes=false
            fi
            allow_shell_child_probe=false
            if [ "$name" = "$requested_scan_session" ]; then
                allow_shell_child_probe=true
            fi
            trace_event "collect.ai-probe.begin session=$name probe=$probe_processes fingerprint=$capture_fingerprint"
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            session_cli_state_for_session "$name" "$probe_processes" "$capture_fingerprint" "$allow_shell_child_probe"
            if [ -n "$metrics_start" ]; then
                metrics_ai_us=$((metrics_ai_us + $(metrics_now_us) - metrics_phase_start))
                metrics_ai_count=$((metrics_ai_count + 1))
            fi
            trace_event "collect.ai-probe.end session=$name"
            cached_session_cli_state["$name"]="$session_cli_state_result"
            cached_session_ai_fingerprint["$name"]="$session_ai_fingerprint_result"
        elif [ -n "$metrics_start" ]; then
            metrics_ai_cache_hits=$((metrics_ai_cache_hits + 1))
        fi

        cli_state_value="${cached_session_cli_state[$name]}"
        ai_fingerprint_value="${cached_session_ai_fingerprint[$name]:-}"
        ai_fingerprint_value="${ai_fingerprint_value%-focused}"
        ai_fingerprint_value="${ai_fingerprint_value%-focus}"

        local actual_fingerprint="$ai_fingerprint_value"
        if [ "$session_switch_occurred" = "true" ] || [ "$resize_occurred" = "true" ] || [ "$client_switch_occurred" = "true" ]; then
            ai_fingerprint_value="$previous_ai_fingerprint_value"
        fi

        prev_pane_id="${previous_session_ai_direct_pane_id[$name]:-}"
        curr_pane_id="${session_ai_direct_pane_id[$name]:-}"
        if [ "$prev_pane_id" != "$curr_pane_id" ]; then
            session_ai_fingerprint["$name"]=""
            session_ai_stable_count["$name"]=0
            previous_ai_fingerprint_value=""
        fi

        animate_value="false"
        if [ "$cli_state_value" = "active" ] && [ -n "$ai_fingerprint_value" ]; then
            if [ "$previous_ai_fingerprint_value" = "$ai_fingerprint_value" ]; then
                stable_count=$(( ${session_ai_stable_count[$name]:-0} + 1 ))
                session_ai_stable_count["$name"]="$stable_count"
                if [ "$stable_count" -ge 2 ]; then
                    cli_state_value="waiting"
                else
                    animate_value="true"
                fi
            else
                session_ai_stable_count["$name"]=0
                animate_value="true"
            fi
        fi
        if [ "${TMUX_SESSION_LAUNCHER_DEBUG:-0}" = "1" ]; then
            debug_log "state session=$name prev_fp=$previous_ai_fingerprint_value fp=$ai_fingerprint_value state=$cli_state_value animate=$animate_value"
        fi
        trace_event "collect.session.animation-seed.begin session=$name"
        seed_cache_hit=false
        if [ "${cached_session_animation_seed[$name]:-}" != "" ] &&
            [ "${cached_session_animation_seed_created[$name]:-}" = "$created" ]; then
            animation_seed_value="${cached_session_animation_seed[$name]}"
            seed_cache_hit=true
        else
            if [ -n "$metrics_start" ]; then
                metrics_phase_start="$(metrics_now_us)"
            fi
            animation_seed_value="$(session_animation_seed_for "${name}:${created}")"
            if [ -n "$metrics_start" ]; then
                metrics_seed_us=$((metrics_seed_us + $(metrics_now_us) - metrics_phase_start))
                metrics_seed_cache_misses=$((metrics_seed_cache_misses + 1))
            fi
            cached_session_animation_seed["$name"]="$animation_seed_value"
            cached_session_animation_seed_created["$name"]="$created"
        fi
        if [ -n "$metrics_start" ]; then
            metrics_seed_count=$((metrics_seed_count + 1))
            [ "$seed_cache_hit" = true ] &&
                metrics_seed_cache_hits=$((metrics_seed_cache_hits + 1))
        fi
        trace_event "collect.session.animation-seed.end session=$name"

        if [ "$row_cache_reusable" = true ]; then
            session_created[$index]="$created"
            session_status[$index]="$status_value"
            session_cli_state[$index]="$cli_state_value"
            session_animation_seed[$index]="$animation_seed_value"
            session_animate[$index]="$animate_value"
        else
            session_names+=("$name")
            session_created+=("$created")
            session_status+=("$status_value")
            session_cli_state+=("$cli_state_value")
            session_animation_seed+=("$animation_seed_value")
            session_animate+=("$animate_value")
            cached_session_row_index["$name"]="$index"
        fi
        session_ai_fingerprint["$name"]="$actual_fingerprint"
        if [ "${previous_session_animate[$name]:-}" != "$animate_value" ]; then
            session_animation_refresh_indexes+=("$index")
        fi
        if [ "$row_cache_reusable" != true ]; then
            snapshot_signature="${snapshot_signature}${name}:${created}|"
        fi

        if [ "$name" = "$old_selected" ]; then
            selected_index="$index"
            found_selected=true
        fi
        if [ "$row_cache_reusable" != true ]; then
            index=$((index + 1))
        fi
        trace_event "collect.session.end session=$name"
    done <<EOF
$sessions_snapshot
EOF
    if [ -n "$metrics_start" ]; then
        metrics_parse_sessions_us=$(( $(metrics_now_us) - metrics_parse_sessions_start ))
        metrics_write "op=collect phase=summary operation_id=$metrics_operation_id scan_scope=$metrics_scan_scope row_cache_reusable=$row_cache_reusable pane_scan_scope=$metrics_pane_scan_scope incremental_pane_scan=$incremental_pane_scan force=$force_scan requested=${requested_scan_session:-none} sessions=${#session_names[@]} list_sessions_us=$metrics_list_sessions_us list_panes_us=$metrics_list_panes_us parse_panes_us=$metrics_parse_panes_us parse_sessions_us=$metrics_parse_sessions_us status_us=$metrics_status_us status_count=$metrics_status_count status_cache_hits=$metrics_status_cache_hits status_cache_misses=$metrics_status_cache_misses ai_us=$metrics_ai_us ai_count=$metrics_ai_count ai_cache_hits=$metrics_ai_cache_hits ai_refreshes=$metrics_ai_refreshes seed_us=$metrics_seed_us seed_count=$metrics_seed_count seed_cache_hits=$metrics_seed_cache_hits seed_cache_misses=$metrics_seed_cache_misses total_us=$(( $(metrics_now_us) - metrics_start ))"
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing collect_sessions parse-sessions us=$(( timing_end - parse_sessions_start )) total_us=$(( timing_end - timing_start )) session_count=${#session_names[@]}"
    fi
    trace_event "collect.parse-sessions.end count=${#session_names[@]}"

    if [ "$current_session" != "$old_current_session" ]; then
        full_render_required=true
        for index in "${!session_names[@]}"; do
            if [ "${session_names[$index]}" = "$old_current_session" ] ||
                [ "${session_names[$index]}" = "$current_session" ]; then
                session_animation_refresh_indexes+=("$index")
            fi
        done
    fi

    if [ "${#session_names[@]}" -eq 0 ]; then
        selected_session=""
        selected_index=0
        return 0
    fi

    if [ "$found_selected" != true ]; then
        selected_index=0
        for index in "${!session_names[@]}"; do
            if [ "${session_names[$index]}" = "$current_session" ]; then
                selected_index="$index"
                break
            fi
        done
    fi

    selected_session="${session_names[$selected_index]}"
    if [ "$client_switch_occurred" = "true" ] && [ "$client_session_is_my_session" = "true" ]; then
        align_selection_to_session "$my_session"
    fi
    ensure_selection_visible
    trace_event "collect.sessions.end count=${#session_names[@]} selected=$selected_session"
    debug_log "collect_sessions end current_session=$current_session selected_session=$selected_session selected_index=$selected_index count=${#session_names[@]}"
}

ensure_selection_visible()
{
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        visible_rows=$(((height - 4) / 2))
    else
        visible_rows=$((height - 3))
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    if [ "$selected_index" -lt "$scroll_offset" ]; then
        scroll_offset="$selected_index"
    elif [ "$selected_index" -ge $((scroll_offset + visible_rows)) ]; then
        scroll_offset=$((selected_index - visible_rows + 1))
    fi

    [ "$scroll_offset" -lt 0 ] && scroll_offset=0
    return 0
}

align_selection_to_session()
{
    local target_session="$1"
    local selection_index

    [ -n "$target_session" ] || return 0
    for selection_index in "${!session_names[@]}"; do
        if [ "${session_names[$selection_index]}" = "$target_session" ]; then
            selected_index="$selection_index"
            selected_session="$target_session"
            ensure_selection_visible
            return 0
        fi
    done
}

row_screen_line()
{
    printf '%s\n' "$((2 + $1 - scroll_offset))"
}

row_is_visible()
{
    index="$1"
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        visible_rows=$(((height - 4) / 2))
    else
        visible_rows=$((height - 3))
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    [ "$index" -ge "$scroll_offset" ] && [ "$index" -lt $((scroll_offset + visible_rows)) ]
}

session_visible_rows()
{
    height="${cached_pane_height:-20}"
    if [ "$view_mode" = "history" ]; then
        rows=$(((height - 4) / 2))
    else
        rows=$((height - 3))
    fi

    [ "$rows" -lt 1 ] && rows=1
    printf '%s\n' "$rows"
}

history_start_line()
{
    if [ "$view_mode" = "history" ]; then
        printf '%s\n' "$((2 + $(session_visible_rows) + 1))"
    else
        printf '%s\n' 0
    fi
}

history_visible_rows()
{
    height="${cached_pane_height:-20}"
    start="$(history_start_line)"
    rows=$((height - start))

    [ "$rows" -lt 1 ] && rows=1
    printf '%s\n' "$rows"
}

row_mark()
{
    index="$1"
    name="${session_names[$index]}"

    if [ "$index" -eq "$selected_index" ] && [ "$name" = "$current_session" ]; then
        printf '%s\n' '>*'
    elif [ "$index" -eq "$selected_index" ]; then
        printf '%s\n' '> '
    elif [ "$name" = "$current_session" ]; then
        printf '%s\n' ' *'
    else
        printf '%s\n' '  '
    fi
}

row_mark_value()
{
    index="$1"
    name="${session_names[$index]}"

    if [ "$index" -eq "$selected_index" ] && [ "$name" = "$current_session" ]; then
        row_mark_result='>*'
    elif [ "$index" -eq "$selected_index" ]; then
        row_mark_result='> '
    elif [ "$name" = "$current_session" ]; then
        row_mark_result=' *'
    else
        row_mark_result='  '
    fi
}

render_header()
{
    width="${cached_pane_width:-35}"
    move_cursor 1 1
    clear_line
    printf '%s' "$(truncate_text 'sessions' "$width")"
}

render_footer()
{
    width="${cached_pane_width:-35}"
    height="${cached_pane_height:-20}"
    help='j/k Enter c/r/d o q'

    if [ "$width" -ge 30 ]; then
        help='j/k | Enter | c/r/d | o | q'
    fi

    move_cursor "$height" 1
    clear_line
    printf '%s' "$(truncate_text "$help" "$width")"
}

history_title_from_file()
{
    basename "$1" | sed 's/\.tsv$//'
}

collect_history()
{
    history_files=()
    history_titles=()
    history_checked=()
    history_signature=""
    mkdir -p "$HISTORY_DIR"

    while IFS= read -r file_path; do
        [ -n "$file_path" ] || continue
        history_files+=("$file_path")
        local fname="${file_path##*/}"
        history_titles+=("${fname%.tsv}")
        history_checked+=("false")
        history_signature="${history_signature}${file_path}|"
    done <<EOF
$(find "$HISTORY_DIR" -maxdepth 1 -type f -name '*.tsv' 2>/dev/null | sort -r)
EOF

    if [ "${#history_files[@]}" -eq 0 ]; then
        history_index=0
    elif [ "$history_index" -ge "${#history_files[@]}" ]; then
        history_index=$((${#history_files[@]} - 1))
    fi
}

ensure_history_visible()
{
    visible_rows="$(history_visible_rows)"
    [ "$visible_rows" -lt 1 ] && visible_rows=1

    if [ "$history_index" -lt "$history_scroll_offset" ]; then
        history_scroll_offset="$history_index"
    elif [ "$history_index" -ge $((history_scroll_offset + visible_rows)) ]; then
        history_scroll_offset=$((history_index - visible_rows + 1))
    fi

    [ "$history_scroll_offset" -lt 0 ] && history_scroll_offset=0
    return 0
}

history_row_mark()
{
    index="$1"
    checked=' '

    if [ "${history_checked[$index]}" = "true" ]; then
        checked='x'
    fi

    if [ "$index" -eq "$history_index" ]; then
        printf '>%s\n' "$checked"
    else
        printf ' %s\n' "$checked"
    fi
}

render_history()
{
    width="${cached_pane_width:-35}"
    start="$(history_start_line)"
    visible_rows="$(history_visible_rows)"
    index="$history_scroll_offset"
    end=$((history_scroll_offset + visible_rows))
    line="$((start - 1))"

    move_cursor "$line" 1
    clear_line
    printf '%s' "$(truncate_text 'open: Space mark, Enter restore, d delete' "$width")"

    line="$start"
    while [ "$line" -lt "${cached_pane_height:-20}" ]; do
        move_cursor "$line" 1
        clear_line
        line=$((line + 1))
    done

    line="$start"
    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#history_files[@]}" ]; do
        mark="$(history_row_mark "$index")"
        title="$(truncate_text "${history_titles[$index]}" "$((width - 4))")"
        move_cursor "$line" 1
        clear_line
        printf '%s %s' "$mark" "$title"
        index=$((index + 1))
        line=$((line + 1))
    done
}

print_session_name()
{
    format_session_name "$@"
    printf '%s' "$session_name_result"
}

format_session_name()
{
    local name="$1"
    local width="$2"
    local animate="$3"
    local seed="${4:-0}"
    local text="${name:0:width}"
    local text_width="${#text}"
    local padding=$((width - text_width))
    local result='' char phase color colored

    if [ "$animate" = "true" ] && [ "$SIDEBAR_ANIMATION_ENABLED" = "true" ]; then
        for ((i = 0; i < text_width; i++)); do
            char="${text:i:1}"
            phase=$(((i - animation_frame + seed + 24) % 24))
            case "$phase" in
                0) color=255 ;;
                1) color=254 ;;
                2) color=252 ;;
                3) color=250 ;;
                4) color=248 ;;
                5) color=246 ;;
                *) color=241 ;;
            esac
            printf -v colored '\033[38;5;%sm%s' "$color" "$char"
            result+="$colored"
        done
        result+=$'\033[0m'
    else
        result="$text"
    fi

    if [ "$padding" -gt 0 ]; then
        printf -v padding_text '%*s' "$padding" ''
        result+="$padding_text"
    fi

    session_name_result="$result"
}

row_name_width()
{
    width="$1"

    if [ "$width" -lt 16 ]; then
        printf '%s\n' "$((width - 3))"
    else
        printf '%s\n' "$((width - 2 - 1 - 10 - 2))"
    fi
}

render_session_name_cell()
{
    index="$1"
    line=$((2 + index - scroll_offset))
    width="${cached_pane_width:-35}"
    if [ "$width" -lt 16 ]; then
        name_width=$((width - 3))
    else
        name_width=$((width - 2 - 1 - 10 - 2))
    fi

    [ "$name_width" -lt 1 ] && name_width=1
    format_session_name "${session_names[$index]}" "$name_width" \
        "${session_animate[$index]}" "${session_animation_seed[$index]}"
    printf '\033[%s;4H%s' "$line" "$session_name_result"
}

render_row()
{
    format_row "$1"
    printf '%s' "$row_render_result"
}

format_row()
{
    index="$1"
    line=$((2 + index - scroll_offset))
    width="${cached_pane_width:-35}"
    row_mark_value "$index"
    mark="$row_mark_result"
    session_age_value "${session_created[$index]}"
    age="$session_age_result"
    age_width=10
    name_width=$((width - 2 - 1 - age_width - 2))

    [ "$name_width" -lt 1 ] && name_width=1
    if [ "$width" -lt 16 ]; then
        format_session_name "${session_names[$index]}" "$((width - 3))" \
            "${session_animate[$index]}" "${session_animation_seed[$index]}"
        printf -v row_render_result '\033[%s;1H\033[2K%s %s' \
            "$line" "$mark" "$session_name_result"
    else
        format_session_name "${session_names[$index]}" "$name_width" \
            "${session_animate[$index]}" "${session_animation_seed[$index]}"
        printf -v row_render_result '\033[%s;1H\033[2K%s %s %s ' \
            "$line" "$mark" "$session_name_result" "$age"
    fi
}

render_selection_pair()
{
    local old_index="$1"
    local new_index="$2"
    local selection_render_buffer

    format_row "$old_index"
    selection_render_buffer="$row_render_result"
    format_row "$new_index"
    selection_render_buffer+="$row_render_result"
    printf '%s' "$selection_render_buffer"
}

render_animated_name_cells()
{
    local height="${cached_pane_height:-20}"
    local visible_rows=$((height - 3))
    local animation_buffer="" animation_cell
    local metrics_frame_start="" metrics_frame_end="" metrics_format_start="" metrics_format_end=""
    local metrics_emit_start="" metrics_emit_end="" rendered_cells=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_now_us_value
        metrics_frame_start="$metrics_now_us_result"
    fi
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    local end=$((scroll_offset + visible_rows))
    index="$scroll_offset"

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        if [ "${session_animate[$index]}" = "true" ]; then
            line=$((2 + index - scroll_offset))
            width="${cached_pane_width:-35}"
            name_width=$((width - 2 - 1 - 10 - 2))
            [ "$name_width" -lt 1 ] && name_width=1
            if [ -n "$METRICS_FILE" ]; then
                metrics_now_us_value
                metrics_format_start="$metrics_now_us_result"
            fi
            format_session_name "${session_names[$index]}" "$name_width" \
                "${session_animate[$index]}" "${session_animation_seed[$index]}"
            if [ -n "$METRICS_FILE" ]; then
                metrics_now_us_value
                metrics_format_end="$metrics_now_us_result"
                animation_metrics_format_us=$((animation_metrics_format_us + metrics_format_end - metrics_format_start))
            fi
            printf -v animation_cell '\033[%s;4H%s' "$line" "$session_name_result"
            animation_buffer+="$animation_cell"
            rendered_cells=$((rendered_cells + 1))
        fi
        index=$((index + 1))
    done
    if [ -n "$animation_buffer" ]; then
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            metrics_emit_start="$metrics_now_us_result"
        fi
        printf '%s' "$animation_buffer"
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            metrics_emit_end="$metrics_now_us_result"
            animation_metrics_emit_us=$((animation_metrics_emit_us + metrics_emit_end - metrics_emit_start))
        fi
    fi
    if [ -n "$metrics_frame_start" ]; then
        metrics_now_us_value
        metrics_frame_end="$metrics_now_us_result"
        animation_metrics_frames=$((animation_metrics_frames + 1))
        animation_metrics_cells=$((animation_metrics_cells + rendered_cells))
        animation_metrics_frame_us=$((animation_metrics_frame_us + metrics_frame_end - metrics_frame_start))
    fi
}

refresh_sidebar_state_if_due()
{
    now_epoch="${EPOCHSECONDS:-$SECONDS}"
    if [ -z "${last_state_refresh_epoch:-}" ] ||
        [ $((now_epoch - last_state_refresh_epoch)) -ge "$SIDEBAR_STATE_REFRESH_SECONDS" ]; then
        # Passive sessions do not need a full state scan when their pane
        # topology and command names are unchanged.  A single target-scoped
        # snapshot still detects a shell -> command transition.
        if [ -n "${selected_session:-}" ] &&
            [ -z "${session_ai_direct_pane_id[$selected_session]:-}" ]; then
            if session_has_shell_pane "$selected_session"; then
                # A selected shell only needs a cheap process-tree probe.  Do
                # not rebuild the target snapshot when no AI child exists.
                if ! session_has_shell_child_ai_process "$selected_session"; then
                    last_state_refresh_epoch="$now_epoch"
                    return 1
                fi
            else
            # A stable pane command signature is enough to keep ordinary
            # non-AI sessions on their cached state.  The previous busy-command
            # guard forced a full snapshot for fixtures such as `sleep`, even
            # though no AI fingerprint could change without a command/pane
            # transition.  AI-named panes remain on the fingerprint path above.
            session_command_signature_from_tmux "$selected_session"
            if [ "${session_command_signature_result:-}" = \
                "${cached_session_command_signature[$selected_session]:-}" ]; then
                last_state_refresh_epoch="$now_epoch"
                return 1
            fi
            fi
        fi
        refresh_if_needed
        last_state_refresh_epoch="$now_epoch"
        return 0
    fi

    return 1
}

state_refresh_due()
{
    local now_epoch_value="${EPOCHSECONDS:-$SECONDS}"
    [ -z "${last_state_refresh_epoch:-}" ] ||
        [ $((now_epoch_value - last_state_refresh_epoch)) -ge "$SIDEBAR_STATE_REFRESH_SECONDS" ]
}

render_visible_rows()
{
    height="${cached_pane_height:-20}"
    visible_rows="$(session_visible_rows)"
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    end=$((scroll_offset + visible_rows))
    index="$scroll_offset"
    line=2

    while [ "$line" -lt "$height" ]; do
        move_cursor "$line" 1
        clear_line
        line=$((line + 1))
    done

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        render_row "$index"
        index=$((index + 1))
    done
}

render_full()
{
    local metrics_render_start="" metrics_render_end=""
    if [ -n "$METRICS_FILE" ]; then
        metrics_render_start="$(metrics_now_us)"
    fi
    last_width="${cached_pane_width:-35}"
    last_height="${cached_pane_height:-20}"
    debug_log "render_full start current_session=$current_session selected_session=$selected_session view_mode=$view_mode count=${#session_names[@]}"

    local buffer
    buffer="$(
        printf '\033[H\033[2J'
        hide_cursor
        render_header
        render_visible_rows
        if [ "$view_mode" = "history" ]; then
            render_history
        fi
        render_footer
    )"
    printf '%s' "$buffer"

    if [ -n "$metrics_render_start" ]; then
        metrics_render_end="$(metrics_now_us)"
        animation_metrics_full_renders=$((animation_metrics_full_renders + 1))
        animation_metrics_full_render_us=$((animation_metrics_full_render_us + metrics_render_end - metrics_render_start))
    fi

    debug_log "render_full end current_session=$current_session selected_session=$selected_session view_mode=$view_mode"
}

render_age_cells()
{
    local age_buffer="" age_cell
    index="$scroll_offset"
    height="${cached_pane_height:-20}"
    visible_rows=$((height - 3))
    [ "$visible_rows" -lt 1 ] && visible_rows=1
    end=$((scroll_offset + visible_rows))
    width="${cached_pane_width:-35}"
    [ "$width" -lt 16 ] && return 0

    while [ "$index" -lt "$end" ] && [ "$index" -lt "${#session_names[@]}" ]; do
        line=$((2 + index - scroll_offset))
        session_age_value "${session_created[$index]}"
        printf -v age_cell '\033[%s;%sH%s' "$line" "$((width - 10))" "$session_age_result"
        age_buffer+="$age_cell"
        index=$((index + 1))
    done
    [ -n "$age_buffer" ] && printf '%s' "$age_buffer"
}

render_animation_state_changes()
{
    local animation_buffer="" metrics_render_start="" metrics_render_end="" rendered_rows=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_render_start="$(metrics_now_us)"
    fi
    for index in "${session_animation_refresh_indexes[@]}"; do
        if row_is_visible "$index"; then
            format_row "$index"
            animation_buffer+="$row_render_result"
            rendered_rows=$((rendered_rows + 1))
        fi
    done
    [ -n "$animation_buffer" ] && printf '%s' "$animation_buffer"
    if [ -n "$metrics_render_start" ]; then
        metrics_render_end="$(metrics_now_us)"
        animation_metrics_state_renders=$((animation_metrics_state_renders + 1))
        animation_metrics_state_rows=$((animation_metrics_state_rows + rendered_rows))
        animation_metrics_state_render_us=$((animation_metrics_state_render_us + metrics_render_end - metrics_render_start))
    fi
    session_animation_refresh_indexes=()
}

refresh_if_needed()
{
    timing_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"
    timing_start=""
    timing_end=""

    if [ "$timing_enabled" = "1" ]; then
        timing_start="$(debug_now_us)"
    fi
    old_signature="$snapshot_signature"
    old_width="$last_width"
    old_height="$last_height"

    debug_log "refresh_if_needed start old_signature=$old_signature old_width=$old_width old_height=$old_height"
    # The periodic refresh is the only idle-time state probe.  It refreshes the
    # selected session while all other sessions remain on their cached values.
    collect_sessions false "$selected_session"
    if [ "$full_render_required" = "true" ] ||
        [ "$old_signature" != "$snapshot_signature" ] ||
        [ "$old_width" != "${cached_pane_width:-35}" ] ||
        [ "$old_height" != "${cached_pane_height:-20}" ]; then
        debug_log "refresh_if_needed render because signature_or_size_changed new_signature=$snapshot_signature new_width=${cached_pane_width:-35} new_height=${cached_pane_height:-20}"
        render_full
        session_animation_refresh_indexes=()
    fi
    if [ "$timing_enabled" = "1" ]; then
        timing_end="$(debug_now_us)"
        debug_log "timing refresh_if_needed total_us=$(( timing_end - timing_start ))"
    fi
    debug_log "refresh_if_needed end current_session=$current_session selected_session=$selected_session signature=$snapshot_signature"
}

restore_terminal()
{
    stop_tick_timer
    show_cursor
    [ -n "$stty_state" ] && stty "$stty_state" 2>/dev/null || true
}

handle_tick_signal()
{
    tick_signal_pending=true
}

handle_refresh_signal()
{
    refresh_signal_pending=true
}

start_tick_timer()
{
    local parent_pid="$$"

    (
        trap 'exit 0' TERM INT HUP
        trap '' USR1
        while :; do
            sleep "$SIDEBAR_TICK_INTERVAL"
            kill -USR1 "$parent_pid" 2>/dev/null || exit 0
        done
    ) &
    tick_timer_pid="$!"
}

stop_tick_timer()
{
    if [ -n "$tick_timer_pid" ]; then
        kill "$tick_timer_pid" 2>/dev/null || true
        wait "$tick_timer_pid" 2>/dev/null || true
        tick_timer_pid=""
    fi
}

setup_terminal()
{
    stty_state="$(stty -g 2>/dev/null || true)"
    stty -echo -icanon time 0 min 0 2>/dev/null || true
    trap restore_terminal EXIT INT TERM
    trap 'update_pane_geometry; full_render_required=true' WINCH
    trap handle_tick_signal USR1
    trap handle_refresh_signal USR2
}

prompt_line()
{
    prompt="$1"
    prompt_result=""
    prompt_cancelled=false
    height="${cached_pane_height:-20}"
    key=""

    move_cursor "$height" 1
    clear_line
    printf '%s' "$prompt"

    while true; do
        IFS= read -rsn1 key || key=""
        if [ -n "$METRICS_FILE" ]; then
            if [ -n "$key" ]; then
                metrics_phase=action
            else
                metrics_phase=read
            fi
        fi
        case "$key" in
            $'\033')
                prompt_cancelled=true
                break
                ;;
            ''|$'\n'|$'\r')
                break
                ;;
            $'\177'|$'\b')
                if [ -n "$prompt_result" ]; then
                    prompt_result="${prompt_result%?}"
                    printf '\b \b'
                fi
                ;;
            *)
                prompt_result="${prompt_result}${key}"
                printf '%s' "$key"
                ;;
        esac
    done
}

message_line()
{
    message="$1"
    height="${cached_pane_height:-20}"

    move_cursor "$height" 1
    clear_line
    printf '%s' "$(truncate_text "$message" "${cached_pane_width:-35}")"
    sleep 1
}

debug_log()
{
    debug_file="${TMUX_SESSION_LAUNCHER_DEBUG_FILE:-/tmp/tmux-session-launcher-debug.log}"
    debug_enabled="${TMUX_SESSION_LAUNCHER_DEBUG:-0}"

    if [ "$debug_enabled" != "1" ]; then
        return 0
    fi

    {
        printf '%s %s\n' "$(date '+%F %T')" "$*"
    } >> "$debug_file" 2>/dev/null || true
}

trace_event()
{
    [ "${TMUX_SESSION_LAUNCHER_TRACE:-0}" = "1" ] || return 0
    trace_file="${TMUX_SESSION_LAUNCHER_TRACE_FILE:-/tmp/tmux-session-launcher-trace.log}"
    trace_pane="${TMUX_PANE:-${SELF_PANE:-none}}"
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s pane=%s %s\n' "$EPOCHREALTIME" "$trace_pane" "$*" >> "$trace_file" 2>/dev/null || true
    else
        printf '%s pane=%s %s\n' "$(debug_now_us)" "$trace_pane" "$*" >> "$trace_file" 2>/dev/null || true
    fi
}

debug_now_us()
{
    if [ -n "${EPOCHREALTIME:-}" ]; then
        printf '%s\n' "${EPOCHREALTIME/./}"
    else
        date +%s%6N
    fi
}

maintenance_cooldown_active()
{
    local now_us elapsed_us cooldown_us
    [ -n "${last_input_epoch_us:-}" ] || return 1
    cooldown_us=$((SIDEBAR_KEY_MAINTENANCE_COOLDOWN_MS * 1000))
    [ "$cooldown_us" -gt 0 ] || return 1
    now_us="$(debug_now_us)"
    elapsed_us=$((now_us - last_input_epoch_us))
    [ "$elapsed_us" -ge 0 ] && [ "$elapsed_us" -lt "$cooldown_us" ]
}

safe_file_part()
{
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_' ;;
        *) printf '%s' "$1" ;;
    esac
}

tmux_history_file()
{
    printf '%s\n' "${HISTFILE:-$HOME/.cache/dotfiles/tmux.zsh_history}"
}

archivable_window_count()
{
    session_name="$1"
    count=0

    while IFS= read -r window_index; do
        if tmux list-panes -t "=$session_name:$window_index" -F '#{pane_title}' 2>/dev/null |
            awk -v title="$SIDEBAR_TITLE" '$0 != title { found = 1 } END { exit found ? 0 : 1 }'; then
            count=$((count + 1))
        fi
    done <<EOF
$(tmux list-windows -t "=$session_name:" -F '#{window_index}' 2>/dev/null)
EOF

    printf '%s\n' "$count"
}

archive_shell_history()
{
    history_file="$(tmux_history_file)"
    [ -f "$history_file" ] || return 0

    tail -n 200 "$history_file" 2>/dev/null |
        while IFS= read -r history_line; do
            printf 'history\t%s\n' "$history_line"
        done
}

append_archive_history()
{
    archive_path="$1"
    history_file="$(tmux_history_file)"
    history_dir="$(dirname "$history_file")"

    [ -d "$history_dir" ] || mkdir -p "$history_dir"
    while IFS="$(printf '\t')" read -r record history_line; do
        [ "$record" = history ] || continue
        printf '%s\n' "$history_line"
    done < "$archive_path" >> "$history_file"
}

clear_restored_work_panes()
{
    session_name="$1"

    while IFS="$(printf '\t')" read -r pane_session pane_id pane_title; do
        [ "$pane_session" = "$session_name" ] || continue
        [ "$pane_title" = "$SIDEBAR_TITLE" ] && continue
        tmux send-keys -t "$pane_id" C-l 2>/dev/null || true
        tmux clear-history -t "$pane_id" 2>/dev/null || true
    done <<EOF
$(tmux list-panes -a -F '#{session_name}	#{pane_id}	#{pane_title}' 2>/dev/null)
EOF
}

apply_restored_window_layout()
{
    target="$1"
    layout="$2"
    pane_ids="$3"
    restored_layout=""

    [ -n "$target" ] || return 0
    [ -n "$layout" ] || return 0

    trace_event "restore.layout.begin target=$target panes=${pane_ids:-none}"
    restored_layout="$(layout_with_pane_ids "$layout" "$pane_ids")"
    tmux select-layout -t "$target" "$restored_layout" >/dev/null 2>&1 || true
    tmux set-option -wq -t "$target" "$WORK_LAYOUT_OPTION" "$restored_layout" 2>/dev/null || true
    trace_event "restore.layout.end target=$target"
}

archive_session()
{
    local archive_pane_session archive_pane_window archive_pane_index archive_pane_path
    local archive_pane_command archive_pane_title archive_pane_line
    local window_pane_count
    local metrics_archive_start="" metrics_archive_operation_id=""
    local metrics_archive_snapshot_us=0 metrics_archive_write_us=0 metrics_archive_rename_us=0
    local metrics_archive_phase_start=""
    declare -A archive_window_pane_counts=()
    declare -A archive_window_pane_lines=()
    declare -A archive_window_names=()
    declare -A archive_window_active=()
    declare -A archive_window_layouts=()
    declare -A archive_window_created=()
    declare -a archive_window_order=()

    session_name="$1"
    local existence_checked="${2:-false}"
    [ -n "$session_name" ] || return 1
    [ "$existence_checked" = "true" ] || session_exists "$session_name" || return 1
    if [ -n "$METRICS_FILE" ]; then
        metrics_archive_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_archive_operation_id="$metrics_operation_id_result"
    fi

    trace_event "archive.begin session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    mkdir -p "$HISTORY_DIR"
    printf -v stamp '%(%Y%m%d-%H%M%S)T' -1
    archive_base="${stamp}-$(safe_file_part "$session_name")"
    archive_path="$HISTORY_DIR/${archive_base}-pending.tsv"
    trace_event "archive.snapshot.begin session=$session_name"
    archive_panes_snapshot="$(tmux list-panes -t "=$session_name:" \
        -F '#{session_name}	#{window_index}	#{pane_index}	#{pane_current_path}	#{pane_current_command}	#{pane_title}	#{window_name}	#{window_active}	#{window_layout}	#{session_created}' \
        2>/dev/null || true)"
    trace_event "archive.panes_snapshot session=$session_name"
    while IFS="$(printf '\t')" read -r archive_pane_session archive_pane_window \
        archive_pane_index archive_pane_path archive_pane_command archive_pane_title \
        archive_window_name_value archive_window_active_value archive_window_layout_value archive_window_created_value; do
        [ "$archive_pane_session" = "=$session_name:" ] ||
            [ "$archive_pane_session" = "$session_name" ] || continue
        if [ -z "${archive_window_pane_counts[$archive_pane_window]+set}" ]; then
            archive_window_order+=( "$archive_pane_window" )
            archive_window_names["$archive_pane_window"]="$archive_window_name_value"
            archive_window_active["$archive_pane_window"]="$archive_window_active_value"
            archive_window_layouts["$archive_pane_window"]="$archive_window_layout_value"
            archive_window_created["$archive_pane_window"]="$archive_window_created_value"
        fi
        [ "$archive_pane_title" = "$SIDEBAR_TITLE" ] && continue
        archive_window_pane_counts["$archive_pane_window"]=$((
            ${archive_window_pane_counts["$archive_pane_window"]:-0} + 1
        ))
        archive_pane_line="$archive_pane_index$(printf '\t')$archive_pane_path$(printf '\t')$archive_pane_command"
        archive_window_pane_lines["$archive_pane_window"]+="${archive_window_pane_lines["$archive_pane_window"]:+$'\n'}$archive_pane_line"
    done <<< "$archive_panes_snapshot"
    trace_event "archive.snapshot.end session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_snapshot_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    trace_event "archive.write.begin session=$session_name"
    {
        printf 'version\t1\n'
        printf 'session\t%s\n' "$session_name"
        printf -v archived_at '%(%s)T' -1
        printf 'archived_at\t%s\n' "$archived_at"
        window_count=0
        created_value=""
        for window_index in "${archive_window_order[@]}"; do
            window_name="${archive_window_names[$window_index]}"
            window_active="${archive_window_active[$window_index]}"
            window_layout="${archive_window_layouts[$window_index]}"
            window_created="${archive_window_created[$window_index]}"
            [ -n "$created_value" ] || created_value="$window_created"
            window_pane_count="${archive_window_pane_counts["$window_index"]:-0}"
            [ "$window_pane_count" -gt 0 ] || continue
            window_count=$((window_count + 1))
            window_layout="$(prepare_window_for_archive_snapshot "$session_name" "$window_index" "$window_layout")"
            printf 'window\t%s\t%s\t%s\t%s\n' "$window_index" "$window_name" "$window_active" "$window_layout"
            while IFS="$(printf '\t')" read -r pane_index pane_path pane_command; do
                printf 'pane\t%s\t%s\t%s\n' "$pane_index" "$pane_path" "$pane_command"
            done <<< "${archive_window_pane_lines["$window_index"]:-}"
            printf 'endwindow\n'
        done
        printf 'created\t%s\n' "$created_value"
        archive_shell_history
    } > "$archive_path"
    trace_event "archive.write.end session=$session_name windows=$window_count"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_write_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
        metrics_archive_phase_start="$(metrics_now_us)"
    fi

    final_path="$HISTORY_DIR/${archive_base}-${window_count}w.tsv"
    trace_event "archive.rename.begin session=$session_name"
    mv "$archive_path" "$final_path"
    trace_event "archive.rename.end session=$session_name"
    if [ -n "$metrics_archive_start" ]; then
        metrics_archive_rename_us=$(( $(metrics_now_us) - metrics_archive_phase_start ))
    fi
    trace_event "archive.end session=$session_name windows=$window_count"
    if [ -n "$metrics_archive_start" ]; then
        metrics_write "op=archive phase=complete operation_id=$metrics_archive_operation_id session=$session_name windows=$window_count snapshot_us=$metrics_archive_snapshot_us write_us=$metrics_archive_write_us rename_us=$metrics_archive_rename_us total_us=$(( $(metrics_now_us) - metrics_archive_start ))"
    fi

    printf '%s\n' "$final_path"
}

archive_all_sessions()
{
    should_archive="$1"

    while IFS= read -r session_name; do
        [ -n "$session_name" ] || continue
        if [ "$should_archive" = "true" ]; then
            archive_session "$session_name" >/dev/null || true
        fi
    done <<EOF
$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
EOF
}

delete_all_sessions_after_archive()
{
    should_archive="${1:-false}"

    archive_all_sessions "$should_archive"
    tmux kill-server
}

fallback_session()
{
    deleting="$1"

    tmux list-sessions -F '#{session_name}' 2>/dev/null |
        awk -v deleting="$deleting" '$0 != deleting { print; exit }'
}

shell_quote()
{
    printf '%q' "$1"
}

delete_session_after_archive()
{
    local session_name="$1"
    local should_archive="${2:-false}"
    local current_client_session="" target_clients="" target_has_clients=false
    local next_session="" archive_fast_path=false
    local metrics_delete_start="" metrics_delete_operation_id=""
    local metrics_delete_phase_start="" metrics_delete_preflight_us=0
    local metrics_delete_fallback_us=0 metrics_delete_archive_us=0 metrics_delete_kill_us=0

    # archive_session performs the authoritative existence check.  The
    # archive fast path can therefore avoid a duplicate tmux has-session IPC;
    # delete-only keeps the original early return semantics below.
    if [ "$should_archive" != "true" ]; then
        session_exists "$session_name" || return 0
    fi

    if [ -n "$METRICS_FILE" ]; then
        metrics_delete_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_delete_operation_id="$metrics_operation_id_result"
        metrics_phase=action
        metrics_delete_phase_start="$(metrics_now_us)"
    fi

    # Capture the target's client attachment as data.  `list-clients` exits
    # successfully for an existing session even when it has no clients, so
    # checking only its exit status cannot distinguish the fast-path case.
    if ! target_clients="$(tmux list-clients -t "=$session_name" -F '#{session_name}' 2>/dev/null)"; then
        return 0
    fi
    [ -n "$target_clients" ] && target_has_clients=true
    if [ -n "$metrics_delete_start" ]; then
        metrics_delete_preflight_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
        metrics_delete_phase_start="$(metrics_now_us)"
    fi
    if [ "$should_archive" = "true" ] && [ "$target_has_clients" = false ]; then
        archive_fast_path=true
        # An unconnected target cannot require client migration.  Let tmux
        # remove the last session naturally instead of spending another IPC
        # round trip discovering a fallback session.
        next_session=""
    else
        session_exists "$session_name" || return 0
        next_session="$(fallback_session "$session_name")"
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_fallback_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        current_client_session="$(tmux display-message -p '#S' 2>/dev/null || true)"
    fi

    debug_log "delete_session_after_archive start session=$session_name should_archive=$should_archive current_client_session=$current_client_session target_has_clients=$target_has_clients next_session=$next_session archive_fast_path=$archive_fast_path"

    if [ "$archive_fast_path" = false ] &&
        { [ "$current_client_session" = "$session_name" ] || [ "$target_has_clients" = true ]; }; then
        if [ -n "$next_session" ]; then
            debug_log "delete_session_after_archive switch-client to fallback session=$next_session from session=$session_name"
            tmux switch-client -t "=$next_session" 2>/dev/null || true
        else
            debug_log "delete_session_after_archive no fallback session for session=$session_name"
        fi
    fi

    if [ "$should_archive" = "true" ]; then
        debug_log "delete_session_after_archive archive session=$session_name"
        trace_event "archive.delete-wrapper.begin session=$session_name"
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        archive_session "$session_name" true >/dev/null || true
        if [ -n "$metrics_delete_start" ]; then
            metrics_delete_archive_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
            metrics_delete_phase_start="$(metrics_now_us)"
        fi
        trace_event "archive.delete-wrapper.end session=$session_name"
    fi

    if [ "$archive_fast_path" = true ]; then
        debug_log "delete_session_after_archive kill-session fast path session=$session_name"
        tmux kill-session -t "=$session_name" 2>/dev/null || true
    elif [ -n "$next_session" ]; then
        debug_log "delete_session_after_archive kill-session session=$session_name next_session=$next_session"
        tmux switch-client -t "=$next_session" 2>/dev/null || true
        tmux kill-session -t "=$session_name" 2>/dev/null || true
    else
        debug_log "delete_session_after_archive kill-server session=$session_name"
        tmux kill-server
    fi

    if [ -n "$metrics_delete_start" ]; then
        metrics_delete_kill_us=$(( $(metrics_now_us) - metrics_delete_phase_start ))
        metrics_write "op=archive-wrapper phase=complete operation_id=$metrics_delete_operation_id session=$session_name fast_path=$archive_fast_path preflight_us=$metrics_delete_preflight_us fallback_lookup_us=$metrics_delete_fallback_us archive_us=$metrics_delete_archive_us kill_us=$metrics_delete_kill_us total_us=$(( $(metrics_now_us) - metrics_delete_start ))"
    fi
}

run_session_delete()
{
    session_name="$1"
    should_archive="$2"
    quoted_script="$(shell_quote "$SCRIPT_PATH")"
    quoted_session="$(shell_quote "$session_name")"
    quoted_archive="$(shell_quote "$should_archive")"

    debug_log "run_session_delete session=$session_name should_archive=$should_archive"
    tmux run-shell -b "$quoted_script --delete-session-after-archive $quoted_session $quoted_archive"
}

run_all_sessions_delete()
{
    should_archive="$1"
    quoted_script="$(shell_quote "$SCRIPT_PATH")"
    quoted_archive="$(shell_quote "$should_archive")"

    tmux run-shell -b "$quoted_script --delete-all-sessions-after-archive $quoted_archive"
}

archive_selected_indices()
{
    selected_any=false
    for index in "${!history_files[@]}"; do
        if [ "${history_checked[$index]}" = "true" ]; then
            printf '%s\n' "$index"
            selected_any=true
        fi
    done

    if [ "$selected_any" = "false" ] && [ "${#history_files[@]}" -gt 0 ]; then
        printf '%s\n' "$history_index"
    fi
}

restore_archive()
{
    archive_path="$1"
    [ -f "$archive_path" ] || return 1
    local metrics_restore_start="" metrics_restore_operation_id=""
    if [ -n "$METRICS_FILE" ]; then
        metrics_restore_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_restore_operation_id="$metrics_operation_id_result"
    fi

    original_name="$(awk -F '\t' '$1 == "session" { print $2; exit }' "$archive_path")"
    [ -n "$original_name" ] || original_name="restored"

    restore_name="$original_name"
    if session_exists "$restore_name"; then
        message_line "Exists: $restore_name"
        return 1
    fi

    trace_event "restore.history.begin session=$restore_name"
    append_archive_history "$archive_path"
    trace_event "restore.history.end session=$restore_name"

    created=false
    current_window=""
    current_window_target=""
    current_window_pane_ids=""
    first_window=true
    first_pane_in_window=true
    active_window=""
    window_layout=""
    created_target=""
    pane_id=""
    restored_work_pane_ids=""

    while IFS="$(printf '\t')" read -r record a b c d; do
        case "$record" in
            window)
                if [ "$first_window" = "false" ] && [ -n "$current_window_target" ]; then
                    apply_restored_window_layout "$current_window_target" "$window_layout" "$current_window_pane_ids"
                fi
                window_index="$a"
                window_name="$b"
                window_active="$c"
                window_layout="$d"
                current_window="$window_name"
                current_window_target=""
                current_window_pane_ids=""
                first_pane_in_window=true
                if [ "$window_active" = "1" ]; then
                    active_window="$window_name"
                fi
                ;;
            pane)
                trace_event "restore.pane.begin session=$restore_name window=$current_window index=$a"
                pane_path="$b"
                [ -d "$pane_path" ] || pane_path="$HOME"
                if [ "$created" = "false" ]; then
                    new_target="$(
                        tmux new-session -d -P -F '#{window_id}|#{pane_id}' \
                            -s "$restore_name" -n "$current_window" -c "$pane_path"
                    )"
                    IFS='|' read -r created_target pane_id <<< "$new_target"
                    current_window_target="$created_target"
                    current_window_pane_ids="${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                    created=true
                    first_window=false
                    first_pane_in_window=false
                elif [ "$first_pane_in_window" = "true" ]; then
                    new_target="$(
                        tmux new-window -P -F '#{window_id}|#{pane_id}' \
                            -t "=$restore_name:" -n "$current_window" -c "$pane_path"
                    )"
                    IFS='|' read -r created_target pane_id <<< "$new_target"
                    current_window_target="$created_target"
                    current_window_pane_ids="${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                    first_pane_in_window=false
                else
                    pane_id="$(tmux split-window -P -F '#{pane_id}' -t "$current_window_target" -c "$pane_path")"
                    current_window_pane_ids="${current_window_pane_ids}${current_window_pane_ids:+ }${pane_id#%}"
                    restored_work_pane_ids+="${restored_work_pane_ids:+ }$pane_id"
                fi
                trace_event "restore.pane.end session=$restore_name window=$current_window pane=$pane_id"
                ;;
            endwindow)
                if [ -n "$current_window_target" ]; then
                    apply_restored_window_layout "$current_window_target" "$window_layout" "$current_window_pane_ids"
                fi
                current_window=""
                current_window_target=""
                current_window_pane_ids=""
                ;;
        esac
    done < "$archive_path"
    trace_event "restore.panes.end session=$restore_name created=$created"

    if [ "$created" = "false" ]; then
        tmux new-session -d -s "$restore_name" -c "$HOME"
    fi

    if [ -n "$active_window" ]; then
        trace_event "restore.select-window.begin session=$restore_name"
        tmux select-window -t "=$restore_name:$active_window" >/dev/null 2>&1 || true
        trace_event "restore.select-window.end session=$restore_name"
    fi
    selected_session="$restore_name"
    width="$(tmux show-option -gqv '@dotfiles-session-sidebar-width' 2>/dev/null || true)"
    case "$width" in
        ''|*[!0-9]*) width="$SIDEBAR_WIDTH" ;;
    esac
    trace_event "restore.switch-client.begin session=$restore_name"
    tmux switch-client -t "=$restore_name" 2>/dev/null || true
    trace_event "restore.switch-client.end session=$restore_name"
    trace_event "restore.force-refresh.begin session=$restore_name"
    tmux set-option -g "@sidebar_force_refresh_$restore_name" 1 2>/dev/null || true
    trace_event "restore.force-refresh.end session=$restore_name"
    trace_event "restore.target-pane.begin session=$restore_name"
    restore_target_pane="$(tmux list-panes -t "=$restore_name:" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
        awk -F '|' -v title="$SIDEBAR_TITLE" '$2 != title { print $1; exit }')"
    trace_event "restore.target-pane.end session=$restore_name pane=$restore_target_pane"
    if [ -n "$restore_target_pane" ]; then
        if [ "$SIDEBAR_ASYNC_RESTORE" = "true" ]; then
            quoted_script="$(shell_quote "$SCRIPT_PATH")"
            quoted_restore_name="$(shell_quote "$restore_name")"
            trace_event "restore.sidebar.dispatch session=$restore_name pane=$restore_target_pane"
            tmux run-shell -b -t "=$restore_name:" \
                "$quoted_script --ensure-sidebar-session $quoted_restore_name" 2>/dev/null ||
                open_sidebar "$restore_target_pane" false "$width" "" true || true
        else
            trace_event "restore.sidebar.begin session=$restore_name pane=$restore_target_pane"
            open_sidebar "$restore_target_pane" false "$width" "" true || true
            trace_event "restore.sidebar.end session=$restore_name pane=$restore_target_pane"
        fi
    else
        trace_event "restore.sidebar.ensure.begin session=$restore_name"
        ensure_sidebar_for_session "$restore_name" || true
        trace_event "restore.sidebar.ensure.end session=$restore_name"
    fi
    current_session="$restore_name"
    if [ "$SIDEBAR_ASYNC_RESTORE" = "true" ]; then
        wait_for_sidebar_transition "$restore_name" || {
            trace_event "restore.sidebar.wait timeout session=$restore_name"
            debug_log "restore sidebar transition timeout session=$restore_name"
        }
    fi
    if [ -n "$metrics_restore_start" ]; then
        metrics_write "op=restore phase=complete operation_id=$metrics_restore_operation_id session=$restore_name duration_us=$(( $(metrics_now_us) - metrics_restore_start )) sidebar_mode=$SIDEBAR_ASYNC_RESTORE"
    fi
}

wait_for_sidebar_transition()
{
    local target_session="$1"
    local deadline=$(( $(date +%s%N) / 1000000 + 3000 ))
    local sidebar_pane owner_session client_session

    while [ "$(( $(date +%s%N) / 1000000 ))" -lt "$deadline" ]; do
        sidebar_pane="$(find_global_sidebar_pane || true)"
        owner_session="$(sidebar_tmux_pane_session "$sidebar_pane" || true)"
        client_session="$(tmux list-clients -F '#{session_name}' 2>/dev/null | head -n 1 || true)"
        if [ -n "$sidebar_pane" ] &&
            [ "$owner_session" = "$target_session" ] &&
            [ "$client_session" = "$target_session" ]; then
            tmux select-pane -t "$sidebar_pane" 2>/dev/null || true
            signal_sidebar_refresh "$target_session"
            return 0
        fi
        sleep 0.02
    done
    return 1
}

restore_selected_archives()
{
    debug_log "history restore selected index=$history_index file=${history_files[$history_index]:-none}"
    while IFS= read -r index; do
        restore_archive "${history_files[$index]}" || message_line "Restore failed"
    done <<EOF
$(archive_selected_indices)
EOF
}

delete_selected_archives()
{
    prompt_line 'Delete history? y/N '
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    answer="$prompt_result"
    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            while IFS= read -r index; do
                rm -f "${history_files[$index]}"
            done <<EOF
$(archive_selected_indices)
EOF
            ;;
    esac
}

tui_new_session()
{
    prompt_line 'New: '
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    session_name="$prompt_result"
    [ -n "$session_name" ] || return 0

    if session_exists "$session_name"; then
        selected_session="$session_name"
        return 0
    fi

    tmux new-session -d -s "$session_name" -c "$current_path"
    selected_session="$session_name"
}

tui_delete_session()
{
    [ -n "$selected_session" ] || return 0

    prompt_line "Delete $selected_session? y/Enter/All "
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    answer="$prompt_result"
    if [ "$answer" = "All" ]; then
        prompt_line "Save Session? y/N "
        if [ "$prompt_cancelled" = "true" ]; then
            return 0
        fi
        case "$prompt_result" in
            [Yy]|[Yy][Ee][Ss]) run_all_sessions_delete true ;;
            *) run_all_sessions_delete false ;;
        esac
        exit 0
    fi

    if ! session_exists "$selected_session"; then
        message_line "Missing: $selected_session"
        return 0
    fi

    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            debug_log "tui_delete_session confirm yes selected=$selected_session current=$current_session"
            deleted_session="$selected_session"
            deleting_current_session=false
            if [ "$selected_session" = "$current_session" ]; then
                next_session="$(fallback_session "$deleted_session")"
                debug_log "tui_delete_session deleting current selected=$deleted_session next_session=$next_session"
                if [ -n "$next_session" ]; then
                    tmux switch-client -t "=$next_session" 2>/dev/null || true
                    current_session="$next_session"
                fi
                deleting_current_session=true
            fi
            debug_log "tui_delete_session before run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
            run_session_delete "$deleted_session" true
            debug_log "tui_delete_session after run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
            if [ "$deleting_current_session" = "false" ]; then
                wait_for_session_absence "$deleted_session" || true
            fi
            if [ "$deleting_current_session" = "true" ]; then
                debug_log "tui_delete_session exit after deleting current selected=$deleted_session"
                exit 0
            fi
            selected_session="$current_session"
            ;;
        '')
            debug_log "tui_delete_session confirm enter selected=$selected_session current=$current_session"
            deleted_session="$selected_session"
            deleting_current_session=false
            if [ "$selected_session" = "$current_session" ]; then
                next_session="$(fallback_session "$deleted_session")"
                debug_log "tui_delete_session deleting current selected=$deleted_session next_session=$next_session"
                if [ -n "$next_session" ]; then
                    tmux switch-client -t "=$next_session" 2>/dev/null || true
                    current_session="$next_session"
                fi
                deleting_current_session=true
            fi
            debug_log "tui_delete_session before run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
            run_session_delete "$deleted_session" false
            debug_log "tui_delete_session after run_session_delete selected=$deleted_session deleting_current_session=$deleting_current_session"
            if [ "$deleting_current_session" = "false" ]; then
                wait_for_session_absence "$deleted_session" || true
            fi
            if [ "$deleting_current_session" = "true" ]; then
                debug_log "tui_delete_session exit after deleting current selected=$deleted_session"
                exit 0
            fi
            selected_session="$current_session"
            ;;
    esac
}

tui_rename_session()
{
    old_name="$selected_session"
    [ -n "$old_name" ] || return 0

    if ! session_exists "$old_name"; then
        message_line "Missing: $old_name"
        return 0
    fi

    prompt_line "Rename: "
    if [ "$prompt_cancelled" = "true" ]; then
        return 0
    fi
    new_name="$prompt_result"
    [ -n "$new_name" ] || return 0

    if session_exists "$new_name"; then
        message_line "Exists: $new_name"
        return 0
    fi

    tmux rename-session -t "=$old_name" "$new_name"
    selected_session="$new_name"
    if [ "$current_session" = "$old_name" ]; then
        current_session="$new_name"
    fi
}

move_selection()
{
    direction="$1"
    local metrics_input_start="" metrics_input_operation_id=""
    local metrics_input_phase_start=""
    local metrics_input_update_us=0 metrics_input_visibility_us=0 metrics_input_render_us=0
    if [ -n "$METRICS_FILE" ]; then
        metrics_input_start="$(metrics_now_us)"
        metrics_next_operation_id
        metrics_input_operation_id="$metrics_operation_id_result"
    fi
    selection_trace_id=$((selection_trace_id + 1))
    trace_id="$selection_trace_id"
    trace_event "selection.update.begin id=$trace_id direction=$direction index=$selected_index"
    old_index="$selected_index"
    count="${#session_names[@]}"

    [ "$count" -eq 0 ] && return 0

    case "$direction" in
        next) selected_index=$(((selected_index + 1) % count)) ;;
        prev) selected_index=$(((selected_index + count - 1) % count)) ;;
    esac

    selected_session="${session_names[$selected_index]}"
    if [ -n "$metrics_input_start" ]; then
        metrics_input_update_us=$(( $(metrics_now_us) - metrics_input_start ))
        metrics_input_phase_start="$(metrics_now_us)"
    fi
    ensure_selection_visible
    if [ -n "$metrics_input_start" ]; then
        metrics_input_visibility_us=$(( $(metrics_now_us) - metrics_input_phase_start ))
        metrics_input_phase_start="$(metrics_now_us)"
    fi

    trace_event "selection.render.begin id=$trace_id old_index=$old_index new_index=$selected_index"
    if row_is_visible "$old_index" && row_is_visible "$selected_index"; then
        render_selection_pair "$old_index" "$selected_index"
    else
        render_visible_rows
    fi
    trace_event "selection.render.end id=$trace_id old_index=$old_index new_index=$selected_index"
    trace_event "selection.update.end id=$trace_id index=$selected_index session=$selected_session"
    if [ -n "$metrics_input_start" ]; then
        metrics_input_render_us=$(( $(metrics_now_us) - metrics_input_phase_start ))
        metrics_write "op=input phase=selection operation_id=$metrics_input_operation_id direction=$direction old_index=$old_index new_index=$selected_index update_us=$metrics_input_update_us visibility_us=$metrics_input_visibility_us render_us=$metrics_input_render_us duration_us=$(( $(metrics_now_us) - metrics_input_start )) render=selection-pair"
    fi
}

read_key()
{
    timeout="${1:-0.2}"
    key=""
    rest=""
    key_result=""

    if [ "$timeout" = "block" ]; then
        IFS= read -rsn1 key || return 1
    elif ! IFS= read -rsn1 -t "$timeout" key; then
        return 1
    fi

    if [ "$key" = $'\033' ]; then
        IFS= read -rsn2 -t 0.01 rest || true
        case "$rest" in
            '[A') key_result=up ;;
            '[B') key_result=down ;;
            '') key_result=esc ;;
            *) key_result=other ;;
        esac
        return 0
    fi

    case "$key" in
        j) key_result=down ;;
        k) key_result=up ;;
        c) key_result=create ;;
        r) key_result=rename ;;
        d) key_result=delete ;;
        o) key_result=history ;;
        ' ') key_result=mark ;;
        q) key_result=quit ;;
        ''|$'\n'|$'\r') key_result=enter ;;
        *) key_result=other ;;
    esac
}

toggle_history_mode()
{
    if [ "$view_mode" = "history" ]; then
        view_mode="sessions"
    else
        view_mode="history"
        collect_history
        ensure_history_visible
    fi
    render_full
}

move_history_selection()
{
    direction="$1"
    count="${#history_files[@]}"
    [ "$count" -eq 0 ] && return 0

    case "$direction" in
        next) history_index=$(((history_index + 1) % count)) ;;
        prev) history_index=$(((history_index + count - 1) % count)) ;;
    esac
    debug_log "history selection direction=$direction index=$history_index file=${history_files[$history_index]}"

    ensure_history_visible
    render_history
}

toggle_history_mark()
{
    [ "${#history_files[@]}" -eq 0 ] && return 0
    if [ "${history_checked[$history_index]}" = "true" ]; then
        history_checked[$history_index]="false"
    else
        history_checked[$history_index]="true"
    fi
    render_history
}

handle_mouse_select()
{
    pane_id="$1"
    mouse_line="$2"
    mouse_x="$3"
    mouse_word="${4:-}"

    [ -n "$pane_id" ] || return 0
    [ -n "$mouse_line" ] || return 0
    [ -n "$mouse_x" ] || return 0
    [ "$(tmux display-message -p -t "$pane_id" '#{pane_title}' 2>/dev/null || true)" = "$SIDEBAR_TITLE" ] || return 0

    SELF_PANE="$pane_id"
    collect_sessions
    width="$(pane_width)"
    name_start=4
    name_end=$((width - 12))

    case "$mouse_x" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "$mouse_line" in
        ''|*[!0-9]*) return 0 ;;
    esac

    [ "$mouse_x" -ge "$name_start" ] || return 0
    [ "$mouse_x" -le "$name_end" ] || return 0

    row_index=$((mouse_line - 2 + scroll_offset))
    if [ "$row_index" -lt 0 ] ||
        [ "$row_index" -ge "${#session_names[@]}" ] ||
        { [ -n "$mouse_word" ] && [ "$mouse_word" != "${session_names[$row_index]}" ]; }; then
        alt_index=$((mouse_line - 1 + scroll_offset))
        if [ -z "$mouse_word" ] ||
            [ "$alt_index" -lt 0 ] ||
            [ "$alt_index" -ge "${#session_names[@]}" ] ||
            [ "$mouse_word" != "${session_names[$alt_index]}" ]; then
            return 0
        fi
        row_index="$alt_index"
    fi

    session_name="${session_names[$row_index]}"
    if [ -n "$mouse_word" ] && [ "$mouse_word" != "$session_name" ]; then
        return 0
    fi

    switch_session "$session_name"
}

run_tui()
{
    trace_event "sidebar.process.begin pane=${TMUX_PANE:-none}"
    setup_terminal
    trace_event "sidebar.setup.end pane=${TMUX_PANE:-none}"
    mark_sidebar_pane
    trace_event "sidebar.collect.begin pane=${TMUX_PANE:-none}"
    collect_sessions
    trace_event "sidebar.collect.end pane=${TMUX_PANE:-none}"
    trace_event "sidebar.first-render.begin pane=${TMUX_PANE:-none}"
    render_full
    trace_event "sidebar.first-render.end pane=${TMUX_PANE:-none}"
    last_tick="$(epoch_now)"
    sidebar_session_cached="$(sidebar_session_name || true)"
    [ -n "$sidebar_session_cached" ] || sidebar_session_cached="$current_session"
    last_force_refresh_check_epoch="$last_tick"
    if [ "$SIDEBAR_SIGNAL_TIMER_ENABLED" = "true" ]; then
        start_tick_timer
    fi

    while true; do
        if [ -n "$METRICS_FILE" ]; then
            maintenance_metrics_loops=$((maintenance_metrics_loops + 1))
            metrics_phase=read
            metrics_proc_cpu_ticks
            maintenance_read_cpu_start="$metrics_proc_cpu_ticks_result"
            metrics_now_us_value
            maintenance_read_start="$metrics_now_us_result"
        fi
        read_timeout="$SIDEBAR_IDLE_INTERVAL"
        has_animation=false
        for index in "${!session_animate[@]}"; do
            if [ "${session_animate[$index]}" = "true" ]; then
                has_animation=true
                read_timeout="$SIDEBAR_ANIMATION_INTERVAL"
                break
            fi
        done
        # A passive sidebar does not need to wake at the animation cadence.
        # Input still interrupts read immediately, while the slower timeout
        # avoids repeatedly executing the Bash loop when no animation is due.
        if [ "$SIDEBAR_ADAPTIVE_IDLE_READ" = "true" ] && [ "$has_animation" = "false" ]; then
            read_timeout="$SIDEBAR_ADAPTIVE_IDLE_TIMEOUT"
        fi
        if [ "$SIDEBAR_EVENT_LOOP_ENABLED" = "true" ] &&
            [ "$SIDEBAR_SIGNAL_TIMER_ENABLED" = "true" ] &&
            [ "$has_animation" = "false" ]; then
            read_timeout=block
        fi

        trace_event "read.begin timeout=$read_timeout"
        key=""
        if read_key "$read_timeout"; then
            key="$key_result"
            last_input_epoch_us="$(debug_now_us)"
            trace_event "read.end key=$key"
        else
            trace_event "read.timeout"
        fi
        if [ -n "$METRICS_FILE" ]; then
            metrics_now_us_value
            maintenance_read_end="$metrics_now_us_result"
            metrics_proc_cpu_ticks
            maintenance_metrics_read_cpu_ticks=$((maintenance_metrics_read_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_read_cpu_start))
            maintenance_metrics_read_us=$((maintenance_metrics_read_us + maintenance_read_end - maintenance_read_start))
            if [ -n "$key" ]; then
                maintenance_metrics_read_keys=$((maintenance_metrics_read_keys + 1))
            else
                maintenance_metrics_read_timeouts=$((maintenance_metrics_read_timeouts + 1))
            fi
        fi

        case "$key" in
            up)
                trace_event "selection.begin direction=prev"
                if [ "$view_mode" = "history" ]; then
                    move_history_selection prev
                else
                    move_selection prev
                fi
                ;;
            down)
                trace_event "selection.begin direction=next"
                if [ "$view_mode" = "history" ]; then
                    move_history_selection next
                else
                    move_selection next
                fi
                ;;
            enter)
                trace_event "action.begin type=enter session=$selected_session"
                debug_log "enter action view_mode=$view_mode history_index=$history_index selected=$selected_session"
                if [ "$view_mode" = "history" ]; then
                    history_restore_in_progress=true
                    restore_selected_archives
                    collect_history
                    history_restore_in_progress=false
                else
                    switch_session "$selected_session"
                fi
                collect_sessions false "$selected_session"
                render_full
                ;;
            create)
                tui_new_session
                collect_sessions true
                render_full
                ;;
            rename)
                tui_rename_session
                collect_sessions true
                render_full
                ;;
            delete)
                if [ "$view_mode" = "history" ]; then
                    delete_selected_archives
                    collect_history
                else
                    debug_log "main delete before tui_delete_session current_session=$current_session selected_session=$selected_session"
                    tui_delete_session
                    debug_log "main delete after tui_delete_session current_session=$current_session selected_session=$selected_session"
                fi
                collect_sessions true
                debug_log "main delete after collect_sessions current_session=$current_session selected_session=$selected_session"
                render_full
                ;;
            history)
                toggle_history_mode
                ;;
            mark)
                if [ "$view_mode" = "history" ]; then
                    toggle_history_mark
                fi
                ;;
            esc)
                if [ "$view_mode" = "history" ]; then
                    view_mode="sessions"
                    render_full
                fi
                ;;
            quit)
                exit 0
                ;;
        esac

        if [ "$full_render_required" = "true" ]; then
            render_full
            trace_event "render.full"
            full_render_required=false
            session_animation_refresh_indexes=()
        fi

        now="${EPOCHSECONDS:-$SECONDS}"
        maintenance_tick=false
        refresh_signal_tick="$refresh_signal_pending"
        refresh_signal_pending=false
        if [ "$tick_signal_pending" = "true" ] ||
            [ "$refresh_signal_tick" = "true" ] ||
            [ "$now" != "$last_tick" ]; then
            tick_signal_pending=false
            if [ "$now" != "$last_tick" ]; then
                maintenance_tick=true
                if [ -n "$key" ]; then
                    trace_event "maintenance.defer type=age reason=key"
                elif maintenance_cooldown_active; then
                    trace_event "maintenance.defer type=age reason=recent-input"
                else
                    if [ -n "$METRICS_FILE" ]; then
                        metrics_phase=age
                        metrics_proc_cpu_ticks
                        maintenance_age_cpu_start="$metrics_proc_cpu_ticks_result"
                        metrics_now_us_value
                        maintenance_age_start="$metrics_now_us_result"
                    fi
                    render_age_cells
                    if [ -n "$METRICS_FILE" ]; then
                        metrics_now_us_value
                        metrics_proc_cpu_ticks
                        maintenance_metrics_age_cpu_ticks=$((maintenance_metrics_age_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_age_cpu_start))
                        maintenance_metrics_age_us=$((maintenance_metrics_age_us + metrics_now_us_result - maintenance_age_start))
                        maintenance_metrics_age_calls=$((maintenance_metrics_age_calls + 1))
                    fi
                fi
                last_tick="$now"
            fi

            if [ "$maintenance_tick" = true ] || [ "$refresh_signal_tick" = true ]; then
                if [ -n "$key" ]; then
                    trace_event "maintenance.defer type=refresh reason=key"
                elif maintenance_cooldown_active; then
                    trace_event "maintenance.defer type=refresh reason=recent-input"
                else
                    if [ "$refresh_signal_tick" = true ] ||
                        [ -z "$last_force_refresh_check_epoch" ] ||
                        [ $((now - last_force_refresh_check_epoch)) -ge "$SIDEBAR_FORCE_REFRESH_CHECK_SECONDS" ]; then
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_phase=force
                            metrics_proc_cpu_ticks
                            maintenance_force_cpu_start="$metrics_proc_cpu_ticks_result"
                            metrics_now_us_value
                            maintenance_force_start="$metrics_now_us_result"
                            maintenance_metrics_force_checks=$((maintenance_metrics_force_checks + 1))
                        fi
                        local force_refresh_flag="@sidebar_force_refresh_${sidebar_session_cached:-$current_session}"
                        local force_refresh sidebar_owner_session
                        force_refresh="$(tmux show-option -gqv "$force_refresh_flag" 2>/dev/null || true)"
                        sidebar_owner_session="$(sidebar_session_name || true)"
                        [ -n "$sidebar_owner_session" ] || sidebar_owner_session="${sidebar_session_cached:-$current_session}"
                        if [ "$force_refresh" = "1" ] || [ "$refresh_signal_tick" = "true" ]; then
                            collect_sessions false "$sidebar_owner_session"
                            align_selection_to_session "$sidebar_owner_session"
                            render_full
                            session_animation_refresh_indexes=()
                            last_state_refresh_epoch="${EPOCHSECONDS:-$SECONDS}"
                            tmux set-option -g "$force_refresh_flag" 0 2>/dev/null || true
                            [ "$sidebar_owner_session" = "${sidebar_session_cached:-}" ] ||
                                tmux set-option -g "@sidebar_force_refresh_$sidebar_owner_session" 0 2>/dev/null || true
                        fi
                        last_force_refresh_check_epoch="$now"
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_now_us_value
                            metrics_proc_cpu_ticks
                            maintenance_metrics_force_cpu_ticks=$((maintenance_metrics_force_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_force_cpu_start))
                            maintenance_metrics_force_us=$((maintenance_metrics_force_us + metrics_now_us_result - maintenance_force_start))
                        fi
                    fi

                    if [ "$maintenance_tick" = true ] && state_refresh_due; then
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_phase=state
                            metrics_proc_cpu_ticks
                            maintenance_state_cpu_start="$metrics_proc_cpu_ticks_result"
                            metrics_now_us_value
                            maintenance_state_start="$metrics_now_us_result"
                            maintenance_metrics_state_calls=$((maintenance_metrics_state_calls + 1))
                        fi
                        if refresh_sidebar_state_if_due; then
                            render_animation_state_changes
                        fi
                        if [ -n "$METRICS_FILE" ]; then
                            metrics_now_us_value
                            metrics_proc_cpu_ticks
                            maintenance_metrics_state_cpu_ticks=$((maintenance_metrics_state_cpu_ticks + metrics_proc_cpu_ticks_result - maintenance_state_cpu_start))
                            maintenance_metrics_state_us=$((maintenance_metrics_state_us + metrics_now_us_result - maintenance_state_start))
                        fi
                    else
                        [ -n "$METRICS_FILE" ] && maintenance_metrics_state_skips=$((maintenance_metrics_state_skips + 1))
                    fi
                fi
            fi
        fi

        if [ -z "$key" ] && [ "$view_mode" = "sessions" ] &&
            [ "$SIDEBAR_ANIMATION_ENABLED" = "true" ]; then
            animation_tick_counter=$((animation_tick_counter + 1))
            if [ "$animation_tick_counter" -ge 1 ]; then
                animation_tick_counter=0
                animation_frame=$(((animation_frame + 1) % 24))
                for index in "${!session_animate[@]}"; do
                    [ "${session_animate[$index]}" = "true" ] && {
                        render_animated_name_cells
                        break
                    }
                done
            fi
        fi

        metrics_flush
    done
}

# shellcheck disable=SC1090
source "$SIDEBAR_CONTROLLER_PATH"

main()
{
    require_command tmux
    trace_event "launcher.process.begin args=$*"
    debug_log "main start args=$* current_session=$(tmux display-message -p '#S' 2>/dev/null || true)"

    case "${1:-}" in
        --open-sidebar)
            toggle_current_sidebar
            return 0
            ;;
        --toggle-sidebar-session)
            toggle_sidebar_for_session "${2:-}"
            return 0
            ;;
        --toggle-sidebar-pane)
            toggle_sidebar_for_pane "${2:-}"
            return 0
            ;;
        --ensure-current-sidebar)
            open_sidebar
            return 0
            ;;
        --ensure-sidebar-session)
            sidebar_controller_move_to_session "${2:-}"
            return 0
            ;;
        --list-sessions)
            collect_sessions
            for index in "${!session_names[@]}"; do
                printf '%s\t%s\t%s\n' "${session_names[$index]}" "${session_created[$index]}" "${session_status[$index]}"
            done
            return 0
            ;;
        --split-horizontal)
            split_work_pane horizontal
            return 0
            ;;
        --split-vertical)
            split_work_pane vertical
            return 0
            ;;
        --mouse-select)
            handle_mouse_select "${2:-}" "${3:-}" "${4:-}" "${5:-}"
            return 0
            ;;
        --delete-session-after-archive)
            delete_session_after_archive "${2:-}" "${3:-false}"
            return 0
            ;;
        --delete-all-sessions-after-archive)
            delete_all_sessions_after_archive "${2:-false}"
            return 0
            ;;
        --sidebar|"")
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac

    run_tui
    debug_log "main end args=$*"
}

main "$@"
